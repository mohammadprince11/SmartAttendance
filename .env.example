# ZYNORA HR — متغيرات البيئة للاختبار المحلي (أسماء فقط، بلا قيم حقيقية)
# انسخه إلى ‎.env‎ محلياً — و‎.env‎ مستثنى من Git ولا يُرفع أبداً.
# ممنوع منعاً باتاً وضع قيم إنتاج هنا أو بأي ملف داخل المستودع.

# --- اختبارات E2E (بيئة اختبار مخصصة — ليست الإنتاج) ---
ZYNORA_E2E_BASE_URL=
ZYNORA_E2E_USERNAME=
ZYNORA_E2E_PASSWORD=

# --- قاعدة البيانات المحلية للتطوير (لا تضع سلسلة اتصال إنتاج) ---
ConnectionStrings__DefaultConnection=

# --- البريد (SMTP) — يُفعَّل عمداً فقط ---
Smtp__Enabled=
Smtp__Host=
Smtp__Port=
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=

# --- إشعارات الويب (VAPID) — المفتاح الخاص سرّ ---
WebPush__PublicKey=
WebPush__PrivateKey=
WebPush__Subject=

# --- إنفاذ TLS خلف بروكسي/نفق موثوق ---
ForceHttps=

# --- شهادة HTTPS المحلية (LAN) — كلمة المرور سرّ ولا تُكتب بـappsettings ---
# الإقلاع يفشل برسالة واضحة إن عُرّفت نقطة HTTPS ووُجد ملف الشهادة وغاب هذا المتغيّر.
Kestrel__Certificates__Default__Password=

# --- الوسيط العكسي (Cloudflare Tunnel) — أسماء فقط، ليست أسراراً ---
ReverseProxy__Enabled=
ReverseProxy__KnownProxies__0=
ReverseProxy__AllowedHosts__0=

.vs/
.vscode/
**/bin/
**/obj/
*.user
*.suo
*.cache
*.log
*.log.*
TestResults/
.mobile-tools/
artifacts/mobile/*.apk
artifacts/mobile/*.aab
# Local QA screenshots and complete publish outputs are reproducible and can
# contain runtime/user data. Keep them out of source control.
/artifacts/
/_artifacts/

# Patch and temporary files
*.zip
files/
Apply_NEXORA_*.ps1
Remove_NEXORA_*.ps1
*.bak_*
*.before_*
NEXORA_ARCHIVED_PAGES/
NEXORA_BACKUPS_PreGit/

# Database files - never commit real company data
*.mdf
*.ldf
*.bak
*.bacpac
*.trn

# Local settings / secrets
appsettings.Development.json
secrets.json
.env

# NEXORA temporary patch/backups
*.bak_*
_NEXORA_CLEANUP_QUARANTINE_*/
*.ps1
# ...عدا سكربتات التشغيل المعتمدة: القاعدة أعلاه لسكربتات الترقيع العابرة،
# وأداةُ نشرٍ يعتمد عليها الإصدار ليست عابرة.
!scripts/deploy/*.ps1
# سكربتات النسخ/الاستعادة/المراقبة جزء من عقد الإنتاج وليست ترقيعات محلية.
!scripts/operations/*.ps1
# وسكربتا نقل الجهاز: الدليل بالمستودع يأمر بتشغيلهما، فاستثناؤهما كان يعني
# جهازاً جديداً يقرأ التعليمات ولا يجد الأداة. لا أسرار فيهما — مسارات ومنطق.
!scripts/handover/*.ps1
README_V*.md

# Employee uploaded photos
SmartAttendance.Web/wwwroot/uploads/employee-photos/
# NEXORA local cleanup/archive
__Cleanup_Archive/
*.bak*
*.tmp
# Build outputs
bin/
obj/
# Uploaded employee files
SmartAttendance.Web/wwwroot/uploads/employee-documents/
__Archive_RemovedPages/
appsettings.json
appsettings.*.json
!appsettings.example.json
_nexora_backups/

# NEXORA local-only artifacts
_nexora_diagnostics/
SmartAttendance.Web/wwwroot/uploads/company-logos/
SmartAttendance.Web/wwwroot/tenant-assets/
SmartAttendance.Web/App_Data/PageImports/
SmartAttendance.Web/App_Data/PositionImports/
# ملفات استيراد الحضور — بيانات موظفين حقيقية (بطاقات + أوقات). قاعدة حمراء:
# ممنوع أي بيانات موظف حقيقية بالمستودع. كان ملفٌّ منها متتبَّعاً بالخطأ (FIX-014).
SmartAttendance.Web/App_Data/AttendanceImports/

# Claude Code: keep shared launch.json, ignore local session data
.claude/*
!.claude/launch.json
SmartAttendance.Web/App_Data/DataProtection-Keys/
# قاموس اللغات المُدار من الواجهة يحتوي تعديلات العميل المحلية ويُنسخ مع بيانات التشغيل.
SmartAttendance.Web/App_Data/localization-dictionary.json
SmartAttendance.Web/App_Data/localization-dictionary.json.tmp

# LAN dev TLS private key (never commit)
SmartAttendance.Web/certs/
*.pfx

# حزم نقل الأجهزة — تحوي أسراراً ونسخ قاعدة
handover_*/
ZynoraHandover/

# آثار أدوات التنسيق (ruflo/claude-flow) — ليست من المشروع
.claude-flow/
.swarm/
ruvector.db

# Local development backups
LanguageCatalogBackup-*/
LanguageCatalogFix-*/
GlobalLanguageVisibility-*/
VisibilityFix-*/
*.bak-*


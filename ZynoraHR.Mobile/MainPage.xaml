<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZynoraHR.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource ZyBg}"
    FlowDirection="RightToLeft">

    <Grid BackgroundColor="{StaticResource ZyBg}"
          RowDefinitions="*,Auto">
        <ScrollView x:Name="MainScrollView"
                    Grid.Row="0">
            <VerticalStackLayout Padding="8,8,8,22" Spacing="10">

                <Border Style="{StaticResource NxPanel}"
                        Padding="10,8"
                        Margin="0,0,0,2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="بوابة الموظف الذكية"
                                   TextColor="#FFFFFF"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="ZYNORA HR · تجربة الموظف"
                                   TextColor="#9FB3C7"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   FlowDirection="LeftToRight"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="6"
                                               VerticalOptions="Center">
                            <Border WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="#0B1C2F"
                                    Stroke="#20384F"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="●"
                                       TextColor="#19D3E0"
                                       FontSize="13"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <Border WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="#0B1C2F"
                                    Stroke="#20384F"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="⚙"
                                       TextColor="#CFE0F0"
                                       FontSize="16"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <Border x:Name="OfflineBanner"
                        IsVisible="False"
                        BackgroundColor="#342B20"
                        Stroke="#6D5732"
                        StrokeShape="RoundRectangle 14"
                        Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                        <Label Text="●"
                               TextColor="{StaticResource ZyWarning}"
                               FontSize="11"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="وضع عدم الاتصال — بعض الوظائف غير متاحة."
                               TextColor="#F2D7A3"
                               FontSize="12" />
                    </Grid>
                </Border>

                <Border x:Name="LoginCard"
                        Style="{StaticResource ZyCardStrong}"
                        Padding="22">
                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="7">
                            <Border WidthRequest="46"
                                    HeightRequest="46"
                                    HorizontalOptions="Start"
                                    BackgroundColor="#123439"
                                    Stroke="#1C5A59"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="11">
                                <Image Source="zynora_symbol.svg" />
                            </Border>
                            <Label Text="SECURE EMPLOYEE ACCESS"
                                   Style="{StaticResource ZyEyebrow}"
                                   FlowDirection="LeftToRight" />
                            <Label Text="ابدأ يومك من مكان واحد"
                                   Style="{StaticResource ZyDisplay}" />
                            <Label Text="الحضور، الطلبات، الرصيد، والتنبيهات — ضمن تجربة ZYNORA موحدة وآمنة."
                                   Style="{StaticResource ZyBody}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="اسم المستخدم" Style="{StaticResource ZyCaption}" />
                            <Border BackgroundColor="{StaticResource ZyBgSoft}"
                                    Stroke="{StaticResource ZyStrokeSoft}"
                                    StrokeShape="RoundRectangle 15"
                                    Padding="14,2">
                                <Entry x:Name="UsernameEntry"
                                       Placeholder="Employee ID / Username"
                                       FlowDirection="LeftToRight"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource ZyText}"
                                       PlaceholderColor="{StaticResource ZyMuted2}"
                                       HeightRequest="50" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="كلمة المرور" Style="{StaticResource ZyCaption}" />
                            <Border BackgroundColor="{StaticResource ZyBgSoft}"
                                    Stroke="{StaticResource ZyStrokeSoft}"
                                    StrokeShape="RoundRectangle 15"
                                    Padding="14,2">
                                <Entry x:Name="PasswordEntry"
                                       Placeholder="••••••••"
                                       IsPassword="True"
                                       FlowDirection="LeftToRight"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource ZyText}"
                                       PlaceholderColor="{StaticResource ZyMuted2}"
                                       HeightRequest="50" />
                            </Border>
                        </VerticalStackLayout>

                        <Label x:Name="ErrorLabel"
                               IsVisible="False"
                               TextColor="{StaticResource ZyDanger}"
                               FontSize="12" />

                        <Button x:Name="LoginButton"
                                Text="دخول إلى ZYNORA"
                                Clicked="OnLoginClicked"
                                Style="{StaticResource ZyPrimaryButton}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="●"
                                   TextColor="{StaticResource ZySuccess}"
                                   FontSize="9"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="اتصال مشفر · جلسة آمنة · صلاحيات حسب الدور"
                                   Style="{StaticResource ZyCaption}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="HomePanel"
                                     IsVisible="False"
                                     Spacing="10">

                    <Border Style="{StaticResource NxPanel}"
                            Padding="14">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="GreetingLabel"
                                       Text="EMPLOYEE EXPERIENCE PORTAL"
                                       TextColor="#D7A84F"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"
                                       FlowDirection="LeftToRight" />
                                <Label x:Name="NameLabel"
                                       Text="أهلاً بك"
                                       TextColor="#FFFFFF"
                                       FontSize="21"
                                       FontAttributes="Bold"
                                       LineHeight="1.35" />
                                <Label Text="هذه هي صفحة السينك الرسمية: الإعلانات، الاستبيانات، الحضور، الراتب، الطلبات، الشكاوي، والتقييمات تظهر هنا من قاعدة البيانات."
                                       TextColor="#A9BBCF"
                                       FontSize="11.5"
                                       FontAttributes="Bold"
                                       LineHeight="1.55"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Border BackgroundColor="#102B34"
                                    Stroke="#27555D"
                                    StrokeShape="RoundRectangle 15"
                                    Padding="10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border WidthRequest="42"
                                            HeightRequest="42"
                                            BackgroundColor="#153B43"
                                            Stroke="#2B6A70"
                                            StrokeShape="RoundRectangle 13"
                                            Padding="0">
                                        <Label Text="Z"
                                               TextColor="#DFFFFF"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               FlowDirection="LeftToRight" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="1"
                                                         VerticalOptions="Center">
                                        <Label x:Name="IdentityNameLabel"
                                               Text="—"
                                               TextColor="#FFFFFF"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label x:Name="PositionLabel"
                                               Text="—"
                                               TextColor="#9FB3C7"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5">
                                            <Label x:Name="EmployeeNoLabel"
                                                   Text="—"
                                                   TextColor="#9FB3C7"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   FlowDirection="LeftToRight" />
                                            <Label Grid.Column="1"
                                                   Text="·"
                                                   TextColor="#607B94"
                                                   FontSize="10" />
                                            <Label x:Name="OrgLabel"
                                                   Grid.Column="2"
                                                   Text="—"
                                                   TextColor="#9FB3C7"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border Background="{StaticResource NxBalanceBrush}"
                            Stroke="#245D65"
                            StrokeShape="RoundRectangle 18"
                            Padding="12">
                        <VerticalStackLayout Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="رصيد إجازاتي"
                                       TextColor="#E6F0FA"
                                       FontSize="13"
                                       FontAttributes="Bold" />
                                <Label x:Name="BalanceYearLabel"
                                       Grid.Column="1"
                                       Text="2026"
                                       TextColor="#7F95AB"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       FlowDirection="LeftToRight" />
                            </Grid>

                            <HorizontalStackLayout x:Name="HomeLeaveBalancesContainer"
                                                   BindableLayout.ItemsSource="{Binding}"
                                                   Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#16283A"
                                                Stroke="#294158"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="10,8"
                                                WidthRequest="148">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Remaining, StringFormat='{0:0.#}'}"
                                                       TextColor="#19D3E0"
                                                       FontSize="24"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding Type}"
                                                       TextColor="#CFE0F0"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="Center"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding BalanceSummary}"
                                                       TextColor="#7F95AB"
                                                       FontSize="9"
                                                       HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <Label x:Name="HomeLeaveEmptyLabel"
                                   Text="لا يوجد رصيد إجازات مسجّل بعد"
                                   TextColor="#7F95AB"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   IsVisible="False" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,*,*,*"
                          RowSpacing="7"
                          ColumnSpacing="7">
                        <Button Grid.Row="0" Grid.Column="0"
                                Text="＋&#10;طلب جديد"
                                Clicked="OnRequestsTab"
                                Background="{StaticResource NxPrimaryBrush}"
                                BorderColor="#42DCE5"
                                BorderWidth="1"
                                TextColor="#041018"
                                FontAttributes="Bold"
                                FontSize="10"
                                CornerRadius="14"
                                HeightRequest="74" />
                        <Button Grid.Row="0" Grid.Column="1"
                                Text="☷&#10;طلباتي"
                                Clicked="OnRequestsTab"
                                Style="{StaticResource NxQuickButton}" />
                        <Button Grid.Row="0" Grid.Column="2"
                                Text="▣&#10;الحضور"
                                Clicked="OnAttendanceTab"
                                Style="{StaticResource NxQuickButton}"
                                TextColor="#8EF2C8" />
                        <Button Grid.Row="0" Grid.Column="3"
                                Text="◷&#10;بصمة"
                                Clicked="OnAttendanceTab"
                                Style="{StaticResource NxQuickButton}"
                                TextColor="#FFD27F" />
                        <Button Grid.Row="1" Grid.Column="0"
                                Text="⌁&#10;الاستبيانات"
                                Clicked="OnFeatureComingSoon"
                                Style="{StaticResource NxQuickButton}"
                                TextColor="#C9A3FF" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Text="▢&#10;الشكاوي"
                                Clicked="OnFeatureComingSoon"
                                Style="{StaticResource NxQuickButton}"
                                TextColor="#FF9FB2" />
                        <Button Grid.Row="1" Grid.Column="2"
                                Text="◎&#10;ملفي"
                                Clicked="OnProfileTab"
                                Style="{StaticResource NxQuickButton}"
                                TextColor="#19D3E0" />
                        <Button Grid.Row="1" Grid.Column="3"
                                Text="◇&#10;التقييم"
                                Clicked="OnFeatureComingSoon"
                                Style="{StaticResource NxQuickButton}"
                                TextColor="#FFC47F" />
                    </Grid>

                    <Border Style="{StaticResource NxCard}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="حائط الموظف"
                                           TextColor="#FFFFFF"
                                           FontSize="16"
                                           FontAttributes="Bold" />
                                    <Label Text="كل إعلان منشور من الإدارة وموجه لك يظهر هنا."
                                           TextColor="#96A9BD"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           LineHeight="1.45" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="#102B22"
                                        Stroke="#28533E"
                                        StrokeShape="RoundRectangle 99"
                                        Padding="9,4"
                                        VerticalOptions="Start">
                                    <Label x:Name="AnnouncementCountLabel"
                                           Text="0 منشور"
                                           TextColor="#BFFFD8"
                                           FontSize="9"
                                           FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#1D3043" />
                            <Label x:Name="AnnouncementsEmptyLabel"
                                   Text="لا توجد إعلانات منشورة حالياً."
                                   TextColor="#7F95AB"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,18"
                                   IsVisible="False" />
                            <CollectionView x:Name="AnnouncementsList"
                                            SelectionMode="None"
                                            HeightRequest="330">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#0D1B2A"
                                                Stroke="#20384F"
                                                StrokeShape="RoundRectangle 18"
                                                Padding="13"
                                                Margin="0,0,0,9">
                                            <VerticalStackLayout Spacing="8">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border BackgroundColor="#112333"
                                                            Stroke="#2A4258"
                                                            StrokeShape="RoundRectangle 99"
                                                            Padding="8,4">
                                                        <Label Text="{Binding Category}"
                                                               TextColor="#DCE7F3"
                                                               FontSize="9"
                                                               FontAttributes="Bold" />
                                                    </Border>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding PublishDate}"
                                                           TextColor="#7F95AB"
                                                           FontSize="9"
                                                           HorizontalTextAlignment="End"
                                                           FlowDirection="LeftToRight" />
                                                </Grid>
                                                <Label Text="{Binding Title}"
                                                       TextColor="#FFFFFF"
                                                       FontSize="17"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding Body}"
                                                       TextColor="#DCE7F3"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       LineHeight="1.55"
                                                       MaxLines="4"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource NxCard}">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="HR INSIGHT"
                                   TextColor="#D7A84F"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   FlowDirection="LeftToRight" />
                            <Label x:Name="EmployeeInsightLabel"
                                   Text="لا توجد تنبيهات مهمة حالياً"
                                   TextColor="#FFFFFF"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Text="هذه قراءة مبدئية من بيانات الحضور والطلبات والشكاوي."
                                   TextColor="#9FB3C7"
                                   FontSize="11"
                                   LineHeight="1.55" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout IsVisible="False">
                        <Label x:Name="TodayLabel" />
                        <Label x:Name="AttendanceLabel" />
                        <Label x:Name="AttendanceDetailLabel" />
                        <Label x:Name="LeaveLabel" />
                        <Label x:Name="LeaveDetailLabel" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="AttendancePanel"
                                     IsVisible="False"
                                     Spacing="15">
                    <VerticalStackLayout Spacing="4" Margin="0,2,0,2">
                        <Label Text="ATTENDANCE"
                               Style="{StaticResource ZyEyebrow}"
                               FlowDirection="LeftToRight" />
                        <Label Text="الدوام والحضور"
                               Style="{StaticResource ZyTitle}" />
                        <Label Text="حالة اليوم وسجل آخر أيام العمل في مكان واحد."
                               Style="{StaticResource ZyBody}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="{StaticResource ZySurface2}"
                            Stroke="#235A5A"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 26"
                            Padding="20">
                        <VerticalStackLayout Spacing="15">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="حالة اليوم"
                                           Style="{StaticResource ZyCaption}" />
                                    <Label x:Name="AttendancePageTodayLabel"
                                           Text="اليوم"
                                           Style="{StaticResource ZySectionTitle}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        Style="{StaticResource ZyPill}"
                                        VerticalOptions="Start">
                                    <Label x:Name="AttendancePageStatusLabel"
                                           Text="—"
                                           TextColor="{StaticResource ZyAccentBright}"
                                           FontSize="10"
                                           FontAttributes="Bold" />
                                </Border>
                            </Grid>

                            <Label x:Name="AttendancePageDetailLabel"
                                   Text="—"
                                   Style="{StaticResource ZyBody}"
                                   FlowDirection="LeftToRight" />

                            <BoxView HeightRequest="1"
                                     BackgroundColor="{StaticResource ZyStrokeSoft}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="●  تسجيل دخول"
                                        Clicked="OnCheckIn"
                                        Style="{StaticResource ZySuccessButton}" />
                                <Button Grid.Column="1"
                                        Text="◼  تسجيل خروج"
                                        Clicked="OnCheckOut"
                                        Style="{StaticResource ZyWarningButton}" />
                            </Grid>

                            <Label x:Name="AttendancePunchLabel"
                                   Text="سيتم التحقق من دقة الموقع قبل تسجيل الحضور."
                                   Style="{StaticResource ZyCaption}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ZyCard}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="سجل الحضور"
                                           Style="{StaticResource ZySectionTitle}" />
                                    <Label Text="آخر 7 أيام المتاحة من النظام."
                                           Style="{StaticResource ZyCaption}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="تحديث"
                                        Clicked="OnRefresh"
                                        Style="{StaticResource ZySecondaryButton}"
                                        HeightRequest="40"
                                        FontSize="10"
                                        Padding="12,6" />
                            </Grid>

                            <VerticalStackLayout x:Name="AttendanceHistoryContainer"
                                                 BindableLayout.ItemsSource="{Binding}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="{StaticResource ZyBgSoft}"
                                                Stroke="{StaticResource ZyStrokeSoft}"
                                                StrokeShape="RoundRectangle 15"
                                                Padding="13"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  RowDefinitions="Auto,Auto"
                                                  ColumnSpacing="10">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding Date}"
                                                           TextColor="{StaticResource ZyText}"
                                                           FontAttributes="Bold"
                                                           FontSize="13"
                                                           FlowDirection="LeftToRight" />
                                                    <Label Text="{Binding Status}"
                                                           Style="{StaticResource ZyCaption}" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource ZyPill}"
                                                        Padding="8,4"
                                                        VerticalOptions="Start">
                                                    <Label Text="{Binding Status}"
                                                           TextColor="{StaticResource ZyAccentBright}"
                                                           FontSize="9"
                                                           FontAttributes="Bold" />
                                                </Border>
                                                <Label Grid.Row="1"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding AttendanceTimeline}"
                                                       Style="{StaticResource ZyCaption}"
                                                       FlowDirection="LeftToRight"
                                                       Margin="0,6,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label x:Name="AttendanceEmptyLabel"
                                   Text="لا توجد بيانات حضور في الفترة الحالية."
                                   Style="{StaticResource ZyCaption}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,12"
                                   IsVisible="False" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="CompensationPanel"
                                     IsVisible="False"
                                     Spacing="15">
                    <VerticalStackLayout Spacing="4" Margin="0,2,0,2">
                        <Label Text="COMPENSATION"
                               Style="{StaticResource ZyEyebrow}"
                               FlowDirection="LeftToRight" />
                        <Label Text="التعويضات والمزايا"
                               Style="{StaticResource ZyTitle}" />
                        <Label Text="ملخص بياناتك المالية المسجلة في ZYNORA."
                               Style="{StaticResource ZyBody}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="{StaticResource ZySurface2}"
                            Stroke="#235A5A"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 26"
                            Padding="20">
                        <VerticalStackLayout Spacing="9">
                            <Label Text="صافي التعويض"
                                   Style="{StaticResource ZyCaption}" />
                            <Label x:Name="CompensationNetLabel"
                                   Text="—"
                                   Style="{StaticResource ZyMetric}"
                                   FontSize="30"
                                   FlowDirection="LeftToRight" />
                            <Label x:Name="CompensationCurrencyLabel"
                                   Text="IQD"
                                   TextColor="{StaticResource ZyAccentBright}"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   FlowDirection="LeftToRight" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Style="{StaticResource ZyCard}" Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="الراتب الأساسي"
                                       Style="{StaticResource ZyCaption}" />
                                <Label x:Name="CompensationBasicLabel"
                                       Text="—"
                                       TextColor="{StaticResource ZyText}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       FlowDirection="LeftToRight" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1"
                                Style="{StaticResource ZyCard}"
                                Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="البدلات"
                                       Style="{StaticResource ZyCaption}" />
                                <Label x:Name="CompensationAllowancesLabel"
                                       Text="—"
                                       TextColor="{StaticResource ZySuccess}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       FlowDirection="LeftToRight" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2"
                                Style="{StaticResource ZyCard}"
                                Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="الاستقطاعات"
                                       Style="{StaticResource ZyCaption}" />
                                <Label x:Name="CompensationDeductionsLabel"
                                       Text="—"
                                       TextColor="{StaticResource ZyDanger}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       FlowDirection="LeftToRight" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource ZyCard}">
                        <VerticalStackLayout Spacing="13">
                            <Label Text="بيانات الدفع"
                                   Style="{StaticResource ZySectionTitle}" />
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,*"
                                  RowSpacing="10"
                                  ColumnSpacing="14">
                                <Label Text="طريقة الدفع"
                                       Style="{StaticResource ZyCaption}" />
                                <Label x:Name="CompensationPaymentMethodLabel"
                                       Grid.Column="1"
                                       Text="—"
                                       TextColor="{StaticResource ZyText2}"
                                       FontSize="12" />
                                <Label Grid.Row="1"
                                       Text="البنك"
                                       Style="{StaticResource ZyCaption}" />
                                <Label x:Name="CompensationBankLabel"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Text="—"
                                       TextColor="{StaticResource ZyText2}"
                                       FontSize="12" />
                                <Label Grid.Row="2"
                                       Text="الحساب"
                                       Style="{StaticResource ZyCaption}" />
                                <Label x:Name="CompensationAccountLabel"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Text="—"
                                       TextColor="{StaticResource ZyText2}"
                                       FontSize="12"
                                       FlowDirection="LeftToRight" />
                            </Grid>

                            <Label x:Name="CompensationEmptyLabel"
                                   Text="لا توجد بيانات تعويضات مسجلة لهذا الموظف حالياً."
                                   Style="{StaticResource ZyCaption}"
                                   IsVisible="False" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="العودة إلى الرئيسية"
                            Clicked="OnHomeTab"
                            Style="{StaticResource ZySecondaryButton}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ProfilePanel"
                                     IsVisible="False"
                                     Spacing="15">
                    <VerticalStackLayout Spacing="4" Margin="0,2,0,2">
                        <Label Text="MY ZYNORA"
                               Style="{StaticResource ZyEyebrow}"
                               FlowDirection="LeftToRight" />
                        <Label Text="حسابي"
                               Style="{StaticResource ZyTitle}" />
                        <Label Text="هويتك الوظيفية، أرصدتك، وحالة حسابك."
                               Style="{StaticResource ZyBody}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="{StaticResource ZySurface2}"
                            Stroke="{StaticResource ZyStroke}"
                            StrokeShape="RoundRectangle 26"
                            Padding="20">
                        <VerticalStackLayout Spacing="15">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border WidthRequest="64"
                                        HeightRequest="64"
                                        BackgroundColor="#123439"
                                        Stroke="#1C5A59"
                                        StrokeShape="RoundRectangle 20"
                                        Padding="12">
                                    <Label Text="Z"
                                           TextColor="{StaticResource ZyAccent}"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           FlowDirection="LeftToRight" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3"
                                                     VerticalOptions="Center">
                                    <Label x:Name="ProfileNameLabel"
                                           Text="—"
                                           Style="{StaticResource ZySectionTitle}" />
                                    <Label x:Name="ProfilePositionLabel"
                                           Text="—"
                                           Style="{StaticResource ZyBody}" />
                                    <Label x:Name="ProfileEmployeeNoLabel"
                                           Text="—"
                                           TextColor="{StaticResource ZyAccentBright}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           FlowDirection="LeftToRight" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     BackgroundColor="{StaticResource ZyStrokeSoft}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="القسم" Style="{StaticResource ZyCaption}" />
                                    <Label x:Name="ProfileDepartmentLabel"
                                           Text="—"
                                           TextColor="{StaticResource ZyText}"
                                           FontSize="13"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="الموقع" Style="{StaticResource ZyCaption}" />
                                    <Label x:Name="ProfileBranchLabel"
                                           Text="—"
                                           TextColor="{StaticResource ZyText}"
                                           FontSize="13"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>

                            <Border Style="{StaticResource ZyPill}"
                                    HorizontalOptions="Start">
                                <Label x:Name="ProfileStatusLabel"
                                       Text="ACTIVE"
                                       TextColor="{StaticResource ZySuccess}"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       FlowDirection="LeftToRight" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ZyCard}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="أرصدة الإجازات"
                                   Style="{StaticResource ZySectionTitle}" />
                            <VerticalStackLayout x:Name="ProfileLeaveBalancesContainer"
                                                 BindableLayout.ItemsSource="{Binding}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="{StaticResource ZyBgSoft}"
                                                Stroke="{StaticResource ZyStrokeSoft}"
                                                StrokeShape="RoundRectangle 15"
                                                Padding="13"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  RowDefinitions="Auto,Auto">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding Type}"
                                                           TextColor="{StaticResource ZyText}"
                                                           FontSize="13"
                                                           FontAttributes="Bold" />
                                                    <Label Text="{Binding BalanceSummary}"
                                                           Style="{StaticResource ZyCaption}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1"
                                                       Text="{Binding Remaining}"
                                                       Style="{StaticResource ZyMetric}"
                                                       FontSize="20"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Row="1"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding Unit}"
                                                       Style="{StaticResource ZyCaption}"
                                                       Margin="0,5,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ZyCard}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="أمان الحساب"
                                       Style="{StaticResource ZySectionTitle}" />
                                <Label Text="الجلسة محفوظة بشكل آمن على الجهاز."
                                       Style="{StaticResource ZyCaption}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    Style="{StaticResource ZyPill}"
                                    VerticalOptions="Center">
                                <Label Text="SECURE"
                                       TextColor="{StaticResource ZySuccess}"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       FlowDirection="LeftToRight" />
                            </Border>
                        </Grid>
                    </Border>

                    <Button Text="تحديث بيانات الحساب"
                            Clicked="OnRefresh"
                            Style="{StaticResource ZySecondaryButton}" />

                    <Button Text="تسجيل الخروج من الحساب"
                            Clicked="OnLogout"
                            Style="{StaticResource ZyDangerButton}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="RequestsPanel"
                                     IsVisible="False"
                                     Spacing="15">
                    <VerticalStackLayout Spacing="4" Margin="0,2,0,2">
                        <Label Text="REQUEST CENTER"
                               Style="{StaticResource ZyEyebrow}"
                               FlowDirection="LeftToRight" />
                        <Label Text="الطلبات"
                               Style="{StaticResource ZyTitle}" />
                        <Label Text="أنشئ طلباً جديداً وتابع الموافقات والحالة من مكان واحد."
                               Style="{StaticResource ZyBody}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource ZyCardStrong}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="طلب جديد"
                                           Style="{StaticResource ZySectionTitle}" />
                                    <Label Text="الحقول تتغير تلقائياً حسب سياسة نوع الطلب."
                                           Style="{StaticResource ZyCaption}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        Style="{StaticResource ZyPill}"
                                        VerticalOptions="Start">
                                    <Label Text="SELF SERVICE"
                                           TextColor="{StaticResource ZyAccentBright}"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           FlowDirection="LeftToRight" />
                                </Border>
                            </Grid>

                            <Label Text="نوع الطلب" Style="{StaticResource ZyCaption}" />
                            <Picker x:Name="RequestTypePicker"
                                    Title="اختر نوع الطلب"
                                    SelectedIndexChanged="OnRequestTypeChanged"
                                    BackgroundColor="{StaticResource ZyBgSoft}"
                                    TextColor="{StaticResource ZyText}"
                                    TitleColor="{StaticResource ZyMuted}"
                                    HeightRequest="50" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="من تاريخ" Style="{StaticResource ZyCaption}" />
                                    <DatePicker x:Name="FromDatePicker"
                                                BackgroundColor="{StaticResource ZyBgSoft}"
                                                TextColor="{StaticResource ZyText}"
                                                Format="yyyy-MM-dd" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Label Text="إلى تاريخ" Style="{StaticResource ZyCaption}" />
                                    <DatePicker x:Name="ToDatePicker"
                                                BackgroundColor="{StaticResource ZyBgSoft}"
                                                TextColor="{StaticResource ZyText}"
                                                Format="yyyy-MM-dd" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid x:Name="RequestTimeFields"
                                  IsVisible="False"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="وقت البداية" Style="{StaticResource ZyCaption}" />
                                    <TimePicker x:Name="RequestStartTimePicker"
                                                BackgroundColor="{StaticResource ZyBgSoft}"
                                                TextColor="{StaticResource ZyText}"
                                                Format="HH:mm" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Label Text="وقت النهاية" Style="{StaticResource ZyCaption}" />
                                    <TimePicker x:Name="RequestEndTimePicker"
                                                BackgroundColor="{StaticResource ZyBgSoft}"
                                                TextColor="{StaticResource ZyText}"
                                                Format="HH:mm" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout x:Name="RequestAttachmentFields"
                                                 IsVisible="False"
                                                 Spacing="7">
                                <Label x:Name="RequestAttachmentHint"
                                       Text="المرفق اختياري"
                                       Style="{StaticResource ZyCaption}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Button Text="إرفاق ملف"
                                            Clicked="OnPickRequestAttachment"
                                            Style="{StaticResource ZySecondaryButton}"
                                            HeightRequest="42"
                                            FontSize="11"
                                            Padding="14,7" />
                                    <Label x:Name="RequestAttachmentName"
                                           Grid.Column="1"
                                           Text="لم يتم اختيار ملف"
                                           Style="{StaticResource ZyCaption}"
                                           VerticalTextAlignment="Center"
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                            </VerticalStackLayout>

                            <Label Text="السبب / الملاحظات" Style="{StaticResource ZyCaption}" />
                            <Editor x:Name="RequestReasonEditor"
                                    Placeholder="اكتب تفاصيل مختصرة وواضحة..."
                                    AutoSize="TextChanges"
                                    HeightRequest="96"
                                    BackgroundColor="{StaticResource ZyBgSoft}"
                                    TextColor="{StaticResource ZyText}"
                                    PlaceholderColor="{StaticResource ZyMuted2}" />

                            <Button Text="إرسال الطلب"
                                    Clicked="OnSubmitRequest"
                                    Style="{StaticResource ZyPrimaryButton}" />

                            <Label x:Name="RequestStatusLabel"
                                   Style="{StaticResource ZyCaption}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="MissingPunchRequestCard"
                            Style="{StaticResource ZyCard}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="تصحيح بصمة"
                                           Style="{StaticResource ZySectionTitle}" />
                                    <Label Text="استخدمه فقط عند وجود بصمة مفقودة."
                                           Style="{StaticResource ZyCaption}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="#342B20"
                                        Stroke="#6D5732"
                                        StrokeShape="RoundRectangle 99"
                                        Padding="9,5"
                                        VerticalOptions="Start">
                                    <Label Text="ATTENDANCE"
                                           TextColor="{StaticResource ZyWarning}"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           FlowDirection="LeftToRight" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <DatePicker x:Name="MissingDatePicker"
                                            BackgroundColor="{StaticResource ZyBgSoft}"
                                            TextColor="{StaticResource ZyText}"
                                            Format="yyyy-MM-dd" />
                                <TimePicker x:Name="MissingTimePicker"
                                            Grid.Column="1"
                                            BackgroundColor="{StaticResource ZyBgSoft}"
                                            TextColor="{StaticResource ZyText}"
                                            Format="HH:mm" />
                            </Grid>

                            <Editor x:Name="MissingReasonEditor"
                                    Placeholder="سبب نسيان البصمة"
                                    AutoSize="TextChanges"
                                    HeightRequest="82"
                                    BackgroundColor="{StaticResource ZyBgSoft}"
                                    TextColor="{StaticResource ZyText}"
                                    PlaceholderColor="{StaticResource ZyMuted2}" />

                            <Button Text="إرسال طلب التصحيح"
                                    Clicked="OnSubmitMissingPunch"
                                    Style="{StaticResource ZySecondaryButton}" />

                            <Label x:Name="MissingStatusLabel"
                                   Style="{StaticResource ZyCaption}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ZyCard}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="طلباتي"
                                           Style="{StaticResource ZySectionTitle}" />
                                    <Label Text="آخر الطلبات وحالة دورة الموافقة."
                                           Style="{StaticResource ZyCaption}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="تحديث"
                                        Clicked="OnRefreshRequests"
                                        Style="{StaticResource ZySecondaryButton}"
                                        HeightRequest="40"
                                        FontSize="10"
                                        Padding="12,6" />
                            </Grid>

                            <CollectionView x:Name="RequestsList"
                                            SelectionMode="None"
                                            HeightRequest="350">
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Spacing="5" Margin="0,24">
                                        <Label Text="◇"
                                               TextColor="{StaticResource ZyMuted2}"
                                               FontSize="24"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="لا توجد طلبات حالياً."
                                               Style="{StaticResource ZyCaption}"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="{StaticResource ZyBgSoft}"
                                                Stroke="{StaticResource ZyStrokeSoft}"
                                                StrokeShape="RoundRectangle 15"
                                                Padding="13"
                                                Margin="0,0,0,9">
                                            <VerticalStackLayout Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding Type}"
                                                           TextColor="{StaticResource ZyText}"
                                                           FontAttributes="Bold"
                                                           FontSize="14" />
                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource ZyPill}"
                                                            Padding="8,4">
                                                        <Label Text="{Binding StatusLabel}"
                                                               TextColor="{StaticResource ZyAccentBright}"
                                                               FontSize="9"
                                                               FontAttributes="Bold" />
                                                    </Border>
                                                </Grid>
                                                <Label Text="{Binding DateRange}"
                                                       Style="{StaticResource ZyCaption}"
                                                       FlowDirection="LeftToRight" />
                                                <Label Text="{Binding AttachmentText}"
                                                       TextColor="{StaticResource ZyAccent}"
                                                       FontSize="10" />
                                                <Label Text="{Binding Reason}"
                                                       Style="{StaticResource ZyCaption}"
                                                       LineBreakMode="WordWrap" />
                                                <Button Text="إلغاء الطلب"
                                                        IsVisible="{Binding IsCancelable}"
                                                        CommandParameter="{Binding Id}"
                                                        Clicked="OnCancelRequest"
                                                        Style="{StaticResource ZyDangerButton}"
                                                        HeightRequest="38"
                                                        FontSize="10" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ZyCard}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="طلبات تصحيح البصمة"
                                   Style="{StaticResource ZySectionTitle}" />
                            <CollectionView x:Name="MissingPunchesList"
                                            SelectionMode="None"
                                            HeightRequest="250">
                                <CollectionView.EmptyView>
                                    <Label Text="لا توجد طلبات تصحيح بصمة."
                                           Style="{StaticResource ZyCaption}"
                                           HorizontalTextAlignment="Center"
                                           Margin="0,24" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="{StaticResource ZyBgSoft}"
                                                Stroke="{StaticResource ZyStrokeSoft}"
                                                StrokeShape="RoundRectangle 15"
                                                Padding="13"
                                                Margin="0,0,0,9">
                                            <VerticalStackLayout Spacing="5">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding PunchType}"
                                                           TextColor="{StaticResource ZyText}"
                                                           FontAttributes="Bold"
                                                           FontSize="13" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Status}"
                                                           TextColor="{StaticResource ZyAccentBright}"
                                                           FontSize="10" />
                                                </Grid>
                                                <Label Text="{Binding PunchAt}"
                                                       Style="{StaticResource ZyCaption}"
                                                       FlowDirection="LeftToRight" />
                                                <Label Text="{Binding RefNo}"
                                                       TextColor="{StaticResource ZyMuted2}"
                                                       FontSize="9"
                                                       FlowDirection="LeftToRight" />
                                                <Label Text="{Binding Reason}"
                                                       Style="{StaticResource ZyCaption}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="تسجيل الخروج من الحساب"
                            Clicked="OnLogout"
                            Style="{StaticResource ZyDangerButton}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border x:Name="AuthNav"
                Grid.Row="1"
                IsVisible="False"
                Padding="6,5,6,8"
                BackgroundColor="#F006101D"
                Stroke="#263E55"
                StrokeShape="Rectangle">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="2">
                <Button x:Name="HomeTabButton"
                        Grid.Column="0"
                        Text="⌂&#10;الرئيسية"
                        Clicked="OnHomeTab"
                        Style="{StaticResource NxBottomButton}"
                        TextColor="#19D3E0" />
                <Button x:Name="AttendanceTabButton"
                        Grid.Column="1"
                        Text="▣&#10;الحضور"
                        Clicked="OnAttendanceTab"
                        Style="{StaticResource NxBottomButton}" />
                <Button x:Name="RequestsTabButton"
                        Grid.Column="2"
                        Text="▱&#10;طلباتي"
                        Clicked="OnRequestsTab"
                        Style="{StaticResource NxBottomButton}" />
                <Button x:Name="CompensationTabButton"
                        Grid.Column="3"
                        Text="▤&#10;الراتب"
                        Clicked="OnCompensationTab"
                        Style="{StaticResource NxBottomButton}" />
                <Button x:Name="ProfileTabButton"
                        Grid.Column="4"
                        Text="▦&#10;المزيد"
                        Clicked="OnMoreTab"
                        Style="{StaticResource NxBottomButton}" />
            </Grid>
        </Border>

        <Button x:Name="RequestFab"
                Grid.RowSpan="2"
                IsVisible="False"
                Text="+"
                Clicked="OnRequestsTab"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                Padding="0"
                FontSize="28"
                FontAttributes="Bold"
                Background="{StaticResource NxPrimaryBrush}"
                TextColor="#041018"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="18,0,0,82" />

        <Grid x:Name="MoreOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="#88020810"
              ZIndex="40">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseMoreTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border VerticalOptions="End"
                    BackgroundColor="#0A1A2E"
                    Stroke="#263E55"
                    StrokeShape="RoundRectangle 22,22,0,0"
                    Padding="16,10,16,22">
                <VerticalStackLayout Spacing="12">
                    <BoxView WidthRequest="42"
                             HeightRequest="4"
                             CornerRadius="2"
                             BackgroundColor="#597086"
                             HorizontalOptions="Center" />
                    <Label Text="أقسام أخرى"
                           TextColor="#E6F0FA"
                           FontSize="14"
                           FontAttributes="Bold" />

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,*"
                          RowSpacing="10"
                          ColumnSpacing="10">
                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Text="◎  ملفي الشخصي"
                                Clicked="OnProfileFromMore"
                                Style="{StaticResource NxQuickButton}"
                                HeightRequest="56"
                                FontSize="11" />
                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Text="⌁  الاستبيانات"
                                Clicked="OnFeatureComingSoon"
                                Style="{StaticResource NxQuickButton}"
                                HeightRequest="56"
                                FontSize="11" />
                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Text="▢  الشكاوي والمقترحات"
                                Clicked="OnFeatureComingSoon"
                                Style="{StaticResource NxQuickButton}"
                                HeightRequest="56"
                                FontSize="11" />
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Text="◇  التقييم والانضباط"
                                Clicked="OnFeatureComingSoon"
                                Style="{StaticResource NxQuickButton}"
                                HeightRequest="56"
                                FontSize="11" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="LoadingLayer"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="#D907111F">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="True"
                                   Color="#18AEE8"
                                   WidthRequest="40"
                                   HeightRequest="40" />
                <Label x:Name="LoadingLabel"
                       Text="جاري التحميل..."
                       TextColor="#F4F7FB"
                       FontSize="13" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>

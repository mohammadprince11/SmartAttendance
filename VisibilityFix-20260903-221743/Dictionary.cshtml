@page
@model SmartAttendance.Web.Pages.Settings.DictionaryModel

@{
    ViewData["Title"] = "قاموس اللغات";
}

@section Styles {
    <link rel="stylesheet" href="~/css/zynora-dictionary.css" asp-append-version="true" />
    <style id="zy-language-cards-final-fix">

        /* ==================================================
           FINAL LANGUAGE CARDS LAYOUT
           مستقل عن طول الترجمة
           ================================================== */

        .zy-dictionary-page .zy-dictionary-languages {
            display: grid !important;
            grid-template-columns:
                repeat(auto-fit, minmax(280px, 1fr)) !important;
            gap: 12px !important;
            align-items: stretch !important;
        }

        .zy-dictionary-page .zy-language-card {
            min-width: 0 !important;
            min-height: 0 !important;

            display: grid !important;
            grid-template-columns: minmax(0, 1fr) !important;
            grid-template-rows: minmax(72px, auto) auto !important;

            align-items: stretch !important;

            border: 1px solid var(--zy-border) !important;
            border-radius: 14px !important;

            background: var(--zy-surface) !important;
            overflow: hidden !important;
        }

        /* الجزء العلوي: معلومات اللغة */
        .zy-dictionary-page .zy-language-card > a {
            grid-column: 1 !important;
            grid-row: 1 !important;

            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;

            display: flex !important;
            flex-direction: column !important;

            align-items: flex-start !important;
            justify-content: center !important;

            gap: 3px !important;

            margin: 0 !important;
            padding: 13px 15px !important;

            border: 0 !important;
            border-radius: 0 !important;

            color: inherit !important;
            text-decoration: none !important;
        }

        .zy-dictionary-page .zy-language-card > a strong {
            display: block !important;

            width: 100% !important;
            min-width: 0 !important;

            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;

            font-size: 13px !important;
            font-weight: 800 !important;
        }

        .zy-dictionary-page .zy-language-card > a span {
            display: block !important;

            width: 100% !important;

            color: var(--zy-text-muted) !important;
            font-size: 9px !important;
            line-height: 1.5 !important;

            white-space: normal !important;
            overflow-wrap: anywhere !important;
        }

        /* الجزء السفلي: الإجراءات فقط */
        .zy-dictionary-page .zy-language-card__actions {
            grid-column: 1 !important;
            grid-row: 2 !important;

            position: static !important;

            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;

            display: flex !important;
            flex-direction: row !important;
            flex-wrap: wrap !important;

            align-items: center !important;
            justify-content: flex-start !important;

            gap: 6px !important;

            margin: 0 !important;
            padding: 9px 10px !important;

            border: 0 !important;
            border-block-start:
                1px solid var(--zy-border) !important;

            border-radius: 0 !important;

            background:
                color-mix(
                    in srgb,
                    var(--zy-surface-raised) 48%,
                    transparent
                ) !important;
        }

        .zy-dictionary-page .zy-language-card__actions form {
            position: static !important;

            display: flex !important;

            width: auto !important;
            min-width: 0 !important;

            margin: 0 !important;
            padding: 0 !important;

            border: 0 !important;
            background: transparent !important;
        }

        /* الأزرار */
        .zy-dictionary-page .zy-language-action {
            position: static !important;

            width: auto !important;
            min-width: 0 !important;
            max-width: 100% !important;

            min-height: 32px !important;

            display: inline-flex !important;

            align-items: center !important;
            justify-content: center !important;

            margin: 0 !important;
            padding: 6px 10px !important;

            border: 1px solid var(--zy-border) !important;
            border-radius: 8px !important;

            background: var(--zy-surface-raised) !important;
            color: var(--zy-text) !important;

            font-size: 10px !important;
            font-weight: 750 !important;

            line-height: 1.25 !important;

            white-space: normal !important;
            overflow-wrap: anywhere !important;

            cursor: pointer !important;
        }

        .zy-dictionary-page
        .zy-language-action--danger {
            color: var(--zy-danger) !important;
        }

        /* Badge */
        .zy-dictionary-page
        .zy-language-default-badge {
            position: static !important;

            display: inline-flex !important;

            align-items: center !important;
            justify-content: center !important;

            min-height: 28px !important;
            max-width: 100% !important;

            margin: 0 !important;
            padding: 5px 8px !important;

            border-radius: 999px !important;

            background: var(--zy-surface-raised) !important;
            color: var(--zy-text-muted) !important;

            font-size: 9px !important;
            line-height: 1.2 !important;

            white-space: normal !important;
        }

        .zy-dictionary-page
        .zy-language-card.is-hidden {
            opacity: .62 !important;
            border-style: dashed !important;
        }

        @@media (max-width: 1100px) {
            .zy-dictionary-page .zy-dictionary-languages {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr)) !important;
            }
        }

        @@media (max-width: 650px) {
            .zy-dictionary-page .zy-dictionary-languages {
                grid-template-columns: 1fr !important;
            }
        }

    
        /* ZYNORA_HIDE_DEFAULT_LANGUAGE_BADGE */
        .zy-dictionary-page .zy-language-default-badge {
            display: none !important;
        }

        /* ZYNORA_LANGUAGE_DIRECTION_TOGGLE */
        .zy-language-direction {
            min-width: 0;
            margin: 0;
            padding: 0;
            border: 0;
        }

        .zy-language-direction legend {
            margin-block-end: 7px;
            color: var(--zy-text-muted);
            font-size: 11px;
            font-weight: 700;
        }

        .zy-language-direction {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .zy-language-direction legend {
            grid-column: 1 / -1;
        }

        .zy-language-direction__option {
            position: relative;
            min-width: 0;
        }

        .zy-language-direction__option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .zy-language-direction__option span {
            min-height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 0 12px;

            border: 1px solid var(--zy-border);
            border-radius: 10px;

            background: var(--zy-surface-raised);
            color: var(--zy-text);

            font-size: 12px;
            font-weight: 800;

            cursor: pointer;
        }

        .zy-language-direction__option input:checked + span {
            border-color: var(--zy-electric-teal);
            box-shadow: inset 0 0 0 1px var(--zy-electric-teal);

            background:
                color-mix(
                    in srgb,
                    var(--zy-electric-teal) 10%,
                    var(--zy-surface-raised)
                );
        }

        .zy-language-direction__option span:hover {
            border-color: var(--zy-border-strong);
        }

        /* =================================================
           ZYNORA_DELETE_LANGUAGE_DIALOG_STYLE
           ================================================= */

        .zy-delete-language-dialog {
            width: min(390px, calc(100vw - 24px));
            max-width: 390px;

            padding: 0;
            border: 0;

            background: transparent;
            color: var(--zy-text);
        }

        .zy-delete-language-dialog::backdrop {
            background: rgba(3, 10, 22, .68);
            backdrop-filter: blur(4px);
        }

        .zy-delete-language-dialog__card {
            display: grid;
            grid-template-columns: 44px minmax(0, 1fr);
            gap: 14px;

            padding: 20px;

            border: 1px solid var(--zy-border-strong);
            border-radius: 16px;

            background: var(--zy-surface);

            box-shadow:
                0 24px 70px rgba(0, 0, 0, .45);
        }

        .zy-delete-language-dialog__icon {
            width: 42px;
            height: 42px;

            display: grid;
            place-items: center;

            border-radius: 12px;

            background: var(--zy-danger-soft);
            color: var(--zy-danger);

            font-size: 20px;
            font-weight: 900;
        }

        .zy-delete-language-dialog__content {
            min-width: 0;
        }

        .zy-delete-language-dialog__content h2 {
            margin: 0 0 6px;

            font-size: 17px;
            font-weight: 850;

            color: var(--zy-text);
        }

        .zy-delete-language-dialog__content p {
            margin: 0;

            color: var(--zy-text);
            font-size: 12px;
            line-height: 1.7;
        }

        .zy-delete-language-dialog__content strong {
            color: var(--zy-text);
            font-weight: 850;
        }

        .zy-delete-language-dialog__warning {
            display: block;

            margin-top: 7px;

            color: var(--zy-text-muted);

            font-size: 10px;
            line-height: 1.6;
        }

        .zy-delete-language-dialog__actions {
            grid-column: 1 / -1;

            display: flex;
            justify-content: flex-end;
            gap: 8px;

            padding-top: 5px;
        }

        .zy-delete-language-dialog__cancel,
        .zy-delete-language-dialog__confirm {
            min-height: 36px;

            padding: 7px 14px;

            border-radius: 9px;

            font-size: 11px;
            font-weight: 800;

            cursor: pointer;
        }

        .zy-delete-language-dialog__cancel {
            border: 1px solid var(--zy-border);

            background:
                var(--zy-surface-raised);

            color: var(--zy-text);
        }

        .zy-delete-language-dialog__confirm {
            border: 1px solid
                color-mix(
                    in srgb,
                    var(--zy-danger) 65%,
                    transparent);

            background:
                var(--zy-danger-soft);

            color: var(--zy-danger);
        }

        .zy-delete-language-dialog__confirm:hover {
            background: var(--zy-danger);
            color: #fff;
        }

        .zy-delete-language-dialog__cancel:hover {
            border-color:
                var(--zy-border-strong);
        }
</style>

}

<main class="zy-dictionary-page">
    <nav class="zy-dictionary-breadcrumb" aria-label="مسار الصفحة">
        <a asp-page="/Settings/Index">الإعدادات</a><span>/</span><strong>قاموس اللغات</strong>
    </nav>

    <header class="zy-dictionary-hero">
        <div>
            <span class="zy-dictionary-eyebrow">ZYNORA LANGUAGE CENTER</span>
            <h1>قاموس اللغات</h1>
            <p>راجع جميع كلمات النظام، صحّح الترجمة مباشرة، أو انقل قاموس لغة كاملة عبر Excel.</p>
        </div>
        <div class="zy-dictionary-hero__actions">
            <button type="button"
                    class="zy-dictionary-btn zy-dictionary-btn--primary"
                    data-zy-open-language-dialog>
                + إضافة لغة جديدة
            </button>

            <a asp-page-handler="Export"
               asp-route-culture="@Model.SelectedLanguage.Code"
               class="zy-dictionary-btn">
                تصدير @Model.SelectedLanguage.NativeName
            </a>

            <a asp-page-handler="NewLanguageTemplate"
               class="zy-dictionary-btn">
                قالب Excel للغة جديدة
            </a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="zy-dictionary-alert zy-dictionary-alert--success">@success</div>
    }
    @if (TempData["ImportNotice"] is string notice)
    {
        <div class="zy-dictionary-alert">@notice</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="zy-dictionary-alert zy-dictionary-alert--danger">@error</div>
    }
    <dialog id="zy-language-dialog"
            class="zy-language-dialog">

        <div class="zy-language-dialog__panel">

            <header class="zy-language-dialog__header">
                <div>
                    <span class="zy-dictionary-eyebrow">
                        LANGUAGE CATALOG
                    </span>

                    <h2>إضافة لغة جديدة</h2>

                    <p>
                        أضف اللغة أولاً، ثم أكمل ترجمة القاموس عند الحاجة.
                    </p>
                </div>

                <button type="button"
                        class="zy-language-dialog__close"
                        data-zy-close-language-dialog
                        aria-label="إغلاق">
                    ×
                </button>
            </header>

            <form method="post"
                  asp-page-handler="AddLanguage"
                  class="zy-language-dialog__form">

                <label>
                    رمز اللغة
                    <input name="cultureCode"
                           placeholder="fr-FR"
                           required />
                </label>

                <label>
                    اسم اللغة الأصلي
                    <input name="nativeName"
                           placeholder="Français"
                           required />
                </label>

                <label>
                    الاسم بالإنجليزية
                    <input name="englishName"
                           placeholder="French"
                           required />
                </label>

                <fieldset class="zy-language-direction">
    <legend>اتجاه اللغة</legend>

    <label class="zy-language-direction__option">
        <input type="radio"
               name="direction"
               value="ltr"
               checked />
        <span>LTR</span>
    </label>

    <label class="zy-language-direction__option">
        <input type="radio"
               name="direction"
               value="rtl" />
        <span>RTL</span>
    </label>
</fieldset>

                <footer class="zy-language-dialog__actions">
                    <button type="button"
                            class="zy-dictionary-btn"
                            data-zy-close-language-dialog>
                        إلغاء
                    </button>

                    <button type="submit"
                            class="zy-dictionary-btn zy-dictionary-btn--primary">
                        إضافة اللغة
                    </button>
                </footer>
            </form>
        </div>
    </dialog>
<section class="zy-dictionary-languages"
             aria-label="اللغات المثبتة">
        @foreach (var language in Model.Languages)
        {
            var isLastVisible =
                !language.IsHidden &&
                Model.VisibleLanguageCount <= 1;

            <article class="zy-language-card @(language.Code == Model.SelectedLanguage.Code ? "is-active" : "") @(language.IsHidden ? "is-hidden" : "")">
                <a asp-route-culture="@language.Code">
                    <strong data-zy-no-localize>
                        @language.NativeName
                    </strong>

                    <span>
                        @language.Code ·
                        @language.Direction.ToUpperInvariant() ·
                        @(language.IsHidden ? "مخفية" : "ظاهرة")
                    </span>
                </a>

                <div class="zy-language-card__actions">

                    <form method="post"
                          asp-page-handler="SetVisibility">

                        <input type="hidden"
                               name="culture"
                               value="@language.Code" />

                        <input type="hidden"
                               name="hidden"
                               value="@(!language.IsHidden)" />

                        <button type="submit"
                                class="zy-language-action"
                                title="@(isLastVisible ? "يجب أن تبقى لغة واحدة ظاهرة" : null)"
                                @(isLastVisible ? "disabled" : null)>

                            @(language.IsHidden
                                ? "إظهار"
                                : "إخفاء")
                        </button>
                    </form>

                    <form method="post"
                          asp-page-handler="DeleteLanguage" data-zy-delete-language
 data-language-name="@language.NativeName"
 data-language-code="@language.Code">

                        <input type="hidden"
                               name="culture"
                               value="@language.Code" />

                        <button type="submit"
                                class="zy-language-action zy-language-action--danger"
                                title="@(isLastVisible ? "لا يمكن حذف آخر لغة ظاهرة" : null)"
                                @(isLastVisible ? "disabled" : null)>
                            حذف
                        </button>
                    </form>
                </div></article>
        }
    </section>

    <section class="zy-dictionary-import">
        <div>
            <h2>استيراد Excel</h2>
            <p>الملف يجب أن يحتوي لغة واحدة. فعّل الاستبدال لمسح ترجمات اللغة القديمة قبل الاستيراد.</p>
        </div>
        <form method="post" enctype="multipart/form-data" asp-page-handler="Import">
            <input type="hidden" name="Culture" value="@Model.SelectedLanguage.Code" />
            <input type="file" name="file" accept=".xlsx,.csv" required />
            <label><input type="checkbox" name="replace" value="true" /> استبدال القاموس الحالي</label>
            <button type="submit" class="zy-dictionary-btn zy-dictionary-btn--primary">فحص واستيراد</button>
        </form>
    </section>

    @if (!Model.SelectedIsSource)
    {
        <section class="zy-dictionary-automatic">
            <div>
                <span class="zy-dictionary-eyebrow">AZURE AI TRANSLATOR</span>
                <h2>إكمال الكلمات الناقصة آلياً</h2>
                <p>تُرسل عبارات واجهة النظام فقط إلى Azure، ثم تُحفظ النتائج كمسودات تحتاج مراجعة بشرية. لا تُرسل بيانات الموظفين.</p>
            </div>
            @if (Model.AutomaticTranslationEnabled)
            {
                <form method="post" asp-page-handler="AutoTranslate">
                    <input type="hidden" name="culture" value="@Model.SelectedLanguage.Code" />
                    <label>
                        حجم الدفعة
                        <select name="maximumItems">
                            <option value="100">100 عبارة</option>
                            <option value="250" selected>250 عبارة</option>
                            <option value="500">500 عبارة</option>
                            <option value="1000">1000 عبارة</option>
                        </select>
                    </label>
                    <button type="submit" class="zy-dictionary-btn zy-dictionary-btn--primary">ترجمة الناقص</button>
                </form>
            }
            else
            {
                <div class="zy-dictionary-provider-status">
                    <strong>بانتظار تفعيل Azure</strong>
                    <span>ستتفعّل الأداة فور إضافة Endpoint والمفتاح والمنطقة إلى إعدادات التشغيل الآمنة.</span>
                </div>
            }
        </section>
    }

    <section class="zy-dictionary-toolbar">
        <form method="get">
            <input type="hidden" name="culture" value="@Model.SelectedLanguage.Code" />
            <input type="search" name="q" value="@Model.Q" placeholder="ابحث في المفتاح أو الترجمة…" />
            @if (!Model.SelectedIsSource)
            {
                <label><input type="checkbox" name="missingOnly" value="true" checked="@Model.MissingOnly" /> الناقصة فقط</label>
            }
            <button type="submit" class="zy-dictionary-btn">بحث</button>
        </form>
        <div class="zy-dictionary-stats">
            <span><b>@Model.TotalEntries</b> نتيجة</span>
            @if (!Model.SelectedIsSource)
            {
                <span class="@(Model.MissingEntries > 0 ? "has-missing" : "")"><b>@Model.MissingEntries</b> ناقصة</span>
                <span class="@(Model.MachineGeneratedEntries > 0 ? "needs-review" : "")"><b>@Model.MachineGeneratedEntries</b> تحتاج مراجعة</span>
            }
        </div>
    </section>

    <section class="zy-dictionary-table-wrap">
        <table class="zy-dictionary-table">
            <thead><tr><th>#</th><th>النص العربي / المفتاح</th><th>ترجمة @Model.SelectedLanguage.NativeName</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
            @if (Model.Entries.Count == 0)
            {
                <tr><td colspan="5" class="zy-dictionary-empty">لا توجد كلمات مطابقة.</td></tr>
            }
            else
            {
                var rowNumber = (Model.P - 1) * 80;
                foreach (var entry in Model.Entries)
                {
                    rowNumber++;
                    var missing = !Model.SelectedIsSource && string.IsNullOrWhiteSpace(entry.Translation);
                    <tr class="@(missing ? "is-missing" : "")">
                        <td>@rowNumber</td>
                        <td class="zy-dictionary-key" dir="rtl">@entry.Key</td>
                        <td colspan="3">
                            @if (Model.SelectedIsSource)
                            {
                                <span class="zy-dictionary-source">@entry.Translation</span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Save" class="zy-dictionary-row-form">
                                    <input type="hidden" name="culture" value="@Model.SelectedLanguage.Code" />
                                    <input type="hidden" name="key" value="@entry.Key" />
                                    <input type="hidden" name="q" value="@Model.Q" />
                                    <input type="hidden" name="missingOnly" value="@Model.MissingOnly.ToString().ToLowerInvariant()" />
                                    <input type="hidden" name="p" value="@Model.P" />
                                    <textarea name="translation" rows="2" dir="@Model.SelectedLanguage.Direction">@entry.Translation</textarea>
                                    <span class="zy-dictionary-state @(entry.RequiresReview ? "is-machine" : "")">
                                        @(missing ? "ناقص" : entry.RequiresReview ? "آلي · يحتاج مراجعة" : "مراجَع")
                                    </span>
                                    <button type="submit" class="zy-dictionary-btn">حفظ</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </section>

    @if (Model.TotalPages > 1)
    {
        <nav class="zy-dictionary-pagination" aria-label="صفحات القاموس">
            <a asp-route-culture="@Model.Culture" asp-route-q="@Model.Q" asp-route-missingOnly="@Model.MissingOnly" asp-route-p="@(Model.P - 1)" aria-disabled="@(Model.P == 1)">السابق</a>
            <span>صفحة @Model.P من @Model.TotalPages</span>
            <a asp-route-culture="@Model.Culture" asp-route-q="@Model.Q" asp-route-missingOnly="@Model.MissingOnly" asp-route-p="@(Model.P + 1)" aria-disabled="@(Model.P == Model.TotalPages)">التالي</a>
        </nav>
    }

    <!-- ZYNORA_DELETE_LANGUAGE_DIALOG_V1 -->
    <dialog id="zy-delete-language-dialog"
            class="zy-delete-language-dialog">

        <div class="zy-delete-language-dialog__card">

            <div class="zy-delete-language-dialog__icon"
                 aria-hidden="true">
                !
            </div>

            <div class="zy-delete-language-dialog__content">
                <h2>حذف اللغة</h2>

                <p>
                    هل تريد حذف
                    <strong id="zy-delete-language-name"
                            data-zy-no-localize>
                    </strong>
                    نهائياً؟
                </p>

                <span class="zy-delete-language-dialog__warning">
                    سيتم حذف اللغة وترجماتها، ولا يمكن التراجع عن هذا الإجراء.
                </span>
            </div>

            <div class="zy-delete-language-dialog__actions">

                <button type="button"
                        class="zy-delete-language-dialog__cancel"
                        data-zy-delete-cancel>
                    إلغاء
                </button>

                <button type="button"
                        class="zy-delete-language-dialog__confirm"
                        data-zy-delete-confirm>
                    حذف نهائي
                </button>

            </div>

        </div>

    </dialog>

    <script>
    (function () {
        const dialog =
            document.getElementById(
                "zy-delete-language-dialog");

        if (!dialog) return;

        const nameElement =
            document.getElementById(
                "zy-delete-language-name");

        const cancelButton =
            dialog.querySelector(
                "[data-zy-delete-cancel]");

        const confirmButton =
            dialog.querySelector(
                "[data-zy-delete-confirm]");

        let pendingForm = null;

        document
            .querySelectorAll(
                "form[data-zy-delete-language]")
            .forEach(form => {

                form.addEventListener(
                    "submit",
                    function (event) {

                        event.preventDefault();

                        pendingForm = form;

                        const languageName =
                            form.dataset.languageName ||
                            form.dataset.languageCode ||
                            "";

                        nameElement.textContent =
                            languageName;

                        dialog.showModal();
                    });
            });

        cancelButton.addEventListener(
            "click",
            function () {
                pendingForm = null;
                dialog.close();
            });

        confirmButton.addEventListener(
            "click",
            function () {

                if (!pendingForm)
                    return;

                const form = pendingForm;

                pendingForm = null;

                dialog.close();

                // submit مباشر حتى لا يرجع يفتح الـModal
                form.submit();
            });

        dialog.addEventListener(
            "click",
            function (event) {

                if (event.target === dialog) {
                    pendingForm = null;
                    dialog.close();
                }
            });

        dialog.addEventListener(
            "cancel",
            function () {
                pendingForm = null;
            });

    })();
    </script>
</main>

@section Scripts {
<script>
/* ZY_LANGUAGE_DIALOG_SCRIPT */
(function () {
    const dialog =
        document.getElementById(
            "zy-language-dialog");

    if (!dialog) return;

    document
        .querySelectorAll(
            "[data-zy-open-language-dialog]")
        .forEach(button => {
            button.addEventListener(
                "click",
                () => dialog.showModal());
        });

    document
        .querySelectorAll(
            "[data-zy-close-language-dialog]")
        .forEach(button => {
            button.addEventListener(
                "click",
                () => dialog.close());
        });

    dialog.addEventListener(
        "click",
        event => {
            if (event.target === dialog) {
                dialog.close();
            }
        });
})();
</script>
}







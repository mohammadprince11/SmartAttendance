# EnvironmentFile for the existing ZYNORA ASP.NET Core systemd service.
# Copy outside the repository, set ownership/permissions, then reference it
# from the existing service with EnvironmentFile=.

PeopleAIWorker__Enabled=true
PeopleAIWorker__PythonExecutable=/opt/zynora/people-ai/.venv/bin/python
PeopleAIWorker__ScriptPath=PeopleAI/local_ocr_worker.py
PeopleAIWorker__Device=auto
PeopleAIWorker__Language=ar
PeopleAIWorker__TempDirectory=/var/lib/zynora/people-ai/tmp
PeopleAIWorker__PollSeconds=2
PeopleAIWorker__StartupTimeoutSeconds=180
PeopleAIWorker__JobTimeoutSeconds=180
PeopleAIWorker__MaxImageSide=1600

# Production startup must verify schema only; apply migrations explicitly before restart.
DatabaseMigrations__ApplyOnStartup=false

# Optional fallback model source if HuggingFace is unavailable.
# PADDLE_PDX_MODEL_SOURCE=BOS

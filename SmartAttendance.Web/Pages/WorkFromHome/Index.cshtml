@page "/WorkFromHome"
@model SmartAttendance.Web.Pages.WorkFromHome.IndexModel
@using SmartAttendance.Web.Infrastructure.Hrms

@*
    العمل خارج المكتب — «العمل من المنزل» بقائمة إدارة الحضور.
    قراءة فقط: الإنشاء بالخدمة الذاتية والاعتماد بمساره المركزي.
*@

@{
    ViewData["Title"] = "العمل خارج المكتب";
}
<link rel="stylesheet" href="~/css/pages/index-f51291a2d2.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />


<section class="wfh-page" dir="rtl">
    <header class="wfh-head">
        <div>
            <h1>العمل خارج المكتب</h1>
            <p>أيام «عمل من المنزل» و«رحلة عمل» المعتمَدة — كما دخلت محرّك الحضور فعلاً.</p>
        </div>
        <a class="wfh-btn" asp-page="/SelfServices/Index">+ طلب جديد بالخدمة الذاتية</a>
    </header>

    <form method="get" class="wfh-bar">
        <label>الشهر
            <input type="month" name="Month" value="@Model.Month" />
        </label>
        <label>بحث (رمز/اسم موظف)
            <input type="text" name="Search" value="@Model.Search" placeholder="بحث..." />
        </label>
        @* القيم تُحسب خارج الوسم — اقتباس مزدوج داخل قيمة سمةٍ مقتبَسة مزلق تحليل بـRazor. *@
        @{
            var isRemoteSelected = Model.Kind == "WorkFromHome";
            var isTripSelected = Model.Kind == "BusinessTrip";
        }
        <label>النوع
            <select name="Kind">
                <option value="">الكل</option>
                <option value="WorkFromHome" selected="@isRemoteSelected">عمل من المنزل</option>
                <option value="BusinessTrip" selected="@isTripSelected">رحلة عمل</option>
            </select>
        </label>
        <button type="submit" class="wfh-btn ghost">عرض</button>

        <div class="wfh-stats">
            <span class="wfh-stat remote">عمل من المنزل <b>@Model.RemoteDays</b></span>
            <span class="wfh-stat trip">رحلة عمل <b>@Model.BusinessTripDays</b></span>
            @if (Model.AbsentDespiteApproval > 0)
            {
                <span class="wfh-stat absent" title="أيام معتمَدة ومع ذلك حالتها غياب — بلا بصمة">غياب رغم الاعتماد <b>@Model.AbsentDespiteApproval</b></span>
            }
        </div>
    </form>

    @if (Model.AbsentDespiteApproval > 0)
    {
        <div class="wfh-note">
            <b>@Model.AbsentDespiteApproval</b> يوماً معتمَداً للعمل خارج المكتب حالته «غياب».
            هذا ليس عطلاً: الأثر المالي لهذه الأيام <b>محايد بقرار صريح</b> — المحرّك يسجّل
            السياق ولا يمنح إعفاءً، فبلا بصمةٍ يبقى اليوم غياباً.
            إن أردتَ احتسابها حضوراً فابنِ قاعدةً على سياق «أيام العمل من المنزل» من
            <a asp-page="/ShiftRules/Index">قواعد المناوبات</a>.
        </div>
    }

    <div class="wfh-table-card">
        @if (Model.Rows.Count == 0)
        {
            <div class="wfh-empty">
                لا أيام عملٍ خارج المكتب بهذه الفترة.<br />
                الأيام تظهر هنا بعد <b>اعتماد</b> الطلب <b>و</b> تشغيل «تحديث الحضور» بالحضور اليومي —
                فالمعروض هنا اليوميات المحلَّلة لا الطلبات.
            </div>
        }
        else
        {
            <table class="wfh-table">
                <thead>
                    <tr>
                        <th>الكود</th><th>الموظف</th><th>التاريخ</th><th>النوع</th>
                        <th>ختم الدخول</th><th>ختم الخروج</th><th>ساعات العمل</th>
                        <th>ساعات التأخير</th><th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="wfh-num">@row.EmployeeNo</td>
                            <td>@row.EmployeeName</td>
                            <td class="wfh-num">@row.WorkDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="wfh-chip @row.DayKind">@DayAttendanceStore.DayKindLabel(row.DayKind)</span></td>
                            <td class="wfh-num">@(row.CheckIn?.ToString("HH:mm") ?? "—")</td>
                            <td class="wfh-num">@(row.CheckOut?.ToString("HH:mm") ?? "—")</td>
                            <td class="wfh-num">@row.WorkedHours</td>
                            <td class="wfh-num">@row.LateHours</td>
                            <td><span class="wfh-chip @row.Status">@DayAttendanceStore.StatusLabel(row.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

@page "{id:int}"
@model SmartAttendance.Web.Pages.Companies.EditModel

@section Styles {
    <link rel="stylesheet" href="~/css/zynora-setup-pages.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "تعديل شركة";
}

<div class="zynora-setup-page nx-setup-form-page">
    <section class="zynora-setup-hero">
        <div>
            <span class="zynora-setup-kicker">إعداد الشركة</span>
            <h1>تعديل شركة</h1>
            <p>تحديث بيانات الشركة الأساسية.</p>
        </div>
        <a asp-page="./Index" class="btn-secondary nx-setup-btn nx-setup-btn-secondary">الرجوع للقائمة</a>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert-danger nx-setup-alert-danger">@Model.ErrorMessage</div>
    }

    <section class="zynora-setup-card">
        <form method="post" class="nx-setup-modal-form">
            <input type="hidden" asp-for="Company.Id" />
            <input type="hidden" asp-for="Company.Code" />

            <div class="nx-setup-form-grid">
                @for (var index = 0; index < Model.NameTranslations.Count; index++)
                {
                    var language = Model.NameTranslations[index];
                    <label class="nx-setup-field" dir="@language.Direction" lang="@language.CultureCode">
                        <span>اسم الشركة — <b data-zy-no-localize>@language.NativeName</b> @(language.IsRequired ? "*" : "")</span>
                        <input type="hidden" asp-for="NameTranslations[index].CultureCode" />
                        <input asp-for="NameTranslations[index].Name" dir="@language.Direction" />
                    </label>
                }
                <span asp-validation-for="NameTranslations" class="text-danger nx-setup-field-wide"></span>

                <label class="nx-setup-field">
                    <span>البريد الإلكتروني</span>
                    <input asp-for="Company.Email" />
                </label>

                <label class="nx-setup-field">
                    <span>رقم الهاتف</span>
                    <input asp-for="Company.Phone" />
                </label>
            </div>

            <div class="nx-setup-modal__actions">
                <a asp-page="./Index" class="nx-setup-btn nx-setup-btn-secondary">إلغاء</a>
                <button type="submit" class="nx-setup-btn nx-setup-btn-primary">حفظ التعديل</button>
            </div>
        </form>
    </section>
</div>

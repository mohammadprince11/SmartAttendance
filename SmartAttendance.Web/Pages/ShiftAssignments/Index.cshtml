@page "/ShiftAssignments"
@model SmartAttendance.Web.Pages.ShiftAssignments.IndexModel
@using SmartAttendance.Web.Infrastructure.Hrms

@*
    مناوبات الموظفين الثابتة — المرحلة 5 (نمط كيان «تحديد مناوبات الموظفين»):
    تحديد متعدد + تعيين/إلغاء جماعي. المحلل يستخدم هذا التعيين.
*@

@{
    ViewData["Title"] = "مناوبات الموظفين";
}
<link rel="stylesheet" href="~/css/pages/index-5547d1b44f.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />


<section class="sha-page" dir="rtl">
    <header class="sha-head">
        <div>
            <h1>مناوبات الموظفين</h1>
            <p>تعيين المناوبة الثابتة لكل موظف — المحلل يستخدم: تعيين يدوي ← مطابقة معايير الاستحقاق ← المناوبة الافتراضية.</p>
        </div>
        <div class="zyu-9c40389b4ad8">
            <span class="sha-stat zyu-22d70a2892cd">معيّن <b>@Model.AssignedCount</b></span>
            <span class="sha-stat zyu-fecc85c94a43">بلا تعيين <b>@Model.UnassignedCount</b></span>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="sha-alert">@TempData["SuccessMessage"]</div>
    }

    <form method="get" class="sha-bar">
        <label>بحث (رمز/اسم/منصب/هيكلية/موقع)
            <input type="text" name="Search" value="@Model.Search" placeholder="بحث..." />
        </label>
        <label>عرض
            <select name="Filter">
                <option value="All" selected="@(Model.Filter == "All")">الكل</option>
                <option value="Assigned" selected="@(Model.Filter == "Assigned")">المعيّنون</option>
                <option value="Unassigned" selected="@(Model.Filter == "Unassigned")">بلا تعيين</option>
            </select>
        </label>
        <button type="submit" class="sha-btn ghost">عرض</button>
    </form>

    <form method="post" id="sha-form">
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="Filter" value="@Model.Filter" />

        <div class="sha-tools zyu-8cab4cf2c131">
            <button type="button" class="sha-btn ghost sm" onclick="shaSelectAll(true)">تحديد الكل (@Model.TotalRows)</button>
            <button type="button" class="sha-btn ghost sm" onclick="shaSelectAll(false)">مسح الكل</button>
            <span class="sha-none zyu-a49cca52becd">النتائج: <b class="zyu-b27868803587">@Model.TotalRows</b> موظف</span>
        </div>

        <div class="sha-table-card zyu-0ee7f66ad9c0">
            @if (Model.Rows.Count == 0)
            {
                <div class="sha-empty">لا موظفون مطابقون.</div>
            }
            else
            {
                <table class="sha-table">
                    <thead>
                        <tr><th class="zyu-d12729b3d536"><input type="checkbox" id="sha-all" onchange="shaToggleAll(this)" title="تحديد الكل" /></th><th>الرمز</th><th>اسم الموظف</th><th>الهيكلية</th><th>الموقع</th><th>تهيئة المناوبات</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td><input type="checkbox" name="SelectedIds" value="@row.EmployeeId" onchange="shaCount()" /></td>
                                <td class="zyu-934736f196e1">@row.EmployeeNo</td>
                                <td>
                                    <b>@row.EmployeeName</b>
                                    @if (!string.IsNullOrWhiteSpace(row.Position))
                                    { <div class="sha-pos">@row.Position</div> }
                                </td>
                                <td>@row.Department</td>
                                <td>@row.Branch</td>
                                <td>
                                    @if (row.EffectiveShiftName != null)
                                    {
                                        <span class="sha-shift"><i data-zy-style="background:@(row.EffectiveShiftColor ?? "#12D9E3")"></i>@row.EffectiveShiftName</span>
                                        <span class="sha-src @row.EffectiveSource">@(row.EffectiveSource switch { "Manual" => "يدوي", "Eligibility" => "بالاستحقاق", _ => "" })</span>
                                    }
                                    else
                                    {
                                        <span class="sha-none">— الافتراضية</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @* بار الإجراءات الجماعية العائم — يظهر عند التحديد *@
        <div class="sha-bulkbar" id="sha-bulkbar">
            <b>المحدد: <span id="sha-count">0</span></b>
            <select name="ShiftTypeId">
                <option value="">— اختر المناوبة —</option>
                @foreach (var shift in Model.Shifts)
                {
                    <option value="@shift.Id">@shift.Name</option>
                }
            </select>
            <button type="submit" asp-page-handler="Assign" class="sha-btn"
                    data-zyconfirm="تعيين المناوبة للمحدد — تأكيد؟">تعيين للمحدد</button>
            <button type="submit" asp-page-handler="Unassign" class="sha-btn no"
                    data-zyconfirm="إلغاء تعيين المحدد — تأكيد؟">إلغاء التعيين</button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        function shaToggleAll(source) { shaSelectAll(source.checked); }
        function shaSelectAll(on) {
            document.querySelectorAll('[name="SelectedIds"]').forEach(function (cb) { cb.checked = on; });
            var head = document.getElementById('sha-all'); if (head) head.checked = on;
            shaCount();
        }
        function shaCount() {
            var count = document.querySelectorAll('[name="SelectedIds"]:checked').length;
            document.getElementById('sha-count').textContent = count;
            document.getElementById('sha-bulkbar').classList.toggle('show', count > 0);
            var total = document.querySelectorAll('[name="SelectedIds"]').length;
            var head = document.getElementById('sha-all');
            if (head) head.checked = count > 0 && count === total;
        }
    </script>
}

@page "/AttendanceRecommendations"
@model SmartAttendance.Web.Pages.AttendanceRecommendations.IndexModel
@using SmartAttendance.Web.Infrastructure.Hrms

@*
    متابعة الإجراءات المقترحة — المرحلة 4 (نمط كيان): تبويبات حالة + اعتماد/تجاهل
    + «تحليل واسترجاع الاقتراحات».
*@

@{
    ViewData["Title"] = "الإجراءات المقترحة";
    var tabs = new (string Key, string Label, int Count)[]
    {
        ("Pending", "معلقة", Model.PendingCount),
        ("Conflicted", "متعارضة", Model.ConflictedCount),
        ("Auto", "تلقائية", Model.AutoCount),
        ("Approved", "معتمدة", Model.ApprovedCount),
        ("Ignored", "متجاهلة", Model.IgnoredCount),
        ("Transactions", "الحركات", Model.TransactionsCount + Model.ViolationsCount),
        ("All", "الكل", Model.PendingCount + Model.ConflictedCount + Model.AutoCount + Model.ApprovedCount + Model.IgnoredCount)
    };
}

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />

<style>
    .rec-page { display: flex; flex-direction: column; gap: 14px; color: var(--sa-text, #DCEAF4); }
    .rec-head {
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;
        padding: 16px 20px; border: 1px solid rgba(73,111,151,.22); border-radius: 20px;
        background: radial-gradient(circle at 90% 10%, rgba(18,217,227,.12), transparent 36%),
                    linear-gradient(135deg, rgba(9,31,52,.95), rgba(5,16,29,.95));
    }
    html[data-theme="light"] .rec-head { background: linear-gradient(135deg, #fff, #f2f7fb); }
    .rec-head h1 { margin: 0; font-size: 20px; font-weight: 1000; }
    .rec-head p { margin: 2px 0 0; font-size: 12px; color: var(--sa-muted, #8FA8BC); font-weight: 800; }
    .rec-btn { min-height: 38px; padding: 8px 18px; border-radius: 12px; border: 0; font-size: 13px; font-weight: 900; cursor: pointer; background: linear-gradient(135deg, #12D9E3, #0ea5b5); color: #04141d; }
    .rec-btn.ghost { background: transparent; border: 1px solid rgba(73,111,151,.3); color: inherit; }
    .rec-btn.ok { background: linear-gradient(135deg, #4ade80, #22c55e); }
    .rec-btn.no { background: transparent; border: 1px solid rgba(248,113,113,.4); color: #f87171; }

    .rec-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 10px 14px; border: 1px solid rgba(73,111,151,.22); border-radius: 16px; background: var(--sa-surface, rgba(8,25,43,.9)); }
    .rec-bar input[type=month] { min-height: 36px; border-radius: 10px; border: 1px solid rgba(73,111,151,.25); background: rgba(0,0,0,.16); color: var(--sa-text, #DCEAF4); padding: 6px 10px; }
    html[data-theme="light"] .rec-bar input[type=month] { background: #fff; color: inherit; }
    .rec-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-inline-start: auto; }
    .rec-tab { padding: 7px 14px; border-radius: 999px; font-size: 12px; font-weight: 900; border: 1px solid rgba(73,111,151,.25); color: inherit; text-decoration: none; }
    .rec-tab.active { background: rgba(18,217,227,.14); color: #12D9E3; border-color: rgba(18,217,227,.4); }
    .rec-tab b { direction: ltr; display: inline-block; }

    .rec-table-card { border: 1px solid rgba(73,111,151,.22); border-radius: 18px; overflow: auto; background: var(--sa-surface, rgba(8,25,43,.9)); }
    .rec-table { width: 100%; border-collapse: collapse; font-size: 12.5px; min-width: 860px; }
    .rec-table th { text-align: start; padding: 10px 12px; font-size: 11px; font-weight: 1000; color: var(--sa-muted, #8FA8BC); border-bottom: 1px solid rgba(73,111,151,.22); background: rgba(0,0,0,.12); }
    html[data-theme="light"] .rec-table th { background: #f2f7fb; }
    .rec-table td { padding: 10px 12px; border-bottom: 1px solid rgba(143,168,188,.08); vertical-align: middle; }
    .rec-table tr:hover td { background: rgba(18,217,227,.04); }
    .rec-chip { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 900; }
    .rec-chip.Pending { background: rgba(250,204,21,.12); color: #facc15; }
    .rec-chip.Approved { background: rgba(74,222,128,.12); color: #4ade80; }
    .rec-chip.Auto { background: rgba(18,217,227,.12); color: #12D9E3; }
    .rec-chip.Ignored { background: rgba(143,168,188,.14); color: var(--sa-muted, #8FA8BC); }
    .rec-chip.Conflicted { background: rgba(248,113,113,.14); color: #f87171; }
    .rec-chip.note { background: rgba(167,139,250,.14); color: #a78bfa; }
    .rec-chip.fin { background: rgba(96,165,250,.14); color: #60a5fa; }
    .rec-subtabs { display: flex; gap: 6px; flex-wrap: wrap; }
    .rec-subtab {
        padding: 8px 16px; border-radius: 12px; font-size: 12.5px; font-weight: 900;
        border: 1px solid rgba(73,111,151,.25); color: inherit; text-decoration: none;
    }
    .rec-subtab.active { background: rgba(96,165,250,.14); color: #60a5fa; border-color: rgba(96,165,250,.42); }
    .rec-subtab b { direction: ltr; display: inline-block; margin-inline-start: 4px; }
    .rec-chip.moved { background: rgba(74,222,128,.12); color: #4ade80; }
    .rec-chip.notmoved { background: rgba(250,204,21,.12); color: #facc15; }
    .rec-empty { padding: 28px; text-align: center; color: var(--sa-muted, #8FA8BC); font-weight: 800; }
    .rec-bulkbar {
        position: fixed; bottom: 18px; inset-inline: 0; margin-inline: auto; width: max-content; max-width: calc(100% - 32px);
        z-index: 60; display: none; gap: 10px; align-items: center; flex-wrap: wrap; padding: 12px 18px;
        border: 1px solid rgba(18,217,227,.45); border-radius: 16px;
        background: var(--sa-surface, rgba(8,25,43,.98)); box-shadow: 0 14px 44px rgba(0,0,0,.55);
    }
    html[data-theme="light"] .rec-bulkbar { background: #fff; }
    .rec-bulkbar.show { display: flex; }
    .rec-bulkbar b { font-size: 13px; font-weight: 900; margin-inline-end: 6px; }
    .rec-bulkbar b span { color: #12D9E3; }
    .rec-alert { padding: 10px 14px; border-radius: 12px; font-size: 13px; font-weight: 800; border: 1px solid rgba(74,222,128,.35); background: rgba(74,222,128,.08); }
    .rec-ref { font-size: 11px; color: #12D9E3; font-weight: 900; direction: ltr; display: inline-block; }
</style>

<section class="rec-page" dir="rtl">
    <header class="rec-head">
        <div>
            <h1>الإجراءات المقترحة</h1>
            <p>مخرجات محرك القواعد بانتظار الفرز: اعتماد (ينشئ مخالفة أو حركة مرتبطة) أو تجاهل — والتلقائية نُفذت فوراً، والمتعارضة مع حركة قائمة تنتظر مراجعة يدوية.</p>
        </div>
        <form method="post" asp-page-handler="Analyze">
            <input type="hidden" name="Month" value="@Model.Month" />
            <input type="hidden" name="Tab" value="@Model.Tab" />
            <button type="submit" class="rec-btn" data-zyconfirm="تحليل الشهر — تأكيد؟">تحليل واسترجاع الاقتراحات</button>
        </form>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rec-alert">@TempData["SuccessMessage"]</div>
    }

    <div class="rec-bar">
        @* الفلترة شرطُ استعمالٍ لا رفاهية: شهرٌ واحد يولّد آلاف الاقتراحات، وقرار
           «كل الغياب» غير قرار «تأخير موظف بعينه» — فبلا فرزٍ لا يُبتّ بشيء. *@
        @* سطرٌ واحد: الحقول عريضة افتراضياً بقوقعة النظام (width:100%)، فتنزل كلٌّ
           بسطر. `flex:0 0 auto` بعرضٍ صريح يبقيها متجاورة، و`wrap` يبقى للمقاسات
           الضيّقة فلا تُقصّ. *@
        <form method="get" class="rec-filters">
            <input type="hidden" name="Tab" value="@Model.Tab" />
            <input type="month" name="Month" value="@Model.Month" style="flex:0 0 auto;width:150px" />
            <input type="text" name="Search" value="@Model.Search" placeholder="رمز أو اسم موظف" style="flex:0 0 auto;width:170px" />
            @if (Model.RuleFilterOptions.Count > 0)
            {
                <select name="RuleId" style="flex:0 0 auto;width:250px">
                    <option value="0">كل القواعد</option>
                    @foreach (var (id, name, count) in Model.RuleFilterOptions)
                    {
                        <option value="@id" selected="@(Model.RuleId == id)">@name (@count)</option>
                    }
                </select>
            }
            <button type="submit" class="rec-btn ghost" style="flex:0 0 auto">عرض</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.RuleId != 0)
            {
                <a class="rec-btn ghost" style="flex:0 0 auto" href="?Month=@Model.Month&Tab=@Model.Tab">✕ إلغاء الفلتر</a>
            }
        </form>
        <nav class="rec-tabs">
            @foreach (var (key, label, count) in tabs)
            {
                <a class="rec-tab @(Model.Tab == key ? "active" : "")" href="?Month=@Model.Month&Tab=@key">@label <b>@count</b></a>
            }
        </nav>
    </div>

    @if (Model.Tab == "Transactions")
    {
        @* كيان يفصل الأثر المالي عن التأديبي بتبويبين فرعيين بأعمدة مختلفة *@
        <nav class="rec-subtabs">
            <a class="rec-subtab @(Model.SubTab != "Violations" ? "active" : "")"
               href="?Month=@Model.Month&Tab=Transactions&SubTab=Financial">الحركات المالية <b>@Model.TransactionsCount</b></a>
            <a class="rec-subtab @(Model.SubTab == "Violations" ? "active" : "")"
               href="?Month=@Model.Month&Tab=Transactions&SubTab=Violations">حركات المخالفات <b>@Model.ViolationsCount</b></a>
        </nav>
    }

    @if (Model.Tab == "Transactions" && Model.SubTab == "Violations")
    {
        <div class="rec-table-card">
            @if (Model.ViolationCases.Count == 0)
            {
                <div class="rec-empty">لا حركات مخالفات هذا الشهر — تنتج عن اعتماد اقتراح أثره «مخالفة» أو من قاعدة تلقائية.</div>
            }
            else
            {
                <table class="rec-table">
                    <thead>
                        <tr>
                            <th>الموظف</th><th>التاريخ</th><th>المخالفة</th>
                            <th>الحالة</th><th style="text-align:end">الاقتطاع</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.ViolationCases)
                        {
                            <tr>
                                <td><b>@v.EmployeeName</b> <span style="color:var(--sa-muted,#8FA8BC)">· @v.EmployeeNo</span></td>
                                <td style="direction:ltr;text-align:start">@v.EventDate.ToString("yyyy-MM-dd")</td>
                                <td style="font-size:12px">
                                    @v.Title
                                    <a class="rec-ref" href="/Violations">@v.ReferenceNo</a>
                                </td>
                                <td>
                                    <span class="rec-chip Pending">@v.Status</span>
                                    <span class="rec-ref" style="color:var(--sa-muted,#8FA8BC)">@v.ActionStatus</span>
                                </td>
                                <td style="text-align:end;direction:ltr;font-weight:900">
                                    @(v.DeductionAmount > 0 ? v.DeductionAmount.ToString("0.##") : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else if (Model.Tab == "Transactions")
    {
        <form method="post">
            <input type="hidden" name="Month" value="@Model.Month" />
            <div class="rec-table-card">
                @if (Model.Transactions.Count == 0)
                {
                    <div class="rec-empty">لا حركات منفَّذة هذا الشهر — الحركات تنتج عن اعتماد اقتراح ذي أثر (إجازة/مغادرة/أوفرتايم/دخل/اقتطاع) أو من قاعدة تلقائية.</div>
                }
                else
                {
                    <table class="rec-table">
                        <thead>
                            <tr>
                                <th style="width:34px"><input type="checkbox" onclick="recAll(this)" /></th>
                                <th>الموظف</th><th>التاريخ</th><th>القاعدة</th><th>نوع الأثر</th>
                                <th>البيان</th><th style="text-align:end">القيمة</th><th>حالة الترحيل</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var txn in Model.Transactions)
                            {
                                <tr>
                                    <td><input type="checkbox" name="selectedIds" value="@txn.Id" onclick="recSel()" /></td>
                                    <td><b>@txn.EmployeeName</b> <span style="color:var(--sa-muted,#8FA8BC)">· @txn.EmployeeNo</span></td>
                                    <td style="direction:ltr;text-align:start">@txn.WorkDate.ToString("yyyy-MM-dd")</td>
                                    <td style="font-size:12px">@txn.RuleName</td>
                                    <td><span class="rec-chip fin">@ShiftRuleStore.LabelOf(ShiftRuleStore.ActionTypes, txn.ActionType)</span></td>
                                    <td style="font-size:12px;color:var(--sa-muted,#8FA8BC)">@txn.ActionText</td>
                                    <td style="text-align:end;direction:ltr;font-weight:900">
                                        @if (txn.Hours > 0)
                                        { <text>@txn.Hours.ToString("0.##") ساعة</text> }
                                        else if (txn.Amount > 0)
                                        { <text>@txn.Amount.ToString("0.##")</text> }
                                        else
                                        { <text>—</text> }
                                    </td>
                                    <td style="white-space:nowrap">
                                        @if (!AttendanceTransactionStore.IsTransferable(txn.ActionType))
                                        {
                                            <span class="rec-chip Ignored" title="أثر لا يُرحَّل للرواتب — يتبع وحدة المغادرات/الإجازات">لا تُرحَّل</span>
                                        }
                                        else
                                        {
                                            <span class="rec-chip @(txn.IsTransferred ? "moved" : "notmoved")">@AttendanceTransactionStore.PayrollStatusLabel(txn.PayrollStatus)</span>
                                            @if (txn.IsTransferred && txn.PayrollTransactionId != null)
                                            {
                                                var payrollHref = txn.ActionType == "Overtime"
                                                    ? $"/Payroll/Overtime?Year={txn.WorkDate.Year}&Month={txn.WorkDate.Month}"
                                                    : $"/Payroll/Transactions?Type={txn.ActionType}&Year={txn.WorkDate.Year}&Month={txn.WorkDate.Month}";
                                                <a class="rec-ref" href="@payrollHref" style="color:#60a5fa">مسير #@txn.PayrollTransactionId</a>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @if (Model.Transactions.Count > 0)
            {
                <div class="rec-bulkbar" id="rec-bulkbar">
                    <b>المحدد: <span id="rec-selcount">0</span></b>
                    <button type="submit" asp-page-handler="Transfer" class="rec-btn ok" data-zyconfirm="ترحيل الحركات المحددة إلى وحدة الرواتب؟">انقل إلى وحدة الرواتب</button>
                    <button type="submit" asp-page-handler="UndoTransfer" class="rec-btn no" data-zyconfirm="إلغاء ترحيل المحدد وحذف حركة المسير المرتبطة؟">إلغاء الترحيل</button>
                </div>
            }
        </form>

        <script>
            function recAll(cb) {
                document.querySelectorAll('[name=selectedIds]').forEach(function (x) { x.checked = cb.checked; });
                recSel();
            }
            function recSel() {
                var bar = document.getElementById('rec-bulkbar'); if (!bar) return;
                var n = document.querySelectorAll('[name=selectedIds]:checked').length;
                var c = document.getElementById('rec-selcount'); if (c) c.textContent = n;
                bar.classList.toggle('show', n > 0);
            }
        </script>
    }
    else
    {
        <div class="rec-table-card">
            @if (Model.Rows.Count == 0)
            {
                <div class="rec-empty">لا اقتراحات بهذا التبويب — شغّل «تحليل واسترجاع الاقتراحات» بعد تحديث الحضور اليومي.</div>
            }
            else
            {
                <table class="rec-table">
                    <thead>
                        <tr>
                            @* التحديد على الصفوف القابلة للبتّ وحدها — تحديد صفٍّ مبتوتٍ
                               سابقاً يَعِد بفعلٍ لا يقع. *@
                            <th style="width:34px"><input type="checkbox" class="rec-pick" onchange="recPickAll(this.checked)" title="تحديد كل صفوف الصفحة" /></th>
                            <th>الموظف</th><th>التاريخ</th><th>القاعدة</th><th>ما تحقق</th>
                            <th>الإجراء المقترح</th><th>الحالة</th><th style="text-align:end">فرز</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var canDecide = row.Status is "Pending" or "Conflicted";
                            <tr>
                                <td>
                                    @if (canDecide)
                                    {
                                        <input type="checkbox" class="rec-pick rec-row-pick" value="@row.Id" onchange="recPickSync()" />
                                    }
                                </td>
                                <td><b>@row.EmployeeName</b> <span style="color:var(--sa-muted,#8FA8BC)">· @row.EmployeeNo</span></td>
                                <td style="direction:ltr;text-align:start">@row.WorkDate.ToString("yyyy-MM-dd")</td>
                                <td style="font-size:12px">@row.RuleName</td>
                                <td style="font-size:12px;color:var(--sa-muted,#8FA8BC)">@row.Summary</td>
                                <td>
                                    <span class="rec-chip @(row.ActionType == "Note" ? "note" : row.ActionType == "Violation" ? "Pending" : "fin")" style="@(row.ActionType is "Note" or "Violation" ? "background:rgba(18,217,227,.08);color:inherit" : "")">@ShiftRuleStore.LabelOf(ShiftRuleStore.ActionTypes, row.ActionType)@(string.IsNullOrWhiteSpace(row.ActionText) ? "" : $" · {row.ActionText}")</span>
                                    @if (ShiftRuleStore.ActionNeedsValue(row.ActionType) && row.ActionValue > 0)
                                    { <span class="rec-ref" style="color:#60a5fa">@row.ActionValue.ToString("0.##") @ShiftRuleStore.ActionValueUnit(row.ActionType)</span> }
                                    @if (row.ViolationCaseId != null)
                                    {
                                        <a class="rec-ref" href="/Violations">مخالفة #@row.ViolationCaseId</a>
                                    }
                                    @if (row.TransactionId != null)
                                    {
                                        <a class="rec-ref" href="?Month=@Model.Month&Tab=Transactions" style="color:#60a5fa">حركة #@row.TransactionId</a>
                                    }
                                </td>
                                <td><span class="rec-chip @row.Status">@RecommendationStore.StatusLabel(row.Status)</span></td>
                                <td style="text-align:end;white-space:nowrap">
                                    @if (canDecide)
                                    {
                                        <form method="post" asp-page-handler="Approve" style="display:inline">
                                            <input type="hidden" name="id" value="@row.Id" />
                                            <input type="hidden" name="Month" value="@Model.Month" />
                                            <input type="hidden" name="Tab" value="@Model.Tab" />
                                            <button type="submit" class="rec-btn ok" style="min-height:32px;padding:5px 14px" data-zyconfirm="@(row.Status == "Conflicted" ? "اعتماد رغم التعارض مع حركة قائمة؟" : null)">اعتماد</button>
                                        </form>
                                        <form method="post" asp-page-handler="Ignore" style="display:inline">
                                            <input type="hidden" name="id" value="@row.Id" />
                                            <input type="hidden" name="Month" value="@Model.Month" />
                                            <input type="hidden" name="Tab" value="@Model.Tab" />
                                            <button type="submit" class="rec-btn no" style="min-height:32px;padding:5px 14px">تجاهل</button>
                                        </form>
                                        @* راية «السماح بتعديل الإجراء الموصى به» على القاعدة المُصدِرة *@
                                        @if (Model.EditableRuleIds.Contains(row.RuleId))
                                        {
                                            <form method="post" asp-page-handler="EditAction" style="display:inline-flex;gap:4px;align-items:center;margin-inline-start:6px">
                                                <input type="hidden" name="id" value="@row.Id" />
                                                <input type="hidden" name="Month" value="@Model.Month" />
                                                <input type="hidden" name="Tab" value="@Model.Tab" />
                                                <input type="text" name="actionText" value="@row.ActionText" placeholder="الإجراء" style="width:120px;min-height:32px" />
                                                <input type="number" step="0.01" name="actionValue" value="@row.ActionValue" style="width:78px;min-height:32px" />
                                                <button type="submit" class="rec-btn" style="min-height:32px;padding:5px 12px">حفظ</button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <text>—</text>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <div style="display:flex;align-items:center;justify-content:center;gap:10px;font-size:12px;font-weight:900">
            @* الفلتر يسافر مع التصفّح: بدونه ترجع الصفحة الثانية لكل الشهر فيضيع الفرز. *@
            @if (Model.PageNumber > 1)
            {
                <a class="rec-btn ghost" href="?Month=@Model.Month&Tab=@Model.Tab&Search=@Model.Search&RuleId=@Model.RuleId&PageNumber=@(Model.PageNumber - 1)">السابق</a>
            }
            <span>صفحة @Model.PageNumber من @Model.TotalPages (@Model.TotalRows اقتراح)</span>
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a class="rec-btn ghost" href="?Month=@Model.Month&Tab=@Model.Tab&Search=@Model.Search&RuleId=@Model.RuleId&PageNumber=@(Model.PageNumber + 1)">التالي</a>
            }
        </div>
    }
</section>

@* ═══ بار الفرز الجماعي ═══
   خارج جدول الصفوف عمداً: كل صفّ يحمل نموذجَي «اعتماد»/«تجاهل» المفردين، والنماذج
   لا تتداخل بـHTML — فالمربّعات تُنسخ لهذا النموذج لحظة الضغط. *@
<div class="rec-bulkbar" id="rec-bulkbar">
    <span>محدَّد: <b id="rec-pick-count">0</b> اقتراح</span>
    <form method="post" id="rec-bulk-form" style="display:flex;gap:8px;margin:0">
        <input type="hidden" name="Month" value="@Model.Month" />
        <input type="hidden" name="Tab" value="@Model.Tab" />
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="RuleId" value="@Model.RuleId" />
        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
        <div id="rec-bulk-ids"></div>
        <button type="submit" class="rec-btn ok" formaction="?handler=BulkApprove"
                data-zyconfirm="الاعتماد يُنشئ قضايا مخالفة وحركات فعلية للمحدَّد — تأكيد؟">اعتماد المحدَّد</button>
        <button type="submit" class="rec-btn no" formaction="?handler=BulkIgnore"
                data-zyconfirm="تجاهل المحدَّد نهائياً (لن يُعاد توليده) — تأكيد؟">تجاهل المحدَّد</button>
    </form>
    <button type="button" class="rec-btn ghost" onclick="recPickAll(false)">إلغاء التحديد</button>
</div>

<style>
    .rec-filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    /* الكلاندر والمنسدلة يستبدلهما محرّك الواجهة بعنصرين مرئيّين (`nxcal` و
       `nxcs-select`) عرضهما 100%، والأصليّان يُخفيان — فتقييد عرض الأصليّ لا يفعل
       شيئاً، والقياس هو ما كشف ذلك. التقييد هنا على المرئيّ. */
    /* `!important` مقصود لا كسل: محرّك الكلاندر يفرض `.nxcal { width:100% !important }`
       (قِسته: قاعدتي 160px تخسر أمامها)، ولا سبيل لتجاوز `!important` إلا بمثلها. */
    .rec-filters .nxcal { flex: 0 0 auto; width: 160px !important; }
    .rec-filters .nxcs-select { flex: 0 0 auto; width: 250px !important; }
    .rec-filters input[type="text"] { flex: 0 0 auto; width: 170px; }
    .rec-filters input, .rec-filters select {
        min-height: 34px; border-radius: 10px; border: 1px solid rgba(73,111,151,.3);
        background: rgba(0,0,0,.16); color: inherit; padding: 4px 10px; font-size: 13px; font-weight: 800;
    }
    html[data-theme="light"] .rec-filters input, html[data-theme="light"] .rec-filters select { background: #fff; }

    .rec-pick { width: 16px; height: 16px; accent-color: #12D9E3; cursor: pointer; }
    .rec-bulkbar {
        display: none; position: fixed; inset-inline: 0; bottom: 18px; z-index: 880;
        margin-inline: auto; width: max-content; max-width: calc(100% - 24px);
        align-items: center; gap: 12px; padding: 10px 16px; border-radius: 999px;
        border: 1px solid rgba(18,217,227,.45); background: var(--sa-surface, rgba(8,25,43,.98));
        color: var(--sa-text, #DCEAF4); box-shadow: 0 18px 44px rgba(0,0,0,.42);
        font-size: 13px; font-weight: 900;
    }
    html[data-theme="light"] .rec-bulkbar { background: #fff; }
    .rec-bulkbar.is-on { display: flex; }
    .rec-bulkbar b { color: #12D9E3; direction: ltr; display: inline-block; }
</style>

@section Scripts {
    <script>
        function recPicked() {
            return Array.prototype.filter.call(
                document.querySelectorAll('.rec-row-pick'), function (b) { return b.checked; });
        }

        function recPickSync() {
            var picked = recPicked();
            document.getElementById('rec-pick-count').textContent = picked.length;
            document.getElementById('rec-bulkbar').classList.toggle('is-on', picked.length > 0);

            // المعرّفات تُنسخ فوراً لا عند الضغط: زرّ التأكيد بنقرتين يُرسل النموذج
            // بنفسه، فلا مكان لخطّاف «قبل الإرسال» يملؤها.
            var host = document.getElementById('rec-bulk-ids');
            host.innerHTML = '';
            picked.forEach(function (b) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selectedIds';
                input.value = b.value;
                host.appendChild(input);
            });
        }

        function recPickAll(checked) {
            Array.prototype.forEach.call(document.querySelectorAll('.rec-row-pick'), function (b) {
                b.checked = checked;
            });
            Array.prototype.forEach.call(document.querySelectorAll('thead .rec-pick'), function (b) {
                b.checked = checked;
            });
            recPickSync();
        }

        recPickSync();
    </script>
}

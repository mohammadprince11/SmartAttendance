@page
@model SmartAttendance.Web.Pages.Violations.IndexModel
@{
    ViewData["Title"] = "المخالفات";

    // النموذج يفتح تبويب التسجيل من تلقائه حين يرتدّ بخطأ تحقّق — وإلا فالتبويب
    // من الرابط، وافتراضه «ما ينتظرك».
    var tab = Model.OpenCreateModal
        ? "create"
        : (string.IsNullOrWhiteSpace(Model.Tab) ? "work" : Model.Tab);

    bool IsTab(string key) => string.Equals(tab, key, StringComparison.OrdinalIgnoreCase);
    string Sel(string key) => IsTab(key) ? "true" : "false";

    var awaitingAction = Model.Items.Where(i => i.ActionStatus == "بانتظار الإجراء").ToList();
    var awaitingReply = Model.Items.Where(i => i.EmployeeReplyStatus == "Pending").ToList();
    var pendingWork = awaitingAction.Count + awaitingReply.Count;
    var totalDeductions = Model.Items.Sum(i => i.DeductionAmount);
}

@section Styles {
    <link rel="stylesheet" href="~/css/zynora-workscreen.css" asp-append-version="true" />
}

<section class="zyw zy-scope" dir="rtl">

    <header class="zyw-head">
        <div>
            <h1>المخالفات</h1>
            <p>تسجيل المخالفة · طلب ردّ الموظف · العقوبة وأثرها المالي.</p>
        </div>

        @* سطرٌ واحد بدل خمس بطاقات KPI كانت تحتلّ نصف الشاشة فوق جدولٍ فارغ. *@
        <div class="zyw-totals">
            <span><b>@Model.TotalCount</b> حالة</span>
            <span>·</span>
            <span><b>@awaitingAction.Count</b> بانتظار الإجراء</span>
            <span>·</span>
            <span><b>@Model.PendingReplyCount</b> بانتظار ردّ الموظف</span>
            <span>·</span>
            <span><b>@totalDeductions.ToString("N0")</b> دينار خصومات</span>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="zy-card" role="status">@TempData["SuccessMessage"]</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        @* الخطأ يُعرض بنصّه لا برسالة «راجع الحقول داخل النافذة»: النافذة لم تعد
           موجودة، والنصّ الصريح يغني عن البحث عن الحقل المعطوب. *@
        <div class="zyw-empty" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <nav class="zyw-tabs" role="tablist" aria-label="أقسام المخالفات">
        <button type="button" class="zyw-tab" role="tab" data-zyw-tab="work" aria-selected="@Sel("work")">
            ما ينتظرك
            @if (pendingWork > 0)
            {
                <span class="zyw-tab-count">@pendingWork</span>
            }
        </button>
        <button type="button" class="zyw-tab" role="tab" data-zyw-tab="log" aria-selected="@Sel("log")">السجلّ</button>
        <button type="button" class="zyw-tab" role="tab" data-zyw-tab="create" aria-selected="@Sel("create")">تسجيل مخالفة</button>
        <button type="button" class="zyw-tab" role="tab" data-zyw-tab="actions" aria-selected="@Sel("actions")">الإجراءات التأديبية</button>
        <button type="button" class="zyw-tab" role="tab" data-zyw-tab="templates" aria-selected="@Sel("templates")">القوالب والرسائل</button>
        <button type="button" class="zyw-tab" role="tab" data-zyw-tab="setup" aria-selected="@Sel("setup")">التهيئة</button>
    </nav>

    @* ==================================================== ما ينتظرك (الافتراضي) *@
    <section class="zyw-panel" data-zyw-panel="work" role="tabpanel" hidden="@(!IsTab("work"))">
        @if (pendingWork == 0)
        {
            <div class="zyw-empty">
                لا مخالفة تنتظر إجراءً أو ردّاً. سجّل مخالفةً جديدة من تبويب «تسجيل مخالفة».
            </div>
        }

        <div class="zyw-queue">
            @if (awaitingAction.Count > 0)
            {
                <article class="zy-card">
                    <div class="zyw-queue-head">
                        <h2>بانتظار الإجراء</h2>
                        <span class="zy-pill">@awaitingAction.Count</span>
                    </div>
                    <div class="zyw-list">
                        @foreach (var row in awaitingAction.Take(8))
                        {
                            <div class="zyw-item">
                                <div class="zyw-item-main">
                                    <strong>@row.EmployeeName — @row.ViolationTitle</strong>
                                    <small>@row.ReferenceNo · @row.EventDate.ToString("yyyy-MM-dd") · @row.Source</small>
                                </div>
                                <div class="zyw-item-actions">
                                    @if (row.EmployeeReplyStatus == "NotRequested")
                                    {
                                        <form method="post" asp-page-handler="RequestReply">
                                            <input type="hidden" name="id" value="@row.Id" />
                                            <button type="submit" class="btn-secondary">طلب ردّ الموظف</button>
                                        </form>
                                    }
                                    <a class="btn-secondary" asp-page="/Violations/PrintForm" asp-route-id="@row.Id">طباعة</a>
                                </div>
                            </div>
                        }
                    </div>
                </article>
            }

            @if (awaitingReply.Count > 0)
            {
                <article class="zy-card">
                    <div class="zyw-queue-head">
                        <h2>بانتظار ردّ الموظف</h2>
                        <span class="zy-pill">@awaitingReply.Count</span>
                    </div>
                    <div class="zyw-list">
                        @foreach (var row in awaitingReply.Take(8))
                        {
                            <div class="zyw-item">
                                <div class="zyw-item-main">
                                    <strong>@row.EmployeeName — @row.ViolationTitle</strong>
                                    <small>@row.ReferenceNo · طُلب الردّ ولم يصل بعد</small>
                                </div>
                                <div class="zyw-item-actions">
                                    <a class="btn-secondary" asp-page="/Violations/PrintForm" asp-route-id="@row.Id">طباعة</a>
                                </div>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    @* ======================================================================= السجلّ *@
    <section class="zyw-panel" data-zyw-panel="log" role="tabpanel" hidden="@(!IsTab("log"))">
        <article class="zy-card">
            <div class="zyw-filters">
                <div class="zyw-field zyw-field--grow">
                    <label for="vio-search">بحث — موظف · رقم مرجعي · مخالفة</label>
                    <input id="vio-search" type="search" data-zyw-search placeholder="اكتب للتصفية الفورية" />
                </div>

                <div class="zyw-field">
                    <label for="vio-status">الحالة</label>
                    <select id="vio-status" data-zyw-filter="status">
                        <option value="">الكل</option>
                        @foreach (var status in Model.Items.Select(i => i.Status).Distinct().OrderBy(s => s))
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div class="zyw-field">
                    <label for="vio-source">المصدر</label>
                    <select id="vio-source" data-zyw-filter="source">
                        <option value="">الكل</option>
                        @foreach (var source in Model.Items.Select(i => i.Source).Distinct().OrderBy(s => s))
                        {
                            <option value="@source">@source</option>
                        }
                    </select>
                </div>

                @* فلتر ردّ الموظف **خادميّ** (يغيّر الاستعلام لا العرض) فيبقى روابطَ. *@
                <div class="zyw-field">
                    <label>ردّ الموظف</label>
                    <div class="zyw-item-actions">
                        <a class="btn-secondary" asp-page="/Violations/Index" asp-route-reply="all" asp-route-tab="log">الكل</a>
                        <a class="btn-secondary" asp-page="/Violations/Index" asp-route-reply="pending" asp-route-tab="log">بانتظار</a>
                        <a class="btn-secondary" asp-page="/Violations/Index" asp-route-reply="replied" asp-route-tab="log">تم الردّ</a>
                    </div>
                </div>
            </div>

            @if (Model.Items.Count == 0)
            {
                <div class="zyw-empty">لا مخالفات مسجّلة بهذا الفلتر.</div>
            }
            else
            {
                <div class="zyw-table-wrap">
                    <table class="zyw-table">
                        <thead>
                            <tr>
                                <th>الرقم المرجعي</th>
                                <th>الموظف</th>
                                <th>المخالفة</th>
                                <th>تاريخ الحدث</th>
                                <th>المصدر</th>
                                <th>الحالة</th>
                                <th>ردّ الموظف</th>
                                <th>العقوبة</th>
                                <th>الخصم</th>
                                <th>خيارات</th>
                            </tr>
                        </thead>
                        <tbody data-zyw-rows>
                            @foreach (var row in Model.Items)
                            {
                                <tr data-status="@row.Status"
                                    data-source="@row.Source"
                                    data-text="@($"{row.ReferenceNo} {row.EmployeeName} {row.EmployeeCode} {row.ViolationTitle} {row.ViolationCategory}")">
                                    <td>@row.ReferenceNo</td>
                                    <td>@row.EmployeeName<br /><small>@row.EmployeeCode</small></td>
                                    <td>@row.ViolationTitle<br /><small>@row.ViolationCategory</small></td>
                                    <td>@row.EventDate.ToString("yyyy-MM-dd")</td>
                                    <td>@row.Source</td>
                                    <td><span class="zy-pill">@row.Status</span></td>
                                    <td>@row.ReplyStatusText</td>
                                    <td>@(string.IsNullOrWhiteSpace(row.FinalPenaltyAction) ? "—" : row.FinalPenaltyAction)</td>
                                    <td>@(row.DeductionAmount > 0 ? row.DeductionAmount.ToString("N0") : "—")</td>
                                    <td>
                                        <div class="zyw-item-actions">
                                            @if (row.EmployeeReplyStatus == "NotRequested")
                                            {
                                                <form method="post" asp-page-handler="RequestReply">
                                                    <input type="hidden" name="id" value="@row.Id" />
                                                    <button type="submit" class="btn-secondary">طلب ردّ</button>
                                                </form>
                                            }
                                            <a class="btn-secondary" asp-page="/Violations/PrintForm" asp-route-id="@row.Id">طباعة</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="zyw-row-meta">المعروض: <span data-zyw-count>@Model.Items.Count</span> من @Model.TotalCount</p>
            }
        </article>
    </section>

    @* ========================================================= الإجراءات التأديبية *@
    <section class="zyw-panel" data-zyw-panel="actions" role="tabpanel" hidden="@(!IsTab("actions"))">
        <article class="zy-card">
            <div class="zyw-queue-head">
                <h2>العقوبات المطبَّقة</h2>
                <span class="zy-pill">@Model.DisciplinaryActions.Count</span>
            </div>

            @* الحالة مشتقّة من التهيئة لا مخزَّنة: تغيير مدّة الطعن أو الإسقاط
               يعيد التصنيف فوراً. ولذلك تُعلَن المدّتان هنا لا تُخفيان. *@
            <div class="zyw-filters">
                <div class="zyw-field">
                    <label>الحالة</label>
                    <div class="zyw-item-actions">
                        <a class="btn-secondary" asp-page="/Violations/Index" asp-route-actionState="All" asp-route-tab="actions">الكل</a>
                        <a class="btn-secondary" asp-page="/Violations/Index" asp-route-actionState="Open" asp-route-tab="actions">قابلة للطعن (@Model.OpenForObjection)</a>
                        <a class="btn-secondary" asp-page="/Violations/Index" asp-route-actionState="Final" asp-route-tab="actions">نهائية</a>
                        <a class="btn-secondary" asp-page="/Violations/Index" asp-route-actionState="Dropped" asp-route-tab="actions">ساقطة (@Model.DroppedActions)</a>
                    </div>
                </div>
                <div class="zyw-field zyw-field--grow">
                    <label>القاعدة المطبَّقة</label>
                    <p class="zyw-row-meta">
                        مدّة الطعن <b>@Model.ObjectionDays</b> يوماً · الإسقاط بعد <b>@Model.DropMonths</b> شهراً ·
                        إجمالي الخصومات <b>@Model.ActionsDeductions.ToString("N0")</b> دينار
                    </p>
                </div>
            </div>

            @if (Model.DisciplinaryActions.Count == 0)
            {
                <div class="zyw-empty">
                    لا عقوبات مطبَّقة بهذا الفلتر. تظهر هنا المخالفات التي صدرت بحقّها عقوبة فعلية.
                </div>
            }
            else
            {
                <div class="zyw-table-wrap">
                    <table class="zyw-table">
                        <thead>
                            <tr>
                                <th>الرقم المرجعي</th>
                                <th>الموظف</th>
                                <th>المخالفة</th>
                                <th>العقوبة</th>
                                <th>الخصم</th>
                                <th>تاريخ الحدث</th>
                                <th>الحالة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.DisciplinaryActions)
                            {
                                <tr>
                                    <td>@row.ReferenceNo</td>
                                    <td>@row.EmployeeName<br /><small>@row.EmployeeNo</small></td>
                                    <td>@row.ViolationTitle</td>
                                    <td>@(string.IsNullOrWhiteSpace(row.FinalPenaltyAction) ? "—" : row.FinalPenaltyAction)</td>
                                    <td>@(row.DeductionAmount > 0 ? row.DeductionAmount.ToString("N0") : "—")</td>
                                    <td>@row.EventDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="zy-pill">@Model.ActionStatusOf(row)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </section>

    @* ========================================================== القوالب والرسائل *@
    <section class="zyw-panel" data-zyw-panel="templates" role="tabpanel" hidden="@(!IsTab("templates"))">
        <article class="zy-card">
            <div class="zyw-queue-head">
                <h2>أنواع القوالب</h2>
                <span class="zy-pill">@Model.Config.TemplateTypes.Count</span>
            </div>

            @* الكتابة تُرسل لمعالجات `/DisciplinaryRules` — لا يُنسخ منطق الحفظ. *@
            <form method="post" asp-page="/DisciplinaryRules/Index" asp-page-handler="CreateTemplateType">
                <div class="zyw-form-grid">
                    <div class="zyw-field">
                        <label for="tt-name">اسم النوع</label>
                        <input id="tt-name" name="name" required placeholder="إشعار عقوبة" />
                    </div>
                    <div class="zyw-field">
                        <label for="tt-code">الرمز</label>
                        <input id="tt-code" name="code" required placeholder="PenaltyNotice" />
                    </div>
                    <div class="zyw-field zyw-field--wide">
                        <label for="tt-desc">الوصف</label>
                        <input id="tt-desc" name="description" />
                    </div>
                </div>
                <div class="zyw-form-actions">
                    <button type="submit" class="btn-primary">إضافة نوع</button>
                </div>
            </form>

            @if (Model.Config.TemplateTypes.Count == 0)
            {
                <div class="zyw-empty">لا أنواع قوالب بعد.</div>
            }
            else
            {
                <div class="zyw-list">
                    @foreach (var type in Model.Config.TemplateTypes)
                    {
                        <div class="zyw-row">
                            <div class="zyw-item-main">
                                <strong>@type.Name</strong>
                                <div class="zyw-row-meta">
                                    <span class="zy-pill">@type.Code</span>
                                    <small>@type.Description</small>
                                    @if (!type.IsActive)
                                    {
                                        <span class="zy-pill">معطّل</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </article>

        <article class="zy-card">
            <div class="zyw-queue-head">
                <h2>قوالب الرسائل</h2>
                <span class="zy-pill">@Model.Config.MessageTemplates.Count</span>
            </div>

            @if (Model.Config.MessageTemplates.Count == 0)
            {
                <div class="zyw-empty">لا قوالب رسائل بعد.</div>
            }
            else
            {
                <div class="zyw-list">
                    @foreach (var template in Model.Config.MessageTemplates)
                    {
                        <div class="zyw-row">
                            <div class="zyw-item-main">
                                <strong>@template.Name</strong>
                                <div class="zyw-row-meta">
                                    <span class="zy-pill">@template.TemplateType</span>
                                    @if (template.IsDefault)
                                    {
                                        <span class="zy-pill">الافتراضي</span>
                                    }
                                    <small>@template.Subject</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @* تحرير نصّ القالب ومصمّم الفورمة يبقيان بشاشتهما: محرّر نصّ ورفع
               ملفات وطبقات بمعاينة حيّة — نسخُها هنا يعني نسخ سلوكٍ لا عرضاً. *@
            <div class="zyw-form-actions">
                <a class="btn-secondary" asp-page="/DisciplinaryRules/Index" asp-route-tab="templates">تحرير نصوص القوالب</a>
                <a class="btn-secondary" asp-page="/DisciplinaryRules/Index" asp-route-tab="designer">مصمّم الفورمة</a>
            </div>
        </article>
    </section>

    @* ==================================================================== التهيئة *@
    <section class="zyw-panel" data-zyw-panel="setup" role="tabpanel" hidden="@(!IsTab("setup"))">
        <article class="zy-card">
            <div class="zyw-queue-head"><h2>تهيئة نظام المخالفات</h2></div>

            <form method="post" asp-page="/DisciplinaryRules/Index" asp-page-handler="SaveSettings">
                @* الحفظ يعيدك إلى هذا التبويب لا إلى شاشة الإعدادات. *@
                <input type="hidden" name="backTo" value="setup" />

                <div class="zyw-queue">
                    <div class="zy-card zyw-item">
                        <div class="zyw-item-main">
                            <strong>لجنة الموافقات</strong>
                            <small>عند التفعيل لا تُقفل المخالفة إلا بعد مسار اللجنة.</small>
                        </div>
                        <label class="zyw-checks">
                            <input type="checkbox" name="requiresCommitteeApproval" value="true" checked="@Model.Config.Settings.RequiresCommitteeApproval" />
                        </label>
                    </div>

                    <div class="zy-card zyw-item">
                        <div class="zyw-item-main">
                            <strong>اعتراض الموظف</strong>
                            <small>السماح له بالاعتراض من بوابة الموظف بعد صدور المخالفة.</small>
                        </div>
                        <label class="zyw-checks">
                            <input type="checkbox" name="allowEmployeeAppeal" value="true" checked="@Model.Config.Settings.AllowEmployeeAppeal" />
                        </label>
                    </div>
                </div>

                <div class="zyw-form-grid">
                    <div class="zyw-field">
                        <label for="cfg-days">مدّة الاعتراض (أيام)</label>
                        <input id="cfg-days" name="appealWindowDays" type="number" min="0" value="@Model.Config.Settings.AppealWindowDays" />
                    </div>

                    <div class="zyw-field">
                        <label for="cfg-template">القالب الافتراضي</label>
                        <select id="cfg-template" name="defaultTemplateType">
                            @foreach (var type in Model.Config.TemplateTypes.Where(x => x.IsActive))
                            {
                                <option value="@type.Code" selected="@(type.Code == Model.Config.Settings.DefaultTemplateType)">@type.Name</option>
                            }
                        </select>
                    </div>

                    <div class="zyw-field">
                        <label for="cfg-authority">اسم الجهة المعتمدة</label>
                        <input id="cfg-authority" name="approvingAuthorityName" value="@Model.Config.Settings.ApprovingAuthorityName" />
                    </div>

                    <div class="zyw-field">
                        <label for="cfg-number">صيغة رقم الكتاب</label>
                        <input id="cfg-number" name="documentNumberFormat" value="@Model.Config.Settings.DocumentNumberFormat" />
                    </div>

                    <div class="zyw-field zyw-field--wide">
                        <label for="cfg-header">هيدر الفورمة</label>
                        <textarea id="cfg-header" name="formHeader" rows="4">@Model.Config.Settings.FormHeader</textarea>
                    </div>

                    <div class="zyw-field zyw-field--wide">
                        <label for="cfg-footer">فوتر الفورمة</label>
                        <textarea id="cfg-footer" name="formFooter" rows="4">@Model.Config.Settings.FormFooter</textarea>
                    </div>
                </div>

                <div class="zyw-form-actions">
                    <button type="submit" class="btn-primary">حفظ التهيئة</button>
                </div>
            </form>
        </article>
    </section>

    @* ============================================================== تسجيل مخالفة *@
    <section class="zyw-panel" data-zyw-panel="create" role="tabpanel" hidden="@(!IsTab("create"))">
        <article class="zy-card">
            <div class="zyw-queue-head"><h2>تسجيل مخالفة</h2></div>

            <form method="post" asp-page-handler="Create">
                <input type="hidden" name="tab" value="create" />

                <div class="zyw-form-grid">
                    @* المنتقي المشترك بدل منسدلة تحمل كل الموظفين — نفس مكوّن الشاشات الستّ. *@
                    <div class="zyw-field zyw-field--wide">
                        <partial name="_EmployeePicker" model="@(new SmartAttendance.Web.Pages.Shared.EmployeePickerModel {
                            Name = "Input.EmployeeId",
                            Label = "الموظف",
                            SelectedId = Model.Input.EmployeeId,
                            SubmitOnSelect = false })" />
                    </div>

                    <div class="zyw-field">
                        <label asp-for="Input.CategoryId">الفئة</label>
                        <select asp-for="Input.CategoryId" data-zyw-category>
                            <option value="">اختر الفئة</option>
                            @foreach (var category in Model.CategoryOptions)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>

                    <div class="zyw-field">
                        <label asp-for="Input.ViolationTypeId">نوع المخالفة</label>
                        <select asp-for="Input.ViolationTypeId" data-zyw-violation>
                            <option value="">اختر النوع</option>
                            @foreach (var violation in Model.ViolationOptions)
                            {
                                <option value="@violation.Id"
                                        data-category="@violation.CategoryId"
                                        data-penalty="@violation.PenaltyAction"
                                        data-impact="@violation.FinancialImpactType">@violation.ViolationName</option>
                            }
                        </select>
                    </div>

                    <div class="zyw-field">
                        <label asp-for="Input.EventDate">تاريخ الحدث</label>
                        <input asp-for="Input.EventDate" type="date" />
                    </div>

                    <div class="zyw-field">
                        <label asp-for="Input.Source">المصدر</label>
                        <select asp-for="Input.Source">
                            <option value="مباشر">مباشر</option>
                            <option value="تقرير الحضور">تقرير الحضور</option>
                            <option value="بلاغ">بلاغ</option>
                        </select>
                    </div>

                    <div class="zyw-field">
                        <label asp-for="Input.Status">الحالة</label>
                        <select asp-for="Input.Status">
                            <option value="مسودة">مسودة</option>
                            <option value="بانتظار الاعتماد">بانتظار الاعتماد</option>
                            <option value="موافق عليه">موافق عليه</option>
                            <option value="مرفوض">مرفوض</option>
                            <option value="تم اتخاذ الإجراء">تم اتخاذ الإجراء</option>
                        </select>
                    </div>

                    <div class="zyw-field">
                        <label asp-for="Input.ActionStatus">حالة الإجراء</label>
                        <select asp-for="Input.ActionStatus">
                            <option value="بانتظار الإجراء">بانتظار الإجراء</option>
                            <option value="تم اتخاذ الإجراء">تم اتخاذ الإجراء</option>
                        </select>
                    </div>

                    <div class="zyw-field">
                        <label asp-for="Input.ProposedAction">الإجراء المقترح</label>
                        <input asp-for="Input.ProposedAction" />
                    </div>

                    <div class="zyw-field">
                        <label asp-for="Input.FinalPenaltyAction">العقوبة</label>
                        <input asp-for="Input.FinalPenaltyAction" data-zyw-penalty />
                    </div>

                    <div class="zyw-field">
                        <label asp-for="Input.FinancialImpactType">نوع الأثر المالي</label>
                        <select asp-for="Input.FinancialImpactType" data-zyw-impact>
                            <option value="None">بلا أثر</option>
                            <option value="Percent">نسبة</option>
                            <option value="Days">أيام</option>
                            <option value="Amount">مبلغ</option>
                        </select>
                    </div>

                    <div class="zyw-field">
                        <label asp-for="Input.FinancialImpactValue">قيمة الأثر</label>
                        <input asp-for="Input.FinancialImpactValue" type="number" step="0.01" min="0" />
                    </div>

                    <div class="zyw-field">
                        <label asp-for="Input.DeductionAmount">مبلغ الخصم (دينار)</label>
                        <input asp-for="Input.DeductionAmount" type="number" step="0.01" min="0" />
                    </div>

                    <div class="zyw-field zyw-field--wide">
                        <label asp-for="Input.Notes">ملاحظات</label>
                        <textarea asp-for="Input.Notes" rows="3"></textarea>
                    </div>
                </div>

                <div class="zyw-form-actions">
                    <button type="submit" class="btn-primary">حفظ المخالفة</button>
                </div>
            </form>
        </article>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';

            // ---------- التبويبات: نفس سلوك شاشة التفاعل، و`?tab=` يتبع الاختيار.
            var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-zyw-tab]'));
            var panels = Array.prototype.slice.call(document.querySelectorAll('[data-zyw-panel]'));

            function show(key) {
                tabs.forEach(function (t) { t.setAttribute('aria-selected', String(t.dataset.zywTab === key)); });
                panels.forEach(function (p) { p.hidden = p.dataset.zywPanel !== key; });

                var url = new URL(window.location.href);
                url.searchParams.set('tab', key);
                window.history.replaceState(window.history.state, '', url.pathname + url.search);
            }

            tabs.forEach(function (t) {
                t.addEventListener('click', function () { show(t.dataset.zywTab); });
            });

            // ---------- تصفية الجدول بالعميل: بحثٌ وحالةٌ ومصدر بلا إعادة تحميل.
            // (فلتر ردّ الموظف وحده خادميّ لأنه يغيّر الاستعلام نفسه لا العرض.)
            var search = document.querySelector('[data-zyw-search]');
            var filters = Array.prototype.slice.call(document.querySelectorAll('[data-zyw-filter]'));
            var body = document.querySelector('[data-zyw-rows]');
            var counter = document.querySelector('[data-zyw-count]');

            function applyFilters() {
                if (!body) return;

                var text = ((search && search.value) || '').trim().toLowerCase();
                var statusBox = document.querySelector('[data-zyw-filter="status"]');
                var sourceBox = document.querySelector('[data-zyw-filter="source"]');
                var status = statusBox ? statusBox.value : '';
                var source = sourceBox ? sourceBox.value : '';
                var shown = 0;

                Array.prototype.forEach.call(body.rows, function (row) {
                    var hit = (!text || (row.dataset.text || '').toLowerCase().indexOf(text) !== -1)
                        && (!status || row.dataset.status === status)
                        && (!source || row.dataset.source === source);
                    row.hidden = !hit;
                    if (hit) shown++;
                });

                if (counter) counter.textContent = String(shown);
            }

            if (search) search.addEventListener('input', applyFilters);
            filters.forEach(function (f) { f.addEventListener('change', applyFilters); });

            // ---------- نوع المخالفة يتبع الفئة، ويقترح العقوبة وأثرها من اللائحة.
            var category = document.querySelector('[data-zyw-category]');
            var violation = document.querySelector('[data-zyw-violation]');
            var penalty = document.querySelector('[data-zyw-penalty]');
            var impact = document.querySelector('[data-zyw-impact]');

            function syncViolations() {
                if (!category || !violation) return;

                var wanted = category.value;
                Array.prototype.forEach.call(violation.options, function (option) {
                    if (!option.value) return;
                    option.hidden = Boolean(wanted) && option.dataset.category !== wanted;
                });

                var current = violation.selectedOptions[0];
                if (current && current.hidden) violation.value = '';
            }

            function suggestPenalty() {
                var option = violation && violation.selectedOptions[0];
                if (!option || !option.value) return;

                // **اقتراحٌ لا فرض**: يملأ الفارغ ولا يدوس ما كتبه المستخدم — العقوبة
                // قرارٌ بشريّ وأثرها ماليّ، فلا تُكتب فوقه بصمت.
                if (penalty && !penalty.value && option.dataset.penalty) {
                    penalty.value = option.dataset.penalty;
                }
                if (impact && impact.value === 'None' && option.dataset.impact) {
                    impact.value = option.dataset.impact;
                }
            }

            if (category) category.addEventListener('change', syncViolations);
            if (violation) violation.addEventListener('change', suggestPenalty);
            syncViolations();
        })();
    </script>
}

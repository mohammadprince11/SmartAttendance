                            <div class="zyw-field">
                                <label for="tp-name">اسم القالب</label>
                                <input id="tp-name" name="name" required placeholder="نموذج إشعار عقوبة" />
                            </div>
                            <div class="zyw-field">
                                <label for="tp-type">نوع القالب</label>
                                <select id="tp-type" name="templateType">
                                    @foreach (var templateType in Model.TemplateTypes.Where(x => x.IsActive))
                                    {
                                        <option value="@templateType.Code">@templateType.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="zyw-field zyw-field--wide">
                                <label for="tp-subject">عنوان الرسالة</label>
                                <input id="tp-subject" name="subject" required value="إشعار مخالفة وجزاء - {EmployeeName}" />
                            </div>
                            <div class="zyw-field zyw-field--wide">
                                <label for="tp-body">نصّ القالب</label>
                                <textarea id="tp-body" name="body" rows="10">@Model.DefaultTemplateBody</textarea>
                            </div>
                            <div class="zyw-field zyw-field--wide zyw-checks">
                                <label><input type="checkbox" name="isDefault" value="true" /> قالب افتراضي</label>
                                <label><input type="checkbox" name="isActive" value="true" checked /> فعّال</label>
                            </div>
                        </div>
                        <div class="zyw-form-actions">
                            <button type="submit" class="btn-primary">إضافة قالب</button>
                        </div>
                    </form>

                    </details>
                    @if (Model.MessageTemplates.Count == 0)
                    {
                        <div class="zyw-empty">لا قوالب بعد — أضف واحداً ليصدر إشعار العقوبة بنصٍّ ثابت.</div>
                    }

                    <div class="zyw-list">
                        @foreach (var template in Model.MessageTemplates)
                        {
                            <details class="zyw-acc @(template.IsActive ? "" : "disabled")">
                                <summary>
                                    <span>@(template.IsDefault ? "★" : "—")</span>
                                    <strong>@template.Name</strong>
                                    <small>@template.TemplateType</small>
                                </summary>
                                <form method="post" asp-page-handler="UpdateTemplate">
                                    <input type="hidden" name="id" value="@template.Id" />
                                    <div class="zyw-form-grid">
                                        <div class="zyw-field">
                                            <label>الاسم</label>
                                            <input name="name" value="@template.Name" required />
                                        </div>
                                        <div class="zyw-field">
                                            <label>النوع</label>
                                            <select name="templateType">
                                                @foreach (var templateType in Model.TemplateTypes)
                                                {
                                                    <option value="@templateType.Code" selected="@(templateType.Code == template.TemplateType)">@templateType.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="zyw-field zyw-field--wide">
                                            <label>عنوان الرسالة</label>
                                            <input name="subject" value="@template.Subject" required />
                                        </div>
                                        <div class="zyw-field zyw-field--wide">
                                            <label>نصّ القالب</label>
                                            <textarea name="body" rows="10">@template.Body</textarea>
                                        </div>
                                        <div class="zyw-field zyw-field--wide zyw-checks">
                                            <label><input type="checkbox" name="isDefault" value="true" checked="@template.IsDefault" /> قالب افتراضي</label>
                                            <label><input type="checkbox" name="isActive" value="true" checked="@template.IsActive" /> فعّال</label>
                                        </div>
                                    </div>
                                    <div class="zyw-form-actions">
                                        <button type="submit" class="btn-primary">حفظ</button>
                                    </div>
                                </form>
                            </details>
                        }
                    </div>
                </article>
            }
        </section>
    </main>
<script data-disciplinary-script data-disciplinary-once src="~/js/zynora-disciplinary-tools.js" asp-append-version="true"></script>

@if (activeTab == "library")
{
    @* كتالوج المعايير **مرّةً واحدة للصفحة**: كان يُنسخ بكل صفّ (4KB × 79 = 336KB). *@
    <script type="application/json" id="zy-criteria-catalog">@Html.Raw(Model.CriteriaJson)</script>
    <script data-disciplinary-script data-disciplinary-once src="~/js/zynora-conditions.js" asp-append-version="true" defer></script>
}
@if (activeTab == "library" || activeTab == "articles")
{
    <script data-disciplinary-script data-disciplinary-once src="~/js/zynora-grid-editor.js" asp-append-version="true" defer></script>
}





@if (activeTab == "designer")
{
<script data-disciplinary-script data-disciplinary-once src="~/js/zynora-disciplinary-pdf.js" asp-append-version="true" defer></script>
<script data-disciplinary-script src="~/js/zynora-a4-custom-file-picker-v13-1.js" asp-append-version="true" defer></script>


}
</section>
@section Scripts {
    <script src="~/js/zynora-disciplinary-workspace.js" asp-append-version="true" defer></script>
}

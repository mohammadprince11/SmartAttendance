@page
@model SmartAttendance.Web.Pages.DisciplinaryRules.IndexModel
@using SmartAttendance.Web.Infrastructure.Theming
@using SmartAttendance.Web.Infrastructure.Hrms
@inject IThemeContextService ThemeContextService
@{
    ViewData["Title"] = "لائحة المخالفات";

    // هوية الشركة تلزم **معاينة الورقة** بتبويب المصمّم وحده (شعار وترويسة).
    var brandTheme = await ThemeContextService.GetCurrentAsync(default);
    var brandName = string.IsNullOrWhiteSpace(brandTheme.DisplayName) ? "ZYNORA HR" : brandTheme.DisplayName!;
    var brandSymbol = new string(brandName.Where(char.IsLetterOrDigit).Take(1).ToArray()).ToUpperInvariant();
    if (string.IsNullOrEmpty(brandSymbol)) { brandSymbol = "Z"; }

    var activeTab = Model.Tab;
    var selectedCategory = Model.SelectedCategoryId;
    var visibleTypes = Model.ViolationTypes.Where(x => selectedCategory <= 0 || x.CategoryId == selectedCategory).ToList();
    var visibleRules = Model.PenaltyRules.Where(x => selectedCategory <= 0 || x.CategoryId == selectedCategory).ToList();

    // المخالفة المفتوح سلّمها (زرّ الثلاث نقاط) — صفر يعني كلّها.
    var openType = Model.OpenTypeId;

    string Sel(string key) => (activeTab == key).ToString().ToLowerInvariant();
}

@* أُعيد بناء الصفحة من جذرها على «شاشة العمل» (`zynora-workscreen.css`) وطبقة
   التوكنات وحدهما.

   ⚠️ **الأنماط القديمة لم تعد تُحمَّل إلا بتبويب المصمّم.** كانت ثلاثة ملفات
   تُحمَّل بكل تبويب فتصبغ ما لا يخصّها: قِيس أن خطّ بطاقةٍ جديدة يخرج `Tahoma`
   لا `Tajawal` لأن غلاف الصفحة القديم يورّثه لكل ما بالداخل. والمصمّم وحده
   يحتاجها (ورقة A4 · طبقات · منتقي ملف)، فحُصرت به. *@
@section Styles {
    <link rel="stylesheet" href="~/css/zynora-workscreen.css" asp-append-version="true" />
    @if (activeTab == "library")
    {
        <link rel="stylesheet" href="~/css/zynora-conditions.css" asp-append-version="true" />
    }
    @if (activeTab == "designer")
    {
        <link rel="stylesheet" href="~/css/nexora-disciplinary-rules.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/nexora-a4-custom-file-picker-v13-1.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/nexora-disciplinary-designer-preview-safe-v1.css" asp-append-version="true" />
    }
}

<section class="zyw zy-scope" dir="rtl">

    <header class="zyw-head">
        <div>
            <h1>لائحة المخالفات</h1>
            <p>ما الذي يُعدّ مخالفة، وماذا يترتّب عليها بالتكرار — قبل أن تُسجَّل على أحد.</p>
        </div>
        <div class="zyw-totals">
            <span><b>@Model.Categories.Count</b> فئة</span>
            <span>·</span>
            <span><b>@Model.ViolationTypes.Count</b> مخالفة</span>
            <span>·</span>
            <span><b>@Model.PenaltyRules.Count</b> جزاء</span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="zy-card" role="status">@Model.StatusMessage</div>
    }

    @* ما رُفض حذفه يُعرض **بجانب** النجاح لا بدلاً منه: حفظٌ نجح وحذفٌ رُفض
       حدثان مختلفان، وابتلاع أحدهما يترك المستخدم يظنّ أن الصفّ اختفى. *@
    @if (!string.IsNullOrWhiteSpace(Model.BlockedMessage))
    {
        <div class="zy-card" role="alert">@Model.BlockedMessage</div>
    }

    @* روابط لا أزرار: كل تبويب يحمّل بياناته من الخادم (المصمّم يحتاج طبقاته). *@
    <nav class="zyw-tabs" aria-label="أقسام لائحة المخالفات">
        <a class="zyw-tab" aria-selected="@Sel("library")" asp-page="./Index" asp-route-tab="library" asp-route-categoryId="@selectedCategory">المخالفات والجزاءات</a>
        <a class="zyw-tab" aria-selected="@Sel("templates")" asp-page="./Index" asp-route-tab="templates">قوالب الرسائل</a>
        <a class="zyw-tab" aria-selected="@Sel("designer")" asp-page="./Index" asp-route-tab="designer">مصمّم الفورمة</a>
    </nav>

    <main>
        <section>
            @if (activeTab == "library")
            {
                @* الخطوة صفر: بلا لائحة لا يمكن تسجيل مخالفة أصلاً. *@
                @if (Model.Categories.Count == 0)
                {
                    <article class="zy-card">
                        <div class="zyw-queue-head">
                            <h2>ابدأ اللائحة</h2>
                            <span class="zy-pill">فارغة</span>
                        </div>
                        <p class="zyw-row-meta">
                            نموذج تسجيل المخالفة يفرض اختيار فئة ونوع — وبلا لائحة يبقى معطّلاً.
                            ابدأ بلائحة عربية جاهزة ثم عدّلها، أو اكتب فئاتك بنفسك أدناه.
                        </p>
                        <p class="zyw-row-meta">
                            ستُضاف: <b>الحضور والانصراف</b> · <b>المظهر العام</b> · <b>نظام العمل</b> ·
                            <b>سلوكية</b>، ومعها مخالفاتها وسلّم جزاءاتها. كلّها قابلة للتعديل والحذف.
                        </p>
                        <form method="post" asp-page-handler="SeedLibrary">
                            <div class="zyw-form-actions">
                                <button type="submit" class="btn-primary" data-zyconfirm="إضافة اللائحة الافتراضية؟">
                                    أضف اللائحة الافتراضية
                                </button>
                            </div>
                        </form>
                    </article>
                }

                @* ══════════ شبكتان محرَّرتان — نمطٌ منقول عن كيان بعد فحصٍ حيّ ══════════

                   كل صفٍّ حقول إدخال حيّة، والصفّ الجديد **يُلحَق بأسفل الشبكة** لا
                   بمودال، و**زرّ حفظٍ واحد** يمرّ على الصفوف كلّها. كان إدخال خمس
                   فئات يعني خمس دورات ذهابٍ وإياب؛ صار دورةً واحدة. *@

                <form method="get" class="zyw-filters" asp-page="./Index">
                    <input type="hidden" name="tab" value="library" />
                    <div class="zyw-field zyw-field--grow">
                        <label for="lib-search">بحث بالشاشة</label>
                        <input id="lib-search" name="search" value="@Model.Search" placeholder="اسم عربي أو إنجليزي أو رقم فقرة" />
                    </div>
                    <div class="zyw-form-actions">
                        <button type="submit" class="btn-secondary">بحث</button>
                        @if (!string.IsNullOrWhiteSpace(Model.Search))
                        {
                            <a class="btn-secondary" asp-page="./Index" asp-route-tab="library">مسح</a>
                        }
                    </div>
                </form>

                <div class="zyw-queue zyw-queue--stacked">

                    @* ─────────────── الفئات ─────────────── *@
                    <article class="zy-card">
                        <div class="zyw-queue-head">
                            <h2>فئات المخالفات</h2>
                            <span class="zy-pill">@Model.Categories.Count</span>
                        </div>
                        <p class="zyw-row-meta">أبواب اللائحة. كل مخالفة تتبع باباً واحداً — واترك «على من تنطبق» فارغاً لتشمل الجميع.</p>

                        <form method="post" asp-page-handler="SaveCategories" data-zyw-grid="categories">
                            <div class="zyw-table-wrap">
                                <table class="zyw-table">
                                    <thead>
                                        <tr>
                                            <th style="width:34px"></th>
                                            <th>الفئة (عربي)</th>
                                            <th>الفئة (English)</th>
                                            <th style="width:90px">الترتيب</th>
                                            <th>على من تنطبق</th>
                                        </tr>
                                    </thead>
                                    <tbody data-zyw-rows>
                                        @foreach (var category in Model.Categories.Where(c => Model.Matches(new[] { c.Name, c.NameEn })))
                                        {
                                            <tr>
                                                <td>
                                                    @* فئة النظام لا تُحذف: يُولَّد عليها آلياً من قواعد المناوبات. *@
                                                    @if (category.IsSystem)
                                                    {
                                                        <span class="zy-pill" title="فئة نظام — يُولَّد عليها آلياً">🔒</span>
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" name="deleteId" value="@category.Id" aria-label="حذف @category.Name" />
                                                    }
                                                </td>
                                                <td>
                                                    <input type="hidden" name="rowId" value="@category.Id" />
                                                    <input name="rowName" value="@category.Name" readonly="@category.IsSystem" required />
                                                </td>
                                                <td><input name="rowNameEn" value="@category.NameEn" readonly="@category.IsSystem" placeholder="Attendance" /></td>
                                                <td><input name="rowOrder" type="number" value="@category.DisplayOrder" /></td>
                                                <td>
                                                    <input type="hidden" name="rowConditions" id="cat-cond-@category.Id" value="@category.ConditionsJson" />
                                                    <div class="zyc" data-zy-conditions data-input="#cat-cond-@category.Id" data-criteria="@Model.CriteriaJson"
                                                         data-empty-text="بلا شروط — تنطبق على كل الموظفين."></div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @* قالب الصفّ الجديد: يُستنسخ بالمتصفّح فلا يُعاد تحميل الصفحة. *@
                            <template data-zyw-template>
                                <tr>
                                    <td></td>
                                    <td>
                                        <input type="hidden" name="rowId" value="0" />
                                        <input name="rowName" placeholder="اسم الفئة" />
                                    </td>
                                    <td><input name="rowNameEn" placeholder="English" /></td>
                                    <td><input name="rowOrder" type="number" value="10" /></td>
                                    <td><button type="button" class="btn-secondary" data-zyw-remove>✖ إزالة</button></td>
                                </tr>
                            </template>

                            <div class="zyw-form-actions">
                                <button type="button" class="btn-secondary" data-zyw-add>+ فئة جديدة</button>
                                <button type="submit" class="btn-primary">حفظ الفئات</button>
                            </div>
                        </form>
                    </article>

                    @* ─────────────── المخالفات ─────────────── *@
                    <article class="zy-card">
                        <div class="zyw-queue-head">
                            <h2>قائمة المخالفات</h2>
                            <span class="zy-pill">@Model.ViolationTypes.Count</span>
                        </div>
                        <p class="zyw-row-meta">لكلٍّ فئتها ورقم فقرتها باللائحة — ومنها يُبنى سلّم الجزاءات أدناه.</p>

                        @if (Model.Categories.Count == 0)
                        {
                            <div class="zyw-empty">أضف فئةً واحدة على الأقل أوّلاً — كل مخالفة تتبع فئة.</div>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="SaveViolationTypes" data-zyw-grid="violations">
                                <div class="zyw-table-wrap">
                                    <table class="zyw-table">
                                        <thead>
                                            <tr>
                                                <th style="width:34px"></th>
                                                <th style="width:170px">الفئة</th>
                                                <th>المخالفة (عربي)</th>
                                                <th>المخالفة (English)</th>
                                                <th style="width:90px">الفقرة</th>
                                                <th>على من تنطبق</th>
                                                <th style="width:70px"></th>
                                            </tr>
                                        </thead>
                                        <tbody data-zyw-rows>
                                            @foreach (var violation in Model.ViolationTypes.Where(v => Model.Matches(new[] { v.Name, v.NameEn, v.ArticleNo })))
                                            {
                                                <tr>
                                                    <td><input type="checkbox" name="deleteId" value="@violation.Id" aria-label="حذف @violation.Name" /></td>
                                                    <td>
                                                        <input type="hidden" name="rowId" value="@violation.Id" />
                                                        <select name="rowCategoryId">
                                                            @foreach (var category in Model.Categories)
                                                            {
                                                                <option value="@category.Id" selected="@(category.Id == violation.CategoryId)">@category.Name</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td><input name="rowName" value="@violation.Name" required /></td>
                                                    <td><input name="rowNameEn" value="@violation.NameEn" placeholder="English" /></td>
                                                    <td><input name="rowArticle" value="@violation.ArticleNo" placeholder="3/ب" /></td>
                                                    <td>
                                                        <input type="hidden" name="rowConditions" id="vt-cond-@violation.Id" value="@violation.ConditionsJson" />
                                                        <div class="zyc" data-zy-conditions data-input="#vt-cond-@violation.Id" data-criteria="@Model.CriteriaJson"
                                                             data-empty-text="بلا شروط — تنطبق على كل الموظفين."></div>
                                                    </td>
                                                    <td>
                                                        @* الثلاث نقاط بكيان: تفتح تفاصيل المخالفة وسلّم جزاءاتها. *@
                                                        <a class="btn-secondary" asp-page="./Index" asp-route-tab="library"
                                                           asp-route-categoryId="@violation.CategoryId" asp-route-openTypeId="@violation.Id"
                                                           title="سلّم الجزاءات">•••</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <template data-zyw-template>
                                    <tr>
                                        <td></td>
                                        <td>
                                            <input type="hidden" name="rowId" value="0" />
                                            <select name="rowCategoryId">
                                                @foreach (var category in Model.Categories)
                                                {
                                                    <option value="@category.Id">@category.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input name="rowName" placeholder="اسم المخالفة" /></td>
                                        <td><input name="rowNameEn" placeholder="English" /></td>
                                        <td><input name="rowArticle" placeholder="3/ب" /></td>
                                        <td></td>
                                        <td><button type="button" class="btn-secondary" data-zyw-remove>✖</button></td>
                                    </tr>
                                </template>

                                <div class="zyw-form-actions">
                                    <button type="button" class="btn-secondary" data-zyw-add>+ نوع مخالفة جديد</button>
                                    <button type="submit" class="btn-primary">حفظ المخالفات</button>
                                </div>
                            </form>
                        }
                    </article>

                    @* ─────────────── سلّم الجزاءات ─────────────── *@
                    @if (Model.ViolationTypes.Count > 0)
                    {
                        <article class="zy-card">
                            <div class="zyw-queue-head">
                                <h2>برنامج التأديب التدريجي</h2>
                                <span class="zy-pill">@Model.PenaltyRules.Count</span>
                            </div>
                            <p class="zyw-row-meta">ماذا يترتّب بالتكرار الأول والثاني والثالث — <b>ونوع الإجراء هو ما يقود الحساب</b>، لا نصّ العقوبة.</p>

                            @foreach (var violation in Model.ViolationTypes.Where(v => openType <= 0 || v.Id == openType))
                            {
                                var rules = Model.PenaltyRules.Where(r => r.ViolationTypeId == violation.Id)
                                    .OrderBy(r => r.OccurrenceFrom).ToList();

                                <details class="zyw-acc" open="@(openType == violation.Id)">
                                    <summary>
                                        <span>@Model.DisplaySeverityShort(violation.Severity)</span>
                                        <strong>@violation.Name</strong>
                                        <small>@violation.CategoryName · @rules.Count جزاء</small>
                                    </summary>

                                    @if (rules.Count == 0)
                                    {
                                        <div class="zyw-empty">لا جزاء بعد — بلا سلّم لا يترتّب على المخالفة شيء.</div>
                                    }

                                    <div class="zyw-list">
                                        @foreach (var rule in rules)
                                        {
                                            <div class="zyw-item">
                                                <div class="zyw-item-main">
                                                    <strong>@rule.ActionLabel — @rule.PenaltyAction</strong>
                                                    <small>
                                                        التكرار @rule.OccurrenceFrom@(rule.OccurrenceTo > rule.OccurrenceFrom ? $"–{rule.OccurrenceTo}" : "") ·
                                                        @rule.DropText
                                                        @if (rule.IsFinancial)
                                                        {
                                                            <text> · @rule.BaseText ÷ @rule.DivisorText</text>
                                                        }
                                                    </small>
                                                </div>
                                                <div class="zyw-item-actions">
                                                    <button type="button" class="btn-secondary" data-zyw-edit-rule="@rule.Id">تعديل</button>
                                                    <form method="post" asp-page-handler="DeletePenaltyRule">
                                                        <input type="hidden" name="id" value="@rule.Id" />
                                                        <button type="submit" class="btn-secondary" data-zyconfirm="حذف الجزاء؟">حذف</button>
                                                    </form>
                                                </div>
                                            </div>

                                            @* نموذج التعديل مطويّ بجانب صفّه — لا مودال ولا صفحة. *@
                                            <form method="post" asp-page-handler="UpdatePenaltyRule" class="zyw-rule-form" data-zyw-rule-form="@rule.Id" hidden>
                                                <input type="hidden" name="id" value="@rule.Id" />
                                                <input type="hidden" name="ViolationTypeId" value="@violation.Id" />
                                                @await Html.PartialAsync("_PenaltyRuleFields", new SmartAttendance.Web.Pages.DisciplinaryRules.PenaltyRuleFieldsModel(Model, rule))
                                            </form>
                                        }
                                    </div>

                                    <details class="zyw-acc">
                                        <summary><span>+</span><strong>قاعدة إجراءات تأديبية جديدة</strong><small>عند التكرار رقم @(rules.Count + 1)</small></summary>
                                        <form method="post" asp-page-handler="CreatePenaltyRule">
                                            <input type="hidden" name="ViolationTypeId" value="@violation.Id" />
                                            @await Html.PartialAsync("_PenaltyRuleFields", new SmartAttendance.Web.Pages.DisciplinaryRules.PenaltyRuleFieldsModel(Model, null, rules.Count + 1))
                                        </form>
                                    </details>
                                </details>
                            }
                        </article>
                    }
                </div>
            }
            
            else if (activeTab == "designer")
            {
                <section class="zy-card">
                    <header class="zyw-queue-head">
                        <div>
                            
                            <h2>مصمم فورمة العقوبة</h2>
                            <p>
                                ارفع صورة الهيدر والفوتر، ثم أضف مربعات نص في المكان الذي تريده مع التحكم بنوع وحجم ولون الخط.
                                إذا لم ترفع صورة، يظهر هيدر وفوتر تلقائي من النظام.
                            </p>
                        </div>
                    </header>

                    <section class="nxpen-designer-grid">
                        <div class="nxpen-designer-panel">
                    <section class="zy-card nxpen-a4-form-card" data-nxpen-a4-form-upload>
                        <header>
                            <h3>&#1585;&#1601;&#1593; &#1601;&#1608;&#1585;&#1605;&#1577; &#1575;&#1604;&#1588;&#1585;&#1603;&#1577; A4</h3>
                            <small>&#1575;&#1585;&#1601;&#1593; &#1601;&#1608;&#1585;&#1605;&#1577; &#1601;&#1575;&#1585;&#1594;&#1577; &#1603;&#1575;&#1605;&#1604;&#1577; &#1576;&#1602;&#1610;&#1575;&#1587; A4. &#1610;&#1583;&#1593;&#1605; PDF &#1571;&#1608; &#1589;&#1608;&#1585;&#1577;. &#1575;&#1604;&#1606;&#1589;&#1608;&#1589; &#1587;&#1578;&#1592;&#1607;&#1585; &#1601;&#1608;&#1602;&#1607;&#1575;.</small>
                        </header>

                        <form method="post" asp-page-handler="SaveA4Form" enctype="multipart/form-data" class="zyw-form-grid">
                            <div class="wide">
                                <label>&#1601;&#1608;&#1585;&#1605;&#1577; A4 &#1601;&#1575;&#1585;&#1594;&#1577;</label>
                                <input type="file" name="a4FormFile" accept=".png,.jpg,.jpeg,.webp,.pdf" />
                            </div>
                            <footer class="zyw-form-actions zyw-field--wide">
                                <button type="submit">&#1581;&#1601;&#1592; &#1601;&#1608;&#1585;&#1605;&#1577; A4</button>
                            </footer>
                        </form>
                    </section>

                            <section class="zy-card">
                                <header>
                                    <h3>صور الهيدر والفوتر</h3>
                                    <small>يفضل استخدام صورة عريضة للهيدر والفوتر بعرض صفحة A4.</small>
                                </header>

                                <form method="post" asp-page-handler="SaveFormImages" enctype="multipart/form-data" class="zyw-form-grid">
                                    <div class="wide">
                                        <label>صورة الهيدر</label>
                                        <input type="file" name="headerImage" accept="image/*" />
                                    </div>
                                    <div class="wide">
                                        <label>صورة الفوتر</label>
                                        <input type="file" name="footerImage" accept="image/*" />
                                    </div>
                                    <footer class="zyw-form-actions zyw-field--wide">
                                        <button type="submit">حفظ صور الفورمة</button>
                                    </footer>
                                </form>
                            </section>

                            <section class="zy-card nxpen-main-text-card">
                                <header>
                                    <h3>تعديل النص كطبقات مستقلة</h3>
                                    <small>
                                        كل سطر داخل الورقة صار Text Layer مستقل مثل Word:
                                        العنوان، اسم الموظف، الكود، القسم، تاريخ المخالفة، العقوبة، والأثر المالي.
                                        عدّل كل واحد من قائمة "طبقات النص الحالية" بالأسفل.
                                    </small>
                                </header>

                                <div class="nxpen-layer-guide">
                                    <article>
                                        <strong>الفكرة</strong>
                                        <p>بدل نص واحد كبير، كل عنصر داخل الورقة إله مكان وخط وحجم ولون ومحاذاة مستقلة.</p>
                                    </article>
                                    <article>
                                        <strong>طريقة التعديل</strong>
                                        <p>افتح أي عنصر من طبقات النص الحالية، وعدّل النص أو المكان أو الخط مثل Word.</p>
                                    </article>
                                </div>

                                <form method="post" asp-page-handler="SeedBodyTextLayers" class="zyw-form-grid">
                                    <div class="wide">
                                        <label>إعادة بناء النصوص الأساسية كطبقات منفصلة</label>
                                        <small class="nxpen-form-note">
                                            يستخدم هذا الزر مرة واحدة إذا تريد إنشاء عناصر الورقة الأساسية بشكل منفصل.
                                            لا يحذف النصوص الإضافية في الهيدر أو الفوتر.
                                        </small>
                                    </div>
                                    <footer class="zyw-form-actions zyw-field--wide">
                                        <button type="submit">إنشاء / تحديث طبقات النص الأساسية</button>
                                    </footer>
                                </form>
                            </section>

                            <section class="zy-card">
                                <header>
                                    <h3>إضافة طبقة نص جديدة</h3>
                                    <small>استخدم هذا الخيار لإضافة أي نص جديد فوق الهيدر أو المتن أو الفوتر.</small>
                                </header>

                                <form method="post" asp-page-handler="CreateTextBlock" class="zyw-form-grid">
                                    <div>
                                        <label>المنطقة</label>
                                        <select data-nexora-select="true" name="area">
                                            <option value="Header">الهيدر</option>
                                            <option value="Body" selected>المتن</option>
                                            <option value="Footer">الفوتر</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label>نوع الخط</label>
                                        <select data-nexora-select="true" name="fontFamily">
                                            @foreach (var font in Model.FontFamilies)
                                            {
                                                <option value="@font">@font</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label>حجم الخط</label>
                                        <input name="fontSize" type="number" min="8" max="60" value="14" />
                                    </div>
                                    <div>
                                        <label>لون الخط</label>
                                        <input name="fontColor" type="color" value="#0b1d31" />
                                    </div>
                                    <div>
                                        <label>من اليمين %</label>
                                        <input name="xPercent" type="number" min="0" max="100" step="0.1" value="8" />
                                    </div>
                                    <div>
                                        <label>من الأعلى %</label>
                                        <input name="yPercent" type="number" min="0" max="100" step="0.1" value="25" />
                                    </div>
                                    <div>
                                        <label>العرض %</label>
                                        <input name="widthPercent" type="number" min="5" max="100" step="0.1" value="84" />
                                    </div>
                                    <div>
                                        <label>المحاذاة</label>
                                        <select data-nexora-select="true" name="textAlign">
                                            <option value="right" selected>يمين</option>
                                            <option value="center">وسط</option>
                                            <option value="left">يسار</option>
                                        </select>
                                    </div>
                                    <div class="wide">
                                        <label>النص</label>
                                        <textarea name="text" rows="4" placeholder="مثال: السيد/ة {EmployeeName}"></textarea>
                                    </div>
                                    <div class="zyw-field zyw-field--wide zyw-checks">
                                        <label>
                                            <input type="checkbox" name="isBold" value="true" /> Bold
                                            </label>
                                        <label>
                                            <input type="checkbox" name="isActive" value="true" checked /> فعال
                                            </label>
                                    </div>
                                    <footer class="zyw-form-actions zyw-field--wide">
                                        <button type="submit">إضافة صندوق نص إضافي</button>
                                    </footer>
                                </form>
                            </section>

                            <section class="zy-card">
                                <header>
                                    <h3>صناديق النص الحالية</h3>
                                    <small>يمكن تعديل كل صندوق نص بشكل كامل.</small>
                                </header>

                                <div class="nxpen-edit-list">
                                    @foreach (var block in Model.TextBlocks)
                                    {
                                        <details class="nxpen-edit-item @(block.IsActive ? "" : "disabled")" data-layer-details="@block.Id">
                                            <summary>
                                                <span>@block.Area</span>
                                                <strong>@block.Text</strong>
                                                <small>@block.FontFamily / @block.FontSize px / @block.FontColor</small>
                                            </summary>
                                            <form method="post" asp-page-handler="UpdateTextBlock" class="zyw-form-grid" data-layer-form data-layer-id="@block.Id">
                                                <input type="hidden" name="id" value="@block.Id" />
                                                <div>
                                                    <label>المنطقة</label>
                                                    <select data-nexora-select="true" name="area">
                                                        <option value="Header" selected="@(block.Area == "Header")">الهيدر</option>
                                                        <option value="Body" selected="@(block.Area == "Body")">المتن</option>
                                                        <option value="Footer" selected="@(block.Area == "Footer")">الفوتر</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label>نوع الخط</label>
                                                    <select data-nexora-select="true" name="fontFamily">
                                                        @foreach (var font in Model.FontFamilies)
                                                        {
                                                            <option value="@font" selected="@(block.FontFamily == font)">@font</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div>
                                                    <label>حجم الخط</label>
                                                    <input name="fontSize" type="number" min="8" max="60" value="@block.FontSize" />
                                                </div>
                                                <div>
                                                    <label>لون الخط</label>
                                                    <input name="fontColor" type="color" value="@block.FontColor" />
                                                </div>
                                                <div>
                                                    <label>من اليمين %</label>
                                                    <input name="xPercent" type="number" min="0" max="100" step="0.1" value="@block.XPercent" />
                                                </div>
                                                <div>
                                                    <label>من الأعلى %</label>
                                                    <input name="yPercent" type="number" min="0" max="100" step="0.1" value="@block.YPercent" />
                                                </div>
                                                <div>
                                                    <label>العرض %</label>
                                                    <input name="widthPercent" type="number" min="5" max="100" step="0.1" value="@block.WidthPercent" />
                                                </div>
                                                <div>
                                                    <label>المحاذاة</label>
                                                    <select data-nexora-select="true" name="textAlign">
                                                        <option value="right" selected="@(block.TextAlign == "right")">يمين</option>
                                                        <option value="center" selected="@(block.TextAlign == "center")">وسط</option>
                                                        <option value="left" selected="@(block.TextAlign == "left")">يسار</option>
                                                    </select>
                                                </div>
                                                <div class="wide">
                                                    <label>النص</label>
                                                    <textarea name="text" rows="4">@block.Text</textarea>
                                                </div>
                                                <div class="zyw-field zyw-field--wide zyw-checks">
                                                    <label>
                                                        <input type="checkbox" name="isBold" value="true" checked="@block.IsBold" /> Bold
                                                        </label>
                                                    <label>
                                                        <input type="checkbox" name="isActive" value="true" checked="@block.IsActive" /> فعال
                                                        </label>
                                                </div>
                                                <footer class="zyw-form-actions zyw-field--wide">
                                                    <button type="submit">حفظ طبقة النص</button>
                                                    <button class="danger-outline"
                                                            type="submit"
                                                            formaction="?handler=DeleteTextBlock"
                                                            formmethod="post"
                                                            name="id"
                                                            value="@block.Id">
                                                        حذف
                                                    </button>
                                                </footer>
                                            </form>
                                        </details>
                                    }
                                </div>
                            </section>
                        </div>

                        <section class="nxpen-live-preview">
                            <header>
                                <h3>معاينة واضحة للفورمة</h3>
                                <small>هذه المعاينة تظهر الهيدر والفوتر وصناديق النص كما ستظهر في فورمة الموظف.</small>
                            </header>
                        <div class="nxpen-drag-help" data-nxpen-drag-help>Drag any text directly on the paper. Hold Shift to move without snap. Save the layer after moving.</div>

                            <div class="nxpen-a4-paper">
                             @if (!string.IsNullOrWhiteSpace(Model.Settings.A4FormFilePath) && Model.Settings.A4FormFileType != "Pdf")
{
    <img class="nxpen-a4-form-layer" src="@Model.Settings.A4FormFilePath" alt="A4 Form" />
}
else if (Model.Settings.A4FormFileType == "Pdf")
{
    <div class="nxpen-a4-pdf-note">
        تم رفع ملف PDF بنجاح، لكن المعاينة داخل المصمم تحتاج تحويل PDF إلى صورة A4.
        حالياً ارفع الفورمة كصورة PNG / JPG حتى تظهر كخلفية.
    </div>
}
                                <div class="nxpen-a4-section nxpen-a4-header">
                                    @if (!string.IsNullOrWhiteSpace(Model.Settings.HeaderImagePath))
                                    {
                                        <img src="@Model.Settings.HeaderImagePath" alt="Header" />
                                    }
                                    else
                                    {
                                        <div class="nxpen-auto-header"><div class="nxpen-logo-mark">@brandSymbol</div><div><strong>@brandName</strong><small>Disciplinary Notice / إشعار مخالفة وجزاء</small></div></div>
                                    }

                                    @foreach (var block in Model.TextBlocks.Where(x => x.Area == "Header" && x.IsActive))
                                    {
                                        <div class="nxpen-text-block" data-layer-id="@block.Id" data-layer-area="@block.Area" style="@Model.BuildTextBlockStyle(block)">@block.Text</div>
                                    }
                                </div>

                                <div class="nxpen-a4-section nxpen-a4-body">
                                    @if (!Model.TextBlocks.Any(x => x.Area == "Body" && x.IsActive))
                                    {
                                        <div class="nxpen-empty-paper-note">
                                            اضغط "إنشاء / تحديث طبقات النص الأساسية" حتى تظهر عناصر الورقة كطبقات مستقلة قابلة للتعديل.
                                        </div>
                                    }

                                    @foreach (var block in Model.TextBlocks.Where(x => x.Area == "Body" && x.IsActive))
                                    {
                                        <div class="nxpen-text-block" data-layer-id="@block.Id" data-layer-area="@block.Area" style="@Model.BuildTextBlockStyle(block)">@block.Text</div>
                                    }
                                </div>

                                <div class="nxpen-a4-section nxpen-a4-footer">
                                    @if (!string.IsNullOrWhiteSpace(Model.Settings.FooterImagePath))
                                    {
                                        <img src="@Model.Settings.FooterImagePath" alt="Footer" />
                                    }
                                    else
                                    {
                                        <div class="nxpen-auto-footer"><strong>@Model.Settings.ApprovingAuthorityName</strong><small>تم إنشاء هذا الإشعار آلياً من نظام الموارد البشرية</small></div>
                                    }

                                    @foreach (var block in Model.TextBlocks.Where(x => x.Area == "Footer" && x.IsActive))
                                    {
                                        <div class="nxpen-text-block" data-layer-id="@block.Id" data-layer-area="@block.Area" style="@Model.BuildTextBlockStyle(block)">@block.Text</div>
                                    }
                                </div>
                            </div>
                        </section>
                    </section>
                </section>
            }
            else
            {
                <div class="zyw-queue">
                    <article class="zy-card">
                        <div class="zyw-queue-head">
                            <h2>أنواع القوالب</h2>
                            <span class="zy-pill">@Model.TemplateTypes.Count</span>
                        </div>
                        <p class="zyw-row-meta">النوع هو غرض الكتاب: إشعار عقوبة · إحالة للجنة · لفت نظر.</p>

                        <form method="post" asp-page-handler="CreateTemplateType">
                            <div class="zyw-form-grid">
                                <div class="zyw-field">
                                    <label for="tt-name">الاسم</label>
                                    <input id="tt-name" name="name" required placeholder="إشعار عقوبة" />
                                </div>
                                <div class="zyw-field">
                                    <label for="tt-code">الرمز</label>
                                    <input id="tt-code" name="code" required placeholder="PenaltyNotice" />
                                </div>
                                <div class="zyw-field zyw-field--wide">
                                    <label for="tt-desc">الوصف</label>
                                    <input id="tt-desc" name="description" />
                                </div>
                            </div>
                            <div class="zyw-form-actions">
                                <button type="submit" class="btn-primary">إضافة نوع</button>
                            </div>
                        </form>

                        <div class="zyw-list">
                            @foreach (var templateType in Model.TemplateTypes)
                            {
                                var used = Model.MessageTemplates.Count(t => t.TemplateType == templateType.Code);
                                <details class="zyw-acc @(templateType.IsActive ? "" : "disabled")">
                                    <summary>
                                        <span>@used</span>
                                        <strong>@templateType.Name</strong>
                                        <small>@templateType.Code</small>
                                    </summary>
                                    <form method="post" asp-page-handler="UpdateTemplateType">
                                        <input type="hidden" name="id" value="@templateType.Id" />
                                        <div class="zyw-form-grid">
                                            <div class="zyw-field">
                                                <label>الاسم</label>
                                                <input name="name" value="@templateType.Name" required />
                                            </div>
                                            <div class="zyw-field">
                                                <label>الرمز</label>
                                                <input name="code" value="@templateType.Code" required />
                                            </div>
                                            <div class="zyw-field zyw-field--wide">
                                                <label>الوصف</label>
                                                <input name="description" value="@templateType.Description" />
                                            </div>
                                            <div class="zyw-field zyw-checks">
                                                <label><input type="checkbox" name="isActive" value="true" checked="@templateType.IsActive" /> فعّال</label>
                                            </div>
                                        </div>
                                        <div class="zyw-form-actions">
                                            <button type="submit" class="btn-primary">حفظ</button>
                                        </div>
                                    </form>
                                </details>
                            }
                        </div>
                    </article>

                    <article class="zy-card">
                        <div class="zyw-queue-head">
                            <h2>المتغيّرات</h2>
                            <span class="zy-pill">@Model.TemplateTokens.Count</span>
                        </div>
                        <p class="zyw-row-meta">
                            تُكتب داخل نصّ القالب فيستبدلها النظام ببيانات الموظف والمخالفة عند التوليد.
                        </p>
                        <div class="zyw-checks">
                            @foreach (var token in Model.TemplateTokens)
                            {
                                <span class="zy-pill">@token</span>
                            }
                        </div>
                    </article>
                </div>

                <article class="zy-card">
                    <div class="zyw-queue-head">
                        <h2>قوالب الرسائل</h2>
                        <span class="zy-pill">@Model.MessageTemplates.Count</span>
                    </div>
                    <p class="zyw-row-meta">
                        نصّ الكتاب الذي يصل الموظف. الهيدر والفوتر يأتيان من تهيئة المخالفات لا من هنا.
                    </p>

                    <form method="post" asp-page-handler="CreateTemplate">
                        <div class="zyw-form-grid">
                            <div class="zyw-field">
                                <label for="tp-name">اسم القالب</label>
                                <input id="tp-name" name="name" required placeholder="نموذج إشعار عقوبة" />
                            </div>
                            <div class="zyw-field">
                                <label for="tp-type">نوع القالب</label>
                                <select id="tp-type" name="templateType">
                                    @foreach (var templateType in Model.TemplateTypes.Where(x => x.IsActive))
                                    {
                                        <option value="@templateType.Code">@templateType.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="zyw-field zyw-field--wide">
                                <label for="tp-subject">عنوان الرسالة</label>
                                <input id="tp-subject" name="subject" required value="إشعار مخالفة وجزاء - {EmployeeName}" />
                            </div>
                            <div class="zyw-field zyw-field--wide">
                                <label for="tp-body">نصّ القالب</label>
                                <textarea id="tp-body" name="body" rows="10">@Model.DefaultTemplateBody</textarea>
                            </div>
                            <div class="zyw-field zyw-field--wide zyw-checks">
                                <label><input type="checkbox" name="isDefault" value="true" /> قالب افتراضي</label>
                                <label><input type="checkbox" name="isActive" value="true" checked /> فعّال</label>
                            </div>
                        </div>
                        <div class="zyw-form-actions">
                            <button type="submit" class="btn-primary">إضافة قالب</button>
                        </div>
                    </form>

                    @if (Model.MessageTemplates.Count == 0)
                    {
                        <div class="zyw-empty">لا قوالب بعد — أضف واحداً ليصدر إشعار العقوبة بنصٍّ ثابت.</div>
                    }

                    <div class="zyw-list">
                        @foreach (var template in Model.MessageTemplates)
                        {
                            <details class="zyw-acc @(template.IsActive ? "" : "disabled")">
                                <summary>
                                    <span>@(template.IsDefault ? "★" : "—")</span>
                                    <strong>@template.Name</strong>
                                    <small>@template.TemplateType</small>
                                </summary>
                                <form method="post" asp-page-handler="UpdateTemplate">
                                    <input type="hidden" name="id" value="@template.Id" />
                                    <div class="zyw-form-grid">
                                        <div class="zyw-field">
                                            <label>الاسم</label>
                                            <input name="name" value="@template.Name" required />
                                        </div>
                                        <div class="zyw-field">
                                            <label>النوع</label>
                                            <select name="templateType">
                                                @foreach (var templateType in Model.TemplateTypes)
                                                {
                                                    <option value="@templateType.Code" selected="@(templateType.Code == template.TemplateType)">@templateType.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="zyw-field zyw-field--wide">
                                            <label>عنوان الرسالة</label>
                                            <input name="subject" value="@template.Subject" required />
                                        </div>
                                        <div class="zyw-field zyw-field--wide">
                                            <label>نصّ القالب</label>
                                            <textarea name="body" rows="10">@template.Body</textarea>
                                        </div>
                                        <div class="zyw-field zyw-field--wide zyw-checks">
                                            <label><input type="checkbox" name="isDefault" value="true" checked="@template.IsDefault" /> قالب افتراضي</label>
                                            <label><input type="checkbox" name="isActive" value="true" checked="@template.IsActive" /> فعّال</label>
                                        </div>
                                    </div>
                                    <div class="zyw-form-actions">
                                        <button type="submit" class="btn-primary">حفظ</button>
                                    </div>
                                </form>
                            </details>
                        }
                    </div>
                </article>
            }
        </section>
    </main>
</section>

<script src="~/js/nexora-disciplinary-rules.js" asp-append-version="true"></script>

@if (activeTab == "library")
{
    <script src="~/js/zynora-conditions.js" asp-append-version="true" defer></script>
    <script src="~/js/zynora-grid-editor.js" asp-append-version="true" defer></script>
}





<script src="~/js/nexora-a4-custom-file-picker-v13-1.js" asp-append-version="true" defer></script>



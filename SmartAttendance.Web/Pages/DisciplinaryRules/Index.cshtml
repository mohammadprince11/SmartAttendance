@page
@model SmartAttendance.Web.Pages.DisciplinaryRules.IndexModel
@using SmartAttendance.Web.Infrastructure.Theming
@inject IThemeContextService ThemeContextService
@{
    ViewData["Title"] = "لائحة المخالفات";

    // هوية الشركة تلزم **معاينة الورقة** بتبويب المصمّم وحده (شعار وترويسة).
    var brandTheme = await ThemeContextService.GetCurrentAsync(default);
    var brandName = string.IsNullOrWhiteSpace(brandTheme.DisplayName) ? "ZYNORA HR" : brandTheme.DisplayName!;
    var brandSymbol = new string(brandName.Where(char.IsLetterOrDigit).Take(1).ToArray()).ToUpperInvariant();
    if (string.IsNullOrEmpty(brandSymbol)) { brandSymbol = "Z"; }

    var activeTab = Model.Tab;
    var selectedCategory = Model.SelectedCategoryId;
    var visibleTypes = Model.ViolationTypes.Where(x => selectedCategory <= 0 || x.CategoryId == selectedCategory).ToList();
    var visibleRules = Model.PenaltyRules.Where(x => selectedCategory <= 0 || x.CategoryId == selectedCategory).ToList();

    string Sel(string key) => (activeTab == key).ToString().ToLowerInvariant();
}

@* أُعيد بناء الصفحة من جذرها على «شاشة العمل» (`zynora-workscreen.css`) وطبقة
   التوكنات وحدهما.

   ⚠️ **الأنماط القديمة لم تعد تُحمَّل إلا بتبويب المصمّم.** كانت ثلاثة ملفات
   تُحمَّل بكل تبويب فتصبغ ما لا يخصّها: قِيس أن خطّ بطاقةٍ جديدة يخرج `Tahoma`
   لا `Tajawal` لأن غلاف الصفحة القديم يورّثه لكل ما بالداخل. والمصمّم وحده
   يحتاجها (ورقة A4 · طبقات · منتقي ملف)، فحُصرت به. *@
@section Styles {
    <link rel="stylesheet" href="~/css/zynora-workscreen.css" asp-append-version="true" />
    @if (activeTab == "designer")
    {
        <link rel="stylesheet" href="~/css/nexora-disciplinary-rules.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/nexora-a4-custom-file-picker-v13-1.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/nexora-disciplinary-designer-preview-safe-v1.css" asp-append-version="true" />
    }
}

<section class="zyw zy-scope" dir="rtl">

    <header class="zyw-head">
        <div>
            <h1>لائحة المخالفات</h1>
            <p>ما الذي يُعدّ مخالفة، وماذا يترتّب عليها بالتكرار — قبل أن تُسجَّل على أحد.</p>
        </div>
        <div class="zyw-totals">
            <span><b>@Model.Categories.Count</b> فئة</span>
            <span>·</span>
            <span><b>@Model.ViolationTypes.Count</b> مخالفة</span>
            <span>·</span>
            <span><b>@Model.PenaltyRules.Count</b> جزاء</span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="zy-card" role="status">@Model.StatusMessage</div>
    }

    @* روابط لا أزرار: كل تبويب يحمّل بياناته من الخادم (المصمّم يحتاج طبقاته). *@
    <nav class="zyw-tabs" aria-label="أقسام لائحة المخالفات">
        <a class="zyw-tab" aria-selected="@Sel("library")" asp-page="./Index" asp-route-tab="library" asp-route-categoryId="@selectedCategory">المخالفات والجزاءات</a>
        <a class="zyw-tab" aria-selected="@Sel("templates")" asp-page="./Index" asp-route-tab="templates">قوالب الرسائل</a>
        <a class="zyw-tab" aria-selected="@Sel("designer")" asp-page="./Index" asp-route-tab="designer">مصمّم الفورمة</a>
    </nav>

    <main>
        <section>
            @if (activeTab == "library")
            {
                @* الخطوة صفر: بلا لائحة لا يمكن تسجيل مخالفة أصلاً. *@
                @if (Model.Categories.Count == 0)
                {
                    <article class="zy-card">
                        <div class="zyw-queue-head">
                            <h2>ابدأ اللائحة</h2>
                            <span class="zy-pill">فارغة</span>
                        </div>
                        <p class="zyw-row-meta">
                            نموذج تسجيل المخالفة يفرض اختيار فئة ونوع — وبلا لائحة يبقى معطّلاً.
                            ابدأ بلائحة عربية جاهزة ثم عدّلها، أو اكتب فئاتك بنفسك أدناه.
                        </p>
                        <p class="zyw-row-meta">
                            ستُضاف: <b>الحضور والانصراف</b> · <b>المظهر العام</b> · <b>نظام العمل</b> ·
                            <b>سلوكية</b>، ومعها مخالفاتها وسلّم جزاءاتها. كلّها قابلة للتعديل والحذف.
                        </p>
                        <form method="post" asp-page-handler="SeedLibrary">
                            <div class="zyw-form-actions">
                                <button type="submit" class="btn-primary" data-zyconfirm="إضافة اللائحة الافتراضية؟">
                                    أضف اللائحة الافتراضية
                                </button>
                            </div>
                        </form>
                    </article>
                }

                @if (Model.Categories.Count > 0)
                {
                    <nav class="zyw-tabs" aria-label="تصفية بالفئة">
                        <a class="zyw-tab" aria-selected="@((selectedCategory <= 0).ToString().ToLowerInvariant())" asp-page="./Index" asp-route-tab="library">كل الفئات</a>
                        @foreach (var category in Model.Categories)
                        {
                            <a class="zyw-tab" aria-selected="@((selectedCategory == category.Id).ToString().ToLowerInvariant())" asp-page="./Index" asp-route-tab="library" asp-route-categoryId="@category.Id">@category.Name</a>
                        }
                    </nav>
                }

                <div class="zyw-queue">
                    <article class="zy-card">
                        <div class="zyw-queue-head">
                            <h2>الفئات</h2>
                            <span class="zy-pill">@Model.Categories.Count</span>
                        </div>
                        <p class="zyw-row-meta">أبواب اللائحة. كل مخالفة تتبع باباً واحداً.</p>

                        <form method="post" asp-page-handler="CreateCategory">
                            <div class="zyw-form-grid">
                                <div class="zyw-field zyw-field--wide">
                                    <label for="cat-name">اسم الفئة</label>
                                    <input id="cat-name" name="name" required placeholder="مخالفات الحضور والانصراف" />
                                </div>
                                <div class="zyw-field">
                                    <label for="cat-order">الترتيب</label>
                                    <input id="cat-order" name="displayOrder" type="number" value="10" />
                                </div>
                                <div class="zyw-field zyw-field--wide">
                                    <label for="cat-desc">الوصف</label>
                                    <input id="cat-desc" name="description" placeholder="التأخير والغياب ونسيان البصمة" />
                                </div>
                            </div>
                            <div class="zyw-form-actions">
                                <button type="submit" class="btn-primary">إضافة فئة</button>
                            </div>
                        </form>

                        <div class="zyw-list">
                            @foreach (var category in Model.Categories)
                            {
                                <details class="zyw-acc @(category.IsActive ? "" : "disabled")">
                                    <summary>
                                        <span>@category.DisplayOrder.ToString("00")</span>
                                        <strong>@category.Name</strong>
                                        <small>@category.TypesCount مخالفة</small>
                                    </summary>
                                    <form method="post" asp-page-handler="UpdateCategory">
                                        <input type="hidden" name="id" value="@category.Id" />
                                        <div class="zyw-form-grid">
                                            <div class="zyw-field zyw-field--wide">
                                                <label>الاسم</label>
                                                <input name="name" value="@category.Name" required />
                                            </div>
                                            <div class="zyw-field">
                                                <label>الترتيب</label>
                                                <input name="displayOrder" type="number" value="@category.DisplayOrder" />
                                            </div>
                                            <div class="zyw-field zyw-field--wide">
                                                <label>الوصف</label>
                                                <input name="description" value="@category.Description" />
                                            </div>
                                            <div class="zyw-field zyw-checks">
                                                <label><input type="checkbox" name="isActive" value="true" checked="@category.IsActive" /> فعّالة</label>
                                            </div>
                                        </div>
                                        <div class="zyw-form-actions">
                                            <button type="submit" class="btn-primary">حفظ</button>
                                        </div>
                                    </form>
                                </details>
                            }
                        </div>
                    </article>

                    <article class="zy-card">
                        <div class="zyw-queue-head">
                            <h2>المخالفات</h2>
                            <span class="zy-pill">@visibleTypes.Count</span>
                        </div>
                        <p class="zyw-row-meta">لكلٍّ خطورة وصلاحية وفترة تكرار — ومنها يُحتسب الجزاء.</p>

                        <form method="post" asp-page-handler="CreateViolationType">
                            <div class="zyw-form-grid">
                                <div class="zyw-field">
                                    <label for="vt-cat">الفئة</label>
                                    <select id="vt-cat" name="categoryId" required>
                                        <option value="">اختر الفئة</option>
                                        @foreach (var category in Model.Categories.Where(x => x.IsActive))
                                        {
                                            <option value="@category.Id" selected="@(selectedCategory == category.Id)">@category.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="zyw-field">
                                    <label for="vt-sev">الخطورة</label>
                                    <select id="vt-sev" name="severity">
                                        <option value="A">A — بسيطة</option>
                                        <option value="B" selected>B — متوسطة</option>
                                        <option value="C">C — جسيمة</option>
                                        <option value="FinalWarning">إنذار بالفصل</option>
                                    </select>
                                </div>
                                <div class="zyw-field">
                                    <label for="vt-valid">الصلاحية (شهر)</label>
                                    <input id="vt-valid" name="validityMonths" type="number" min="1" value="6" />
                                </div>
                                <div class="zyw-field">
                                    <label for="vt-period">فترة التكرار</label>
                                    <select id="vt-period" name="countingPeriod">
                                        <option value="Monthly" selected>شهرية</option>
                                        <option value="SixMonths">خلال 6 أشهر</option>
                                        <option value="Yearly">خلال سنة</option>
                                        <option value="Contract">مدة العقد</option>
                                    </select>
                                </div>
                                <div class="zyw-field zyw-field--wide">
                                    <label for="vt-name">اسم المخالفة</label>
                                    <input id="vt-name" name="name" required placeholder="الإهمال في المحافظة على أصول الشركة" />
                                </div>
                                <div class="zyw-field zyw-field--wide">
                                    <label for="vt-desc">الوصف</label>
                                    <input id="vt-desc" name="description" placeholder="استخدام معدات الزملاء دون إذن أو إتلافها" />
                                </div>
                                <div class="zyw-field zyw-field--wide zyw-checks">
                                    <label><input type="checkbox" name="includeInEvaluation" value="true" checked /> تدخل بالتقييم</label>
                                    <label><input type="checkbox" name="showToEmployee" value="true" checked /> تظهر للموظف</label>
                                    <label><input type="checkbox" name="isActive" value="true" checked /> فعّالة</label>
                                </div>
                            </div>
                            <div class="zyw-form-actions">
                                <button type="submit" class="btn-primary">إضافة مخالفة</button>
                            </div>
                        </form>

                        <div class="zyw-list">
                            @foreach (var violation in visibleTypes)
                            {
                                <details class="zyw-acc @(violation.IsActive ? "" : "disabled")">
                                    <summary>
                                        <span>@Model.DisplaySeverityShort(violation.Severity)</span>
                                        <strong>@violation.Name</strong>
                                        <small>@violation.CategoryName · @violation.RulesCount جزاء</small>
                                    </summary>
                                    <form method="post" asp-page-handler="UpdateViolationType">
                                        <input type="hidden" name="id" value="@violation.Id" />
                                        <div class="zyw-form-grid">
                                            <div class="zyw-field">
                                                <label>الفئة</label>
                                                <select name="categoryId">
                                                    @foreach (var category in Model.Categories)
                                                    {
                                                        <option value="@category.Id" selected="@(category.Id == violation.CategoryId)">@category.Name</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="zyw-field">
                                                <label>الخطورة</label>
                                                <select name="severity">
                                                    <option value="A" selected="@(violation.Severity == "A")">A — بسيطة</option>
                                                    <option value="B" selected="@(violation.Severity == "B")">B — متوسطة</option>
                                                    <option value="C" selected="@(violation.Severity == "C")">C — جسيمة</option>
                                                    <option value="FinalWarning" selected="@(violation.Severity == "FinalWarning")">إنذار بالفصل</option>
                                                </select>
                                            </div>
                                            <div class="zyw-field">
                                                <label>الصلاحية</label>
                                                <input name="validityMonths" type="number" min="1" value="@violation.ValidityMonths" />
                                            </div>
                                            <div class="zyw-field">
                                                <label>فترة التكرار</label>
                                                <select name="countingPeriod">
                                                    <option value="Monthly" selected="@(violation.CountingPeriod == "Monthly")">شهرية</option>
                                                    <option value="SixMonths" selected="@(violation.CountingPeriod == "SixMonths")">خلال 6 أشهر</option>
                                                    <option value="Yearly" selected="@(violation.CountingPeriod == "Yearly")">خلال سنة</option>
                                                    <option value="Contract" selected="@(violation.CountingPeriod == "Contract")">مدة العقد</option>
                                                </select>
                                            </div>
                                            <div class="zyw-field zyw-field--wide">
                                                <label>الاسم</label>
                                                <input name="name" value="@violation.Name" required />
                                            </div>
                                            <div class="zyw-field zyw-field--wide">
                                                <label>الوصف</label>
                                                <input name="description" value="@violation.Description" />
                                            </div>
                                            <div class="zyw-field zyw-field--wide zyw-checks">
                                                <label><input type="checkbox" name="includeInEvaluation" value="true" checked="@violation.IncludeInEvaluation" /> تدخل بالتقييم</label>
                                                <label><input type="checkbox" name="showToEmployee" value="true" checked="@violation.ShowToEmployee" /> تظهر للموظف</label>
                                                <label><input type="checkbox" name="isActive" value="true" checked="@violation.IsActive" /> فعّالة</label>
                                            </div>
                                        </div>
                                        <div class="zyw-form-actions">
                                            <button type="submit" class="btn-primary">حفظ</button>
                                        </div>
                                    </form>
                                </details>
                            }
                        </div>
                    </article>
                </div>

                <article class="zy-card">
                    <div class="zyw-queue-head">
                        <h2>سلّم الجزاءات</h2>
                        <span class="zy-pill">@visibleRules.Count</span>
                    </div>
                    <p class="zyw-row-meta">
                        ماذا يحدث بالتكرار الأول والثاني والثالث — ومن هنا يأتي الأثر المالي بالقسيمة.
                    </p>

                    <form method="post" asp-page-handler="CreatePenaltyRule">
                        <div class="zyw-form-grid">
                            <div class="zyw-field">
                                <label for="pr-cat">الفئة</label>
                                <select id="pr-cat" name="categoryFilter" data-zyw-rule-category>
                                    <option value="">كل الفئات</option>
                                    @foreach (var category in Model.Categories.Where(x => x.IsActive))
                                    {
                                        <option value="@category.Id" selected="@(selectedCategory == category.Id)">@category.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="zyw-field zyw-field--wide">
                                <label for="pr-violation">المخالفة</label>
                                <select id="pr-violation" name="violationTypeId" required data-zyw-rule-violation>
                                    <option value="">اختر المخالفة</option>
                                    @foreach (var violation in Model.ViolationTypes.Where(x => x.IsActive))
                                    {
                                        <option value="@violation.Id" data-category="@violation.CategoryId">@violation.CategoryName — @violation.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="zyw-field">
                                <label for="pr-from">من تكرار</label>
                                <input id="pr-from" name="occurrenceFrom" type="number" min="1" value="1" required />
                            </div>
                            <div class="zyw-field">
                                <label for="pr-to">إلى تكرار</label>
                                <input id="pr-to" name="occurrenceTo" type="number" min="1" value="1" required />
                            </div>
                            <div class="zyw-field">
                                <label for="pr-period">فترة الاحتساب</label>
                                <select id="pr-period" name="countingPeriod">
                                    <option value="Monthly" selected>شهرية</option>
                                    <option value="SixMonths">خلال 6 أشهر</option>
                                    <option value="Yearly">خلال سنة</option>
                                    <option value="Contract">مدة العقد</option>
                                </select>
                            </div>
                            <div class="zyw-field zyw-field--wide">
                                <label for="pr-action">العقوبة</label>
                                <input id="pr-action" name="penaltyAction" required placeholder="خصم نصف يوم من الراتب" />
                            </div>
                            <div class="zyw-field">
                                <label for="pr-impact">الأثر المالي</label>
                                <select id="pr-impact" name="financialImpactType">
                                    <option value="None">لا يوجد</option>
                                    <option value="Days" selected>أيام</option>
                                    <option value="Hours">ساعات</option>
                                    <option value="Amount">مبلغ ثابت</option>
                                </select>
                            </div>
                            <div class="zyw-field">
                                <label for="pr-value">قيمة الأثر</label>
                                <input id="pr-value" name="financialValue" type="number" step="0.01" value="0.5" />
                            </div>
                            <div class="zyw-field">
                                <label for="pr-valid">صلاحية الجزاء</label>
                                <input id="pr-valid" name="validityMonths" type="number" min="1" value="6" />
                            </div>
                            <div class="zyw-field">
                                <label for="pr-mode">طريقة الاحتساب</label>
                                <select id="pr-mode" name="calculationMode">
                                    <option value="Cumulative" selected>تراكمي</option>
                                    <option value="ReplacePrevious">استبدال السابق</option>
                                    <option value="DifferenceOnly">فرق فقط</option>
                                </select>
                            </div>
                            <div class="zyw-field zyw-checks">
                                <label><input type="checkbox" name="requiresApproval" value="true" /> اعتماد إضافي</label>
                            </div>
                        </div>
                        <div class="zyw-form-actions">
                            <button type="submit" class="btn-primary">إضافة جزاء</button>
                        </div>
                    </form>

                    <div class="zyw-list">
                        @foreach (var rule in visibleRules)
                        {
                            <details class="zyw-acc">
                                <summary>
                                    <span>@Model.DisplayOccurrenceRange(rule.OccurrenceFrom, rule.OccurrenceTo)</span>
                                    <strong>@rule.PenaltyAction</strong>
                                    <small>@rule.ViolationName · @Model.DisplayFinancialImpact(rule.FinancialImpactType, rule.FinancialValue)</small>
                                </summary>
                                <form method="post" asp-page-handler="UpdatePenaltyRule">
                                    <input type="hidden" name="id" value="@rule.Id" />
                                    <div class="zyw-form-grid">
                                        <div class="zyw-field zyw-field--wide">
                                            <label>المخالفة</label>
                                            <select name="violationTypeId">
                                                @foreach (var violation in Model.ViolationTypes)
                                                {
                                                    <option value="@violation.Id" selected="@(violation.Id == rule.ViolationTypeId)">@violation.CategoryName — @violation.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="zyw-field">
                                            <label>من</label>
                                            <input name="occurrenceFrom" type="number" min="1" value="@rule.OccurrenceFrom" />
                                        </div>
                                        <div class="zyw-field">
                                            <label>إلى</label>
                                            <input name="occurrenceTo" type="number" min="1" value="@rule.OccurrenceTo" />
                                        </div>
                                        <div class="zyw-field">
                                            <label>فترة الاحتساب</label>
                                            <select name="countingPeriod">
                                                <option value="Monthly" selected="@(rule.CountingPeriod == "Monthly")">شهرية</option>
                                                <option value="SixMonths" selected="@(rule.CountingPeriod == "SixMonths")">خلال 6 أشهر</option>
                                                <option value="Yearly" selected="@(rule.CountingPeriod == "Yearly")">خلال سنة</option>
                                                <option value="Contract" selected="@(rule.CountingPeriod == "Contract")">مدة العقد</option>
                                            </select>
                                        </div>
                                        <div class="zyw-field">
                                            <label>طريقة الاحتساب</label>
                                            <select name="calculationMode">
                                                <option value="Cumulative" selected="@(rule.CalculationMode == "Cumulative")">تراكمي</option>
                                                <option value="ReplacePrevious" selected="@(rule.CalculationMode == "ReplacePrevious")">استبدال السابق</option>
                                                <option value="DifferenceOnly" selected="@(rule.CalculationMode == "DifferenceOnly")">فرق فقط</option>
                                            </select>
                                        </div>
                                        <div class="zyw-field zyw-field--wide">
                                            <label>العقوبة</label>
                                            <input name="penaltyAction" value="@rule.PenaltyAction" required />
                                        </div>
                                        <div class="zyw-field">
                                            <label>الأثر المالي</label>
                                            <select name="financialImpactType">
                                                <option value="None" selected="@(rule.FinancialImpactType == "None")">لا يوجد</option>
                                                <option value="Days" selected="@(rule.FinancialImpactType == "Days")">أيام</option>
                                                <option value="Hours" selected="@(rule.FinancialImpactType == "Hours")">ساعات</option>
                                                <option value="Amount" selected="@(rule.FinancialImpactType == "Amount")">مبلغ ثابت</option>
                                            </select>
                                        </div>
                                        <div class="zyw-field">
                                            <label>قيمة الأثر</label>
                                            <input name="financialValue" type="number" step="0.01" value="@rule.FinancialValue" />
                                        </div>
                                        <div class="zyw-field">
                                            <label>الصلاحية</label>
                                            <input name="validityMonths" type="number" min="1" value="@rule.ValidityMonths" />
                                        </div>
                                        <div class="zyw-field zyw-checks">
                                            <label><input type="checkbox" name="requiresApproval" value="true" checked="@rule.RequiresApproval" /> اعتماد إضافي</label>
                                        </div>
                                    </div>
                                    <div class="zyw-form-actions">
                                        <button type="submit" class="btn-primary">حفظ</button>

@page
@model SmartAttendance.Web.Pages.UserAccess.IndexModel

@*
    إدارة مستخدمي النظام — أعيد تصميمها بنمط كيان (2026-07):
    شريط عنوان بعدادات ← فلاتر ← جدول هويات نظيف ← سلايد إنشاء/تعديل.
    كل المعالجات بالـ PageModel كما هي (Save/Toggle + تعبئة التعديل عبر
    EditLoginId/EditSystemUserId بالسيرفر) — هذه الواجهة عرض وتفاعل فقط.
*@

@{
    ViewData["Title"] = "إدارة مستخدمي النظام";
}

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/zynora-user-access.css" asp-append-version="true" />

<style>
    .zua-bulk-bar { border:1px solid var(--zua-line); border-radius:18px; padding:14px 18px; margin:0 0 14px; }
    .zua-bulk-title { display:flex; align-items:center; gap:12px; margin-bottom:12px; }
    .zua-bulk-title b { font-size:14px; }
    .zua-bulk-title #zua-bulk-count { color:var(--zua-muted); font-size:12px; font-weight:800; }
    .zua-bulk-fields { display:flex; flex-wrap:wrap; align-items:end; gap:12px; }
    .zua-bulk-fields label { display:flex; flex-direction:column; gap:6px; font-size:12px; font-weight:800; color:var(--zua-muted); }
    .zua-bulk-fields input[type=password] { min-height:38px; padding:0 12px; border:1px solid var(--zua-line); border-radius:12px; background:transparent; color:inherit; min-width:190px; }
    .zua-bulk-codes { display:flex; flex-direction:column; gap:6px; font-size:12px; font-weight:800; color:var(--zua-muted); margin-bottom:8px; }
    .zua-bulk-codes textarea { border:1px solid var(--zua-line); border-radius:12px; background:transparent; color:inherit; padding:10px 12px; resize:vertical; font-family:inherit; }
    .zua-bulk-check { flex-direction:row !important; align-items:center; gap:8px; color:var(--zua-muted); }
    .zua-bulk-check input { min-height:auto; }
</style>

<section class="zua-page" dir="rtl">

    @* ---------- العنوان + العدادات ---------- *@
    <header class="zua-head">
        <div>
            <h1>إدارة مستخدمي النظام</h1>
            <p>حسابات الدخول وهويات الصلاحيات وربطها بالموظفين — بمكان واحد.</p>
        </div>
        <div class="zua-stats">
            <div class="zua-stat"><b>@Model.TotalCount</b><span>إجمالي الهويات</span></div>
            <div class="zua-stat ok"><b>@Model.LinkedCount</b><span>مرتبط صحيح</span></div>
            <div class="zua-stat warn"><b>@Model.NeedsReviewCount</b><span>يحتاج مراجعة</span></div>
            <div class="zua-stat"><b>@Model.Identities.Count(x => x.IsActive)</b><span>فعال</span></div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="zua-alert">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.PageError))
    {
        <div class="zua-alert error">@Model.PageError</div>
    }

    @* ---------- الفلاتر + زر الإنشاء ---------- *@
    <form method="get" class="zua-filters">
        <input type="search" name="Search" value="@Model.Search" placeholder="بحث بالاسم، اسم المستخدم، الموظف..." />
        <select name="Status" onchange="this.form.submit()">
            <option value="">جميع الحالات</option>
            <option value="linked" selected="@(Model.Status == "linked")">مرتبط بشكل صحيح</option>
            <option value="review" selected="@(Model.Status == "review")">يحتاج مراجعة</option>
            <option value="active" selected="@(Model.Status == "active")">فعال</option>
            <option value="inactive" selected="@(Model.Status == "inactive")">معطل</option>
        </select>
        <button type="submit" class="zua-btn ghost">بحث</button>
        <button type="button" class="zua-btn" onclick="zuaOpenCreate()">+ مستخدم جديد</button>
    </form>

    @* ---------- شريط الإجراء الجماعيّ: إعادة تعيين كلمة المرور ---------- *@
    <form method="post" asp-page-handler="BulkResetPassword" id="zua-bulk"
          class="zua-bulk-bar" data-zyconfirm="تأكيد؟ اضغط «تطبيق» مرّة أخرى">
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="Status" value="@Model.Status" />
        <div class="zua-bulk-title">
            <b>إعادة تعيين كلمة المرور جماعيّاً</b>
            <span id="zua-bulk-count">لم تُحدَّد حسابات</span>
        </div>
        <label class="zua-bulk-codes">أكواد الموظفين (اختياري — الصقها مفصولةً بمسافة أو سطر أو فاصلة)
            <textarea name="BulkEmployeeCodes" rows="2" dir="ltr"
                      placeholder="11230 10000 10521 ..." oninput="zuaBulkCount()"></textarea>
        </label>
        <span class="hint" style="display:block;margin:-4px 0 8px">من لا حساب دخول له من هذه الأكواد يُنشأ له حساب «موظف» تلقائيّاً (اسم المستخدم = كوده).</span>
        <div class="zua-bulk-fields">
                <label>كلمة مرور مؤقّتة
                    <input type="password" name="BulkPassword" dir="ltr" minlength="8"
                           autocomplete="new-password" placeholder="8 أحرف على الأقل" />
                </label>
                <label>تأكيد الكلمة
                    <input type="password" name="BulkConfirmPassword" dir="ltr"
                           autocomplete="new-password" />
                </label>
                <label class="zua-bulk-check">
                    <input type="checkbox" name="BulkKickSessions" value="true" />
                    طرد جلساتهم الحاليّة فوراً
                </label>
                <label class="zua-bulk-check">
                    <input type="checkbox" name="BulkForceChange" value="true" checked />
                    إجبار تغييرها عند أول دخول
                </label>
                <button type="submit" class="zua-btn">تطبيق</button>
            </div>
            <label class="zua-bulk-check" style="margin-top:10px;color:var(--zua-amber);font-weight:800">
                <input type="checkbox" name="BulkAllNoAccount" value="true" onchange="zuaBulkCount()" />
                إنشاء حساب «موظف» لكل الموظّفين الفعّالين بلا حساب (اسم المستخدم = كود الموظّف)
            </label>
            <p class="hint" style="margin:6px 0 0">
                يُطبَّق على الحسابات المحدَّدة في الجدول أو المُلصقة بالأكواد، ويُطلب من كلٍّ تغييرها عند الدخول التالي. حسابك الشخصي مُستثنى.
            </p>
        </form>

    @if (Model.NoAccountTotal > Model.NoAccountShown)
    {
        <div class="zua-alert" style="background:rgba(18,217,227,.08)">
            يوجد @Model.NoAccountTotal موظّف بلا حساب دخول — يُعرض منهم @Model.NoAccountShown فقط لأداء أفضل.
            ابحث بالاسم أو الكود بالأعلى لإيجاد موظّفٍ بعينه، أو الصق أكواد الموظّفين في أداة كلمة المرور لإنشاء حساباتهم دفعةً واحدة.
        </div>
    }

    @* ---------- الجدول ---------- *@
    <div class="zua-table-card">
        @if (Model.Identities.Count == 0)
        {
            <div class="zua-empty">لا هويات مطابقة للفلاتر الحالية.</div>
        }
        else
        {
            <table class="zua-table">
                <thead>
                    <tr>
                        <th style="width:34px">
                            <input type="checkbox" id="zua-select-all" title="تحديد الكل"
                                   onclick="zuaToggleAll(this)" />
                        </th>
                        <th>المستخدم</th>
                        <th>الموظف المرتبط</th>
                        <th>الدور</th>
                        <th>حالة الربط</th>
                        <th>الحالة</th>
                        <th>آخر دخول</th>
                        <th style="text-align:end">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Identities)
                    {
                        <tr>
                            <td>
                                @if (row.LoginId > 0 && row.LoginId != Model.CurrentLoginId)
                                {
                                    <input type="checkbox" class="zua-row-check" form="zua-bulk"
                                           name="SelectedLoginIds" value="@row.LoginId"
                                           onchange="zuaBulkCount()" />
                                }
                                else if (row.LinkStatus == SmartAttendance.Web.Pages.UserAccess.IndexModel.IdentityLinkStatus.NoAccount
                                         && !string.IsNullOrWhiteSpace(row.EmployeeNo))
                                {
                                    <input type="checkbox" class="zua-row-check" form="zua-bulk"
                                           name="SelectedEmployeeCodes" value="@row.EmployeeNo"
                                           onchange="zuaBulkCount()" title="سيُنشأ حساب موظف عند التطبيق" />
                                }
                            </td>
                            <td>
                                <div class="zua-user">
                                    <span class="zua-avatar">@(string.IsNullOrWhiteSpace(row.DisplayName) ? "؟" : row.DisplayName.Trim()[..1])</span>
                                    <div>
                                        <b>@row.DisplayName</b>
                                        <small>@row.UserName</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (row.EmployeeId.HasValue && !string.IsNullOrWhiteSpace(row.EmployeeName))
                                {
                                    <a href="/Employees/Profile?id=@row.EmployeeId" style="color:var(--zua-teal);text-decoration:none;font-weight:800">@row.EmployeeName</a>
                                    <small style="color:var(--zua-muted)"> @row.EmployeeNo</small>
                                }
                                else
                                {
                                    <span style="color:var(--zua-muted)">بلا ربط</span>
                                }
                            </td>
                            <td><span class="zua-chip role">@row.CompatibilityRole</span></td>
                            <td><span class="zua-chip @row.StatusCss">@row.StatusLabel</span></td>
                            <td><span class="zua-chip @(row.IsActive ? "on" : "off")">@(row.IsActive ? "فعال" : "معطل")</span></td>
                            <td style="direction:ltr;text-align:end;font-size:12px;color:var(--zua-muted)">
                                @(row.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
                            </td>
                            <td>
                                <div class="zua-actions">
                                    @if (row.CanEdit)
                                    {
                                        <a class="zua-btn ghost" style="display:inline-flex;align-items:center;text-decoration:none"
                                           href="?EditLoginId=@row.LoginId&EditSystemUserId=@row.SystemUserId&Search=@Model.Search&Status=@Model.Status">تعديل</a>
                                    }
                                    @if (row.LinkStatus == SmartAttendance.Web.Pages.UserAccess.IndexModel.IdentityLinkStatus.NoAccount && row.EmployeeId.HasValue)
                                    {
                                        <a class="zua-btn" style="display:inline-flex;align-items:center;text-decoration:none"
                                           href="?CreateEmployeeId=@row.EmployeeId&Search=@Model.Search&Status=@Model.Status">إنشاء حساب</a>
                                    }
                                    @if (row.CanToggle)
                                    {
                                        <form method="post" asp-page-handler="Toggle" style="display:inline">
                                            <input type="hidden" name="loginId" value="@row.LoginId" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <input type="hidden" name="status" value="@Model.Status" />
                                            <button type="submit" class="zua-btn ghost">@(row.IsActive ? "تعطيل" : "تفعيل")</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* ---------- سلايد الإنشاء/التعديل (نفس نمط سلايدات الملف 360°) ---------- *@
    <div class="hrms-slideover-backdrop" id="zua-backdrop" onclick="zuaClose()"></div>
    <aside class="hrms-slideover" id="zua-slide" aria-hidden="true">
        <div class="hrms-slideover-head">
            <h2 id="zua-slide-title">@(Model.Input.IsEditing ? "تعديل الحساب" : "حساب جديد")</h2>
            <button type="button" class="hrms-slideover-close" onclick="zuaClose()">×</button>
        </div>
        <div class="hrms-slideover-body">
            <form method="post" asp-page-handler="Save" class="zua-form">
                <input type="hidden" asp-for="Input.LoginId" />
                <input type="hidden" asp-for="Input.SystemUserId" />
                <input type="hidden" name="Search" value="@Model.Search" />
                <input type="hidden" name="Status" value="@Model.Status" />

                @* المنتقي المشترك (رمز + اسم). الحقل اختياري: تركه فارغاً = بلا ربط.
                   ⚠️ سقطت معه شارة «· مرتبط» التي كانت بالمنسدلة — والإنفاذ لم
                   يسقط: الحفظ يرفض موظفاً مرتبطاً مسبقاً برسالةٍ صريحة، فالشارة
                   كانت تسهيلاً لا حارساً. *@
                <partial name="_EmployeePicker" model="@(new SmartAttendance.Web.Pages.Shared.EmployeePickerModel {
                    Label = "الموظف المرتبط (اختياري)",
                    Name = "Input.EmployeeId",
                    SelectedId = Model.Input.EmployeeId ?? 0,
                    SelectedCode = Model.SelectedEmployeeCode,
                    SelectedName = Model.SelectedEmployeeName
                })" />
                <span class="hint">عند اختيار موظف يُعتمد اسمه تلقائياً إن تُرك الاسم فارغاً. اتركه فارغاً لحسابٍ بلا ربط.</span>

                <div class="row2">
                    <label>الاسم الكامل
                        <input asp-for="Input.FullName" placeholder="اسم العرض" />
                    </label>
                    <label>اسم المستخدم *
                        <input asp-for="Input.UserName" required dir="ltr" placeholder="username" />
                    </label>
                </div>

                <div class="row2">
                    <label>البريد الإلكتروني
                        <input asp-for="Input.Email" type="email" dir="ltr" placeholder="user@company.com" />
                    </label>
                    <label>الدور
                        <select asp-for="Input.CompatibilityRole">
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.Value">@role.Label</option>
                            }
                        </select>
                    </label>
                </div>

                <div class="row2">
                    <label>كلمة المرور @(Model.Input.IsEditing ? "(فارغة = بلا تغيير)" : "*")
                        <input asp-for="Input.Password" type="password" dir="ltr" autocomplete="new-password" />
                    </label>
                    <label>تأكيد كلمة المرور
                        <input asp-for="Input.ConfirmPassword" type="password" dir="ltr" autocomplete="new-password" />
                    </label>
                </div>

                <label>ملاحظات
                    <textarea asp-for="Input.Notes" rows="2"></textarea>
                </label>

                <label style="flex-direction:row;align-items:center;gap:8px">
                    <input asp-for="Input.IsActive" type="checkbox" style="min-height:auto" /> الحساب فعال
                </label>

                <button type="submit" class="zua-btn">@(Model.Input.IsEditing ? "حفظ التعديلات" : "إنشاء الحساب")</button>
            </form>
        </div>
    </aside>
</section>

@section Scripts {
    <script>
        // فتح/إغلاق سلايد الحساب — التعديل يفتح تلقائياً عندما يعبّئه السيرفر (EditLoginId).
        function zuaOpen() {
            document.getElementById('zua-slide').classList.add('open');
            document.getElementById('zua-backdrop').classList.add('open');
        }
        function zuaClose() {
            document.getElementById('zua-slide').classList.remove('open');
            document.getElementById('zua-backdrop').classList.remove('open');
        }
        function zuaOpenCreate() {
            var form = document.querySelector('#zua-slide form');
            form.reset();
            document.getElementById('Input_LoginId').value = '0';
            document.getElementById('Input_SystemUserId').value = '0';
            document.getElementById('zua-slide-title').textContent = 'حساب جديد';
            zuaOpen();
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') zuaClose(); });

        // ---- التحديد الجماعيّ لإعادة تعيين كلمة المرور ----
        function zuaRowChecks() {
            return Array.prototype.slice.call(document.querySelectorAll('.zua-row-check'));
        }
        function zuaToggleAll(master) {
            zuaRowChecks().forEach(function (c) { c.checked = master.checked; });
            zuaBulkCount();
        }
        function zuaCodeCount() {
            var ta = document.querySelector('#zua-bulk textarea[name=BulkEmployeeCodes]');
            if (!ta || !ta.value.trim()) { return 0; }
            return ta.value.split(/[\s,;،]+/).filter(function (s) { return s.trim().length; }).length;
        }
        function zuaBulkCount() {
            var n = zuaRowChecks().filter(function (c) { return c.checked; }).length;
            var codes = zuaCodeCount();
            var label = document.getElementById('zua-bulk-count');
            if (label) {
                var parts = [];
                if (n > 0) { parts.push('محدَّدون: ' + n); }
                if (codes > 0) { parts.push('أكواد ملصوقة: ' + codes); }
                label.textContent = parts.length ? parts.join(' · ') : 'لم تُحدَّد حسابات';
            }
            var master = document.getElementById('zua-select-all');
            if (master) {
                var all = zuaRowChecks();
                master.checked = all.length > 0 && n === all.length;
                master.indeterminate = n > 0 && n < all.length;
            }
        }
        function zuaAllNoAccount() {
            var c = document.querySelector('#zua-bulk input[name=BulkAllNoAccount]');
            return !!(c && c.checked);
        }
        function zuaBulkConfirm() {
            var n = zuaRowChecks().filter(function (c) { return c.checked; }).length;
            var codes = zuaCodeCount();
            var all = zuaAllNoAccount();
            if (n === 0 && codes === 0 && !all) {
                alert('حدِّد حساباً من الجدول، أو الصق أكواد، أو فعّل «إنشاء حساب للجميع».');
                return false;
            }
            if (all) {
                return confirm('سيتم إنشاء حساب «موظف» لكل الموظّفين الفعّالين بلا حساب (اسم المستخدم = كود كلٍّ) بكلمة المرور المُدخلة. متابعة؟');
            }
            var total = n + codes;
            return confirm('إعادة تعيين كلمة المرور لـ' + total + ' حساب (المحدَّد + الملصوق)؟ من لا حساب له من الأكواد سيُنشأ له حساب «موظف».');
        }

        @if (Model.Input.IsEditing || Model.OpenCreate)
        {
            @:zuaOpen();
        }
    </script>
}

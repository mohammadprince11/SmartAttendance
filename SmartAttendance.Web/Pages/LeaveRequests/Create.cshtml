@page
@model SmartAttendance.Web.Pages.LeaveRequests.CreateModel

@{
    ViewData["Title"] = "إضافة إجازة معتمدة";
}

<div class="page-header">
    <div>
        <h1>إضافة إجازة معتمدة</h1>
        <p>تسجيل إجازة معتمدة لموظف مباشرة</p>
    </div>

    <a asp-page="./Index" class="btn-secondary">رجوع للقائمة</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert-danger">
        @Model.ErrorMessage
    </div>
}

<div class="form-card">
    <form method="post">
        <div class="form-group">
            @* المنتقي المشترك (رمز + اسم) بدل منسدلةٍ تحمّل كل الموظفين بكل فتحة *@
            <partial name="_EmployeePicker" model="@(new SmartAttendance.Web.Pages.Shared.EmployeePickerModel {
                Label = "الموظف",
                Name = "LeaveRequest.EmployeeId",
                SelectedId = Model.LeaveRequest.EmployeeId,
                SelectedCode = Model.SelectedEmployeeCode,
                SelectedName = Model.SelectedEmployeeName
            })" />
            <span asp-validation-for="LeaveRequest.EmployeeId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LeaveRequest.LeaveType">نوع الإجازة</label>
            <select asp-for="LeaveRequest.LeaveType" asp-items="Model.LeaveTypes" class="form-control"></select>
            <span asp-validation-for="LeaveRequest.LeaveType" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LeaveRequest.FromDate">من تاريخ</label>
            <input asp-for="LeaveRequest.FromDate" type="date" class="form-control" />
            <span asp-validation-for="LeaveRequest.FromDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LeaveRequest.ToDate">إلى تاريخ</label>
            <input asp-for="LeaveRequest.ToDate" type="date" class="form-control" />
            <span asp-validation-for="LeaveRequest.ToDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LeaveRequest.Reason">السبب</label>
            <input asp-for="LeaveRequest.Reason" class="form-control" />
            <span asp-validation-for="LeaveRequest.Reason" class="text-danger"></span>
        </div>

        <div class="alert-success">
            تُحفظ الحالة تلقائياً كـ«معتمدة».
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">حفظ</button>
            <a asp-page="./Index" class="btn-secondary">إلغاء</a>
        </div>
    </form>
</div>

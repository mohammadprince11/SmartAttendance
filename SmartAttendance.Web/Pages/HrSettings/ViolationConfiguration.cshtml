@page
@model SmartAttendance.Web.Pages.HrSettings.ViolationConfigurationModel

@{
    ViewData["Title"] = "تهيئة المخالفات";
}
<link rel="stylesheet" href="~/css/pages/violationconfiguration-04ead15ab3.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/zynora-hr-settings-v16.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/zynora-conditions.css" asp-append-version="true" />

<section class="nxhs-page" dir="rtl">
    <header class="nxhs-titlebar">
        <a asp-page="./Index">إعدادات الموارد البشرية</a>
        <h1>تهيئة المخالفات</h1>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="nxhs-alert">@TempData["SuccessMessage"]</div>
    }

    <form method="post" class="nxhs-panel zyp-editor">
        <h3>ضمانات الانضباط</h3>
        <p class="zyp-hint">
            كل التواريخ تُحسب من <b>تاريخ التبليغ</b> لا من تاريخ وقوع المخالفة —
            المهلة تبدأ حين يَعلم الموظف، وهذا فرق يحسم الطعون.
        </p>

        <div class="zyp-editor-grid">
            <label>
                مهلة الاعتراض (يوم) — صفر = لا اعتراض
                <input asp-for="ObjectionDays" type="number" min="0" />
            </label>
            <label>
                إلزام أخذ ردّ الموظف قبل القرار
                <select asp-for="RequireEmployeeReply">
                    <option value="false">لا</option>
                    <option value="true">نعم</option>
                </select>
            </label>
            <label>
                مهلة الردّ (يوم)
                <input asp-for="ReplyDays" type="number" min="0" />
            </label>
            <label>
                إلزام موافقة لجنة
                <select asp-for="RequireCommitteeApproval">
                    <option value="false">لا</option>
                    <option value="true">نعم</option>
                </select>
            </label>
            <label>
                مدّة إسقاط العقوبة (شهر) — صفر = لا تسقط
                <input asp-for="DropMonths" type="number" min="0" />
            </label>
            <label>
                بادئة الرقم المرجعي
                <input asp-for="RefPrefix" placeholder="VC" />
            </label>
        </div>

        <p class="zyp-hint">
            <b>لماذا يهمّ الإسقاط؟</b> العقوبة الساقطة لا تُحتسب بتدرّج العقوبة اللاحق.
            بلا مدّة، يُعاقَب الموظف اليوم كمكرِّر بسبب مخالفةٍ عمرها ثلاث سنوات.
            @if (Model.DropMonths > 0)
            {
                <b> — بالمدّة الحالية: @Model.DroppedByCurrentSetting من @Model.TotalCases حالة ساقطة أصلاً.</b>
            }
            else
            {
                <span> — الآن: لا تسقط أي عقوبة (سلوك النظام الحالي، بلا تغيير).</span>
            }
        </p>

        <footer class="nxhs-actions">
            <button type="submit">حفظ التهيئة</button>
        </footer>
    </form>

    <div class="nxhs-panel zyp-copies">
        <header>
            <span>السند النظامي</span>
            <h2>رقم الفقرة من لائحة الجزاءات</h2>
            <p class="zyp-hint">
                لكل نوع مخالفة سندُه بلائحة الجزاءات — يُذكر بكتاب العقوبة.
                وهو <b>نفس الحقل</b> الذي تحرّره بعمود «الفقرة» في
                <a asp-page="/DisciplinaryRules/Index" asp-route-tab="library">لائحة المخالفات</a>؛
                ما تكتبه هنا يظهر هناك والعكس.
            </p>
            @if (Model.TotalTypes > 0)
            {
                <p class="zyp-hint">
                    يُعرض <b>@Model.FirstIndex–@Model.LastIndex</b> من <b>@Model.TotalTypes</b> نوعاً
                    @if (Model.PageCount > 1)
                    {
                        <text>· صفحة <b>@Model.CurrentPage</b> من <b>@Model.PageCount</b></text>
                    }
                </p>
            }
        </header>

        @if (Model.ViolationTypes.Count == 0)
        {
            <p class="zyc-empty">
                لا أنواع مخالفات معرَّفة — عرّفها أولاً من
                <a asp-page="/DisciplinaryRules/Index">قواعد الانضباط</a>.
            </p>
        }
        else
        {
            <table class="zyp-table">
                <thead>
                    <tr>
                        <th>نوع المخالفة</th>
                        <th class="zyu-e104eb5fa217">رقم الفقرة</th>
                        <th class="zyu-5a5f7abe4163"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (id, name, clause) in Model.ViolationTypes)
                    {
                        <tr>
                            <td><b>@name</b></td>
                            <td colspan="2">
                                <form method="post" asp-page-handler="Clause" class="zyu-9c40389b4ad8">
                                                    <input type="hidden" name="id" value="@id" />
                                    @* الصفحة تُمرَّر مع الحفظ كي تعود إليها لا إلى الأولى. *@
                                    <input type="hidden" name="pageNo" value="@Model.CurrentPage" />
                                    <input name="clause" value="@clause" placeholder="مثال: المادة 12 / فقرة ب"
                                           class="zyu-45fd55b81692" />
                                    <button type="submit" class="zyc-add-rule zyu-8ede280590c3">حفظ</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @* ⚠️ **روابط لا أزرار**: كل صفٍّ بالجدول نموذجُ حفظٍ مستقلّ، وزرُّ
               تصفّحٍ داخل الصفحة كان سيُرسل أحدها بالخطأ. والرابط يحمل رقم
               الصفحة بالمسار فيبقى قابلاً للمشاركة والرجوع. *@
            @if (Model.PageCount > 1)
            {
                <nav class="zyp-pager" aria-label="تصفّح أنواع المخالفات">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-page="./ViolationConfiguration" asp-route-pageNo="@(Model.CurrentPage - 1)" rel="prev">‹ السابق</a>
                    }

                    @for (var number = 1; number <= Model.PageCount; number++)
                    {
                        if (number == Model.CurrentPage)
                        {
                            <span aria-current="page">@number</span>
                        }
                        else
                        {
                            <a asp-page="./ViolationConfiguration" asp-route-pageNo="@number">@number</a>
                        }
                    }

                    @if (Model.CurrentPage < Model.PageCount)
                    {
                        <a asp-page="./ViolationConfiguration" asp-route-pageNo="@(Model.CurrentPage + 1)" rel="next">التالي ›</a>
                    }
                </nav>
            }
        }
    </div>
</section>

@section Scripts {

}

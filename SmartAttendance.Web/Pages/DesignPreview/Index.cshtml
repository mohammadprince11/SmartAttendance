@page "/DesignPreview"
@model SmartAttendance.Web.Pages.DesignPreview.IndexModel

@{
    ViewData["Title"] = "معاينة الهوية الجديدة";
}

<style>
    /* تخطيط خاص بصفحة المعاينة فقط — كل الستايل الفعلي من zynora-design-system.css */
    .dp-wrap { border-radius: 18px; padding: 26px; min-height: 80vh; }
    .dp-cols { display: grid; grid-template-columns: 1.7fr 1fr; gap: 16px; align-items: start; }
    .dp-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .dp-sec { margin-bottom: 16px; }
    @@media (max-width: 900px) { .dp-cols { grid-template-columns: 1fr; } }
</style>

<div class="zy-app dp-wrap" dir="rtl" style="background:var(--color-background)">

    <div class="zy-breadcrumb">النظام <b>معاينة الهوية الجديدة</b>
        <span style="margin-inline-start:auto"></span>
        <span class="zy-desc">بدّل الوضع من زر الشمس/الهلال بالشريط العلوي ☝</span>
    </div>

    <div class="zy-page-header">
        <div>
            <h1>صباح الخير، محمد</h1>
            <div class="zy-desc">هكذا ستبدو لوحة البيانات بالهوية الجديدة — الأرقام أدناه حية من نظامك الآن.</div>
        </div>
        <span class="zy-spacer"></span>
        <button type="button" class="zy-btn zy-btn--primary">
            <svg class="zy-ic" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            إجراء سريع
        </button>
    </div>

    @* ===== 4 مؤشرات حية ===== *@
    <div class="zy-stats">
        <div class="zy-stat">
            <span class="zy-stat__icon"><svg class="zy-ic" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
            <div><div class="zy-stat__label">الموظفون النشطون</div><div class="zy-stat__value">@Model.ActiveEmployees.ToString("N0")</div></div>
        </div>
        <div class="zy-stat">
            <span class="zy-stat__icon zy-card__icon--warning"><svg class="zy-ic" viewBox="0 0 24 24"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg></span>
            <div><div class="zy-stat__label">مفاتيح بصمة بانتظار الاعتماد</div><div class="zy-stat__value">@Model.PendingBiometricKeys</div>
                @if (Model.PendingBiometricKeys > 0) { <span class="zy-stat__delta zy-stat__delta--flat">تحتاج قرارك</span> }
            </div>
        </div>
        <div class="zy-stat">
            <span class="zy-stat__icon zy-card__icon--secondary"><svg class="zy-ic" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span>
            <div><div class="zy-stat__label">مناوبات متاحة بالروستر</div><div class="zy-stat__value">@Model.ActiveShiftTypes</div></div>
        </div>
        <div class="zy-stat">
            <span class="zy-stat__icon zy-card__icon--success"><svg class="zy-ic" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></span>
            <div><div class="zy-stat__label">خلايا روستر هذا الشهر</div><div class="zy-stat__value">@Model.RosterCellsThisMonth.ToString("N0")</div></div>
        </div>
    </div>

    <div class="dp-cols">
        <div>
            @* ===== مهامك اليوم (حية جزئياً) ===== *@
            <section class="zy-card dp-sec">
                <div class="zy-card__header">
                    <span class="zy-card__icon"><svg class="zy-ic" viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
                    <h2>مهامك اليوم</h2>
                    <span class="zy-badge zy-badge--info"><span class="zy-badge__dot"></span>مباشر</span>
                </div>
                <div class="zy-card__body">
                    @if (Model.PendingBiometricKeys > 0)
                    {
                        <div class="dp-row" style="padding:10px 0;border-bottom:1px dashed var(--color-border)">
                            <span class="zy-card__icon zy-card__icon--warning"><svg class="zy-ic" viewBox="0 0 24 24"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777z"/></svg></span>
                            <div style="flex:1"><b>@Model.PendingBiometricKeys مفاتيح بصمة/وجه بانتظار الاعتماد</b>
                                <div class="zy-desc">لن تعمل للبصم ولا للدخول قبل موافقتك</div></div>
                            <a href="/BiometricKeys" class="zy-btn zy-btn--ghost zy-btn--sm">راجعها الآن</a>
                        </div>
                    }
                    <div class="dp-row" style="padding:10px 0;border-bottom:1px dashed var(--color-border)">
                        <span class="zy-card__icon zy-card__icon--secondary"><svg class="zy-ic" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span>
                        <div style="flex:1"><b>جدولة الشهر القادم</b>
                            <div class="zy-desc">اقتراح: «نسخ الشهر الماضي» يعبّيها بضغطة ثم عدّل الاستثناءات</div></div>
                        <a href="/Roster" class="zy-btn zy-btn--ghost zy-btn--sm">افتح الجدولة</a>
                    </div>
                    <div class="dp-row" style="padding:10px 0">
                        <span class="zy-card__icon zy-card__icon--success"><svg class="zy-ic" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span>
                        <div style="flex:1"><b>إعلان للموظفين</b>
                            <div class="zy-desc">يصل للجوال فوراً عبر الإشعارات</div></div>
                        <a href="/Engagement/Announcements" class="zy-btn zy-btn--ghost zy-btn--sm">أنشئ إعلاناً</a>
                    </div>
                </div>
            </section>

            @* ===== نموذج جدول بالهوية الجديدة ===== *@
            <section class="zy-card dp-sec">
                <div class="zy-card__header">
                    <span class="zy-card__icon zy-card__icon--secondary"><svg class="zy-ic" viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></span>
                    <h2>هكذا ستبدو الجداول</h2>
                    <button type="button" class="zy-btn zy-btn--secondary zy-btn--sm">
                        <svg class="zy-ic" viewBox="0 0 24 24" style="width:14px;height:14px"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        تصدير
                    </button>
                </div>
                <div class="zy-table-wrap" style="border:0;box-shadow:none">
                    <table class="zy-table">
                        <thead><tr><th>الموظف</th><th>النوع</th><th>التاريخ</th><th>الحالة</th><th style="text-align:end">إجراءات</th></tr></thead>
                        <tbody>
                            <tr>
                                <td><div class="zy-cell-main">أحمد صلاح حسين</div><div class="zy-cell-sub">10010 · الصيانة</div></td>
                                <td>إجازة اعتيادية</td><td class="zy-cell-num">2026-07-29</td>
                                <td><span class="zy-badge zy-badge--warning"><span class="zy-badge__dot"></span>قيد المراجعة</span></td>
                                <td><div class="zy-row-actions"><button class="zy-btn zy-btn--ghost zy-btn--sm">عرض</button><button class="zy-btn zy-btn--danger zy-btn--sm">رفض</button></div></td>
                            </tr>
                            <tr>
                                <td><div class="zy-cell-main">قتيبة اسماعيل محمود</div><div class="zy-cell-sub">10011 · المالية</div></td>
                                <td>مغادرة ساعية</td><td class="zy-cell-num">2026-07-28</td>
                                <td><span class="zy-badge zy-badge--success"><span class="zy-badge__dot"></span>موافق عليه</span></td>
                                <td><div class="zy-row-actions"><button class="zy-btn zy-btn--ghost zy-btn--sm">عرض</button></div></td>
                            </tr>
                            <tr>
                                <td><div class="zy-cell-main">عمار زهير كريم</div><div class="zy-cell-sub">10020 · التجاري</div></td>
                                <td>سلفة</td><td class="zy-cell-num">2026-07-27</td>
                                <td><span class="zy-badge zy-badge--danger"><span class="zy-badge__dot"></span>مرفوض</span></td>
                                <td><div class="zy-row-actions"><button class="zy-btn zy-btn--ghost zy-btn--sm">عرض</button></div></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div>
            @* ===== معرض المكونات ===== *@
            <section class="zy-card dp-sec">
                <div class="zy-card__header"><h2>الأزرار</h2></div>
                <div class="zy-card__body dp-row">
                    <button class="zy-btn zy-btn--primary">حفظ</button>
                    <button class="zy-btn zy-btn--secondary">إلغاء</button>
                    <button class="zy-btn zy-btn--danger">حذف</button>
                    <button class="zy-btn zy-btn--ghost">أداة</button>
                    <button class="zy-btn zy-btn--primary zy-btn--sm">صغير</button>
                    <button class="zy-btn zy-btn--primary" disabled>معطّل</button>
                </div>
            </section>

            <section class="zy-card dp-sec">
                <div class="zy-card__header"><h2>الحقول</h2></div>
                <div class="zy-card__body" style="display:flex;flex-direction:column;gap:14px">
                    <div class="zy-field">
                        <label>اسم الموظف <span class="zy-req">*</span></label>
                        <input class="zy-input" placeholder="ابحث بالاسم أو الرقم..." />
                        <span class="zy-help">اكتب 3 أحرف على الأقل</span>
                    </div>
                    <div class="zy-field zy-field--invalid">
                        <label>تاريخ البداية <span class="zy-req">*</span></label>
                        <input class="zy-input" type="date" />
                        <span class="zy-error">هذا الحقل مطلوب</span>
                    </div>
                    <div class="zy-field">
                        <label>نوع الطلب</label>
                        <select class="zy-select"><option>إجازة اعتيادية</option><option>مرضية</option></select>
                    </div>
                    <label class="zy-check"><input type="checkbox" checked /> إشعار الموظف بالنتيجة</label>
                    <div class="dp-row"><span class="zy-toggle"><input type="checkbox" checked /><i></i></span> <b style="font-size:var(--fs-small)">تفعيل القاعدة</b></div>
                    <div class="zy-upload">
                        اسحب الملف هنا أو <b style="color:var(--color-primary)">اختر ملفاً</b>
                        <div class="zy-upload__file">
                            <svg class="zy-ic" viewBox="0 0 24 24" style="width:15px;height:15px"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            كتاب_التعيين.pdf <span class="zy-size">PDF · 214 KB</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="zy-card dp-sec">
                <div class="zy-card__header"><h2>حالة فارغة + تحميل</h2></div>
                <div class="zy-card__body">
                    <div class="zy-empty" style="padding:18px">
                        <span class="zy-empty__icon"><svg class="zy-ic" viewBox="0 0 24 24" style="width:24px;height:24px"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
                        <b>لا توجد نتائج مطابقة</b>
                        <p>جرّب تغيير الفلاتر أو البحث باسم آخر</p>
                        <button class="zy-btn zy-btn--secondary zy-btn--sm">إعادة الضبط</button>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:8px;margin-top:10px">
                        <div class="zy-skeleton" style="width:70%"></div>
                        <div class="zy-skeleton" style="width:90%"></div>
                        <div class="zy-skeleton" style="width:50%"></div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="zy-toasts" style="position:static;margin-top:6px;max-width:340px">
        <div class="zy-toast zy-toast--success">✓ تم حفظ البيانات بنجاح — هكذا تبدو التنبيهات</div>
    </div>
</div>

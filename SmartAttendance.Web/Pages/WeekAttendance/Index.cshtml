@page "/WeekAttendance"
@model SmartAttendance.Web.Pages.WeekAttendance.IndexModel
@using SmartAttendance.Web.Infrastructure.Hrms

@{
    ViewData["Title"] = "الحضور الأسبوعي";
    var (year, week) = Model.Period;
}
<link rel="stylesheet" href="~/css/pages/index-566b9d55cf.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />


<section class="mat-page" dir="rtl">
    <partial name="_AttendanceApprovalViews" />
    <header class="mat-head">
        <div>
            <h1>الحضور الأسبوعي</h1>
            <p>نظير الحضور الشهري بتجميع أسبوعي (أسابيع ISO): تحت المراجعة ← معتمد ← <b>مقفل</b>. الأسبوع <b>@week</b> · @Model.Range.Start.ToString("yyyy-MM-dd") → @Model.Range.End.ToString("yyyy-MM-dd").</p>
        </div>
        <form method="post" asp-page-handler="Build">
            <input type="hidden" name="IsoYear" value="@year" />
            <input type="hidden" name="Week" value="@week" />
            <input type="hidden" name="Search" value="@Model.Search" />
            <input type="hidden" name="Filter" value="@Model.Filter" />
            <button type="submit" class="mat-btn" data-zyconfirm="بناء الأسبوع — تأكيد؟">بناء الأسبوع من اليوميات</button>
        </form>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mat-alert">@TempData["SuccessMessage"]</div>
    }

    <form method="get" class="mat-bar">
        <label>السنة
            <select name="IsoYear" onchange="this.form.submit()">
                @for (var y = DateTime.Today.Year - 3; y <= DateTime.Today.Year + 1; y++)
                { <option value="@y" selected="@(y == year)">@y</option> }
            </select>
        </label>
        <label>الأسبوع
            <select name="Week">
                @for (var w = 1; w <= Model.WeeksInYear; w++)
                {
                    var r = WeekAttendanceStore.WeekRange(year, w);
                    <option value="@w" selected="@(w == week)">أسبوع @w (@r.Start.ToString("MM-dd") → @r.End.ToString("MM-dd"))</option>
                }
            </select>
        </label>
        <label>بحث
            <input type="text" name="Search" value="@Model.Search" placeholder="رمز/اسم..." />
        </label>
        <label>الحالة
            <select name="Filter">
                <option value="All" selected="@(Model.Filter == "All")">الكل</option>
                <option value="UnderReview" selected="@(Model.Filter == "UnderReview")">تحت المراجعة</option>
                <option value="Approved" selected="@(Model.Filter == "Approved")">معتمد</option>
                <option value="Locked" selected="@(Model.Filter == "Locked")">مقفل</option>
            </select>
        </label>
        <button type="submit" class="mat-btn ghost">عرض</button>
        <div class="zyu-454b71f2df7a">
            <span class="mat-stat zyu-fecc85c94a43">تحت المراجعة <b>@Model.UnderReviewCount</b></span>
            <span class="mat-stat zyu-22d70a2892cd">معتمد <b>@Model.ApprovedCount</b></span>
            <span class="mat-stat zyu-474799ee2243">مقفل <b>@Model.LockedCount</b></span>
        </div>
    </form>

    <form method="post" id="mat-form">
        <input type="hidden" name="IsoYear" value="@year" />
        <input type="hidden" name="Week" value="@week" />
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="Filter" value="@Model.Filter" />
        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />

        <div class="mat-bar zyu-4a0b63657981">
            <label class="zyu-081564a256b8">
                <input type="checkbox" onchange="matToggleAll(this)" /> تحديد الصفحة
            </label>
            <span id="mat-count" class="zyu-067034cc892a">0 محدد</span>
            <button type="submit" asp-page-handler="Approve" class="mat-btn ok"
                    data-zyconfirm="اعتماد المحدد — تأكيد؟">اعتماد المحدد</button>
            <button type="submit" asp-page-handler="Lock" class="mat-btn lock"
                    data-zyconfirm="قفل الأسبوع — تأكيد؟">قفل</button>
            <button type="submit" asp-page-handler="Reopen" class="mat-btn no"
                    data-zyconfirm="إرجاع للمراجعة — تأكيد؟">إرجاع للمراجعة</button>
            <input type="text" name="UnlockReason" maxlength="500" placeholder="سبب فتح المقفل (إلزامي)" />
            <button type="submit" asp-page-handler="Unlock" class="mat-btn no"
                    data-zyconfirm="فتح المقفل إلى معتمد وتسجيل السبب — تأكيد؟">فتح المقفل</button>
        </div>

        <div class="mat-table-card zyu-c53ea1da2385">
            @if (Model.Rows.Count == 0)
            {
                <div class="mat-empty">لا أسابيع مبنية — شغّل «بناء الأسبوع من اليوميات» بعد «تحديث الحضور».</div>
            }
            else
            {
                <table class="mat-table">
                    <thead>
                        <tr>
                            <th class="zyu-d12729b3d536"></th><th>الموظف</th><th>أيام العمل</th><th>حاضر</th><th>غائب</th>
                            <th>بصمة ناقصة</th><th>إجازة بدون راتب</th><th>ساعات التأخير</th><th>الخروج المبكر</th><th>ساعات العمل</th><th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="SelectedIds" value="@row.Id" onchange="matCount()" />
                                </td>
                                <td><b>@row.EmployeeName</b> <span class="zyu-c8664f4c9a37">· @row.EmployeeNo</span></td>
                                <td class="mat-num">@row.WorkDays</td>
                                <td class="mat-num zyu-22d70a2892cd">@row.PresentDays</td>
                                <td class="mat-num @(row.AbsentDays > 0 ? "bad" : "")">@row.AbsentDays</td>
                                <td class="mat-num @(row.IncompleteDays > 0 ? "warn" : "")">@row.IncompleteDays</td>
                                <td class="mat-num @(row.UnpaidLeaveDays > 0 ? "bad" : "")">@row.UnpaidLeaveDays</td>
                                <td class="mat-num @(row.LateHours > 0 ? "warn" : "")">@row.LateHours.ToString("0.##")</td>
                                <td class="mat-num @(row.EarlyLeaveHours > 0 ? "warn" : "")">@row.EarlyLeaveHours.ToString("0.##")</td>
                                <td class="mat-num">@row.WorkedHours.ToString("0.##")</td>
                                <td><span class="mat-chip @row.Status" title="@(row.LockedAt != null ? $"قُفل {row.LockedAt:yyyy-MM-dd HH:mm}" : row.ApprovedAt != null ? $"اعتُمد {row.ApprovedAt:yyyy-MM-dd HH:mm}" : "")">@WeekAttendanceStore.StatusLabel(row.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </form>

    @if (Model.TotalPages > 1)
    {
        var qs = $"IsoYear={year}&Week={week}&Search={Model.Search}&Filter={Model.Filter}";
        <div class="mat-pager">
            @if (Model.PageNumber > 1)
            {
                <a class="mat-btn ghost" href="?@qs&PageNumber=@(Model.PageNumber - 1)">السابق</a>
            }
            <span>صفحة @Model.PageNumber من @Model.TotalPages (@Model.TotalRows موظف)</span>
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a class="mat-btn ghost" href="?@qs&PageNumber=@(Model.PageNumber + 1)">التالي</a>
            }
        </div>
    }
</section>

@section Scripts {
    <script>
        function matToggleAll(source) {
            document.querySelectorAll('[name="SelectedIds"]').forEach(function (cb) { cb.checked = source.checked; });
            matCount();
        }
        function matCount() {
            var count = document.querySelectorAll('[name="SelectedIds"]:checked').length;
            document.getElementById('mat-count').textContent = count + ' محدد';
        }
    </script>
}

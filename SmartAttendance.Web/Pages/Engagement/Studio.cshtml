@page
@model SmartAttendance.Web.Pages.Engagement.StudioModel
@using System.Text.Json
@using System.Globalization
@inject SmartAttendance.Web.Infrastructure.Localization.ILocalizationDictionaryService Dictionary
@{
    var catalog = await Dictionary.GetCatalogAsync(CultureInfo.CurrentUICulture.Name, HttpContext.RequestAborted);
    var languages = await Dictionary.GetLanguagesAsync(HttpContext.RequestAborted);
    var scriptKeys = new HashSet<string> { "لا توجد قوالب فعالة. فعّل قالباً أو أنشئ قالباً جديداً.", "— اختياري", "تاريخ النهاية يجب ألا يسبق البداية.", "نص", "تاريخ", "شهر وسنة", "رقم", "إزالة الحقل", "رمز الحقل", "اسم الحقل", "نوع الحقل", "مطلوب", "إزالة اللغة", "رمز اللغة (ar / en / ku أو لغة جديدة)", "العنوان", "النص", "رمز اللغة مكرر." };
    var scriptCatalog = catalog.Where(p => scriptKeys.Contains(p.Key) || Model.Templates.Any(t => t.Definition.Name == p.Key || t.Definition.Fields.Any(f => f.Label == p.Key))).ToDictionary(p => p.Key, p => p.Value);
    string L(string key) => catalog.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : key;
    ViewData["Title"] = L("استوديو قوالب الإعلانات");
}
@section Styles { <link rel="stylesheet" href="~/css/zynora-announcement-templates.css" asp-append-version="true" /> }
<section class="zy-scope zys" id="announcement-template-studio">
    <header class="zy-page-header"><div><h1>@L("استوديو قوالب الإعلانات")</h1><p>@L("اختر القالب والتصميم، أكمل حقول المناسبة، ثم راجع المعاينة قبل النشر.")</p></div><a asp-page="Index" asp-route-tab="announcements" class="zy-btn">@L("الرجوع للإعلانات")</a></header>
    <div asp-validation-summary="All" role="alert"></div>
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <p role="status">@Model.StatusMessage</p> }
    <form method="get" class="zy-filter-bar"><label>@L("الشركة")<select name="CompanyId" onchange="this.form.submit()">@foreach(var c in Model.Companies){<option value="@c.Id" selected="@(c.Id==Model.CompanyId)">@c.Name</option>}</select></label><button type="submit" class="zy-btn">@L("عرض")</button></form>
    <div class="zys-layout">
        <form method="post" asp-page-handler="Compose" id="zys-compose" class="zy-card">
            <input type="hidden" name="CompanyId" value="@Model.CompanyId" /><input type="hidden" name="RequestId" value="@Model.RequestId" />
            <h2>@L("إنشاء الإعلان")</h2>
            <label>@L("القالب")<select name="TemplateKey" id="zys-template">@foreach(var t in Model.Templates.Where(t=>t.IsActive)){<option value="@t.Definition.Key">@L(t.Definition.Name)</option>}</select></label>
            <div id="zys-fields"></div>
            <label>@L("التصميم")<select name="Design" id="zys-design">@foreach(var asset in SmartAttendance.Application.Announcements.Models.AnnouncementStudio.BuiltinAssets){<option value="builtin:@asset">@L("تصميم جاهز") · @asset</option>}@foreach(var d in Model.Designs){<option value="@d.Id">@d.Name</option>}</select></label>
            <details><summary>@L("إعدادات التصميم والجمهور")</summary>
                <label>@L("عرض الصورة")<select name="Fit" id="zys-fit"><option value="contain">@L("كاملة بدون قص")</option><option value="cover">@L("ملء المساحة مع القص")</option></select></label>
                <label>@L("موضع القص")<select name="Position" id="zys-position"><option value="center">@L("الوسط")</option><option value="top">@L("الأعلى")</option><option value="bottom">@L("الأسفل")</option></select></label>
                <label>@L("مكان النص")<select name="TextPlacement" id="zys-placement"><option value="above">@L("فوق الصورة")</option><option value="below">@L("تحت الصورة")</option><option value="overlay">@L("على الصورة")</option></select></label>
                <partial name="_EmployeePickerMulti" model="@(new SmartAttendance.Web.Pages.Shared.EmployeePickerMultiModel { Label = L("موظفون محددون — اتركه فارغاً لكل موظفي الشركة"), Name = "EmployeeIds" })" />
                <label class="zys-check"><input type="checkbox" name="CommentsEnabled" value="true" />@L("السماح بالتعليقات")</label>
            </details>
            <div class="zys-actions"><label class="zys-check"><input type="checkbox" name="PublishNow" value="true" />@L("نشر فوراً")</label><button class="zy-btn zy-btn--primary" type="submit">@L("حفظ الإعلان")</button></div>
            <p>@L("بدون «نشر فوراً» يُحفظ الإعلان كمسودة. تاريخ المناسبة مستقل عن تاريخ النشر.")</p>
        </form>
        <section class="zy-card" aria-label="@L("المعاينة")"><div class="zys-actions"><h2>@L("المعاينة المباشرة")</h2><label>@L("اللغة")<select id="zys-preview-language"></select></label></div>
            <article id="zys-preview" class="zys-visual zys-above zys-contain zys-center" aria-live="polite"><div class="zys-copy"><h3 id="zys-title"></h3><p id="zys-body"></p></div><img id="zys-image" alt="@L("تصميم الإعلان")" /></article><p id="zys-errors" role="status"></p>
        </section>
    </div>
    @if(Model.CanEditLibrary){
    <details class="zy-card"><summary>@L("إدارة القوالب — إنشاء وتعديل وتحديد الحقول واللغات والصور")</summary>
        <form method="post" asp-page-handler="SaveTemplate" id="zys-builder">
            <input type="hidden" name="CompanyId" value="@Model.CompanyId" /><input type="hidden" name="Revision" id="zys-revision" value="" /><input type="hidden" name="TemplateJson" id="zys-json" />
            <label>@L("تعديل قالب محفوظ")<select id="zys-edit"><option value="">@L("قالب جديد")</option>@foreach(var t in Model.Templates){<option value="@t.Definition.Key">@L(t.Definition.Name) @(t.IsActive ? "" : L("— غير فعال"))</option>}</select></label>
            <div class="zys-grid"><label>@L("رمز القالب")<input id="zys-key" required maxlength="80" pattern="[a-z][a-z0-9-]{0,79}" placeholder="special-occasion" /></label><label>@L("اسم القالب")<input id="zys-name" required maxlength="150" /></label></div>
            <h3>@L("حقول الحالة")</h3><p>@L("حدد لكل حقل اسماً ورمزاً ونوعاً، وهل هو مطلوب. لفترة زمنية أضف startDate وendDate. ذكرى العمل تستخدم joiningDate وتحسب years تلقائياً.")</p>
            <div id="zys-builder-fields"></div><button type="button" id="zys-add-field" class="zy-btn">@L("إضافة حقل")</button>
            <h3>@L("نصوص القالب حسب اللغة")</h3><p>@L("أدخل الترجمة لكل لغة. المتغير يُكتب بهذا الشكل: {person} أو رمز الحقل الذي أضفته. لا تُترجم البيانات تلقائياً.")</p>
            <div id="zys-builder-languages"></div><button type="button" id="zys-add-language" class="zy-btn">@L("إضافة لغة")</button>
            <fieldset><legend>@L("الصور المتاحة لهذا القالب")</legend><p>@L("إذا لم تحدد صوراً تكون جميع صور مكتبة الشركة متاحة.")</p>@foreach(var d in Model.Designs){<label class="zys-check"><input type="checkbox" data-zys-design-id="@d.Id" />@d.Name</label>}</fieldset>
            <button type="submit" class="zy-btn zy-btn--primary">@L("حفظ القالب")</button>
        </form>
        <h3>@L("تفعيل القوالب")</h3><div class="zys-library">@foreach(var t in Model.Templates){<form method="post" asp-page-handler="ToggleTemplate"><input type="hidden" name="CompanyId" value="@Model.CompanyId" /><input type="hidden" name="key" value="@t.Definition.Key" /><span>@L(t.Definition.Name)</span><button type="submit" class="zy-btn">@(t.IsActive ? L("تعطيل") : L("تفعيل"))</button></form>}</div>
    </details>
    <details class="zy-card"><summary>@L("مكتبة التصاميم")</summary>
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data"><input type="hidden" name="CompanyId" value="@Model.CompanyId" /><label>@L("اسم التصميم")<input name="DesignName" required maxlength="150" /></label><label>@L("صورة التصميم — PNG أو JPEG، حتى 5 ميغابايت")<input name="Upload" type="file" required accept="image/png,image/jpeg" /></label><button class="zy-btn zy-btn--primary" type="submit">@L("إضافة التصميم")</button></form>
        <div class="zys-library">@foreach(var d in Model.Designs){<article><img src="@Url.Page("Studio", "Image", new { Model.CompanyId, id=d.Id })" alt="@d.Name" loading="lazy" /><p>@d.Name</p><form method="post" asp-page-handler="DisableDesign"><input type="hidden" name="CompanyId" value="@Model.CompanyId" /><input type="hidden" name="id" value="@d.Id" /><button class="zy-btn" data-zyconfirm="تعطيل التصميم؟ الإعلانات القديمة ستحتفظ به." type="submit">@L("تعطيل")</button></form></article>}</div>
    </details>
    }
    <datalist id="zys-cultures">@foreach(var language in languages){<option value="@language.Code">@language.NativeName</option>}</datalist>
    <script type="application/json" id="zys-data">@Html.Raw(JsonSerializer.Serialize(new { templates=Model.Templates, designs=Model.Designs, companyId=Model.CompanyId, catalog=scriptCatalog, languages, today=DateOnly.FromDateTime(DateTime.UtcNow.AddHours(3)).ToString("yyyy-MM-dd"), templateKey=Model.TemplateKey, values=Model.Values, design=Model.Design, fit=Model.Fit, position=Model.Position, placement=Model.TextPlacement }))</script>
</section>
@section Scripts { <script src="~/js/zynora-announcement-templates.js" asp-append-version="true"></script> }

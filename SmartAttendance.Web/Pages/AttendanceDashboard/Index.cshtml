@page "/AttendanceDashboard"
@model SmartAttendance.Web.Pages.AttendanceDashboard.IndexModel

@*
    رسومات مودل الحضور — لوحة قراءةٍ محضة على اليوميات المحلَّلة بفترة الغلق.
*@

@{
    ViewData["Title"] = "رسومات الحضور";
}
<link rel="stylesheet" href="~/css/pages/index-10e92d037b.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />


<section class="zxd-page" dir="rtl">
    <header class="zxd-head">
        <div>
            <h1>رسومات الحضور</h1>
            <p>
                لوحة قراءةٍ على اليوميات المحلَّلة —
                <span dir="ltr">@Model.CutoffPeriod.From.ToString("yyyy-MM-dd") → @Model.CutoffPeriod.To.ToString("yyyy-MM-dd")</span>
                @if (!string.IsNullOrWhiteSpace(Model.CutoffPolicyName))
                {
                    <text> · سياسة الغلق: @Model.CutoffPolicyName</text>
                }
            </p>
        </div>
        <a class="zxd-btn ghost" href="/DayAttendance?Month=@Model.Month">الحضور اليومي</a>
    </header>

    <form method="get" class="zxd-bar">
        <label>الشهر
            <input type="month" name="Month" value="@Model.Month" />
        </label>
        <button type="submit" class="zxd-btn ghost">عرض</button>
    </form>

    @if (Model.AnalyzedDays == 0)
    {
        <div class="zxd-card">
            <div class="zxd-empty">
                لا يوميات محلَّلة بهذه الفترة — فلا شيء يُرسم.<br />
                شغّل «تحديث الحضور» من <a href="/DayAttendance?Month=@Model.Month">الحضور اليومي</a> أولاً.
            </div>
        </div>
    }
    else
    {
        <div class="zxd-kpis">
            <div class="zxd-kpi rate">
                <span>نسبة الالتزام</span>
                <b>@Model.AttendanceRate%</b>
                <small>(حاضر + متأخر) ÷ اليوميات المحلَّلة</small>
            </div>
            <div class="zxd-kpi">
                <span>الموظفون</span>
                <b>@Model.Employees</b>
                <small>@Model.AnalyzedDays يومية محلَّلة</small>
            </div>
            <div class="zxd-kpi late">
                <span>ساعات التأخير</span>
                <b>@Model.LateHours</b>
                <small>@Model.LateDays يومية متأخرة</small>
            </div>
            <div class="zxd-kpi absent">
                <span>أيام الغياب</span>
                <b>@Model.AbsentDays</b>
                <small>@Model.IncompleteDays بصمة ناقصة</small>
            </div>
            <div class="zxd-kpi">
                <span>ساعات العمل</span>
                <b>@Model.WorkedHours</b>
                <small>@Model.EarlyLeaveHours ساعة خروج مبكر</small>
            </div>
            @if (Model.StaleDays > 0)
            {
                <div class="zxd-kpi stale">
                    <span>لم تُحلَّل</span>
                    <b>@Model.StaleDays</b>
                    <small>طرأ عليها تغيير بعد التحليل — الأرقام أعلاه بائتة بقدرها</small>
                </div>
            }
        </div>

        <div class="zxd-grid">
            <div class="zxd-card">
                <div class="zxd-card-head">
                    <h2>توزيع الحالات</h2>
                    <p>حصّة كل حالة من يوميات الفترة.</p>
                </div>
                <div class="zxd-card-body">
                    <div class="zxd-dist">
                        @foreach (var slice in Model.Distribution)
                        {
                            <div class="zxd-dist-row">
                                <span>@slice.Label</span>
                                <span class="zxd-track">
                                    <span class="zxd-fill @slice.Key" data-zy-style="width:@(Math.Max(slice.Percent, 1))%"></span>
                                </span>
                                <span class="zxd-dist-num">@slice.Count · @slice.Percent%</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="zxd-card">
                <div class="zxd-card-head">
                    <h2>الأكثر تأخّراً</h2>
                    <p>بالساعات لا بعدد المرّات — تأخيرُ ثلاث ساعات مرّةً أثقل من خمس دقائق ثلاث مرّات.</p>
                </div>
                <div class="zxd-card-body">
                    @if (Model.TopLate.Count == 0)
                    {
                        <div class="zxd-empty">لا تأخير بهذه الفترة.</div>
                    }
                    else
                    {
                        <table class="zxd-table">
                            <thead>
                                <tr><th>الكود</th><th>الموظف</th><th>ساعات</th><th>أيام</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var stat in Model.TopLate)
                                {
                                    <tr>
                                        <td class="zxd-num">@stat.EmployeeNo</td>
                                        <td>@stat.EmployeeName</td>
                                        <td class="zxd-num">@stat.Value</td>
                                        <td class="zxd-num">@stat.Days</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div class="zxd-card">
                <div class="zxd-card-head">
                    <h2>الأكثر غياباً</h2>
                    <p>أيام حالتها «غائب» بالفترة.</p>
                </div>
                <div class="zxd-card-body">
                    @if (Model.TopAbsent.Count == 0)
                    {
                        <div class="zxd-empty">لا غياب بهذه الفترة.</div>
                    }
                    else
                    {
                        <table class="zxd-table">
                            <thead>
                                <tr><th>الكود</th><th>الموظف</th><th>أيام الغياب</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var stat in Model.TopAbsent)
                                {
                                    <tr>
                                        <td class="zxd-num">@stat.EmployeeNo</td>
                                        <td>@stat.EmployeeName</td>
                                        <td class="zxd-num">@stat.Days</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div class="zxd-card">
                <div class="zxd-card-head">
                    <h2>روابط سريعة</h2>
                    <p>اللوحة تقرأ ولا تُشغّل شيئاً — الإجراء من شاشته.</p>
                </div>
                <div class="zxd-card-body zyu-e71fea521116">
                    <a class="zxd-btn ghost" href="/DayAttendance?Month=@Model.Month">الحضور اليومي</a>
                    <a class="zxd-btn ghost" href="/AttendanceRecommendations">الإجراءات المقترحة</a>
                    <a class="zxd-btn ghost" href="/MonthAttendance">الحضور الشهري والاعتماد</a>
                    <a class="zxd-btn ghost" href="/AttendanceReports">تقارير الحضور</a>
                    @if (Model.StaleDays > 0)
                    {
                        <a class="zxd-btn" href="/DayAttendance?Month=@Model.Month&StatusFilter=Stale">
                            راجع الـ@(Model.StaleDays) يومية البائتة
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</section>

@page
@model SmartAttendance.Web.Pages.EmployeePortal.FormFillModel
@using SmartAttendance.Web.Infrastructure.Hrms
@{
    Layout = "_EmployeePortalLayout";
    ViewData["Title"] = "النماذج";
}
<link rel="stylesheet" href="~/css/pages/formfill-ea21584dc1.css" asp-append-version="true" />


<div class="ef">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="ef-msg">@Model.StatusMessage</div>
    }

    @if (Model.Current is { } form)
    {
        <div class="ef-card">
            <h2>@form.Name</h2>
            <p class="sub">@form.Description</p>

            @if (Model.Errors.Count > 0)
            {
                <div class="ef-err">
                    @foreach (var error in Model.Errors)
                    {
                        <div>• @error</div>
                    }
                </div>
            }

            <form method="post" data-request-submit="@(!form.IsSurvey ? "true" : null)">
                <input type="hidden" asp-for="SubmissionToken" />
                @foreach (var (group, fields) in Model.Layout())
                {
                    <div class="ef-group">
                        <h3>@(group?.Name ?? "أسئلة")</h3>

                        @foreach (var field in fields)
                        {
                            var name = $"f_{field.Id}";
                            <label class="ef-field">
                                <span>
                                    @field.Label
                                    @if (field.IsRequired)
                                    {
                                        <b class="ef-req">*</b>
                                    }
                                </span>

                                @switch (field.ControlType)
                                {
                                    case FormBuilder.ControlTextArea:
                                        <textarea name="@name" rows="3" required="@(field.IsRequired ? "required" : null)" data-request-required-label="@field.Label"></textarea>
                                        break;
                                    case FormBuilder.ControlNumber:
                                        <input name="@name" type="number" step="any" required="@(field.IsRequired ? "required" : null)" data-request-required-label="@field.Label" />
                                        break;
                                    case FormBuilder.ControlDate:
                                        <input name="@name" type="date" required="@(field.IsRequired ? "required" : null)" data-request-required-label="@field.Label" />
                                        break;
                                    case FormBuilder.ControlTime:
                                        <input name="@name" type="time" required="@(field.IsRequired ? "required" : null)" data-request-required-label="@field.Label" />
                                        break;
                                    case FormBuilder.ControlFile:
                                        <input name="@name" type="text" placeholder="رابط أو وصف المرفق" required="@(field.IsRequired ? "required" : null)" data-request-required-label="@field.Label" />
                                        break;
                                    case FormBuilder.ControlYesNo:
                                        <select name="@name" required="@(field.IsRequired ? "required" : null)" data-request-required-label="@field.Label">
                                            <option value="">—</option>
                                            <option>نعم</option><option>لا</option><option>بلا إجابة</option>
                                        </select>
                                        break;
                                    case FormBuilder.ControlSelect:
                                        <select name="@name" required="@(field.IsRequired ? "required" : null)" data-request-required-label="@field.Label">
                                            <option value="">—</option>
                                            @foreach (var option in field.OptionList)
                                            {
                                                <option>@option</option>
                                            }
                                        </select>
                                        break;
                                    case FormBuilder.ControlMultiSelect:
                                        <select name="@name" multiple size="4" required="@(field.IsRequired ? "required" : null)" data-request-required-label="@field.Label">
                                            @foreach (var option in field.OptionList)
                                            {
                                                <option>@option</option>
                                            }
                                        </select>
                                        break;
                                    case FormBuilder.ControlRating:
                                        <span class="ef-rate">
                                            @for (var n = 1; n <= field.EffectiveScale; n++)
                                            {
                                                <label>
                                                    <input type="radio" name="@name" value="@n" required="@(field.IsRequired ? "required" : null)" data-request-required-label="@field.Label" />
                                                    <span>@n</span>
                                                </label>
                                            }
                                        </span>
                                        break;
                                    default:
                                        <input name="@name" type="text" required="@(field.IsRequired ? "required" : null)" data-request-required-label="@field.Label" />
                                        break;
                                }
                            </label>
                        }
                    </div>
                }

                <button class="ef-btn" type="submit">@(form.IsSurvey ? "أرسل إجاباتي" : "أرسل الطلب")</button>
            </form>

            <p class="zyu-0ee7f66ad9c0"><a class="ef-open" asp-page="./FormFill">← رجوع</a></p>
        </div>
    }
    else
    {
        <div class="ef-card">
            <h2>النماذج المتاحة</h2>
            <p class="sub">طلبات واستبيانات — تظهر لك ما تنطبق عليك شروطه فقط.</p>

            @if (Model.Available.Count == 0)
            {
                <p class="sub">لا نماذج متاحة حالياً.</p>
            }
            else
            {
                @foreach (var template in Model.Available)
                {
                    <div class="ef-item">
                        <div>
                            <b class="zyu-226444d36645">@template.Name</b>
                            <div class="sub zyu-ab79ea2b8573">@template.TypeLabel</div>
                        </div>
                        <a class="ef-open" asp-page="./FormFill" asp-route-form="@template.Id">افتح</a>
                    </div>
                }
            }
        </div>
    }

    <div class="ef-card">
        <h2>ما أرسلتُه</h2>
        @if (Model.Mine.Count == 0)
        {
            <p class="sub">لا شيء بعد.</p>
        }
        else
        {
            @foreach (var item in Model.Mine)
            {
                <div class="ef-item">
                    <div>
                        <b class="zyu-226444d36645">@item.TemplateName</b>
                        <div class="sub zyu-ab79ea2b8573">@item.SubmittedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                        @if (!string.IsNullOrWhiteSpace(item.ReviewNote))
                        {
                            <div class="sub zyu-ab79ea2b8573">@item.ReviewNote</div>
                        }
                    </div>
                    <span class="ef-chip @item.Status">@item.StatusText</span>
                </div>
            }
        }
    </div>
</div>

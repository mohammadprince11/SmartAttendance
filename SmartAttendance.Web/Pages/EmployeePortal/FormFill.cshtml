@page
@model SmartAttendance.Web.Pages.EmployeePortal.FormFillModel
@using SmartAttendance.Web.Infrastructure.Hrms
@{
    Layout = "_EmployeePortalLayout";
    ViewData["Title"] = "النماذج";
}

<style>
    .ef { display:flex; flex-direction:column; gap:16px; color:var(--sa-text,#DCEAF4); }
    .ef-card { border:1px solid rgba(73,111,151,.22); border-radius:18px;
        background:var(--sa-surface,rgba(8,25,43,.9)); padding:18px; }
    .ef-card h2 { margin:0 0 4px; font-size:16px; font-weight:1000; }
    .ef-card p.sub { margin:0 0 14px; font-size:12px; color:var(--sa-muted,#8FA8BC); font-weight:800; }
    .ef-msg { border-radius:12px; padding:10px 14px; font-size:13px; font-weight:900;
        background:color-mix(in srgb,#38bdf8 12%,transparent); }
    .ef-err { border-radius:12px; padding:12px 14px; font-size:12px; font-weight:800;
        background:rgba(248,113,113,.12); color:#f87171; line-height:1.9; }
    .ef-group { border:1px solid rgba(73,111,151,.18); border-radius:14px; padding:14px; margin-bottom:14px; }
    .ef-group h3 { margin:0 0 12px; font-size:13px; font-weight:1000; }
    .ef-field { display:flex; flex-direction:column; gap:5px; font-size:12px; font-weight:900;
        color:var(--sa-muted,#8FA8BC); margin-bottom:14px; }
    .ef-field input, .ef-field select, .ef-field textarea {
        border:1px solid rgba(73,111,151,.3); border-radius:12px; background:transparent;
        color:var(--sa-text,#DCEAF4); padding:10px 12px; font-size:14px; font-weight:800; }
    .ef-rate { display:flex; gap:8px; flex-wrap:wrap; }
    .ef-rate label { display:inline-flex; flex-direction:column; align-items:center; gap:4px;
        border:1px solid rgba(73,111,151,.3); border-radius:12px; padding:8px 12px; cursor:pointer; }
    .ef-rate input { appearance:auto; }
    .ef-btn { width:100%; border:0; border-radius:14px; padding:12px; font-size:14px;
        font-weight:1000; cursor:pointer; background:#0d9488; color:#fff; }
    .ef-item { display:flex; align-items:center; justify-content:space-between; gap:10px;
        padding:12px 0; border-bottom:1px solid rgba(73,111,151,.18); }
    .ef-item:last-child { border-bottom:0; }
    .ef-open { border:0; border-radius:12px; padding:8px 14px; font-size:12px; font-weight:1000;
        background:#0d9488; color:#fff; text-decoration:none; display:inline-block; }
    .ef-chip { border-radius:999px; padding:3px 11px; font-size:11px; font-weight:900; }
    .ef-chip.Submitted { color:#fbbf24; background:rgba(251,191,36,.12); }
    .ef-chip.Approved { color:#34d399; background:rgba(52,211,153,.12); }
    .ef-chip.Rejected { color:#f87171; background:rgba(248,113,113,.12); }
    .ef-req { color:#f87171; }
</style>

<div class="ef">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="ef-msg">@Model.StatusMessage</div>
    }

    @if (Model.Current is { } form)
    {
        <div class="ef-card">
            <h2>@form.Name</h2>
            <p class="sub">@form.Description</p>

            @if (Model.Errors.Count > 0)
            {
                <div class="ef-err">
                    @foreach (var error in Model.Errors)
                    {
                        <div>• @error</div>
                    }
                </div>
            }

            <form method="post">
                @foreach (var (group, fields) in Model.Layout())
                {
                    <div class="ef-group">
                        <h3>@(group?.Name ?? "أسئلة")</h3>

                        @foreach (var field in fields)
                        {
                            var name = $"f_{field.Id}";
                            <label class="ef-field">
                                <span>
                                    @field.Label
                                    @if (field.IsRequired)
                                    {
                                        <b class="ef-req">*</b>
                                    }
                                </span>

                                @switch (field.ControlType)
                                {
                                    case FormBuilder.ControlTextArea:
                                        <textarea name="@name" rows="3"></textarea>
                                        break;
                                    case FormBuilder.ControlNumber:
                                        <input name="@name" type="number" step="any" />
                                        break;
                                    case FormBuilder.ControlDate:
                                        <input name="@name" type="date" />
                                        break;
                                    case FormBuilder.ControlTime:
                                        <input name="@name" type="time" />
                                        break;
                                    case FormBuilder.ControlFile:
                                        <input name="@name" type="text" placeholder="رابط أو وصف المرفق" />
                                        break;
                                    case FormBuilder.ControlYesNo:
                                        <select name="@name">
                                            <option value="">—</option>
                                            <option>نعم</option><option>لا</option><option>بلا إجابة</option>
                                        </select>
                                        break;
                                    case FormBuilder.ControlSelect:
                                        <select name="@name">
                                            <option value="">—</option>
                                            @foreach (var option in field.OptionList)
                                            {
                                                <option>@option</option>
                                            }
                                        </select>
                                        break;
                                    case FormBuilder.ControlMultiSelect:
                                        <select name="@name" multiple size="4">
                                            @foreach (var option in field.OptionList)
                                            {
                                                <option>@option</option>
                                            }
                                        </select>
                                        break;
                                    case FormBuilder.ControlRating:
                                        <span class="ef-rate">
                                            @for (var n = 1; n <= field.EffectiveScale; n++)
                                            {
                                                <label>
                                                    <input type="radio" name="@name" value="@n" />
                                                    <span>@n</span>
                                                </label>
                                            }
                                        </span>
                                        break;
                                    default:
                                        <input name="@name" type="text" />
                                        break;
                                }
                            </label>
                        }
                    </div>
                }

                <button class="ef-btn" type="submit">@(form.IsSurvey ? "أرسل إجاباتي" : "أرسل الطلب")</button>
            </form>

            <p style="margin-top:12px"><a class="ef-open" asp-page="./FormFill">← رجوع</a></p>
        </div>
    }
    else
    {
        <div class="ef-card">
            <h2>النماذج المتاحة</h2>
            <p class="sub">طلبات واستبيانات — تظهر لك ما تنطبق عليك شروطه فقط.</p>

            @if (Model.Available.Count == 0)
            {
                <p class="sub">لا نماذج متاحة حالياً.</p>
            }
            else
            {
                @foreach (var template in Model.Available)
                {
                    <div class="ef-item">
                        <div>
                            <b style="font-size:14px">@template.Name</b>
                            <div class="sub" style="margin:0">@template.TypeLabel</div>
                        </div>
                        <a class="ef-open" asp-page="./FormFill" asp-route-form="@template.Id">افتح</a>
                    </div>
                }
            }
        </div>
    }

    <div class="ef-card">
        <h2>ما أرسلتُه</h2>
        @if (Model.Mine.Count == 0)
        {
            <p class="sub">لا شيء بعد.</p>
        }
        else
        {
            @foreach (var item in Model.Mine)
            {
                <div class="ef-item">
                    <div>
                        <b style="font-size:14px">@item.TemplateName</b>
                        <div class="sub" style="margin:0">@item.SubmittedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                        @if (!string.IsNullOrWhiteSpace(item.ReviewNote))
                        {
                            <div class="sub" style="margin:0">@item.ReviewNote</div>
                        }
                    </div>
                    <span class="ef-chip @item.Status">@item.StatusText</span>
                </div>
            }
        }
    </div>
</div>

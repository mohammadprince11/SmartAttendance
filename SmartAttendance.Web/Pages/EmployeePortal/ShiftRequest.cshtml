@page
@model SmartAttendance.Web.Pages.EmployeePortal.ShiftRequestModel
@using SmartAttendance.Web.Infrastructure.Hrms
@{
    Layout = "_EmployeePortalLayout";
    ViewData["Title"] = "طلب مناوبة";
}
<link rel="stylesheet" href="~/css/pages/shiftrequest-4658954639.css" asp-append-version="true" />


<div class="esr">
    @if (!string.IsNullOrWhiteSpace(Model.InlineRequestError))
    {
        <div class="nxex-request-guard nxex-request-guard--inline" role="alert">
            <strong>الطلب متوقف لحين إكمال ملف الموظف</strong>
            <span>@Model.InlineRequestError</span>
        </div>
    }
    else if (Model.StatusMessage is { } statusMessage)
    {
        <div class="esr-msg">@statusMessage</div>
    }

    <div class="esr-card">
        <h2>طلب مناوبة</h2>
        <p class="sub">اختر مناوبةً متاحة ومدى الأيام — يُطبَّق التغيير بعد اعتماد الطلب.</p>

        @if (!Model.HasEmployee)
        {
            <p class="sub">المستخدم غير مرتبط بموظف.</p>
        }
        else if (Model.Shifts.Count == 0)
        {
            <p class="sub">لا توجد مناوبات متاحة للطلب حالياً — تُعلَّم المناوبة «قابلة للطلب من الخدمة الذاتية» من إعدادات أنواع المناوبات.</p>
        }
        else
        {
            <form method="post" data-request-submit>
                <div class="esr-grid">
                    <label class="esr-field full">المناوبة المطلوبة
                        <select name="ShiftTypeId" required>
                            @foreach (var (id, name) in Model.Shifts)
                            {
                                <option value="@id">@name</option>
                            }
                        </select>
                    </label>
                    <label class="esr-field">من تاريخ
                        <input type="date" name="FromDate" required />
                    </label>
                    <label class="esr-field">إلى تاريخ
                        <input type="date" name="ToDate" />
                    </label>
                    <label class="esr-field full">السبب (اختياري)
                        <textarea name="Reason" rows="2"></textarea>
                    </label>
                </div>
                <button type="submit" class="esr-btn">إرسال الطلب</button>
            </form>
        }
    </div>

    @if (Model.MyRequests.Count > 0)
    {
        <div class="esr-card">
            <h2>طلباتي السابقة</h2>
            <table class="esr-table">
                <thead><tr><th>المناوبة</th><th>من</th><th>إلى</th><th>الحالة</th></tr></thead>
                <tbody>
                    @foreach (var row in Model.MyRequests)
                    {
                        <tr>
                            <td>@row.ShiftName</td>
                            <td>@(row.FromDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td>@(row.ToDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td>
                                <span class="esr-chip @row.Status">
                                    @(row.Status switch { "Pending" => "قيد المراجعة", "Approved" => "معتمد", "Rejected" => "مرفوض", _ => row.Status })
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

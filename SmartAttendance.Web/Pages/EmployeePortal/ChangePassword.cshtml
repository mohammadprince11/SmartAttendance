@page
@model SmartAttendance.Web.Pages.EmployeePortal.ChangePasswordModel
@{
    Layout = "_EmployeePortalLayout";
    ViewData["Title"] = "تغيير كلمة المرور";
}
<link rel="stylesheet" href="~/css/pages/changepassword-d08f63df79.css" asp-append-version="true" />

<section class="nxex-subpage" dir="rtl" data-nxex-page data-active-tab="home">
    <header class="nxex-subpage-head">
        <a class="nxex-back-btn" href="/EmployeePortal" aria-label="رجوع">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </a>
        <div>
            <h1>تغيير كلمة المرور</h1>
            <p>حدّث كلمة مرور دخولك للبوابة. ستحتاجها في المرّة القادمة لتسجيل الدخول.</p>
        </div>
    </header>

    @if (Model.Success)
    {
        <div class="nxex-flash zyu-7d65e6bb77de" data-request-success>
            ✅ تم تغيير كلمة المرور بنجاح.
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="nxex-flash zyu-02e74f792350">
                @Model.ErrorMessage
            </div>
        }

        <section class="nxex-card">
            <form method="post" class="nxex-form">
                <div class="nxex-field">
                    <label>كلمة المرور الحالية</label>
                    <input type="password" name="CurrentPassword" autocomplete="current-password" required />
                </div>
                <div class="nxex-field">
                    <label>كلمة المرور الجديدة</label>
                    <input type="password" name="NewPassword" autocomplete="new-password" minlength="8" required />
                </div>
                <div class="nxex-field">
                    <label>تأكيد كلمة المرور الجديدة</label>
                    <input type="password" name="ConfirmPassword" autocomplete="new-password" required />
                </div>
                <p class="nxex-dc-hint">8 محارف على الأقل. يُفضّل مزج أحرف وأرقام.</p>
                <button type="submit" class="nxex-leave-submit">تغيير كلمة المرور</button>
            </form>
        </section>
    }
</section>

@page
@model SmartAttendance.Web.Pages.EmployeePortal.DocumentRequestModel
@{
    Layout = "_EmployeePortalLayout";
    ViewData["Title"] = "طلب وثيقة";
}
<link rel="stylesheet" href="~/css/pages/documentrequest-ec663f6a19.css" asp-append-version="true" />


<div class="edr">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="edr-msg">@Model.StatusMessage</div>
    }

    <div class="edr-card">
        <h2>طلب وثيقة</h2>
        <p class="sub">اطلب شهادة راتب أو كتاب تعريف — تُصدر تلقائياً ببياناتك عند الاعتماد.</p>

        @if (Model.Available.Count == 0)
        {
            <p class="sub">لا وثائق متاحة للطلب حالياً.</p>
        }
        else
        {
            <form method="post" enctype="multipart/form-data">
                <label class="edr-field">
                    نوع الوثيقة
                    <select asp-for="TemplateId">
                        <option value="0">— اختر —</option>
                        @foreach (var template in Model.Available)
                        {
                            <option value="@template.Id">
                                @template.Name@(template.IsReasonRequired ? " (السبب إلزامي)" : "")@(template.IsAttachmentRequired ? " (المرفق إلزامي)" : "")
                            </option>
                        }
                    </select>
                </label>

                <label class="edr-field">
                    سبب الطلب
                    <textarea asp-for="Reason" rows="3" placeholder="لماذا تحتاج هذه الوثيقة؟"></textarea>
                </label>

                <label class="edr-field">
                    مرفق (اختياري ما لم يُطلب)
                    <input asp-for="Attachment" type="file" />
                </label>

                <button class="edr-btn" type="submit">أرسل الطلب</button>
            </form>
        }
    </div>

    <div class="edr-card">
        <h2>طلباتي</h2>
        @if (Model.MyRequests.Count == 0)
        {
            <p class="sub">لا طلبات بعد.</p>
        }
        else
        {
            @foreach (var request in Model.MyRequests)
            {
                <div class="edr-item">
                    <div>
                        <b class="zyu-226444d36645">@request.TemplateName</b>
                        <div class="edr-note">@request.RequestedAt.ToLocalTime().ToString("yyyy/MM/dd")</div>
                        @if (!string.IsNullOrWhiteSpace(request.ReviewNote))
                        {
                            <div class="edr-note">سبب الرفض: @request.ReviewNote</div>
                        }
                    </div>
                    <div class="zyu-a4e017b7b0ef">
                        <span class="edr-chip @request.Status">@request.StatusLabel</span>
                        @if (request.IsPending)
                        {
                            <form method="post" asp-page-handler="Withdraw" class="zyu-6b8b63d565c4">
                                <input type="hidden" name="id" value="@request.Id" />
                                <button class="edr-mini" type="submit">سحب</button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

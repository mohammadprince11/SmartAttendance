@page
@model SmartAttendance.Web.Pages.EmployeePortal.FinancialRequestModel
@using SmartAttendance.Web.Infrastructure.Hrms
@{
    Layout = "_EmployeePortalLayout";
    ViewData["Title"] = "طلب مالي";
}
<link rel="stylesheet" href="~/css/pages/financialrequest-c39279c45a.css" asp-append-version="true" />


<section class="efr" dir="rtl">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="efr-alert">@Model.StatusMessage</div>
    }

    @if (!Model.HasEmployee)
    {
        <div class="efr-card"><p class="sub">حسابك غير مرتبط بموظف — تواصل مع الموارد البشرية.</p></div>
    }
    else
    {
        <div class="efr-card">
            <h2>طلب مالي جديد</h2>
            <p class="sub">قرض · سُلفة · بدل · استرداد — يمرّ طلبك بلجنة الموافقة ثم يُفعَّل أثره آلياً.</p>
            <form method="post" id="efrForm">
                @{
                    var defKind = Model.Kinds.FirstOrDefault(k => k.Key == "Loan") ?? Model.Kinds.FirstOrDefault();
                }
                <div class="efr-grid">
                    <div class="efr-field full">نوع الطلب
                        <div class="nxex-csel" id="efrKindSel">
                            <button type="button" class="nxex-csel-trigger" data-csel-trigger aria-haspopup="listbox" aria-expanded="false">
                                <span data-csel-label>@(defKind?.Icon) @(defKind?.Label)</span>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                            </button>
                            <input type="hidden" name="Kind" id="efrKindInput" data-csel-input value="@(defKind?.Key)" />
                            <ul class="nxex-csel-list" data-csel-list role="listbox" hidden>
                                @foreach (var k in Model.Kinds)
                                {
                                    <li class="nxex-csel-opt" role="option" data-value="@k.Key" data-label="@(k.Icon + " " + k.Label)" aria-selected="@(k.Key == defKind?.Key ? "true" : "false")">@k.Icon @k.Label</li>
                                }
                            </ul>
                        </div>
                    </div>
                    <label class="efr-field full"><span id="efrLblAmount">المبلغ</span>
                        <input name="Amount" id="efrAmount" type="number" step="0.01" min="0.01" required oninput="efrCalc()" />
                    </label>
                    <div class="efr-row3">
                        <label class="efr-field" id="efrFldCount">الأقساط
                            <input name="InstallmentCount" id="efrCount" type="number" min="1" value="1" oninput="efrCalc()" />
                        </label>
                        <div class="efr-field" id="efrFldMonth"><span id="efrLblMonth">الشهر</span>
                            <div class="nxex-csel">
                                <button type="button" class="nxex-csel-trigger" data-csel-trigger aria-haspopup="listbox" aria-expanded="false">
                                    <span data-csel-label>@DateTime.Today.Month.ToString("00")</span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                                </button>
                                <input type="hidden" name="StartMonth" data-csel-input value="@DateTime.Today.Month" />
                                <ul class="nxex-csel-list" data-csel-list role="listbox" hidden>
                                    @for (var m = 1; m <= 12; m++)
                                    {
                                        <li class="nxex-csel-opt" role="option" data-value="@m" data-label="@m.ToString("00")" aria-selected="@(m == DateTime.Today.Month ? "true" : "false")">@m.ToString("00")</li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <label class="efr-field" id="efrFldYear">السنة
                            <input name="StartYear" type="number" value="@DateTime.Today.Year" />
                        </label>
                    </div>
                    <div class="efr-preview" id="efrPreview"></div>
                    <label class="efr-field full">السبب
                        <input name="Reason" maxlength="200" placeholder="سبب الطلب (اختياري)" />
                    </label>
                </div>
                <button type="submit" class="efr-submit">إرسال للموافقة</button>
            </form>
        </div>

        @if (Model.MyRequests.Any())
        {
            <div class="efr-card">
                <h2>طلباتي المالية</h2>
                <p class="sub">متابعة حالة طلباتك.</p>
                <div class="efr-list">
                    @foreach (var r in Model.MyRequests)
                    {
                        <div class="efr-row">
                            <div>
                                <b>@r.Detail.KindLabelText</b>
                                <span class="amt"> · @r.Detail.Amount.ToString("N2")</span>
                                @if (r.Detail.Kind is "Loan" or "Advance")
                                {
                                    <span class="zyu-541964fc246f"> · @r.Detail.InstallmentCount قسط</span>
                                }
                                <br /><small class="zyu-541964fc246f">@(r.CreatedAt?.ToLocalTime().ToString("yyyy-MM-dd")) · @(string.IsNullOrWhiteSpace(r.CurrentStep) ? "" : r.CurrentStep)</small>
                            </div>
                            <div class="zyu-a4e017b7b0ef">
                                <span class="efr-pill @r.Status">@r.StatusText</span>
                                @if (r.Status == "Pending")
                                {
                                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('حذف الطلب المعلّق؟');">
                                        <input type="hidden" name="id" value="@r.RequestId" />
                                        <button type="submit" class="efr-del">حذف</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</section>

@section Scripts {
    <script>
        var efrKind = "Loan";
        function efrShow(id, on){ var el=document.getElementById(id); if(el) el.style.display = on ? "" : "none"; }
        function efrSelect(kind){
            efrKind = kind;
            var isLoan = kind === "Loan" || kind === "Advance";
            efrShow("efrFldCount", isLoan);
            var lbl = document.getElementById("efrLblMonth");
            if (lbl) lbl.textContent = isLoan ? "شهر البدء" : "الشهر";
            efrCalc();
        }
        function efrCalc(){
            var amt = parseFloat(document.getElementById("efrAmount").value) || 0;
            var box = document.getElementById("efrPreview");
            if (efrKind === "Loan" || efrKind === "Advance"){
                var cnt = parseInt(document.getElementById("efrCount").value) || 1; if (cnt < 1) cnt = 1;
                var monthly = Math.round((amt/cnt)*100)/100;
                box.textContent = amt > 0 ? ("القسط الشهري: " + monthly.toLocaleString() + " × " + cnt + " قسط") : "";
            } else { box.textContent = ""; }
        }
        // تهيئة موحّدة لكل قائمة منسدلة مخصّصة بالصفحة (قائمتها المفتوحة بتصميم التطبيق)
        function initCsel(sel){
            var trigger = sel.querySelector('[data-csel-trigger]');
            var list = sel.querySelector('[data-csel-list]');
            var labelEl = sel.querySelector('[data-csel-label]');
            var input = sel.querySelector('[data-csel-input]');
            if(!trigger || !list || !input) return;
            var opts = [].slice.call(sel.querySelectorAll('.nxex-csel-opt'));
            function close(){ list.hidden = true; sel.classList.remove('open'); trigger.setAttribute('aria-expanded','false'); }
            function open(){ list.hidden = false; sel.classList.add('open'); trigger.setAttribute('aria-expanded','true'); }
            trigger.addEventListener('click', function(e){ e.stopPropagation(); if(list.hidden) open(); else close(); });
            opts.forEach(function(li){ li.addEventListener('click', function(){
                if(li.getAttribute('data-disabled') === 'true') return;
                opts.forEach(function(o){ o.setAttribute('aria-selected', o===li ? 'true':'false'); });
                labelEl.textContent = li.getAttribute('data-label') || li.textContent.trim();
                input.value = li.getAttribute('data-value');
                close();
                if(sel.id === 'efrKindSel') efrSelect(li.getAttribute('data-value'));
            }); });
            document.addEventListener('click', function(e){ if(!sel.contains(e.target)) close(); });
        }
        [].slice.call(document.querySelectorAll('.nxex-csel')).forEach(initCsel);
        efrSelect((document.getElementById('efrKindInput') || {}).value || "Loan");
    </script>
}

@page "/EmployeePortal/Reports"
@model SmartAttendance.Web.Pages.EmployeePortal.ReportsModel
@{
    ViewData["Title"] = "تقاريري";
}

<style>
    .epr { direction: rtl; display: grid; gap: 14px; max-width: 1000px; margin: 0 auto; padding: 8px 4px 40px; }
    .epr h1 { margin: 0; font-size: 22px; font-weight: 1000; }
    .epr-hint { color: #9fb3c7; font-size: 12.5px; font-weight: 800; margin: 4px 0 0; }
    .epr-card { border: 1px solid var(--sa-border, rgba(148,163,184,.22)); border-radius: 14px;
        background: var(--sa-surface, rgba(6,16,29,.55)); padding: 14px 16px; }
    .epr-list { display: grid; gap: 10px; }
    .epr-item { display: flex; justify-content: space-between; align-items: center; gap: 12px;
        border: 1px solid var(--sa-border, rgba(148,163,184,.22)); border-radius: 12px; padding: 12px 14px;
        text-decoration: none; color: inherit; font-weight: 900; }
    .epr-table-wrap { overflow-x: auto; }
    .epr-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .epr-table th, .epr-table td { padding: 9px 10px; text-align: right; border-bottom: 1px solid var(--sa-border, rgba(148,163,184,.18)); }
    .epr-table th { font-weight: 1000; }
    .epr-empty { color: #9fb3c7; font-weight: 800; }
</style>

<div class="epr">
    <div>
        <h1>تقاريري</h1>
        <p class="epr-hint">التقارير التي نشرها قسم الموارد البشرية لك. تعرض <b>بياناتك أنت</b> فقط.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="epr-card epr-empty">@Model.Notice</div>
    }

    @if (Model.Current == null)
    {
        <div class="epr-card">
            @if (Model.Published.Count == 0)
            {
                <div class="epr-empty">لا توجد تقارير منشورة لك حالياً.</div>
            }
            else
            {
                <div class="epr-list">
                    @foreach (var report in Model.Published)
                    {
                        <a class="epr-item" asp-page="./Reports" asp-route-ReportId="@report.Id">
                            <span>
                                @report.Name
                                @if (!string.IsNullOrWhiteSpace(report.Description))
                                {
                                    <div class="epr-hint">@report.Description</div>
                                }
                            </span>
                            <span aria-hidden="true">‹</span>
                        </a>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="epr-card">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px">
                <b>@Model.Current.Name</b>
                <a asp-page="./Reports" style="font-weight:900">رجوع</a>
            </div>

            @if (Model.Rows.Count == 0)
            {
                <div class="epr-empty">لا توجد بيانات تخصّك بهذا التقرير.</div>
            }
            else
            {
                <div class="epr-table-wrap">
                    <table class="epr-table">
                        <thead>
                            <tr>
                                @foreach (var column in Model.Columns)
                                {
                                    <th>@column.Label</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    @foreach (var column in Model.Columns)
                                    {
                                        var value = row.GetValueOrDefault(column.Key, "");
                                        <td>@(string.IsNullOrEmpty(value) ? "—" : value)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

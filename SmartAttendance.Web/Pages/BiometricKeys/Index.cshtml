@page "/BiometricKeys"
@model SmartAttendance.Web.Pages.BiometricKeys.IndexModel
@using SmartAttendance.Web.Infrastructure.Security

@{
    ViewData["Title"] = "اعتماد مفاتيح البصمة/الوجه";
}
<link rel="stylesheet" href="~/css/pages/index-b8c306e1d9.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />


<section class="bk-page" dir="rtl">
    <header class="bk-head">
        <div>
            <h1>🔐 اعتماد مفاتيح البصمة/الوجه</h1>
            <p>كل مفتاح يسجّله موظف من بوابته يبقى معلّقاً حتى تعتمده الموارد البشرية — الاعتماد يفعّله للبصم والدخول، ولكل موظف مفتاح نشط واحد فقط.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="bk-alert">@Model.StatusMessage</div>
    }

    <div class="bk-kpis">
        <div class="bk-kpi p"><b class="zyu-fecc85c94a43">@Model.PendingCount</b><span>بانتظار الاعتماد</span></div>
        <div class="bk-kpi a"><b class="zyu-22d70a2892cd">@Model.ActiveCount</b><span>نشطة</span></div>
    </div>

    <form method="get" class="bk-bar">
        <input type="text" name="Search" value="@Model.Search" placeholder="بحث: اسم/رقم موظف" class="zyu-43459be14cf5" />
        <select name="Status">
            <option value="">كل الحالات</option>
            @foreach (var s in new[] { WebAuthnCredentialStore.StatusPending, WebAuthnCredentialStore.StatusActive, WebAuthnCredentialStore.StatusRejected, WebAuthnCredentialStore.StatusSuperseded, WebAuthnCredentialStore.StatusRevoked })
            { <option value="@s" selected="@(Model.Status == s)">@WebAuthnCredentialStore.StatusArabic(s)</option> }
        </select>
        <button type="submit" class="bk-btn ok">تصفية</button>
    </form>

    <div class="bk-card">
        @if (Model.Credentials.Count == 0)
        {
            <div class="bk-empty">لا توجد مفاتيح مطابقة.</div>
        }
        else
        {
            <table class="bk-table">
                <thead>
                    <tr>
                        <th>الموظف</th>
                        <th>الجهاز</th>
                        <th>تاريخ التسجيل</th>
                        <th>الحالة</th>
                        <th>البتّ</th>
                        <th>آخر استخدام</th>
                        <th class="zyu-814fec806937">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Credentials)
                    {
                        <tr>
                            <td class="bk-emp"><b>@c.EmployeeName</b><span>@c.EmployeeNo</span></td>
                            <td>@(string.IsNullOrWhiteSpace(c.DeviceLabel) ? "—" : c.DeviceLabel)</td>
                            <td class="bk-time">@c.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="bk-chip @c.Status">@c.StatusText</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(c.ApprovedBy))
                                {
                                    <span class="bk-time">@c.ApprovedBy · @(c.ApprovedAt?.ToString("MM-dd HH:mm"))</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="bk-time">@(c.LastUsedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td>
                                <div class="bk-actions">
                                    @if (c.Status == WebAuthnCredentialStore.StatusPending)
                                    {
                                        <form method="post" asp-page-handler="Approve" asp-route-id="@c.Id">
                                            <button type="submit" class="bk-btn ok">اعتماد</button>
                                        </form>
                                        <form method="post" asp-page-handler="Reject" asp-route-id="@c.Id">
                                            <button type="submit" class="bk-btn danger" data-zyconfirm="تأكيد رفض المفتاح؟">رفض</button>
                                        </form>
                                    }
                                    else if (c.Status == WebAuthnCredentialStore.StatusActive)
                                    {
                                        <form method="post" asp-page-handler="Revoke" asp-route-id="@c.Id">
                                            <button type="submit" class="bk-btn danger" data-zyconfirm="تأكيد إلغاء المفتاح؟ لن يعمل للبصم ولا للدخول.">إلغاء المفتاح</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

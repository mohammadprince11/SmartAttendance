@page "/EmployeeGeoLocations"
@model SmartAttendance.Web.Pages.EmployeeGeoLocations.IndexModel
@using SmartAttendance.Web.Infrastructure.Hrms
@using System.Text.Json

@*
    المواقع الجغرافية للموظفين — الصفحة الرابعة بقسم «حضور الموظفين» (نمط كيان):
    قائمة موظفين + Geo Location + تعيين جماعي + إدارة تعريفات المواقع (geofence).
*@

@{
    ViewData["Title"] = "المواقع الجغرافية للموظفين";
    var locsJson = JsonSerializer.Serialize(Model.Locations.Select(l => new { l.Id, l.Name, l.Latitude, l.Longitude, l.RadiusMeters, l.IsActive }));
}

@* الأنماط برأس الصفحة (section Styles) لا بجسمها — منعاً لوميض «الشكل القديم ثم الجديد» (FOUC) *@
@section Styles {
<link rel="stylesheet" href="~/css/pages/index-5d47c478df.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />

}

<section class="geo-page" dir="rtl">
    <header class="geo-head">
        <div>
            <h1>المواقع الجغرافية للموظفين</h1>
            <p>ربط موقع جغرافي (نطاق مسموح للبصم) بالموظفين — التعريفات تُدار من «إدارة المواقع». الإنفاذ وقت البصم يُفعَّل من «إعدادات الحضور».</p>
        </div>
        <div class="zyu-39c68df36fcc">
            <span class="geo-stat zyu-22d70a2892cd">معيّن <b>@Model.AssignedCount</b></span>
            <span class="geo-stat zyu-fecc85c94a43">بلا موقع <b>@Model.UnassignedCount</b></span>
            <button type="button" class="geo-btn ghost" onclick="geoManage()">إدارة المواقع (@Model.Locations.Count)</button>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="geo-alert">@TempData["SuccessMessage"]</div>
    }

    <form method="get" class="geo-bar">
        <label>بحث (رمز/اسم/هيكلية/وحدة)
            <input type="text" name="Search" value="@Model.Search" placeholder="بحث..." />
        </label>
        <label>عرض
            <select name="Filter">
                <option value="All" selected="@(Model.Filter == "All")">الكل</option>
                <option value="Assigned" selected="@(Model.Filter == "Assigned")">المعيّنون</option>
                <option value="Unassigned" selected="@(Model.Filter == "Unassigned")">بلا موقع</option>
            </select>
        </label>
        <button type="submit" class="geo-btn ghost">عرض</button>
    </form>

    <form method="post" id="geo-form-list">
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="Filter" value="@Model.Filter" />

        <div class="zyu-e2ba48f2bbc4">
            <button type="button" class="geo-btn ghost sm" onclick="geoSelectAll(true)">تحديد الكل (@Model.TotalRows)</button>
            <button type="button" class="geo-btn ghost sm" onclick="geoSelectAll(false)">مسح الكل</button>
        </div>

        <div class="geo-table-card zyu-0ee7f66ad9c0">
            @if (Model.Rows.Count == 0)
            {
                <div class="geo-empty">لا موظفون مطابقون.</div>
            }
            else
            {
                <table class="geo-table">
                    <thead>
                        <tr><th class="zyu-d12729b3d536"><input type="checkbox" id="geo-all" onchange="geoToggleAll(this)" /></th>
                            <th>الرمز</th><th>اسم الموظف</th><th>الهيكلية</th><th>وحدة عمل</th><th>Geo Location</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.TotalRows > Model.Rows.Count)
                        {
                            <tr><td colspan="6" class="zyu-02a14627fe2c">
                                يُعرض أول @Model.Rows.Count من @Model.TotalRows موظفاً — استخدم البحث أو فلتر «بلا موقع/معيّن» للوصول للبقية.
                            </td></tr>
                        }
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td><input type="checkbox" name="SelectedIds" value="@row.EmployeeId" onchange="geoCount()" /></td>
                                <td class="zyu-934736f196e1">@row.EmployeeNo</td>
                                <td><b>@row.EmployeeName</b></td>
                                <td>@row.Department</td>
                                <td>@row.Branch</td>
                                <td>
                                    @if (row.GeoLocationName != null)
                                    { <span class="geo-loc">📍 @row.GeoLocationName</span> }
                                    else
                                    { <span class="geo-none">— بلا موقع</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="geo-bulkbar" id="geo-bulkbar">
            <b>المحدد: <span id="geo-count">0</span></b>
            <select name="GeoLocationId">
                <option value="">— اختر الموقع —</option>
                @foreach (var loc in Model.Locations)
                {
                    <option value="@loc.Id">@loc.Name</option>
                }
            </select>
            <button type="submit" asp-page-handler="Assign" class="geo-btn" data-zyconfirm="تعيين الموقع للمحدد؟">تعيين للمحدد</button>
            <button type="submit" asp-page-handler="Unassign" class="geo-btn no" data-zyconfirm="إلغاء تعيين المحدد؟">إلغاء التعيين</button>
        </div>
    </form>

    @* ---------- سلايد إدارة المواقع ---------- *@
    <div class="hrms-slideover-backdrop" id="geo-backdrop" onclick="geoClose()"></div>
    <aside class="hrms-slideover wide" id="geo-slide" aria-hidden="true">
        <div class="hrms-slideover-head">
            <h2>إدارة المواقع الجغرافية</h2>
            <button type="button" class="hrms-slideover-close" onclick="geoClose()">×</button>
        </div>
        <div class="hrms-slideover-body zyu-8b0ebad99652">
            <form method="post" asp-page-handler="SaveLocation" class="geo-form">
                <input type="hidden" name="Search" value="@Model.Search" />
                <input type="hidden" name="Filter" value="@Model.Filter" />
                <input type="hidden" name="LocId" id="geo-LocId" value="0" />
                <label>اسم الموقع *<input type="text" name="LocName" id="geo-LocName" required placeholder="مثال: المكتب الرئيسي" /></label>
                <div class="zyu-71658681447f">
                    <label>خط العرض (Latitude)<input type="number" step="any" inputmode="decimal" name="LocLat" id="geo-LocLat" value="0" /></label>
                    <label>خط الطول (Longitude)<input type="number" step="any" inputmode="decimal" name="LocLng" id="geo-LocLng" value="0" /></label>
                </div>
                <label>نصف القطر (متر)<input type="number" name="LocRadius" id="geo-LocRadius" value="100" min="1" class="zyu-eb9e070a2eee" oninput="geoMapCircle()" /></label>
                <div>
                    <label class="zyu-e08c1b3326b7">اختر الموقع من الخريطة (نقرة تحدّد الإحداثيات، والدائرة = نصف القطر)</label>
                    <div class="zyu-5864c5f610eb">
                        <input type="text" id="geo-search" placeholder="ابحث عن مكان… (مثال: المنصور بغداد)" class="zyu-83725d2c6e00"
                               onkeydown="if(event.key==='Enter'){event.preventDefault();geoSearch();}" />
                        <button type="button" class="geo-btn ghost sm" onclick="geoSearch()">بحث</button>
                        <button type="button" class="geo-btn ghost sm" onclick="geoMyLocation()" title="موقعي الحالي">📍 موقعي</button>
                        <button type="button" class="geo-btn ghost sm" onclick="geoToggleLayer()" id="geo-layerbtn" title="تبديل قمر صناعي/خريطة">🛰️</button>
                    </div>
                    <div id="geo-results" class="zyu-045c12a33d2c"></div>
                    <div id="geo-map" class="zyu-f45227f99c0e"></div>
                </div>
                <label class="zyu-95e15889185d"><input type="checkbox" name="LocActive" value="true" id="geo-LocActive" checked /> الموقع نشط</label>
                <div class="zyu-9c40389b4ad8">
                    <button type="submit" class="geo-btn">حفظ الموقع</button>
                    <button type="button" class="geo-btn ghost" onclick="geoResetForm()">جديد</button>
                </div>
            </form>

            <div>
                <label class="zyu-e08c1b3326b7">المواقع المعرّفة</label>
                <div class="geo-loclist zyu-43a97fe4943c">
                    @if (Model.Locations.Count == 0)
                    {
                        <span class="geo-none zyu-a49cca52becd">لا مواقع بعد.</span>
                    }
                    @foreach (var loc in Model.Locations)
                    {
                        <div class="geo-locrow">
                            <div>
                                <b>@loc.Name</b>
                                <span class="co">@loc.Latitude.ToString("0.####"), @loc.Longitude.ToString("0.####") · @loc.RadiusMeters م</span>
                            </div>
                            <div class="zyu-69374f356aba">
                                <button type="button" class="geo-btn ghost sm" onclick="geoEdit(@loc.Id)">تعديل</button>
                                <form method="post" asp-page-handler="DeleteLocation" class="zyu-6b8b63d565c4">
                                    <input type="hidden" name="Search" value="@Model.Search" />
                                    <input type="hidden" name="Filter" value="@Model.Filter" />
                                    <input type="hidden" name="id" value="@loc.Id" />
                                    <button type="submit" class="geo-btn ghost sm zyu-94c76e9c8583" data-zyconfirm="حذف الموقع؟">حذف</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </aside>
</section>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script>
        var GEO_LOCS = @Html.Raw(locsJson);

        function geoToggleAll(src) { geoSelectAll(src.checked); }
        function geoSelectAll(on) {
            document.querySelectorAll('[name="SelectedIds"]').forEach(function (cb) { cb.checked = on; });
            var h = document.getElementById('geo-all'); if (h) h.checked = on;
            geoCount();
        }
        function geoCount() {
            var n = document.querySelectorAll('[name="SelectedIds"]:checked').length;
            document.getElementById('geo-count').textContent = n;
            document.getElementById('geo-bulkbar').classList.toggle('show', n > 0);
            var total = document.querySelectorAll('[name="SelectedIds"]').length;
            var h = document.getElementById('geo-all'); if (h) h.checked = n > 0 && n === total;
        }

        function geoManage() {
            document.getElementById('geo-slide').classList.add('open');
            document.getElementById('geo-backdrop').classList.add('open');
            // الخريطة تُهيّأ عند أول فتح (اللوح كان مخفياً فيلزم invalidateSize بعد الظهور)
            setTimeout(geoMapInit, 220);
        }

        // ===== خريطة اختيار الموقع (Leaflet + OpenStreetMap، ملفات محلية بلا CDN) =====
        var geoMap = null, geoMarker = null, geoCircle = null, geoBase = null, geoSat = false;
        function geoNum(id) { var v = parseFloat(document.getElementById(id).value); return isFinite(v) ? v : 0; }
        function geoMapInit() {
            if (typeof L === 'undefined') return;
            var lat = geoNum('geo-LocLat'), lng = geoNum('geo-LocLng');
            var hasPoint = lat !== 0 || lng !== 0;
            if (!geoMap) {
                geoMap = L.map('geo-map').setView(hasPoint ? [lat, lng] : [33.3152, 44.3661], hasPoint ? 16 : 11);
                geoBase = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19, attribution: '&copy; OpenStreetMap'
                }).addTo(geoMap);
                geoMap.on('click', function (e) {
                    document.getElementById('geo-LocLat').value = e.latlng.lat.toFixed(6);
                    document.getElementById('geo-LocLng').value = e.latlng.lng.toFixed(6);
                    geoMapPoint(e.latlng.lat, e.latlng.lng, true);
                });
                // النطاقات المحفوظة الأخرى — دوائر باهتة للسياق (لا تُعدَّل من الخريطة)
                (GEO_LOCS || []).forEach(function (l) {
                    if (l.Latitude || l.Longitude)
                        L.circle([l.Latitude, l.Longitude], { radius: Math.max(10, l.RadiusMeters), color: '#64748b', fillOpacity: .06, weight: 1 })
                         .bindTooltip(l.Name).addTo(geoMap);
                });
            }
            geoMap.invalidateSize();
            if (hasPoint) geoMapPoint(lat, lng, false);
        }

        // تبديل الأساس: خريطة شوارع ↔ قمر صناعي (Esri World Imagery، بلا مفتاح)
        function geoToggleLayer() {
            if (!geoMap) return;
            geoMap.removeLayer(geoBase);
            geoSat = !geoSat;
            geoBase = geoSat
                ? L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19, attribution: '&copy; Esri' })
                : L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap' });
            geoBase.addTo(geoMap);
            document.getElementById('geo-layerbtn').textContent = geoSat ? '🗺️' : '🛰️';
        }

        // بحث الأماكن عبر Nominatim (خدمة OpenStreetMap المجانية) بأولوية عربية
        function geoSearch() {
            var q = document.getElementById('geo-search').value.trim();
            var box = document.getElementById('geo-results');
            if (!q) { box.style.display = 'none'; return; }
            box.style.display = 'block';
            box.innerHTML = '<div class="zyu-5de347d2338a">جارٍ البحث…</div>';
            fetch('https://nominatim.openstreetmap.org/search?format=json&limit=5&accept-language=ar&q=' + encodeURIComponent(q))
                .then(function (r) { return r.json(); })
                .then(function (list) {
                    if (!list.length) { box.innerHTML = '<div class="zyu-5de347d2338a">لا نتائج.</div>'; return; }
                    box.innerHTML = '';
                    list.forEach(function (item) {
                        var row = document.createElement('button');
                        row.type = 'button';
                        row.textContent = item.display_name;
                        row.style.cssText = 'display:block;width:100%;text-align:right;padding:8px 12px;font-size:12px;font-weight:800;background:transparent;border:0;border-bottom:1px solid rgba(73,111,151,.15);cursor:pointer;color:inherit';
                        row.onclick = function () {
                            box.style.display = 'none';
                            var lat = parseFloat(item.lat), lng = parseFloat(item.lon);
                            document.getElementById('geo-LocLat').value = lat.toFixed(6);
                            document.getElementById('geo-LocLng').value = lng.toFixed(6);
                            geoMapPoint(lat, lng, false);
                        };
                        box.appendChild(row);
                    });
                })
                .catch(function () { box.innerHTML = '<div class="zyu-5de347d2338a">تعذّر البحث — تحقق من الإنترنت.</div>'; });
        }

        // «موقعي الحالي»: يتمركز على GPS الجهاز ويحدد الدبوس (يحتاج سماح إذن الموقع)
        function geoMyLocation() {
            if (!navigator.geolocation || !geoMap) return;
            navigator.geolocation.getCurrentPosition(function (p) {
                document.getElementById('geo-LocLat').value = p.coords.latitude.toFixed(6);
                document.getElementById('geo-LocLng').value = p.coords.longitude.toFixed(6);
                geoMapPoint(p.coords.latitude, p.coords.longitude, false);
            }, function () { alert('تعذّر الحصول على موقعك — تأكد من السماح بإذن الموقع.'); }, { timeout: 8000 });
        }
        function geoMapPoint(lat, lng, keepZoom) {
            if (!geoMap) return;
            if (!geoMarker) {
                geoMarker = L.marker([lat, lng], { draggable: true }).addTo(geoMap);
                geoMarker.on('dragend', function () {
                    var p = geoMarker.getLatLng();
                    document.getElementById('geo-LocLat').value = p.lat.toFixed(6);
                    document.getElementById('geo-LocLng').value = p.lng.toFixed(6);
                    geoMapPoint(p.lat, p.lng, true);
                });
            } else { geoMarker.setLatLng([lat, lng]); }
            geoMapCircle();
            if (!keepZoom) geoMap.setView([lat, lng], 16);
        }
        function geoMapCircle() {
            if (!geoMap || !geoMarker) return;
            var p = geoMarker.getLatLng();
            var r = Math.max(10, geoNum('geo-LocRadius') || 100);
            if (!geoCircle) geoCircle = L.circle(p, { radius: r, color: '#0d9488', fillOpacity: .15 }).addTo(geoMap);
            else { geoCircle.setLatLng(p); geoCircle.setRadius(r); }
        }
        function geoClose() {
            document.getElementById('geo-slide').classList.remove('open');
            document.getElementById('geo-backdrop').classList.remove('open');
        }
        function geoResetForm() {
            document.getElementById('geo-LocId').value = 0;
            document.getElementById('geo-LocName').value = '';
            document.getElementById('geo-LocLat').value = 0;
            document.getElementById('geo-LocLng').value = 0;
            document.getElementById('geo-LocRadius').value = 100;
            document.getElementById('geo-LocActive').checked = true;
        }
        function geoEdit(id) {
            var l = GEO_LOCS.find(function (x) { return x.Id === id; });
            if (!l) return;
            document.getElementById('geo-LocId').value = l.Id;
            document.getElementById('geo-LocName').value = l.Name;
            document.getElementById('geo-LocLat').value = l.Latitude;
            document.getElementById('geo-LocLng').value = l.Longitude;
            document.getElementById('geo-LocRadius').value = l.RadiusMeters;
            document.getElementById('geo-LocActive').checked = !!l.IsActive;
            geoManage();
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') geoClose(); });
    </script>
}

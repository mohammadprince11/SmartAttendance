@{
    Layout = null;
    var userName = Context.User.Identity?.Name ?? "employee";
    var role = Context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Employee";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - NEXORA Employee Experience</title>

    @* ===== PWA — تطبيق قابل للتثبيت على كل الأجهزة ===== *@
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#071424" />
    <meta name="color-scheme" content="dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="بوابتي" />
    <meta name="application-name" content="بوابتي" />
    <link rel="apple-touch-icon" href="~/brand/pwa/apple-touch-icon.png?v=2" />
    <link rel="icon" type="image/svg+xml" href="~/brand/pwa/icon-white.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/brand/pwa/icon-192.png?v=2" />

    <link rel="stylesheet" href="~/css/nexora-calendar-v18.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nexora-employee-experience.css" asp-append-version="true" />

    @* ===== شاشة البداية: أنميشن الشعار عند إطلاق التطبيق (خفيفة، مرة واحدة/جلسة) ===== *@
    <style>
        /* شاشة الإقلاع بنفس لون خلفية التطبيق (بلا مربّع)، والشعار أكبر مع سكيل-أنميشن احترافي */
        #nxsp-splash{position:fixed;inset:0;z-index:100000;display:grid;place-items:center;background:#050d18;
            animation:nxspOut .5s ease 1.95s forwards}
        #nxsp-splash.nxsp-skip{display:none}
        #nxsp-splash svg{width:min(66vw,250px);height:auto;overflow:visible;transform-origin:center;
            animation:nxspScale .85s cubic-bezier(.2,.9,.25,1.15) forwards}
        @@keyframes nxspScale{0%{opacity:0;transform:scale(.5)}60%{opacity:1;transform:scale(1.05)}100%{opacity:1;transform:scale(1)}}
        @@keyframes nxspOut{to{opacity:0;visibility:hidden}}
        #nxsp-splash .nxsp{opacity:0;transform-box:fill-box}
        #nxsp-splash .nxsp-top{animation:nxspTop .5s cubic-bezier(.2,.85,.25,1) .28s forwards}
        #nxsp-splash .nxsp-bottom{animation:nxspBottom .5s cubic-bezier(.2,.85,.25,1) .4s forwards}
        #nxsp-splash .nxsp-diag{transform-origin:left bottom;animation:nxspDiag .55s cubic-bezier(.2,.85,.25,1) .55s forwards}
        #nxsp-splash .nxsp-facet{animation:nxspFade .5s ease .72s forwards}
        #nxsp-splash .nxsp-anchor{transform-origin:center;animation:nxspPop .45s cubic-bezier(.3,1.5,.5,1) .8s forwards}
        #nxsp-splash .nxsp-px{transform-origin:center;animation:nxspPop .4s cubic-bezier(.3,1.6,.5,1) forwards}
        @@keyframes nxspTop{from{opacity:0;transform:translateY(-26px)}to{opacity:1;transform:none}}
        @@keyframes nxspBottom{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
        @@keyframes nxspDiag{from{opacity:0;transform:scaleY(.15)}to{opacity:1;transform:none}}
        @@keyframes nxspFade{to{opacity:.8}}
        @@keyframes nxspPop{from{opacity:0;transform:scale(0)}to{opacity:1;transform:scale(1)}}
        @@media (prefers-reduced-motion:reduce){
            #nxsp-splash svg{animation-duration:.01s !important}
            #nxsp-splash .nxsp{animation-duration:.01s !important;animation-delay:0s !important}
        }
        /* ===== وضع التضمين (embed): إخفاء زينة البوابة وعرض النموذج فقط داخل مودال ===== */
        .nxex-embed .nxex-shell-sidebar,.nxex-embed .nxex-topbar,.nxex-embed .nxex-bottom-nav,.nxex-embed .nxex-fab,.nxex-embed #nxsp-splash,.nxex-embed .nxex-ios-hint{display:none!important}
        .nxex-embed .nxex-shell-main{margin:0!important;padding:14px 14px 26px!important;max-width:none!important}
        .nxex-embed-backdrop{position:fixed;inset:0;z-index:900;background:rgba(2,8,16,.62);opacity:0;transition:opacity .22s}
        .nxex-embed-backdrop.open{opacity:1}.nxex-embed-backdrop[hidden]{display:none}
        .nxex-embed-modal{position:fixed;left:0;right:0;bottom:0;z-index:901;display:flex;flex-direction:column;height:92vh;max-height:92vh;background:#071626;border-radius:20px 20px 0 0;border:1px solid rgba(91,132,176,.2);transform:translateY(100%);transition:transform .28s cubic-bezier(.2,.8,.2,1)}
        html[data-theme="light"] .nxex-embed-modal{background:#eef6f8}
        .nxex-embed-modal.open{transform:translateY(0)}.nxex-embed-modal[hidden]{display:none}
        .nxex-embed-head{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid rgba(91,132,176,.16)}
        .nxex-embed-head h2{margin:0;font-size:16px;font-weight:1000;color:var(--sa-text,#e6f0fa);flex:1}
        .nxex-embed-close{width:34px;height:34px;border-radius:50%;border:1px solid rgba(91,132,176,.3);background:transparent;color:inherit;font-size:15px;cursor:pointer}
        .nxex-embed-frame{flex:1;width:100%;border:0;background:transparent}
    </style>
</head>
@{ var embed = Context.Request.Query["embed"] == "1"; }
<body class="nxex-body @(embed ? "nxex-embed" : "")">
    <div id="nxsp-splash" aria-hidden="true">
        <svg viewBox="0 0 1024 1024" role="img" aria-label="ZYNORA">
            <path class="nxsp nxsp-top"    fill="#F7F9FB" d="M170 218h520l-112 126H58z"/>
            <path class="nxsp nxsp-diag"   fill="#18C7BD" d="M584 294h176L360 746H184z"/>
            <path class="nxsp nxsp-facet"  fill="#42DED3" d="M584 294h88L272 746h-88z"/>
            <path class="nxsp nxsp-bottom" fill="#F7F9FB" d="M334 680h520L742 806H222z"/>
            <rect class="nxsp nxsp-anchor" x="150" y="720" width="74" height="74" rx="8" fill="#D4B36A"/>
            <rect class="nxsp nxsp-px" style="animation-delay:.66s" x="650" y="184" width="62" height="62" rx="6" fill="#18C7BD"/>
            <rect class="nxsp nxsp-px" style="animation-delay:.72s" x="726" y="184" width="62" height="62" rx="6" fill="#18C7BD"/>
            <rect class="nxsp nxsp-px" style="animation-delay:.78s" x="802" y="184" width="62" height="62" rx="6" fill="#18C7BD"/>
            <rect class="nxsp nxsp-px" style="animation-delay:.84s" x="726" y="108" width="62" height="62" rx="6" fill="#18C7BD"/>
            <rect class="nxsp nxsp-px" style="animation-delay:.90s" x="802" y="108" width="62" height="62" rx="6" fill="#18C7BD"/>
            <rect class="nxsp nxsp-px" style="animation-delay:.96s" x="878" y="108" width="62" height="62" rx="6" fill="#18C7BD"/>
            <rect class="nxsp nxsp-px" style="animation-delay:1.02s" x="802" y="32" width="62" height="62" rx="6" fill="#18C7BD"/>
            <rect class="nxsp nxsp-px" style="animation-delay:1.08s" x="878" y="32" width="62" height="62" rx="6" fill="#18C7BD"/>
        </svg>
    </div>
    <script>
        (function () {
            var sp = document.getElementById('nxsp-splash');
            if (!sp) return;
            try {
                if (sessionStorage.getItem('nxspShown')) { sp.classList.add('nxsp-skip'); return; }
                sessionStorage.setItem('nxspShown', '1');
            } catch (e) { }
            setTimeout(function () { sp.parentNode && sp.parentNode.removeChild(sp); }, 2600);
        })();
    </script>
    <aside class="nxex-shell-sidebar">
        <div class="nxex-brand">
            <div class="nxex-brand-symbol">NX</div>
            <div>
                <strong>NEXORA</strong>
                <span>Employee Experience</span>
            </div>
        </div>

        <div class="nxex-user-mini">
            <span>المستخدم الحالي</span>
            <strong>@userName</strong>
            <small>@role</small>
        </div>

        <nav class="nxex-side-nav">
            <a href="/EmployeePortal?tab=home">الرئيسية</a>
            <a href="/EmployeePortal?tab=profile">ملفي الشخصي</a>
            <a href="/EmployeePortal?tab=attendance">الحضور</a>
            <a href="/EmployeePortal?tab=compensation">الراتب والتعويضات</a>
            <a href="/EmployeePortal?tab=requests">طلباتي</a>
            <a href="/EmployeePortal?tab=pulse">الاستبيانات</a>
            <a href="/EmployeePortal?tab=feedback">الشكاوي والمقترحات</a>
            <a href="/EmployeePortal?tab=performance">التقييم والانضباط</a>
        </nav>

        <div class="nxex-side-note">
            <strong>بوابة الموظف</strong>
            <span>واجهة السينك الرسمية لكل ما ينشر أو يسجل من الإدارة.</span>
        </div>
    </aside>

    <main class="nxex-shell-main">
        <div class="nxex-topbar">
            <div>
                <strong>بوابة الموظف الذكية</strong>
                <span>Employee Experience Portal · <b style="color:#19d3e0">إصدار v7</b></span>
            </div>
            <div class="nxex-topbar-actions">
                <button type="button" id="pwa-install-btn" class="nxex-install-btn" hidden>
                    ⬇ تثبيت التطبيق
                </button>
                <a href="/Account/Logout">خروج</a>
            </div>
        </div>

        <div id="pwa-ios-hint" class="nxex-ios-hint" hidden>
            لتثبيت التطبيق على iPhone: اضغط زر المشاركة
            <span aria-hidden="true">􀈂</span> ثم «أضف إلى الشاشة الرئيسية».
        </div>

        @RenderBody()
    </main>

    @* ===== شريط التنقّل السفلي (موبايل فقط) — يستبدل الشريط الجانبي والتبويبات المكرّرة ===== *@
    <nav class="nxex-bottom-nav" aria-label="التنقّل السريع">
        <button type="button" class="nxex-bnav-item" data-nxex-tab="home">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
            <span>الرئيسية</span>
        </button>
        <button type="button" class="nxex-bnav-item" data-nxex-tab="attendance">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
            <span>الحضور</span>
        </button>
        <button type="button" class="nxex-bnav-item" data-nxex-tab="requests" data-scroll-target=".nxex-request-list-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13l2.5-8h11L20 13"/><path d="M4 13v6h16v-6M4 13h4l1 2h6l1-2h4"/></svg>
            <span>طلباتي</span>
        </button>
        <button type="button" class="nxex-bnav-item" data-nxex-tab="compensation">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M16 14h2"/></svg>
            <span>الراتب</span>
        </button>
        <button type="button" class="nxex-bnav-item" id="nxex-more-btn" data-nxex-more-toggle aria-haspopup="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            <span>المزيد</span>
        </button>
    </nav>

    @* زر «طلب جديد» عائم (موبايل) — يفتح منتقي أنواع الطلبات *@
    <button type="button" class="nxex-fab" data-open-reqsheet aria-label="طلب جديد">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
    </button>

    @* درج منتقي «طلب جديد»: النسخة الكاملة (بفئات المتجر + شاشة الإجازة) تُرندَر في
       صفحة البوابة (Index). على الصفحات الفرعية نرندر نسخة روابط خفيفة بنفس المعرّف
       حتى يفتح زر «+» بمكانه بلا انتقال. *@
    @{
        var __page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        var __isEmployeeHub = __page.Equals("/EmployeePortal/Index", StringComparison.OrdinalIgnoreCase);
    }
    @if (!__isEmployeeHub && !embed)
    {
        <div class="nxex-more-backdrop" id="nxex-req-backdrop" hidden></div>
        <div class="nxex-more-sheet nxex-req-sheet" id="nxex-req-sheet" role="dialog" aria-label="نوع الطلب" hidden>
            <div class="nxex-more-handle"></div>
            <h3>طلب جديد</h3>
            <div class="nxex-more-grid">
                <a class="nxex-more-item" href="/EmployeePortal?open=leave">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M6 21V10l6-4 6 4v11M9 21v-5h6v5"/></svg>
                    <span>إجازة</span>
                </a>
                <button type="button" class="nxex-more-item" data-embed-src="/EmployeePortal/MissingPunch?embed=1" data-embed-title="نسيان بصمة">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 11v3m0 0 2 2m-2-2-2 2M7 8a5 5 0 0 1 10 0c0 2-1 3-1 5"/><circle cx="12" cy="12" r="9"/></svg>
                    <span>نسيان بصمة</span>
                </button>
                <button type="button" class="nxex-more-item" data-embed-src="/EmployeePortal/DataChange?embed=1" data-embed-title="تعديل بياناتي">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    <span>تعديل بياناتي</span>
                </button>
                <button type="button" class="nxex-more-item" data-embed-src="/EmployeePortal/FinancialRequest?embed=1" data-embed-title="طلب مالي">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    <span>طلب مالي</span>
                </button>
            </div>
        </div>
    }

    @* مودال التضمين العام: يعرض نموذج أي طلب داخل البوابة بمكانه (iframe) بلا انتقال *@
    @if (!embed)
    {
        <div class="nxex-embed-backdrop" id="nxex-embed-backdrop" hidden></div>
        <div class="nxex-embed-modal" id="nxex-embed-modal" role="dialog" aria-modal="true" hidden>
            <div class="nxex-embed-head">
                <button type="button" class="nxex-embed-close" data-embed-close aria-label="إغلاق">✕</button>
                <h2 id="nxex-embed-title">طلب</h2>
            </div>
            <iframe class="nxex-embed-frame" id="nxex-embed-frame" title="نموذج الطلب"></iframe>
        </div>
    }

    <div class="nxex-more-backdrop" id="nxex-more-backdrop" hidden></div>
    <div class="nxex-more-sheet" id="nxex-more-sheet" role="dialog" aria-label="أقسام إضافية" hidden>
        <div class="nxex-more-handle"></div>
        <h3>أقسام أخرى</h3>
        <div class="nxex-more-grid">
            <button type="button" class="nxex-more-item" data-nxex-tab="profile">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
                <span>ملفي الشخصي</span>
            </button>
            <button type="button" class="nxex-more-item" data-nxex-tab="pulse">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-6 4 12 2-6h6"/></svg>
                <span>الاستبيانات</span>
            </button>
            <button type="button" class="nxex-more-item" data-nxex-tab="feedback">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span>الشكاوي والمقترحات</span>
            </button>
            <button type="button" class="nxex-more-item" data-nxex-tab="performance">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M8 14l-2 7 6-3 6 3-2-7"/></svg>
                <span>التقييم والانضباط</span>
            </button>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/nexora-calendar-v18.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/nxex-bottom-nav.js" asp-append-version="true"></script>
    <script src="~/js/nxex-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/nxex-timepicker.js" asp-append-version="true"></script>
</body>
</html>


@using SmartAttendance.Web.Infrastructure.Security
@{
    // ③ اعتماد الحضور — مبدّل الفترة: نفس دورة الاعتماد (بناء/مراجعة/اعتماد/قفل)،
    // الفرق «الفترة» فقط (شهري ↔ أسبوعي). Stores منفصلة تبقى — هذا مبدّل عرضٍ لا دمج
    // بيانات. كل فترةٍ محكومة بصلاحية مسارها الأصلي عبر RoleRouteCatalog (نفس ما
    // ينفّذه RoleSecurityMiddleware) ⟹ لا توسيع رؤية، والمساران يبقيان حيّين.
    var loginRole = Context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var currentPath = (Context.Request.Path.Value ?? "/").TrimEnd('/').ToLowerInvariant();

    var views = new (string Label, string Page, string Route)[]
    {
        ("شهري", "/MonthAttendance/Index", "/monthattendance"),
        ("أسبوعي", "/WeekAttendance/Index", "/weekattendance"),
    };

    var visible = views
        .Where(v => RoleRouteCatalog.IsAllowed(loginRole, v.Route))
        .ToList();
}
@if (visible.Count > 1)
{
<link rel="stylesheet" href="~/css/pages/_attendanceapprovalviews-3115a62117.css" asp-append-version="true" />
    <nav class="att-views" aria-label="فترة اعتماد الحضور">
        @foreach (var v in visible)
        {
            var active = currentPath == v.Route
                || currentPath.StartsWith(v.Route + "/", StringComparison.Ordinal);
            <a asp-page="@v.Page" class="att-view @(active ? "is-active" : "")">@v.Label</a>
        }
    </nav>
    }

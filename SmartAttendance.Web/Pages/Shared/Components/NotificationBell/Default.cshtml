@model SmartAttendance.Web.Infrastructure.Notifications.BackOfficeNotificationStore.BellView
@{
    var unread = Model.UnreadCount;
}

@* جرس إشعارات الـback-office — CSS مضمّن (لا ملف أصول) تفادياً لفخّ مانيفست الأصول. *@
<style>
    .zy-bell { position: relative; }
    .zy-bell > summary {
        list-style: none; cursor: pointer; display: inline-flex;
        align-items: center; justify-content: center;
        width: 40px; height: 40px; border-radius: 12px;
        background: var(--color-background, #10151f));
        border: 1px solid var(--color-border, rgba(255,255,255,.10));
        color: var(--color-text-primary, #e8ecf1); position: relative; transition: background .15s ease;
    }
    .zy-bell > summary::-webkit-details-marker { display: none; }
    .zy-bell > summary:hover { background: var(--color-primary-soft, rgba(255,255,255,.10)); }
    .zy-bell[open] > summary { background: var(--color-primary-soft, rgba(255,255,255,.10)); }
    .zy-bell-icon { width: 20px; height: 20px; }
    .zy-bell-badge {
        position: absolute; top: -4px; inset-inline-end: -4px; min-width: 18px; height: 18px;
        padding: 0 5px; border-radius: 9px; background: #e5484d; color: #fff;
        font-size: 11px; font-weight: 700; line-height: 18px; text-align: center;
        box-shadow: 0 0 0 2px var(--zy-bg, #0f1420);
    }
    .zy-bell-panel {
        position: absolute; inset-inline-end: 0; top: calc(100% + 8px); width: 360px; max-width: 92vw;
        background: var(--color-surface, #171d2b); border: 1px solid var(--color-border, rgba(255,255,255,.10));
        border-radius: 14px; box-shadow: 0 18px 48px rgba(0,0,0,.42); z-index: 1400; overflow: hidden;
    }
    .zy-bell-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 12px 14px; border-bottom: 1px solid var(--zy-border, rgba(255,255,255,.08));
    }
    .zy-bell-head b { font-size: 14px; color: var(--color-text-primary, #e8ecf1); }
    .zy-bell-markall {
        background: transparent; border: 0; cursor: pointer; padding: 4px 6px; border-radius: 8px;
        color: var(--zy-teal, #1aa3a3); font-size: 12px; font-weight: 600;
    }
    .zy-bell-markall:hover { background: var(--color-background, #10151f)); }
    .zy-bell-markall[disabled] { opacity: .45; cursor: default; }
    .zy-bell-list { max-height: 380px; overflow-y: auto; }
    .zy-bell-item {
        display: block; padding: 11px 14px; text-decoration: none; color: inherit;
        border-bottom: 1px solid var(--zy-border, rgba(255,255,255,.05));
        border-inline-start: 3px solid var(--zy-teal, #1aa3a3);
    }
    .zy-bell-item:hover { background: var(--color-background, #10151f)); }
    .zy-bell-item.is-read { border-inline-start-color: transparent; opacity: .6; }
    .zy-bell-item-title { font-size: 13px; font-weight: 600; color: var(--color-text-primary, #e8ecf1); margin: 0 0 3px; }
    .zy-bell-item-msg { font-size: 12px; color: var(--color-text-secondary, #a7b0c0); margin: 0; line-height: 1.5; }
    .zy-bell-item-time { font-size: 11px; color: var(--color-text-secondary, #7a839a); margin-top: 4px; display: block; }
    .zy-bell-empty { padding: 28px 14px; text-align: center; color: var(--color-text-secondary, #a7b0c0); font-size: 13px; }
</style>

<details class="zy-bell" id="zyBell">
    @Html.AntiForgeryToken()
    <summary aria-label="الإشعارات" title="الإشعارات">
        <svg class="zy-bell-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.7 21a2 2 0 0 1-3.4 0" />
        </svg>
        <span class="zy-bell-badge" id="zyBellBadge" style="@(unread > 0 ? "" : "display:none")">@(unread > 99 ? "99+" : unread.ToString())</span>
    </summary>

    <div class="zy-bell-panel">
        <div class="zy-bell-head">
            <b>الإشعارات</b>
            <button type="button" class="zy-bell-markall" id="zyBellMarkAll" @(unread > 0 ? "" : "disabled")>تعليم الكل كمقروء</button>
        </div>
        <div class="zy-bell-list" id="zyBellList">
            @if (Model.Items.Count == 0)
            {
                <div class="zy-bell-empty">لا توجد إشعارات</div>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    var href = string.IsNullOrWhiteSpace(item.Url) ? "#" : item.Url;
                    <a class="zy-bell-item @(item.IsRead ? "is-read" : "")" href="@href" data-id="@item.Id">
                        <p class="zy-bell-item-title">@item.Title</p>
                        @if (!string.IsNullOrWhiteSpace(item.Message))
                        {
                            <p class="zy-bell-item-msg">@item.Message</p>
                        }
                        <span class="zy-bell-item-time">@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    </a>
                }
            }
        </div>
    </div>
</details>

<script>
    (function () {
        var bell = document.getElementById("zyBell");
        if (!bell || bell.dataset.wired) return;
        bell.dataset.wired = "1";

        var badge = document.getElementById("zyBellBadge");
        var markAll = document.getElementById("zyBellMarkAll");
        var list = document.getElementById("zyBellList");
        var tokenEl = bell.querySelector('input[name="__RequestVerificationToken"]');

        function token() { return tokenEl ? tokenEl.value : ""; }

        function setBadge(n) {
            if (n > 0) {
                badge.textContent = n > 99 ? "99+" : String(n);
                badge.style.display = "";
                if (markAll) markAll.disabled = false;
            } else {
                badge.style.display = "none";
                if (markAll) markAll.disabled = true;
            }
        }

        function unreadCount() {
            return list.querySelectorAll(".zy-bell-item:not(.is-read)").length;
        }

        // إغلاق القائمة عند النقر خارجها.
        document.addEventListener("click", function (e) {
            if (bell.open && !bell.contains(e.target)) bell.open = false;
        });

        function post(handler, body) {
            var data = new FormData();
            data.append("__RequestVerificationToken", token());
            if (body) { for (var k in body) data.append(k, body[k]); }
            return fetch("/Notifications/Bell?handler=" + handler, {
                method: "POST", body: data, credentials: "same-origin"
            }).then(function (r) { return r.ok ? r.json() : { ok: false }; });
        }

        // تعليم إشعار مفرد كمقروء عند فتحه (لا يمنع الانتقال للرابط).
        list.addEventListener("click", function (e) {
            var item = e.target.closest(".zy-bell-item");
            if (!item || item.classList.contains("is-read")) return;
            var id = item.dataset.id;
            if (!id) return;
            item.classList.add("is-read");
            setBadge(unreadCount());
            post("Read", { id: id });
        });

        if (markAll) {
            markAll.addEventListener("click", function (e) {
                e.preventDefault(); e.stopPropagation();
                if (markAll.disabled) return;
                Array.prototype.forEach.call(list.querySelectorAll(".zy-bell-item"), function (el) {
                    el.classList.add("is-read");
                });
                setBadge(0);
                post("ReadAll");
            });
        }
    })();
</script>

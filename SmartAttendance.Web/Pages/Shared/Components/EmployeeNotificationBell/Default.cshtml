@model SmartAttendance.Web.Infrastructure.Notifications.EmployeeNotificationStore.InboxView
@{
    var unread = Model.UnreadCount;
}

@* جرس إشعارات بوابة الموظف — CSS مضمّن (لا ملف أصول) تفادياً لفخّ مانيفست الأصول. *@
<link rel="stylesheet" href="~/css/pages/default-fe42d97482.css" asp-append-version="true" />

<details class="emp-bell" id="empBell">
    @Html.AntiForgeryToken()
    <summary aria-label="الإشعارات" title="الإشعارات">
        <svg class="emp-bell-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.7 21a2 2 0 0 1-3.4 0" />
        </svg>
        <span class="emp-bell-badge" id="empBellBadge" data-zy-style="@(unread > 0 ? "" : "display:none")">@(unread > 99 ? "99+" : unread.ToString())</span>
    </summary>
    <div class="emp-bell-panel">
        <div class="emp-bell-head">
            <b>الإشعارات</b>
            <button type="button" class="emp-bell-all" id="empBellAll" @(unread > 0 ? "" : "disabled")>تعليم الكل كمقروء</button>
        </div>
        <div class="emp-bell-list" id="empBellList">
            @if (Model.Items.Count == 0)
            {
                <div class="emp-bell-empty">لا توجد إشعارات</div>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    var href = string.IsNullOrWhiteSpace(item.Url) ? "#" : item.Url;
                    <a class="emp-bell-item @(item.IsRead ? "is-read" : "")" href="@href" data-id="@item.Id">
                        <p class="emp-bell-item-t">@item.Title</p>
                        @if (!string.IsNullOrWhiteSpace(item.Message))
                        {
                            <p class="emp-bell-item-m">@item.Message</p>
                        }
                        <span class="emp-bell-item-d">@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    </a>
                }
            }
        </div>
    </div>
</details>

<script>
    (function () {
        var bell = document.getElementById("empBell");
        if (!bell || bell.dataset.wired) return;
        bell.dataset.wired = "1";
        var badge = document.getElementById("empBellBadge");
        var all = document.getElementById("empBellAll");
        var list = document.getElementById("empBellList");
        var tokenEl = bell.querySelector('input[name="__RequestVerificationToken"]');
        function token() { return tokenEl ? tokenEl.value : ""; }
        function unreadCount() { return list.querySelectorAll(".emp-bell-item:not(.is-read)").length; }
        function setBadge(n) {
            if (n > 0) { badge.textContent = n > 99 ? "99+" : String(n); badge.style.display = ""; if (all) all.disabled = false; }
            else { badge.style.display = "none"; if (all) all.disabled = true; }
        }
        document.addEventListener("click", function (e) { if (bell.open && !bell.contains(e.target)) bell.open = false; });
        function post(handler, body) {
            var data = new FormData();
            data.append("__RequestVerificationToken", token());
            if (body) { for (var k in body) data.append(k, body[k]); }
            return fetch("/EmployeePortal/Notifications?handler=" + handler, { method: "POST", body: data, credentials: "same-origin" })
                .then(function (r) { return r.ok ? r.json() : { ok: false }; });
        }
        list.addEventListener("click", function (e) {
            var item = e.target.closest(".emp-bell-item");
            if (!item || item.classList.contains("is-read")) return;
            var id = item.dataset.id;
            if (!id) return;
            item.classList.add("is-read");
            setBadge(unreadCount());
            post("Read", { id: id });
        });
        if (all) {
            all.addEventListener("click", function (e) {
                e.preventDefault(); e.stopPropagation();
                if (all.disabled) return;
                Array.prototype.forEach.call(list.querySelectorAll(".emp-bell-item"), function (el) { el.classList.add("is-read"); });
                setBadge(0);
                post("ReadAll");
            });
        }
    })();
</script>

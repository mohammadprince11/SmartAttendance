                            <details class="ky-acc" @(IsUnder("/AttendanceSettings") || IsUnder("/ShiftTypes") || IsUnder("/Holidays") || IsUnder("/Devices") || IsUnder("/BiometricKeys") || IsUnder("/EmployeeGeoLocations") ? "open" : "")>
                                <summary><span>الإعدادات</span><span class="ky-acc-chev"></span></summary>
                                <div class="ky-acc-body">
                                    @if (CanRoute("/attendancesettings"))
                                    {
                                        <a href="/AttendanceSettings" class="nexora-nav-link @(IsUnder("/AttendanceSettings") ? "active nexora-active" : "")"><span>التهيئة</span></a>
                                    }
                                    @if (CanRoute("/shifttypes"))

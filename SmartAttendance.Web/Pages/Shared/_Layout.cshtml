                                    {
                                        <a href="/PeriodRules" class="nexora-nav-link @(IsUnder("/PeriodRules") ? "active nexora-active" : "")"><span>القواعد الفترية</span></a>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                </details>
                }

                @if (CanPage("Payroll.TaxSocial"))
                {
                <details name="nexora-main-menu" class="nexora-nav-group" @(payrollOpen ? "open" : "")>
                    <summary data-nav-area="payroll" data-sidebar-label="&#x0627;&#x0644;&#x0631;&#x0648;&#x0627;&#x062A;&#x0628;">
                        <span class="nexora-nav-dot gold"></span>
                        <span class="nexora-nav-text">&#x0627;&#x0644;&#x0631;&#x0648;&#x0627;&#x062A;&#x0628;</span>
                        <span class="nexora-chevron"></span>
                    </summary>
                    @* توزيع كيان: المسير عنواناً ← العمليات اليومية ← أكورديونات (حركات/التزامات) ← الإعدادات آخر شيء *@
                    <div class="nexora-nav-group-links" data-ky-title="الرواتب">
                        <a asp-page="/Payroll/Runs" class="nexora-nav-link ky-drawer-title @(IsUnder("/Payroll/Runs") || IsUnder("/Payroll/RunDetail") ? "active nexora-active" : "")">
                            <span>المسير</span>
                        </a>
                        <a asp-page="/Payroll/FinancialRequests" class="nexora-nav-link @(IsUnder("/Payroll/FinancialRequests") ? "active nexora-active" : "")">
                            <span>مركز الطلبات المالية</span>
                        </a>

                        <details class="ky-acc" @(IsUnder("/Payroll/Transactions") || IsUnder("/Payroll/Overtime") || IsUnder("/Payroll/SalaryDaysAdjustment") || IsUnder("/Payroll/LeaveEncashment") ? "open" : "")>
                            <summary><span>الحركات الشهرية</span><span class="ky-acc-chev"></span></summary>
                            <div class="ky-acc-body">
                                <a href="/Payroll/Transactions?type=Income" class="nexora-nav-link"><span>حركات الدخل</span></a>
                                <a href="/Payroll/Transactions?type=Deduction" class="nexora-nav-link"><span>حركات الاقتطاع</span></a>
                                <a asp-page="/Payroll/Overtime" class="nexora-nav-link @(IsUnder("/Payroll/Overtime") ? "active nexora-active" : "")"><span>العمل الإضافي</span></a>
                                <a asp-page="/Payroll/SalaryDaysAdjustment" class="nexora-nav-link @(IsUnder("/Payroll/SalaryDaysAdjustment") ? "active nexora-active" : "")"><span>تعديل أيام الراتب</span></a>
                                <a asp-page="/Payroll/LeaveEncashment" class="nexora-nav-link @(IsUnder("/Payroll/LeaveEncashment") ? "active nexora-active" : "")"><span>بدل إجازة</span></a>
                            </div>
                        </details>

                        <details class="ky-acc" @(IsUnder("/Payroll/Loans") || IsUnder("/Payroll/Raises") || IsUnder("/Payroll/EndOfService") || IsUnder("/PayrollProvisions") ? "open" : "")>
                            <summary><span>التزامات ومستحقات الموظف</span><span class="ky-acc-chev"></span></summary>
                            <div class="ky-acc-body">
                                <a asp-page="/Payroll/Loans" class="nexora-nav-link @(IsUnder("/Payroll/Loans") ? "active nexora-active" : "")"><span>القروض والسُّلف</span></a>
                                <a asp-page="/Payroll/Raises" class="nexora-nav-link @(IsUnder("/Payroll/Raises") ? "active nexora-active" : "")"><span>زيادات الراتب</span></a>
                                <a asp-page="/Payroll/EndOfService" class="nexora-nav-link @(IsUnder("/Payroll/EndOfService") ? "active nexora-active" : "")"><span>نهاية الخدمة</span></a>
                                <a href="/PayrollProvisions" class="nexora-nav-link @(IsUnder("/PayrollProvisions") ? "active nexora-active" : "")"><span>حساب الاحتياطي</span></a>
                                <a asp-page="/EmployeeUpdates/Index" asp-route-section="financial" class="nexora-nav-link"><span>تحديث المعلومات المالية</span></a>
                                <a asp-page="/EmployeeUpdates/Index" asp-route-section="payment" class="nexora-nav-link"><span>معلومات الدفع</span></a>
                            </div>
                        </details>

                        @* حُذفت صفحة /Payroll/TaxSocialSecurity: بذرة حاسبة سابقة لمحرّك
                           المسير، كانت تكتب جدولَي PayrollTaxSocialSecurity{Settings,Records}
                           ولا يقرأهما أحد، بينما المحرّك يقرأ TaxProfiles/GosiProfiles من
                           «الضريبة والضمان» أدناه — فكان الأدمن يعدّل بلا أثر وبلا تحذير.
                           الجدولان اليتيمان يبقيان بالقاعدة حتى تُسقطهما هجرة محكومة. *@
                        <details class="ky-acc" @(IsUnder("/Payroll/SalaryItems") || IsUnder("/Payroll/Settings") || IsUnder("/Payroll/BankTemplates") ? "open" : "")>
                            <summary><span>إعدادات الرواتب</span><span class="ky-acc-chev"></span></summary>
                            <div class="ky-acc-body">
                                <a asp-page="/Payroll/SalaryItems" class="nexora-nav-link @(IsUnder("/Payroll/SalaryItems") ? "active nexora-active" : "")"><span>عناصر الراتب</span></a>

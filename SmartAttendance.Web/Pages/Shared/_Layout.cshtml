                            }

                            @if (canUseLegacyPeopleAdministration)
                            {
                                <a href="/Employees/PeopleDashboard" class="nexora-nav-link @(IsUnder("/Employees/PeopleDashboard") ? "active nexora-active" : "")">
                                    <span>داشبورد الأشخاص</span>
                                </a>
                                @* رابط صريح لا asp-page: AddPageRoute لمسار /AttendanceReports يجعل
                                   توليد الرابط بالاسم يختار المسار المُضاف، فنثبّت مسار الأشخاص يدوياً. *@
                                <a href="/PeopleReports" class="nexora-nav-link @(IsUnder("/PeopleReports") ? "active nexora-active" : "")">
                                    <span>التقارير</span>

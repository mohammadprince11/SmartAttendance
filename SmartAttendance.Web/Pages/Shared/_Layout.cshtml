                        @{
                            // القسم 10 — الوجهة الأولى المسموحة لكل مساحة عمل: لا نوجّه
                            // المستخدم قسراً لعرضٍ يُمنع منه. الترتيب واضح، وأوّل مسموحٍ يفوز.
                            string? FirstAllowedNavUrl(params (string Route, string Url)[] pairs) =>
                                pairs.FirstOrDefault(p => CanRoute(p.Route)).Url;

                            var manageUrl = FirstAllowedNavUrl(
                                ("/dayattendance", "/DayAttendance"),
                                ("/attendanceviewer", "/AttendanceViewer"),
                                ("/attendancerecords", "/AttendanceRecords"),
                                ("/attendanceoperations", "/AttendanceOperations"));
                            var manageActive = IsUnder("/DayAttendance") || IsUnder("/AttendanceViewer")
                                || IsUnder("/AttendanceRecords") || IsUnder("/AttendanceOperations");

                            var approvalUrl = FirstAllowedNavUrl(
                                ("/monthattendance", "/MonthAttendance"),
                                ("/weekattendance", "/WeekAttendance"));
                            var approvalActive = IsUnder("/MonthAttendance") || IsUnder("/WeekAttendance");
                        }

                        @* ② إدارة الحضور — رابطٌ واحد لمساحة العمل. العروض (اليوميات · المصفوفة ·

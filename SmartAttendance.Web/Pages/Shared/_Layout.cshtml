@using SmartAttendance.Application.Common.Security
@using SmartAttendance.Web.Infrastructure.Security
@using SmartAttendance.Web.Infrastructure.Theming
@inject IPermissionAuthorizationService PermissionAuthorizationService
@inject IThemeContextService ThemeContextService
@inject IAccessRoleService AccessRoleService
@inject SmartAttendance.Infrastructure.Persistence.ApplicationDbContext DesignTokenDb
@{
    var companyTheme = await ThemeContextService.GetCurrentAsync(Context.RequestAborted);
    var brandName = string.IsNullOrWhiteSpace(companyTheme.DisplayName) ? "ZYNORA HR" : companyTheme.DisplayName;

    // مقاسات الواجهة المخصَّصة. مكشوفةٌ من كاش العملية لا من القاعدة بكل طلب.
    var designTokenCss = DesignTokenStore.CompileCss(await DesignTokenStore.LoadAsync(DesignTokenDb));
}

<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="light" data-sidebar="expanded">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? brandName) - @brandName</title>

    <script>
        (function () {
            // تنظيف مفاتيح قديمة (تخطيط الشريط الجانبي وأسماء ثيم سابقة)
            try {
                [
                    "SmartAttendance.Sidebar",
                    "NEXORA.Sidebar.State",
                    "NEXORA.Sidebar.Final.Working",
                    "NEXORA.SidebarMode.Final",
                    "NEXORA.V2.Sidebar",
                    "NEXORA.Sidebar",
                    "SidebarCollapsed",
                    "sidebar",
                    "ZYNORA.Theme"
                ].forEach(function (key) {
                    localStorage.removeItem(key);
                });
            } catch (e) { }

            // القائمة الجانبية موسّعة دائماً (فكرة الطي أُلغيت بطلب محمد)
            try { localStorage.removeItem("ZY.Sidebar"); } catch (e) { }
            document.documentElement.setAttribute(
                "data-sidebar",
                "expanded"
            );

            // الوضع المحفوظ (زر الشمس/الهلال بالشريط العلوي). الافتراضي **داكن**
            // بقرار محمد 2026-08-02 مع اعتماد لوحة الهوية v2 — اللوحة الداكنة هي
            // الوجه الأول للمنتج. ولا نتبع تفضيل الجهاز هنا عمداً: مَن لم يختر
            // يجب أن يرى هويةَ المنتج لا إعدادَ نظامه. اختيارُه يبقى محفوظاً.
            var zyTheme = null;
            try { zyTheme = localStorage.getItem("ZY.Theme"); } catch (e) { }

            if (zyTheme !== "light" && zyTheme !== "dark") {
                zyTheme = "dark";
            }

            document.documentElement.setAttribute("data-theme", zyTheme);
        })();
    </script>

    @* حاجز الوميض: لا رسمة وسيطة إطلاقاً — الصفحة مخفية حتى يكتمل بناء DOM وتطبيق
       كل أوراق الأنماط الحاجبة، فتظهر مرة واحدة بشكلها النهائي. مهلة أمان 3ث. *@
    <style>html:not([data-ready]) body { visibility: hidden; }</style>
    <script>
        (function () {
            function ready() { document.documentElement.setAttribute("data-ready", "1"); }
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", ready);
            else ready();
            setTimeout(ready, 3000);
        })();
    </script>

    @if (!string.IsNullOrWhiteSpace(companyTheme.FaviconPath))
    {
        <link rel="icon" href="@companyTheme.FaviconPath" />
    }
    else
    {
        <link rel="icon" type="image/svg+xml" href="~/brand/zynora-symbol.svg" />
        <link rel="apple-touch-icon" href="~/brand/zynora-symbol-1024.png" />
    }
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nexora-reference-redesign-v3.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nexora-ui-stabilization-phase1.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nexora-calendar-v18.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nexora-global-scroll-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nexora-select-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/zynora-theme-contract.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/zynora-design-tokens.css" asp-append-version="true" />
    @* Design System v1 الموحد (كلاسات zy-*): مرجع إعادة التصميم صفحة-صفحة — إضافي لا يمس القديم *@
    <link rel="stylesheet" href="~/css/zynora-design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nexora-brand.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/nexora-button-interactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/zynora-checkbox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/zynora-file-input.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/zynora-kayan-nav.css" asp-append-version="true" />
    @* منتقي الموظف المشترك — متاح لكل صفحة بسطر واحد: partial name="_EmployeePicker" *@
    <link rel="stylesheet" href="~/css/zynora-employee-picker.css" asp-append-version="true" />

    @* جسر الصفحات القديمة نُقل إلى ما بعد RenderBody — انظر التعليق هناك *@

    @* Branding & Theme Engine injection point (P4): overrides the token contract
       for the active company. Rendered last so it wins the cascade; absent for
       the ZYNORA Default so the shell is byte-identical to pre-engine. *@
    @if (companyTheme.HasCompanyOverride)
    {
        <style id="company-theme">@Html.Raw(companyTheme.CompiledCss)</style>
    }
</head>

<body dir="rtl">
    @{
        var loginUser = Context.User.Identity?.Name;
        var displayNameCookie = Context.Request.Cookies["SA.DisplayName"] ?? Context.User.FindFirst("DisplayName")?.Value;
        var loginDisplayName = !string.IsNullOrWhiteSpace(displayNameCookie) ? displayNameCookie : loginUser;
        var loginRole = Context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
        var loginEmployeeId = Context.User.FindFirst("EmployeeId")?.Value ?? "";
        var isLoggedIn = !string.IsNullOrWhiteSpace(loginUser);
        var systemUserId = PeopleAccessContext.GetSystemUserId(Context) ?? 0;

        var canViewPeopleDirectory = isLoggedIn &&
            await PermissionAuthorizationService.HasPermissionAsync(
                systemUserId,
                PeoplePermissionCodes.ViewDirectory,
                PeopleCompatibilityAccess.IsAllowed(
                    loginRole,
                    PeoplePermissionCodes.ViewDirectory),
                Context.RequestAborted);

        var canImportPeople = isLoggedIn &&
            await PermissionAuthorizationService.HasGlobalPermissionAsync(
                systemUserId,
                PeoplePermissionCodes.Import,
                PeopleCompatibilityAccess.IsAllowed(
                    loginRole,
                    PeoplePermissionCodes.Import),
                Context.RequestAborted);

        var canManagePeoplePermissions = isLoggedIn &&
            await PermissionAuthorizationService.HasGlobalPermissionAsync(
                systemUserId,
                PeoplePermissionCodes.ManagePermissions,
                PeopleCompatibilityAccess.IsAllowed(
                    loginRole,
                    PeoplePermissionCodes.ManagePermissions),
                Context.RequestAborted);

        var isAdminRole = loginRole.Equals(
            "Admin",
            StringComparison.OrdinalIgnoreCase);

        // Access Roles page enforcement (nav visibility). Admin bypasses; a user
        // with no Pages role is unrestricted, so existing users are unaffected.
        var accessProfile = (isLoggedIn && !isAdminRole)
            ? await AccessRoleService.ResolveAsync(systemUserId, Context.RequestAborted)
            : null;
        Func<string, bool> CanPage = code => accessProfile == null || accessProfile.CanViewPage(code);

        // إخفاء ما سيمنعه الحارس: نفس مصدر الحقيقة الذي ينفّذه RoleSecurityMiddleware.
        // بدونها كان الدور غير الأدمن يرى روابط تنتهي كلها بـ«لا صلاحية».
        Func<string, bool> CanRoute = path =>
            SmartAttendance.Web.Infrastructure.Security.RoleRouteCatalog.IsAllowed(loginRole, path);

        var canViewOrganization = isAdminRole ||
            loginRole.Equals("HR Manager", StringComparison.OrdinalIgnoreCase) ||
            loginRole.Equals("HR Officer", StringComparison.OrdinalIgnoreCase) ||
            loginRole.Equals("Branch Manager", StringComparison.OrdinalIgnoreCase) ||
            loginRole.Equals("Finance Viewer", StringComparison.OrdinalIgnoreCase);

        // These People pages still use the legacy server-side Admin compatibility rule.
        // Keep their navigation visibility aligned with the middleware until each route
        // receives a dedicated dynamic permission code.
        var canUseLegacyPeopleAdministration = isAdminRole;

        var hasVisiblePeopleNavigation =
            canViewPeopleDirectory ||
            canImportPeople ||
            canManagePeoplePermissions ||
            canViewOrganization ||
            canUseLegacyPeopleAdministration;

        var pageTitle = ViewData["Title"]?.ToString() ?? "ZYNORA HR";

        var rawPath = (Context.Request.Path.Value ?? "/").TrimEnd('/');
        if (string.IsNullOrWhiteSpace(rawPath))
        {
            rawPath = "/";
        }

        var currentPath = rawPath.ToLowerInvariant();

        Func<string, string> NormalizePath = path =>
        {
            var value = (path ?? "/").TrimEnd('/').ToLowerInvariant();
            return string.IsNullOrWhiteSpace(value) ? "/" : value;
        };

        Func<string, bool> IsCurrent = path =>
        {
            var normalized = NormalizePath(path);
            if (currentPath == normalized)
            {
                return true;
            }

            if (normalized.EndsWith("/index", StringComparison.OrdinalIgnoreCase))
            {
                var withoutIndex = normalized.Substring(0, normalized.Length - "/index".Length);
                if (string.IsNullOrWhiteSpace(withoutIndex))
                {
                    withoutIndex = "/";
                }

                return currentPath == withoutIndex;
            }

            return false;
        };

        Func<string, bool> IsUnder = path =>
        {
            var normalized = NormalizePath(path);
            if (normalized == "/")
            {
                return currentPath == "/";
            }

            return currentPath == normalized || currentPath.StartsWith(normalized + "/", StringComparison.OrdinalIgnoreCase);
        };

        Func<string, string> ActiveClass = path => IsCurrent(path) ? "active nexora-active" : "";

        var employeesOpen = IsUnder("/Employees") || IsUnder("/Contracts") || IsUnder("/Acknowledgments") || IsUnder("/EmployeeUpdates") || IsUnder("/DisciplinaryRules") || IsUnder("/EmployeeProfileSettings") || IsUnder("/EmployeeDocuments") || IsUnder("/EmployeePermissions") || IsUnder("/Organization") || IsUnder("/OrgStructures") || IsUnder("/Alerts") || IsUnder("/LeaveBalances") || IsUnder("/PeopleReports") || IsUnder("/EmployeeTasks") || IsUnder("/Engagement");
        @* المجموعة تُفتح على أي شاشة حضور — لا على السبع الأُوَل وحدها. الشاشات
           المضافة بموجات الحضور (اليومي/الأسبوعي/الشهري/القواعد/العمل خارج المكتب)
           كانت خارج هذا الشرط فتُفتح صفحتُها والقائمةُ مطويّة. *@
        var attendanceOpen = IsUnder("/AttendanceDashboard") || IsUnder("/AttendanceOperations") || IsUnder("/AttendanceRecords")
            || IsUnder("/AttendanceImports") || IsUnder("/AttendanceProcessing") || IsUnder("/AttendanceCorrections")
            || IsUnder("/AttendanceViewer") || IsUnder("/AttendanceRecommendations") || IsUnder("/AttendanceReports")
            || IsUnder("/AttendanceSettings") || IsUnder("/DayAttendance") || IsUnder("/WeekAttendance")
            || IsUnder("/MonthAttendance") || IsUnder("/EmployeeOnlinePunches") || IsUnder("/MissingPunchRequests")
            || IsUnder("/WorkFromHome") || IsUnder("/Roster") || IsUnder("/ShiftAssignments") || IsUnder("/ShiftOverrides")
            || IsUnder("/ShiftTypes") || IsUnder("/ShiftRules") || IsUnder("/PeriodRules") || IsUnder("/BiometricKeys")
            || IsUnder("/EmployeeGeoLocations") || IsUnder("/Holidays") || IsUnder("/Devices");
        var requestsOpen = IsUnder("/LeaveRequests") || IsUnder("/Approvals") || IsUnder("/SelfServices");
        var payrollOpen = IsUnder("/Payroll");
    }

    <div class="nexora-shell">
        <aside class="nexora-sidebar" aria-label="القائمة الجانبية">
            <div class="nexora-brand-card">
                @* الشعار عرض فقط (لا رابط) — وحرف Z نفسه هو زر الطي: خطوطه الثلاثة
                   تتحول بأنميشن إلى ثلاث خطوط أفقية عند الانكماش. *@
                @* الشعار عرض فقط لا رابط — التنقل للرئيسية من بند «لوحة البيانات» *@
                <div class="nexora-brand-link" aria-label="@brandName">
                    <img class="nexora-brand-logo"
                         src="@(string.IsNullOrWhiteSpace(companyTheme.LogoPath) ? Url.Content("~/brand/zynora-logo-horizontal-light.svg") : companyTheme.LogoPath)"
                         alt="@brandName" />
                    <span class="nexora-brand-tagline">
                        Smarter People. Stronger Business.
                    </span>
                </div>
            </div>

            @if (isLoggedIn)
            {
                <nav class="nexora-nav nexora-stable-nav" aria-label="القائمة الرئيسية">
                    <!-- NEXORA_SAFE_MAIN_MENU_START -->
                <a asp-page="/Index" class="nexora-nav-link nexora-root-link @ActiveClass("/Index")" data-nav-area="dashboard" data-sidebar-label="&#x0644;&#x0648;&#x062D;&#x0629; &#x0627;&#x0644;&#x0628;&#x064A;&#x0627;&#x0646;&#x0627;&#x062A;">
                    <span class="nexora-nav-dot"></span>
                    <span>لوحة البيانات</span>
                </a>

                @if (loginRole.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                {
                    <a asp-page="/Setup/Index" class="nexora-nav-link nexora-root-link @(IsUnder("/Setup") ? "active nexora-active" : "")" data-nav-area="setup" data-sidebar-label="&#x0625;&#x0639;&#x062F;&#x0627;&#x062F; &#x0627;&#x0644;&#x0634;&#x0631;&#x0643;&#x0629;">
                        <span class="nexora-nav-dot gold"></span>
                        <span>&#x0625;&#x0639;&#x062F;&#x0627;&#x062F; &#x0627;&#x0644;&#x0634;&#x0631;&#x0643;&#x0629;</span>
                    </a>
                    <a asp-page="/UserAccess/Index" class="nexora-nav-link nexora-root-link @(IsUnder("/UserAccess") ? "active nexora-active" : "")" data-nav-area="identity" data-sidebar-label="&#x0625;&#x062F;&#x0627;&#x0631;&#x0629; &#x0627;&#x0644;&#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645;&#x064A;&#x0646;">
                        <span class="nexora-nav-dot"></span>
                        <span>&#x0625;&#x062F;&#x0627;&#x0631;&#x0629; &#x0627;&#x0644;&#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645;&#x064A;&#x0646;</span>
                    </a>
                    <a asp-page="/Branding/Index" class="nexora-nav-link nexora-root-link @(IsUnder("/Branding") ? "active nexora-active" : "")" data-nav-area="branding" data-sidebar-label="&#x0627;&#x0644;&#x0647;&#x0648;&#x064A;&#x0629; &#x0648;&#x0627;&#x0644;&#x062B;&#x064A;&#x0645;">
                        <span class="nexora-nav-dot gold"></span>
                        <span>الهوية والثيم</span>
                    </a>
                    <a asp-page="/AccessRoles/Index" class="nexora-nav-link nexora-root-link @(IsUnder("/AccessRoles") ? "active nexora-active" : "")" data-nav-area="access-roles" data-sidebar-label="&#x0623;&#x062F;&#x0648;&#x0627;&#x0631; &#x0627;&#x0644;&#x0648;&#x0635;&#x0648;&#x0644;">
                        <span class="nexora-nav-dot"></span>
                        <span>أدوار الوصول</span>
                    </a>
                }
                @if (hasVisiblePeopleNavigation && CanPage("People.Directory"))
                {
                    <details name="nexora-main-menu" class="nexora-nav-group" @(employeesOpen ? "open" : "")>
                        <summary data-nav-area="people" data-sidebar-label="&#x0623;&#x0634;&#x062E;&#x0627;&#x0635;">
                            <span class="nexora-nav-dot gold"></span>
                            <span class="nexora-nav-text">أشخاص</span>
                            <span class="nexora-chevron"></span>
                        </summary>
                        @* بنية درج كيان: عنوان المجموعة أول صف + روابط مباشرة + أكورديونات فرعية حصرية (قسم 20 بالدراسة) *@
                        <div class="nexora-nav-group-links" data-ky-title="أشخاص">
                            @*
                                ⭐ ترتيب هذا الدرج **يطابق مودل أشخاص بكيان** (فحص حيّ 2026-08-01):
                                رسومات بيانية · عرض الموظفين · عمليات م.ب. · الهياكل التنظيمية ·
                                مركز الوثائق · مركز بطاقات الموظفين · التقارير · إعدادات م.ب.

                                وكان عندنا قبل التوحيد قسمٌ واحد اسمه «عمليات الموارد البشرية» يحوي
                                **عشرين رابطاً** خلطت ثلاث عائلات: تشغيل (عقود/مخالفات/عهد) ووثائق
                                (منشئ/توليد/طلبات) وإعدادات (مختبر الصيغ/تهيئة المخالفات). فوُزّعت
                                كلٌّ على قسمها: الوثائق ⟵ مركز الوثائق، والإعدادات ⟵ إعدادات م.ب.
                            *@
                            @* عنوان الدرج **اسمُ شاشةٍ لا رابط**: كان `<a>` إلى
                               `/Employees/Index` — أي الوجهة نفسها لـ«عرض الموظفين»
                               بعده بصفّين. فمن ضغط على «أشخاص» ظنّاً أنه عنوان
                               القسم وجد نفسه بقائمة الموظفين. والعنوان يبقى بلا
                               `ActiveClass` أيضاً: العنوان لا «يُنشَّط». *@
                            <div class="nexora-nav-link ky-drawer-title" role="heading" aria-level="2">
                                <span>أشخاص</span>
                            </div>

                            @* ① الداشبورد أول القائمة كما بكيان — كان مدفوناً بالمرتبة السابعة *@
                            @if (canUseLegacyPeopleAdministration)
                            {
                                <a href="/Employees/PeopleDashboard" class="nexora-nav-link @(IsUnder("/Employees/PeopleDashboard") ? "active nexora-active" : "")">
                                    <span>رسومات بيانية</span>
                                </a>
                            }

                            @* ② عرض الموظفين *@
                            @if (canViewPeopleDirectory)
                            {
                                <a asp-page="/Employees/Index" class="nexora-nav-link @ActiveClass("/Employees/Index")">
                                    <span>عرض الموظفين</span>
                                </a>
                            }

                            @* ③ عمليات الموارد البشرية — تشغيلٌ محض بعد إخراج الوثائق والإعدادات *@
                            @if (canUseLegacyPeopleAdministration)
                            {
                                <details class="ky-acc" @(IsUnder("/Engagement") || IsUnder("/EmployeeUpdates") || IsUnder("/Contracts") || IsUnder("/Acknowledgments") || IsUnder("/Forms") || IsUnder("/Violations") || IsUnder("/AssetsManagement") || IsUnder("/EmployeeTasks") || IsUnder("/LeaveBalances") || IsUnder("/Alerts") ? "open" : "")>
                                    <summary><span>عمليات الموارد البشرية</span><span class="ky-acc-chev"></span></summary>
                                    @*
                                        ترتيب هذه العناصر ومجموعاتها الفرعية **مطابق لقائمة كيان
                                        المستخرَجة بمساراتها** (فحص حيّ 2026-08-01):
                                        تفاعل · تحديثات · عقود ▾ · متابعة الطلبات المخصصة · مهام ▾ ·
                                        مخالفات ▾ · عهد · تقييمات · إنهاء · رئيس وحدة مؤقت.

                                        وعندهم **الباني بالإعدادات والمتابعة بالعمليات** — قاعدة
                                        مطّردة بكل مودلهم، طُبِّقت هنا على النماذج والإقرارات.
                                    *@
                                    <div class="ky-acc-body">
                                        <a asp-page="/Engagement/Index" class="nexora-nav-link @(IsUnder("/Engagement") ? "active nexora-active" : "")">
                                            <span>تفاعل الموظفين</span>
                                        </a>
                                        <a asp-page="/EmployeeUpdates/Index" class="nexora-nav-link @(IsUnder("/EmployeeUpdates") ? "active nexora-active" : "")">
                                            <span>تحديثات الموظف</span>
                                        </a>

                                        @* عندهم قسمٌ بشاشتين — و«تحديثات العقود» مبنيّة عندنا وكانت **غائبة عن القائمة** *@
                                        <details class="ky-acc" @(IsUnder("/Contracts") ? "open" : "")>
                                            <summary><span>عقود الموظفين</span><span class="ky-acc-chev"></span></summary>
                                            <div class="ky-acc-body">
                                                <a asp-page="/Contracts/Index" class="nexora-nav-link @(IsUnder("/Contracts/Index") ? "active nexora-active" : "")">
                                                    <span>سجلّ العقود</span>
                                                </a>
                                                <a asp-page="/Contracts/Movements" class="nexora-nav-link @(IsUnder("/Contracts/Movements") ? "active nexora-active" : "")">
                                                    <span>تحديثات العقود</span>
                                                </a>
                                            </div>
                                        </details>

                                        <a asp-page="/Forms/Submissions" class="nexora-nav-link @(IsUnder("/Forms/Submissions") ? "active nexora-active" : "")">
                                            <span>متابعة الطلبات المخصصة</span>
                                        </a>
                                        <a asp-page="/EmployeeTasks/Index" class="nexora-nav-link @(IsUnder("/EmployeeTasks") ? "active nexora-active" : "")">
                                            <span>إدارة مهام الموظفين</span>
                                        </a>

                                        @* كان قسماً بفرعين (الحالات · الإجراءات). صارت الإجراءات
                                           **تبويباً داخل شاشة المخالفات** لا صفحةً مستقلّة، فبقي
                                           فرعٌ واحد — وقسمٌ بفرعٍ واحد ليس قسماً، بل نقرةٌ زائدة
                                           تخفي وجهتها. فصار رابطاً مباشراً. *@
                                        <a asp-page="/Violations/Index" class="nexora-nav-link @(IsUnder("/Violations") ? "active nexora-active" : "")">
                                            <span>المخالفات</span>
                                        </a>

                                        <a asp-page="/AssetsManagement/Index" class="nexora-nav-link @(IsUnder("/AssetsManagement") ? "active nexora-active" : "")">
                                            <span>إدارة العهد</span>
                                        </a>
                                        <a asp-page="/Payroll/TerminationSettlement" class="nexora-nav-link">
                                            <span>إنهاء الموظف — تسوية الفروقات</span>
                                        </a>
                                        <a asp-page="/Employees/TemporaryHeads" class="nexora-nav-link">
                                            <span>تخصيص رئيس الوحدة المؤقت</span>
                                        </a>

                                        @* بلا نظير بقائمة كيان — أُبقيت آخر القسم لأنها تشغيلية عندنا *@
                                        <a asp-page="/LeaveBalances/Index" class="nexora-nav-link @(IsUnder("/LeaveBalances") ? "active nexora-active" : "")">
                                            <span>أرصدة الإجازات</span>

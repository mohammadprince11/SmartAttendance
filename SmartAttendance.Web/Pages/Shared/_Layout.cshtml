                <div class="nexora-controls">
                    @if (isLoggedIn)
                    {
                        @* زر الوضع الفاتح/الداكن (شمس/هلال) — بصف الإشعارات، بتبديل ناعم ومحفوظ *@
                        <button type="button" class="zy-theme-btn" id="zy-theme-toggle" aria-label="تبديل الوضع الفاتح والداكن" title="الوضع الفاتح / الداكن">
                            <svg class="zy-tt-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                            <svg class="zy-tt-moon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                        </button>
                        <script>
                            (function () {
                                var btn = document.getElementById("zy-theme-toggle");
                                if (!btn) return;
                                // التبديل فوريّ: أُزيل صنف `zy-theme-anim` ومؤقّته (450ms)
                                // مع حذف انتقال الـ220ms من نظام التصميم — انظر التعليق هناك.
                                // و`data-theme-switching` يُسكِت انتقالات المكوّنات الخاصة
                                // (المكتوبة لتأثير المرور) إطارين فقط، وإلا تلاشى 123 عنصراً
                                // من كل 400 رغم حذف قاعدتنا. يُرفع بعد إطارين لا بمؤقّت:
                                // الإطار الأول يطبّق الألوان الجديدة، والثاني يضمن رسمها.
                                btn.addEventListener("click", function () {
                                    var h = document.documentElement;
                                    var next = h.getAttribute("data-theme") === "light" ? "dark" : "light";
                                    h.setAttribute("data-theme-switching", "");
                                    h.setAttribute("data-theme", next);
                                    try { localStorage.setItem("ZY.Theme", next); } catch (e) { }
                                    // ⚠️ الرفع بحارسين لا بواحد. rAF **لا ينطلق** إن كان
                                    // التبويب خلفياً أو خُنق المتصفح، ووقتها تبقى السمة
                                    // فتُسكِت كل حركة بالنظام للأبد (رُصد فعلياً بالقياس).
                                    // فمؤقّتٌ قصير يضمن الرفع مهما حدث، وأيّهما سبق كفى.
                                    var clear = function () { h.removeAttribute("data-theme-switching"); };
                                    requestAnimationFrame(function () { requestAnimationFrame(clear); });
                                    setTimeout(clear, 200);
                                });
                            })();
                        </script>


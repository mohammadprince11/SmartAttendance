@page
@model SmartAttendance.Web.Pages.Approvals.IndexModel
@{
    ViewData["Title"] = "الموافقات";
    var acc = "#12D9E3";

    (string ic, string cls) TypeBadge(string t)
    {
        if (t.Contains("قرض") || t.Contains("سُلفة") || t.Contains("سلفة")) return ("🏦", "fin");
        if (t.Contains("بدل") || t.Contains("استرداد")) return ("🧾", "fin");
        if (t.Contains("زيادة")) return ("📈", "fin");
        if (t.Contains("تعديل")) return ("✏️", "data");
        if (t.Contains("إجازة") || t.Contains("اجازة")) return ("🌴", "leave");
        if (t.Contains("بصمة")) return ("👆", "att");
        if (t.Contains("مغادرة") || t.Contains("خروج")) return ("🚪", "att");
        if (t.Contains("إضافي") || t.Contains("اوفر") || t.Contains("أوفر")) return ("⏱️", "att");
        return ("📄", "gen");
    }
    string D(DateOnly? d) => d?.ToString("yyyy-MM-dd") ?? "";
    var panelOpen = Model.HasActiveFilters;
}

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />

<style>
    .apv-page { display:flex; flex-direction:column; gap:14px; color:var(--sa-text,#DCEAF4); --acc:@acc; padding-bottom:70px; }
    .apv-head { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;
        padding:16px 20px; border:1px solid rgba(73,111,151,.22); border-radius:20px;
        background:radial-gradient(circle at 92% 8%,color-mix(in srgb,var(--acc) 16%,transparent),transparent 42%),linear-gradient(135deg,rgba(9,31,52,.95),rgba(5,16,29,.95)); }
    html[data-theme="light"] .apv-head { background:linear-gradient(135deg,#fff,#eef6f8); }
    .apv-head h1 { margin:0; font-size:20px; font-weight:1000; }
    .apv-head p { margin:2px 0 0; font-size:12px; color:var(--sa-muted,#8FA8BC); font-weight:800; max-width:640px; }

    .apv-kpis { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; }
    .apv-kpi { padding:14px 16px; border:1px solid rgba(73,111,151,.22); border-radius:16px; background:var(--sa-surface,rgba(8,25,43,.9)); display:flex; align-items:center; gap:12px; }
    .apv-kpi .dot { width:38px; height:38px; border-radius:12px; display:grid; place-items:center; font-size:18px; flex:0 0 38px; }
    .apv-kpi b { display:block; font-size:22px; font-weight:1000; direction:ltr; line-height:1; }
    .apv-kpi span { font-size:11px; font-weight:900; color:var(--sa-muted,#8FA8BC); }
    .apv-kpi.pending .dot { background:rgba(250,204,21,.16); color:#facc15; }
    .apv-kpi.approved .dot { background:rgba(52,211,153,.16); color:#34d399; }
    .apv-kpi.rejected .dot { background:rgba(248,113,113,.16); color:#f87171; }

    .apv-toolbar { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .apv-tabs { display:flex; gap:6px; flex-wrap:wrap; }
    .apv-tab { min-height:38px; padding:7px 15px; border-radius:999px; border:1px solid rgba(73,111,151,.28); background:transparent; color:var(--sa-muted,#8FA8BC); font-size:12px; font-weight:900; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; gap:6px; }
    .apv-tab.on { border-color:var(--acc); background:color-mix(in srgb,var(--acc) 14%,transparent); color:var(--acc); }
    .apv-quick { display:flex; align-items:center; gap:8px; margin-inline-start:auto; flex-wrap:wrap; }
    .apv-search { min-height:40px; box-sizing:border-box; border-radius:11px; border:1px solid rgba(73,111,151,.25); background:rgba(0,0,0,.16); color:inherit; padding:6px 12px; font-weight:800; font-size:13px; min-width:220px; }
    html[data-theme="light"] .apv-search { background:#fff; }
    .apv-btn { min-height:40px; padding:8px 16px; border-radius:11px; border:0; font-size:13px; font-weight:900; cursor:pointer; background:var(--acc); color:#04141d; display:inline-flex; align-items:center; gap:7px; white-space:nowrap; }
    .apv-btn.ghost { background:transparent; border:1px solid rgba(73,111,151,.3); color:inherit; }
    .apv-btn .chip { background:#04141d; color:var(--acc); border-radius:999px; padding:0 7px; font-size:11px; direction:ltr; }

    .apv-panel { display:none; border:1px solid rgba(73,111,151,.22); border-radius:18px; background:var(--sa-surface,rgba(8,25,43,.9)); padding:16px 18px; }
    .apv-panel.open { display:block; }
    .apv-pgrid { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:14px; align-items:end; }
    .apv-f { display:flex; flex-direction:column; gap:6px; font-size:12px; font-weight:900; color:var(--sa-muted,#8FA8BC); }
    .apv-f input, .apv-f select { min-height:42px; box-sizing:border-box; border-radius:11px; border:1px solid rgba(73,111,151,.25); background:rgba(0,0,0,.16); color:var(--sa-text,#DCEAF4); padding:7px 12px; font-weight:800; font-size:13px; }
    html[data-theme="light"] .apv-f input, html[data-theme="light"] .apv-f select { background:#fff; }
    .apv-f.wide { grid-column:span 2; }
    .apv-f .rng { display:flex; gap:8px; align-items:center; }
    .apv-f .rng input { flex:1; min-width:0; }
    .apv-f .rng span { font-size:11px; opacity:.6; flex:0 0 auto; }
    .apv-pfoot { grid-column:1/-1; display:flex; gap:10px; padding-top:2px; }
    .apv-pfoot button, .apv-pfoot a { min-height:42px; padding:8px 22px; border-radius:12px; font-size:13px; font-weight:1000; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; text-decoration:none; }
    .apv-pfoot .go { background:var(--acc); border:0; color:#04141d; }
    .apv-pfoot .clr { background:transparent; border:1px solid rgba(73,111,151,.35); color:inherit; }

    /* جدول نظيف بنمط كيان */
    .apv-card { border:1px solid rgba(73,111,151,.22); border-radius:18px; overflow-x:auto; background:var(--sa-surface,rgba(8,25,43,.9)); }
    .apv-table { width:100%; border-collapse:collapse; font-size:13px; min-width:920px; }
    .apv-table th { text-align:start; padding:13px 16px; font-size:11px; font-weight:1000; color:var(--sa-muted,#8FA8BC); border-bottom:1px solid rgba(73,111,151,.22); background:rgba(0,0,0,.14); white-space:nowrap; }
    html[data-theme="light"] .apv-table th { background:#eef6f8; }
    .apv-table td { padding:14px 16px; border-bottom:1px solid rgba(143,168,188,.1); vertical-align:top; }
    .apv-table tbody tr:hover td { background:color-mix(in srgb,var(--acc) 5%,transparent); }
    .apv-table tbody tr.sel td { background:color-mix(in srgb,var(--acc) 10%,transparent); }
    .apv-table tbody tr:last-child td { border-bottom:0; }
    .apv-chk { width:17px; height:17px; accent-color:var(--acc); cursor:pointer; margin-top:3px; }

    .apv-emp { display:flex; align-items:center; gap:10px; min-width:180px; }
    .apv-ava { width:36px; height:36px; border-radius:11px; flex:0 0 36px; display:grid; place-items:center; font-size:14px; font-weight:1000; color:#04141d;
        background:linear-gradient(135deg,color-mix(in srgb,var(--acc) 85%,#fff),color-mix(in srgb,var(--acc) 55%,#1b3550)); }
    .apv-emp .nm { font-weight:900; }
    .apv-emp .meta { font-size:11px; opacity:.6; font-weight:800; direction:ltr; text-align:start; }

    .apv-type { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:900; padding:5px 12px; border-radius:999px; border:1px solid rgba(73,111,151,.3); white-space:nowrap; }
    .apv-type.fin { color:#38bdf8; border-color:rgba(56,189,248,.4); background:rgba(56,189,248,.08); }
    .apv-type.data { color:#c084fc; border-color:rgba(192,132,252,.4); background:rgba(192,132,252,.08); }
    .apv-type.leave { color:#34d399; border-color:rgba(52,211,153,.4); background:rgba(52,211,153,.08); }
    .apv-type.att { color:#facc15; border-color:rgba(250,204,21,.4); background:rgba(250,204,21,.08); }
    .apv-type.gen { color:var(--sa-muted,#8FA8BC); }

    .apv-status { display:inline-block; font-size:11px; font-weight:900; padding:4px 12px; border-radius:999px; border:1px solid rgba(73,111,151,.3); white-space:nowrap; }
    .apv-status.pending { color:#facc15; border-color:rgba(250,204,21,.45); background:rgba(250,204,21,.08); }
    .apv-status.approved { color:#34d399; border-color:rgba(52,211,153,.45); background:rgba(52,211,153,.08); }
    .apv-status.rejected { color:#f87171; border-color:rgba(248,113,113,.45); background:rgba(248,113,113,.08); }

    /* التفاصيل: كل تفصيلة سطر واحد مضغوط (بلا التفاف) */
    .apv-detail { display:flex; flex-direction:column; min-width:0; gap:2px; }
    .apv-drow { font-size:11px; font-weight:800; display:flex; align-items:center; gap:5px; padding:2px 0; white-space:nowrap; line-height:1.5; }
    .apv-drow b { color:var(--acc); font-weight:900; }
    .apv-old { color:#f87171; text-decoration:line-through; opacity:.75; }
    .apv-arrow { opacity:.5; }
    .apv-new { color:#4ade80; }
    .apv-fchk { width:14px; height:14px; accent-color:#34d399; cursor:pointer; flex:0 0 14px; }
    .apv-drow.excluded { opacity:.5; }
    .apv-drow.excluded .apv-new { text-decoration:line-through; color:#f87171; }
    .apv-fhint { font-size:10px; opacity:.5; font-weight:800; padding-top:3px; }
    .apv-dates { direction:ltr; font-weight:900; }
    .apv-mut { opacity:.55; }

    /* عمود القرار */
    .apv-decide { display:flex; flex-direction:column; gap:7px; min-width:210px; }
    .apv-decide .note { min-height:36px; border-radius:10px; border:1px solid rgba(73,111,151,.28); background:rgba(0,0,0,.18); color:var(--sa-text,#DCEAF4); padding:6px 11px; font-weight:700; font-size:12px; width:100%; box-sizing:border-box; }
    html[data-theme="light"] .apv-decide .note { background:#fff; }
    .apv-decide .row { display:flex; gap:7px; }
    .apv-act { flex:1; min-height:36px; border-radius:10px; border:0; font-size:12.5px; font-weight:900; cursor:pointer; }
    .apv-act.ok { background:rgba(52,211,153,.16); border:1px solid rgba(52,211,153,.5); color:#34d399; }
    .apv-act.ok:hover { background:rgba(52,211,153,.28); }
    .apv-act.no { background:rgba(248,113,113,.16); border:1px solid rgba(248,113,113,.5); color:#f87171; }
    .apv-act.no:hover { background:rgba(248,113,113,.28); }
    .apv-done-note { font-size:12px; font-weight:900; }

    .apv-empty { text-align:center; padding:44px 16px; color:var(--sa-muted,#8FA8BC); }
    .apv-empty .big { font-size:34px; display:block; margin-bottom:6px; opacity:.5; }

    .apv-bulk { position:fixed; inset-inline:0; bottom:0; z-index:60; display:none; align-items:center; gap:12px; flex-wrap:wrap;
        padding:12px 22px; border-top:1px solid rgba(73,111,151,.3);
        background:linear-gradient(180deg,rgba(9,31,52,.98),rgba(5,16,29,.99)); box-shadow:0 -6px 24px rgba(0,0,0,.35); }
    html[data-theme="light"] .apv-bulk { background:linear-gradient(180deg,#fff,#eef6f8); }
    .apv-bulk.show { display:flex; }
    .apv-bulk .cnt { font-weight:1000; }
    .apv-bulk .cnt b { color:var(--acc); direction:ltr; }
    .apv-bulk .note { flex:1; min-width:160px; min-height:40px; border-radius:11px; border:1px solid rgba(73,111,151,.28); background:rgba(0,0,0,.18); color:var(--sa-text,#DCEAF4); padding:6px 12px; font-weight:700; font-size:13px; }
    html[data-theme="light"] .apv-bulk .note { background:#fff; }
    .apv-bulk button { min-height:40px; padding:8px 20px; border-radius:11px; font-size:13px; font-weight:1000; cursor:pointer; }
    .apv-bulk .ok { background:#34d399; border:0; color:#04141d; }
    .apv-bulk .no { background:rgba(248,113,113,.18); border:1px solid rgba(248,113,113,.55); color:#f87171; }
    .apv-bulk .x { background:transparent; border:1px solid rgba(73,111,151,.35); color:inherit; }
</style>

<section class="apv-page" dir="rtl">
    <header class="apv-head">
        <div>
            <h1>الموافقات</h1>
            <p>راجع تفاصيل كل طلب وقرّر — يُطبَّق أثر الطلبات المالية وتعديل البيانات آلياً عند الاعتماد النهائي.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="hrms-alert @(Model.MessageIsError ? "danger" : "success")">@Model.Message</div>
    }

    <div class="apv-kpis">
        <div class="apv-kpi pending"><div class="dot">⏳</div><div><b>@Model.PendingCount</b><span>قيد الموافقة</span></div></div>
        <div class="apv-kpi approved"><div class="dot">✓</div><div><b>@Model.ApprovedCount</b><span>معتمدة</span></div></div>
        <div class="apv-kpi rejected"><div class="dot">✕</div><div><b>@Model.RejectedCount</b><span>مرفوضة</span></div></div>
    </div>

    <div class="apv-toolbar">
        <div class="apv-tabs">
            @{ var tabs = new[] { ("Pending", "قيد الموافقة"), ("Approved", "معتمدة"), ("Rejected", "مرفوضة"), ("All", "الكل") }; }
            @foreach (var (val, label) in tabs)
            {
                <a class="apv-tab @(Model.Status == val ? "on" : "")" href="?Status=@val">@label</a>
            }
        </div>
        <div class="apv-quick">
            <form method="get" style="display:flex;gap:8px;align-items:center">
                <input type="hidden" name="Status" value="@Model.Status" />
                <input class="apv-search" name="Search" value="@Model.Search" placeholder="🔎 بحث سريع بالاسم أو الكود" />
            </form>
            <button type="button" class="apv-btn ghost" onclick="apvPanel()">
                ⛃ بحث متقدم
                @{ var activeCount = new object?[] { Model.RequestType, Model.DepartmentId, Model.BranchId, Model.Position, Model.ReqFrom, Model.ReqTo, Model.ActFrom, Model.ActTo }.Count(x => x != null && !(x is string s && string.IsNullOrWhiteSpace(s))); }
                @if (activeCount > 0)
                {
                    <span class="chip">@activeCount</span>
                }
            </button>
            @if (Model.HasActiveFilters)
            {
                <a class="apv-btn ghost" href="?Status=@Model.Status">مسح</a>
            }
        </div>
    </div>

    <div class="apv-panel @(panelOpen ? "open" : "")" id="apvPanel">
        <form method="get" class="apv-pgrid">
            <input type="hidden" name="Status" value="@Model.Status" />
            <label class="apv-f">اسم أو كود الموظف
                <input name="Search" value="@Model.Search" placeholder="بحث بالاسم أو الكود" />
            </label>
            <label class="apv-f">نوع الطلب
                <select name="RequestType">
                    <option value="">كل الأنواع</option>
                    @foreach (var t in Model.RequestTypes)
                    {
                        <option value="@t" selected="@(Model.RequestType == t)">@t</option>
                    }
                </select>
            </label>
            <label class="apv-f">القسم
                <select name="DepartmentId">
                    <option value="">كل الأقسام</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                    }
                </select>
            </label>
            <label class="apv-f">الفرع
                <select name="BranchId">
                    <option value="">كل الفروع</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </label>
            <label class="apv-f">المنصب
                <select name="Position">
                    <option value="">كل المناصب</option>
                    @foreach (var p in Model.Positions)
                    {
                        <option value="@p" selected="@(Model.Position == p)">@p</option>
                    }
                </select>
            </label>
            <label class="apv-f wide">تاريخ الطلب (من — إلى)
                <div class="rng">
                    <input type="date" name="ReqFrom" value="@D(Model.ReqFrom)" />
                    <span>إلى</span>
                    <input type="date" name="ReqTo" value="@D(Model.ReqTo)" />
                </div>
            </label>
            <label class="apv-f wide">تاريخ آخر حركة (من — إلى)
                <div class="rng">
                    <input type="date" name="ActFrom" value="@D(Model.ActFrom)" />
                    <span>إلى</span>
                    <input type="date" name="ActTo" value="@D(Model.ActTo)" />
                </div>
            </label>
            <div class="apv-pfoot">
                <button type="submit" class="go">🔎 تطبيق الفلاتر</button>
                <a class="clr" href="?Status=@Model.Status">إزالة الفلتر</a>
            </div>
        </form>
    </div>

    <div class="apv-card">
        <table class="apv-table">
            <thead>
                <tr>
                    <th style="width:34px"><input type="checkbox" class="apv-chk" id="apvAll" title="تحديد الكل" /></th>
                    <th class="text-start">الموظف</th>
                    <th>نوع الطلب</th>
                    <th class="text-start">التفاصيل</th>
                    <th>تاريخ الطلب</th>
                    <th>الحالة</th>
                    <th>القرار</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    Model.Flows.TryGetValue(request.Id, out var flow);
                    var badge = TypeBadge(request.RequestType);
                    var initials = string.IsNullOrWhiteSpace(request.EmployeeName) ? "؟" : request.EmployeeName.Trim()[..1];
                    var canAct = request.Status == "Pending" && flow?.Current != null;
                    var formId = $"decform_{request.Id}";
                    var meta = string.Join(" · ", new[] { request.EmployeeNo, request.Department }.Where(s => !string.IsNullOrWhiteSpace(s)));
                    <tr id="row_@request.Id">
                        <td>
                            @if (canAct)
                            {
                                <input type="checkbox" class="apv-chk apv-row" name="Ids" value="@request.Id" form="apvBulkForm" data-row="row_@request.Id" />
                            }
                        </td>
                        <td class="text-start">
                            <div class="apv-emp">
                                <span class="apv-ava">@initials</span>
                                <div>
                                    <div class="nm">@request.EmployeeName</div>
                                    <div class="meta">@meta</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="apv-type @badge.cls">@badge.ic @request.RequestType</span></td>
                        <td class="text-start">
                            <div class="apv-detail">
                                @if (Model.DataChanges.TryGetValue(request.Id, out var diffs))
                                {
                                    @foreach (var d in diffs)
                                    {
                                        var excluded = d.Decision == "Rejected";
                                        <label class="apv-drow @(excluded ? "excluded" : "")">
                                            @if (canAct)
                                            {
                                                <input type="checkbox" class="apv-fchk" name="ApprovedFieldKeys" value="@d.Key" form="@formId" checked="@(!excluded)" />
                                            }
                                            <span><b>@d.Label:</b>
                                                <span class="apv-old">@(string.IsNullOrWhiteSpace(d.OldValue) ? "—" : d.OldValue)</span>
                                                <span class="apv-arrow">→</span>
                                                <span class="apv-new">@(string.IsNullOrWhiteSpace(d.NewValue) ? "—" : d.NewValue)</span>
                                            </span>
                                        </label>
                                    }
                                    @if (canAct && diffs.Count > 1)
                                    {
                                        <div class="apv-fhint">أزل تحديد أي حقل لرفضه دون رفض الطلب كاملاً.</div>
                                    }
                                }
                                else if (Model.FinancialRequests.TryGetValue(request.Id, out var fin))
                                {
                                    <div class="apv-drow"><b>@(fin.Kind == "Raise" ? "قيمة الزيادة" : "المبلغ"):</b>
                                        <span class="apv-new">@fin.Amount.ToString("N2")@(fin.Kind == "Raise" && fin.RaiseType == "Percentage" ? " %" : "")</span>
                                    </div>
                                    @if (fin.Kind is "Loan" or "Advance")
                                    {
                                        <div class="apv-drow"><b>الأقساط:</b> <span>@fin.InstallmentCount قسط ابتداءً من @fin.PeriodText</span></div>
                                    }
                                    else if (fin.Kind is "Allowance" or "Reimbursement")
                                    {
                                        <div class="apv-drow"><b>الدفعة:</b> <span>@(fin.PaymentType == "OutSalary" ? "خارج الراتب" : "داخل الراتب")</span></div>
                                    }
                                }
                                else if (request.FromDate.HasValue)
                                {
                                    <div class="apv-drow"><b>الفترة:</b> <span class="apv-dates">@request.FromDate?.ToString("yyyy-MM-dd")@(request.ToDate.HasValue ? " → " + request.ToDate?.ToString("yyyy-MM-dd") : "")</span></div>
                                    @if (!string.IsNullOrWhiteSpace(request.Reason))
                                    {
                                        <div class="apv-drow apv-mut">@request.Reason</div>
                                    }
                                }
                                else
                                {
                                    <div class="apv-drow apv-mut">@(string.IsNullOrWhiteSpace(request.Reason) ? "—" : request.Reason)</div>
                                }
                            </div>
                        </td>
                        <td class="apv-dates">@(request.CreatedAt?.ToLocalTime().ToString("yyyy-MM-dd"))</td>
                        <td><span class="apv-status @request.Status.ToLower()">@request.Status</span></td>
                        <td>
                            @if (canAct)
                            {
                                <form method="post" class="apv-decide" id="@formId">
                                    <input asp-for="Note" class="note" placeholder="ملاحظة@(flow!.CommentRequiredOnReject ? " (إلزامية للرفض)" : " (اختياري)")" />
                                    <div class="row">
                                        <button asp-page-handler="Approve" asp-route-id="@request.Id" class="apv-act ok">✓ موافقة</button>
                                        <button asp-page-handler="Reject" asp-route-id="@request.Id" class="apv-act no">✕ رفض</button>
                                    </div>
                                </form>
                            }
                            else if (request.Status == "Approved")
                            {
                                <span class="apv-done-note" style="color:#34d399">✓ معتمد</span>
                            }
                            else if (request.Status == "Rejected")
                            {
                                <span class="apv-done-note" style="color:#f87171">✕ مرفوض</span>
                            }
                            else
                            {
                                <span class="apv-mut">—</span>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Requests.Any())
                {
                    <tr>
                        <td colspan="7" class="apv-empty">
                            <span class="big">📭</span>
                            لا توجد طلبات حسب الفلاتر الحالية.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@* شريط الإجراءات الجماعية *@
<form method="post" id="apvBulkForm" class="apv-bulk" dir="rtl">
    <span class="cnt">المحدد: <b id="apvCount">0</b></span>
    <input asp-for="Note" class="note" placeholder="ملاحظة (تُطبَّق على الكل — إلزامية عند الرفض إن طلبها القالب)" />
    <button asp-page-handler="BulkApprove" class="ok">✓ اعتماد المحدد</button>
    <button asp-page-handler="BulkReject" class="no" data-zyconfirm="رفض كل الطلبات المحددة؟">✕ رفض المحدد</button>
    <button type="button" class="x" onclick="apvClear()">إلغاء التحديد</button>
</form>

@section Scripts {
    <script>
        window.apvPanel = function () { document.getElementById('apvPanel').classList.toggle('open'); };
        (function () {
            var all = document.getElementById('apvAll');
            var bar = document.getElementById('apvBulkForm');
            var count = document.getElementById('apvCount');
            function rows() { return Array.prototype.slice.call(document.querySelectorAll('.apv-row')); }
            function refresh() {
                var checked = rows().filter(function (c) { return c.checked; });
                count.textContent = checked.length;
                bar.classList.toggle('show', checked.length > 0);
                rows().forEach(function (c) { var it = document.getElementById(c.getAttribute('data-row')); if (it) it.classList.toggle('sel', c.checked); });
                if (all) {
                    var total = rows().length;
                    all.checked = total > 0 && checked.length === total;
                    all.indeterminate = checked.length > 0 && checked.length < total;
                }
            }
            if (all) all.addEventListener('change', function () { rows().forEach(function (c) { c.checked = all.checked; }); refresh(); });
            rows().forEach(function (c) { c.addEventListener('change', refresh); });
            window.apvClear = function () { rows().forEach(function (c) { c.checked = false; }); refresh(); };
            document.querySelectorAll('.apv-fchk').forEach(function (c) {
                c.addEventListener('change', function () { c.closest('.apv-drow').classList.toggle('excluded', !c.checked); });
            });
            refresh();
        })();
    </script>
}

@page
@model SmartAttendance.Web.Pages.Approvals.IndexModel
@{
    ViewData["Title"] = "الموافقات";

    // المفاتيح الإنجليزية المخزّنة (SelfServices/البوابة) ⟵ تسميتها العربية للعرض.
    string TypeLabel(string t) => t switch
    {
        "Leave" => "إجازة",
        "MissingPunch" => "نسيان بصمة",
        "ExitPermission" => "خروج أثناء الدوام",
        "Overtime" => "عمل إضافي",
        "ShiftRequest" => "طلب مناوبة",
        _ => t
    };

    (string ic, string cls) TypeBadge(string t)
    {
        if (t.Contains("مناوبة")) return ("🕐", "att");
        if (t.Contains("قرض") || t.Contains("سُلفة") || t.Contains("سلفة")) return ("🏦", "fin");
        if (t.Contains("بدل") || t.Contains("استرداد")) return ("🧾", "fin");
        if (t.Contains("زيادة")) return ("📈", "fin");
        if (t.Contains("تعديل")) return ("✏️", "data");
        if (t.Contains("إجازة") || t.Contains("اجازة")) return ("🌴", "leave");
        if (t.Contains("بصمة")) return ("👆", "att");
        if (t.Contains("مغادرة") || t.Contains("خروج")) return ("🚪", "att");
        if (t.Contains("إضافي") || t.Contains("اوفر") || t.Contains("أوفر")) return ("⏱️", "att");
        return ("📄", "gen");
    }
    string D(DateOnly? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // تنسيق الوقت "HH:mm" (عمود SQL time = TimeSpan).
    string T(TimeSpan? t) => t.HasValue ? $"{(int)t.Value.TotalHours:00}:{t.Value.Minutes:00}" : "";

    // المدة بين وقتين مع تجاوز منتصف الليل، كنص عربي "س ساعة و د دقيقة".
    string Dur(TimeSpan st, TimeSpan et)
    {
        var span = et - st;
        if (span <= TimeSpan.Zero) span += TimeSpan.FromDays(1);
        var h = (int)span.TotalHours;
        var m = span.Minutes;
        if (h > 0 && m > 0) return $"{h} ساعة و{m} دقيقة";
        if (h > 0) return $"{h} ساعة";
        return $"{m} دقيقة";
    }

    var panelOpen = Model.HasActiveFilters;

    // أول طلب قابل للفتح (يُفتح افتراضياً في لوحة التفاصيل)
    var firstSel = Model.Requests.FirstOrDefault();
}
<link rel="stylesheet" href="~/css/pages/index-aa8aeae67e.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />


<section class="apv-page" dir="rtl">
    <header class="apv-head">
        <div>
            <h1>الموافقات</h1>
            <p>اختر طلباً من القائمة لتظهر تفاصيله — كل تفصيلة بسطر مستقل، ويُطبَّق أثر الطلبات المالية وتعديل البيانات آلياً عند الاعتماد النهائي.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="hrms-alert @(Model.MessageIsError ? "danger" : "success")">@Model.Message</div>
    }

    <div class="apv-kpis">
        <div class="apv-kpi pending"><div class="dot">⏳</div><div><b>@Model.PendingCount</b><span>قيد الموافقة</span></div></div>
        <div class="apv-kpi approved"><div class="dot">✓</div><div><b>@Model.ApprovedCount</b><span>معتمدة</span></div></div>
        <div class="apv-kpi rejected"><div class="dot">✕</div><div><b>@Model.RejectedCount</b><span>مرفوضة</span></div></div>
    </div>

    <div class="apv-toolbar">
        <div class="apv-tabs">
            @{ var tabs = new[] { ("Pending", "قيد الموافقة"), ("Approved", "معتمدة"), ("Rejected", "مرفوضة"), ("All", "الكل") }; }
            @foreach (var (val, label) in tabs)
            {
                <a class="apv-tab @(Model.Status == val ? "on" : "")" href="?Status=@val">@label</a>
            }
        </div>
        <div class="apv-quick">
            <form method="get" class="zyu-39c68df36fcc">
                <input type="hidden" name="Status" value="@Model.Status" />
                <input class="apv-search" name="Search" value="@Model.Search" placeholder="🔎 بحث سريع بالاسم أو الكود" />
            </form>
            <button type="button" class="apv-btn ghost" onclick="apvPanel()">
                ⛃ بحث متقدم
                @{ var activeCount = new object?[] { Model.RequestType, Model.DepartmentId, Model.BranchId, Model.Position, Model.ReqFrom, Model.ReqTo, Model.ActFrom, Model.ActTo }.Count(x => x != null && !(x is string s && string.IsNullOrWhiteSpace(s))); }
                @if (activeCount > 0)
                {
                    <span class="chip">@activeCount</span>
                }
            </button>
            @if (Model.HasActiveFilters)
            {
                <a class="apv-btn ghost" href="?Status=@Model.Status">مسح</a>
            }
        </div>
    </div>

    <div class="apv-panel @(panelOpen ? "open" : "")" id="apvPanel">
        <form method="get" class="apv-pgrid">
            <input type="hidden" name="Status" value="@Model.Status" />
            <label class="apv-f">اسم أو كود الموظف
                <input name="Search" value="@Model.Search" placeholder="بحث بالاسم أو الكود" />
            </label>
            <label class="apv-f">نوع الطلب
                <select name="RequestType">
                    <option value="">كل الأنواع</option>
                    @foreach (var t in Model.RequestTypes)
                    {
                        <option value="@t" selected="@(Model.RequestType == t)">@TypeLabel(t)</option>
                    }
                </select>
            </label>
            <label class="apv-f">القسم
                <select name="DepartmentId">
                    <option value="">كل الأقسام</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                    }
                </select>
            </label>
            <label class="apv-f">الفرع
                <select name="BranchId">
                    <option value="">كل الفروع</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </label>
            <label class="apv-f">المنصب
                <select name="Position">
                    <option value="">كل المناصب</option>
                    @foreach (var p in Model.Positions)
                    {
                        <option value="@p" selected="@(Model.Position == p)">@p</option>
                    }
                </select>
            </label>
            <label class="apv-f wide">تاريخ الطلب (من — إلى)
                <div class="rng">
                    <input type="date" name="ReqFrom" value="@D(Model.ReqFrom)" />
                    <span>إلى</span>
                    <input type="date" name="ReqTo" value="@D(Model.ReqTo)" />
                </div>
            </label>
            <label class="apv-f wide">تاريخ آخر حركة (من — إلى)
                <div class="rng">
                    <input type="date" name="ActFrom" value="@D(Model.ActFrom)" />
                    <span>إلى</span>
                    <input type="date" name="ActTo" value="@D(Model.ActTo)" />
                </div>
            </label>
            <div class="apv-pfoot">
                <button type="submit" class="go">🔎 تطبيق الفلاتر</button>
                <a class="clr" href="?Status=@Model.Status">إزالة الفلتر</a>
            </div>
        </form>
    </div>

    @if (!Model.Requests.Any())
    {
        <div class="apv-list">
            <div class="apv-empty">
                <span class="big">📭</span>
                لا توجد طلبات حسب الفلاتر الحالية.
            </div>
        </div>
    }
    else
    {
        <div class="apv-split">
            @* ===== القائمة (يسار) ===== *@
            <div class="apv-list">
                <div class="apv-lhead">
                    <label class="all"><input type="checkbox" class="apv-chk" id="apvAll" title="تحديد كل القابلة للإجراء" /> تحديد الكل</label>
                    <span class="zyu-a3d4b1c97186">@Model.Requests.Count طلب</span>
                </div>
                @foreach (var request in Model.Requests)
                {
                    Model.Flows.TryGetValue(request.Id, out var flow);
                    var typeLabel = TypeLabel(request.RequestType);
                    var badge = TypeBadge(typeLabel);
                    var initials = string.IsNullOrWhiteSpace(request.EmployeeName) ? "؟" : request.EmployeeName.Trim()[..1];
                    var canAct = request.Status == "Pending" && flow?.Current != null;
                    var meta = string.Join(" · ", new[] { request.EmployeeNo, request.Department }.Where(s => !string.IsNullOrWhiteSpace(s)));
                    <div class="apv-lrow @(firstSel != null && firstSel.Id == request.Id ? "active" : "")" data-target="side_@request.Id" id="row_@request.Id">
                        <span>
                            @if (canAct)
                            {
                                <input type="checkbox" class="apv-chk apv-row" name="Ids" value="@request.Id" form="apvBulkForm" data-row="row_@request.Id" onclick="event.stopPropagation()" />
                            }
                        </span>
                        <div class="apv-lmain">
                            <span class="apv-ava">@initials</span>
                            <div class="zyu-22a08c80a960">
                                <div class="nm">@request.EmployeeName</div>
                                <div class="sub"><span class="apv-type @badge.cls">@badge.ic @typeLabel</span>@if (!string.IsNullOrWhiteSpace(meta)) { <span class="apv-lmeta">@meta</span> }</div>
                            </div>
                        </div>
                        <div class="apv-lright">
                            <span class="apv-status @request.Status.ToLower()">@request.Status</span>
                            <span class="apv-ldate">@(request.CreatedAt?.ToLocalTime().ToString("yyyy-MM-dd"))</span>
                        </div>
                    </div>
                }
            </div>

            @* ===== لوحة التفاصيل (يمين) ===== *@
            <div class="apv-side">
                @foreach (var request in Model.Requests)
                {
                    Model.Flows.TryGetValue(request.Id, out var flow);
                    var initials = string.IsNullOrWhiteSpace(request.EmployeeName) ? "؟" : request.EmployeeName.Trim()[..1];
                    var canAct = request.Status == "Pending" && flow?.Current != null;
                    var formId = $"decform_{request.Id}";
                    var meta = string.Join(" · ", new[] { request.EmployeeNo, request.Department, request.Position }.Where(s => !string.IsNullOrWhiteSpace(s)));
                    var hasFields = Model.DataChanges.TryGetValue(request.Id, out var diffs) && diffs.Count > 0;
                    <div class="apv-card @(firstSel != null && firstSel.Id == request.Id ? "active" : "")" id="side_@request.Id">
                        <div class="apv-chead">
                            <span class="apv-ava">@initials</span>
                            <div class="zyu-22a08c80a960">
                                <div class="nm">@request.EmployeeName</div>
                                <div class="mt">@TypeLabel(request.RequestType)@(string.IsNullOrWhiteSpace(meta) ? "" : " · " + meta)</div>
                            </div>
                        </div>

                        <form method="post" id="@formId">
                            @if (hasFields)
                            {
                                <div class="apv-sect">الحقول المطلوب تعديلها</div>
                                @foreach (var d in diffs!)
                                {
                                    var excluded = d.Decision == "Rejected";
                                    <label class="apv-frow @(excluded ? "excluded" : "")">
                                        @if (canAct)
                                        {
                                            <input type="checkbox" class="apv-fchk" name="ApprovedFieldKeys" value="@d.Key" form="@formId" checked="@(!excluded)" />
                                        }
                                        <span class="apv-fbody">
                                            <span class="lbl">@d.Label</span>
                                            <span class="val">
                                                <span class="apv-old">@(string.IsNullOrWhiteSpace(d.OldValue) ? "—" : d.OldValue)</span>
                                                <span class="apv-arrow">→</span>
                                                <span class="apv-new">@(string.IsNullOrWhiteSpace(d.NewValue) ? "—" : d.NewValue)</span>
                                            </span>
                                        </span>
                                    </label>
                                }
                                @if (canAct && diffs.Count > 1)
                                {
                                    <div class="apv-fhint">أزل تحديد أي حقل لرفضه دون رفض الطلب كاملاً.</div>
                                }
                            }
                            else if (Model.FinancialRequests.TryGetValue(request.Id, out var fin))
                            {
                                <div class="apv-sect">تفاصيل الطلب المالي</div>
                                <div class="apv-frow">
                                    <span class="apv-fbody">
                                        <span class="lbl">@(fin.Kind == "Raise" ? "قيمة الزيادة" : "المبلغ")</span>
                                        <span class="val"><span class="apv-new">@fin.Amount.ToString("N2")@(fin.Kind == "Raise" && fin.RaiseType == "Percentage" ? " %" : "")</span></span>
                                    </span>
                                </div>
                                @if (fin.Kind is "Loan" or "Advance")
                                {
                                    <div class="apv-frow">
                                        <span class="apv-fbody">
                                            <span class="lbl">الأقساط</span>
                                            <span class="val">@fin.InstallmentCount قسط ابتداءً من @fin.PeriodText</span>
                                        </span>
                                    </div>
                                }
                                else if (fin.Kind is "Allowance" or "Reimbursement")
                                {
                                    <div class="apv-frow">
                                        <span class="apv-fbody">
                                            <span class="lbl">الدفعة</span>
                                            <span class="val">@(fin.PaymentType == "OutSalary" ? "خارج الراتب" : "داخل الراتب")</span>
                                        </span>
                                    </div>
                                }
                            }
                            else if (request.StartTime.HasValue)
                            {
                                @* طلب بوقت (مغادرة/أوفرتايم/مغادرة عمل): يُظهر التاريخ والوقت والساعات *@
                                <div class="apv-sect">تفاصيل الطلب</div>
                                <div class="apv-frow">
                                    <span class="apv-fbody">
                                        <span class="lbl">التاريخ</span>
                                        <span class="val apv-dates">@request.FromDate?.ToString("yyyy-MM-dd")</span>
                                    </span>
                                </div>
                                <div class="apv-frow">
                                    <span class="apv-fbody">
                                        <span class="lbl">الوقت</span>
                                        <span class="val apv-dates">@T(request.StartTime)@(request.EndTime.HasValue ? " → " + T(request.EndTime) : "")</span>
                                    </span>
                                </div>
                                @if (request.EndTime.HasValue)
                                {
                                    <div class="apv-frow">
                                        <span class="apv-fbody">
                                            <span class="lbl">المدة</span>
                                            <span class="val"><span class="apv-new">@Dur(request.StartTime.Value, request.EndTime.Value)</span></span>
                                        </span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(request.Reason))
                                {
                                    <div class="apv-frow">
                                        <span class="apv-fbody">
                                            <span class="lbl">السبب</span>
                                            <span class="val apv-reason">@request.Reason</span>
                                        </span>
                                    </div>
                                }
                            }
                            else if (request.FromDate.HasValue)
                            {
                                <div class="apv-sect">تفاصيل الطلب</div>
                                <div class="apv-frow">
                                    <span class="apv-fbody">
                                        <span class="lbl">الفترة</span>
                                        <span class="val apv-dates">@request.FromDate?.ToString("yyyy-MM-dd")@(request.ToDate.HasValue ? " → " + request.ToDate?.ToString("yyyy-MM-dd") : "")</span>
                                    </span>
                                    @if (request.DaysCount.HasValue && request.DaysCount.Value > 0)
                                    {
                                        <span class="lbl zyu-f4561649741d">@request.DaysCount.Value.ToString("0.#") يوم</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(request.Reason))
                                {
                                    <div class="apv-frow">
                                        <span class="apv-fbody">
                                            <span class="lbl">السبب</span>
                                            <span class="val apv-reason">@request.Reason</span>
                                        </span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="apv-sect">تفاصيل الطلب</div>
                                <div class="apv-frow">
                                    <span class="apv-fbody">
                                        <span class="val apv-reason">@(string.IsNullOrWhiteSpace(request.Reason) ? "لا توجد تفاصيل إضافية." : request.Reason)</span>
                                    </span>
                                </div>
                            }

                            @if (canAct)
                            {
                                <input asp-for="Note" class="apv-note" placeholder="ملاحظة@(flow!.CommentRequiredOnReject ? " (إلزامية للرفض)" : " (اختياري)")" />
                                <div class="apv-decide">
                                    <button asp-page-handler="Approve" asp-route-id="@request.Id" class="apv-act ok">✓ موافقة</button>
                                    <button asp-page-handler="Return" asp-route-id="@request.Id" class="apv-act" title="يتطلب كتابة سبب">↩ إعادة للتعديل</button>
                                    <button asp-page-handler="Reject" asp-route-id="@request.Id" class="apv-act no">✕ رفض</button>
                                </div>
                            }
                            else if (request.Status == "Approved")
                            {
                                <div class="apv-done approved">✓ معتمد</div>
                            }
                            else if (request.Status == "Rejected")
                            {
                                <div class="apv-done rejected">✕ مرفوض</div>
                            }
                        </form>
                    </div>
                }
                <div class="apv-side-empty zyu-6aa34d7432e7" id="apvSideEmpty">اختر طلباً من القائمة لعرض تفاصيله.</div>
            </div>
        </div>
    }
</section>

@* شريط الإجراءات الجماعية *@
<form method="post" id="apvBulkForm" class="apv-bulk" dir="rtl">
    <span class="cnt">المحدد: <b id="apvCount">0</b></span>
    <input asp-for="Note" class="note" placeholder="ملاحظة (تُطبَّق على الكل — إلزامية عند الرفض إن طلبها القالب)" />
    <button asp-page-handler="BulkApprove" class="ok">✓ اعتماد المحدد</button>
    <button asp-page-handler="BulkReject" class="no" data-zyconfirm="رفض كل الطلبات المحددة؟">✕ رفض المحدد</button>
    <button type="button" class="x" onclick="apvClear()">إلغاء التحديد</button>
</form>

@section Scripts {
    <script>
        window.apvPanel = function () { document.getElementById('apvPanel').classList.toggle('open'); };
        (function () {
            // ---- اختيار الطلب لعرض تفاصيله (master-detail) ----
            var rows = Array.prototype.slice.call(document.querySelectorAll('.apv-lrow'));
            function select(row) {
                var id = row.getAttribute('data-target');
                rows.forEach(function (r) { r.classList.toggle('active', r === row); });
                document.querySelectorAll('.apv-card').forEach(function (c) { c.classList.toggle('active', c.id === id); });
            }
            rows.forEach(function (r) { r.addEventListener('click', function () { select(r); }); });

            // ---- التحديد الجماعي ----
            var all = document.getElementById('apvAll');
            var bar = document.getElementById('apvBulkForm');
            var count = document.getElementById('apvCount');
            function checks() { return Array.prototype.slice.call(document.querySelectorAll('.apv-row')); }
            function refresh() {
                var checked = checks().filter(function (c) { return c.checked; });
                count.textContent = checked.length;
                bar.classList.toggle('show', checked.length > 0);
                if (all) {
                    var total = checks().length;
                    all.checked = total > 0 && checked.length === total;
                    all.indeterminate = checked.length > 0 && checked.length < total;
                }
            }
            if (all) all.addEventListener('change', function () { checks().forEach(function (c) { c.checked = all.checked; }); refresh(); });
            checks().forEach(function (c) { c.addEventListener('change', refresh); });
            window.apvClear = function () { checks().forEach(function (c) { c.checked = false; }); refresh(); };

            // ---- استبعاد الحقل بصرياً عند إزالة تحديده ----
            document.querySelectorAll('.apv-fchk').forEach(function (c) {
                c.addEventListener('change', function () { c.closest('.apv-frow').classList.toggle('excluded', !c.checked); });
            });
            refresh();
        })();
    </script>
}

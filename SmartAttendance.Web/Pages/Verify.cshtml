@page
@model SmartAttendance.Web.Pages.VerifyModel
@{
    Layout = null;
    ViewData["Title"] = "التحقق من وثيقة";
}
<link rel="stylesheet" href="~/css/pages/verify-d7f0fd1224.css" asp-append-version="true" />
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>التحقق من وثيقة</title>
    <link rel="stylesheet" href="~/css/zynora-design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/zynora-unified-pages.css" asp-append-version="true" />
    <script src="~/js/zynora-unified-pages.js" asp-append-version="true" defer></script>
    </head>
<body class="zy-app">
    <main class="vf zy-scope zy-ui-contract">
        <h1>التحقق من وثيقة</h1>
        <p class="sub">
            أدخل رمز التحقق المطبوع على الوثيقة، وعامل التحقق المرافق له،
            للتأكّد من أنها صادرة فعلاً عن هذه الجهة ولم تُسحب.
        </p>

        @if (Model.Submitted)
        {
            <div class="res @(Model.Success ? "ok" : "no")">
                <b>@Model.Message</b>

                @if (Model.Success)
                {
                    <dl>
                        <dt>نوع الوثيقة</dt>
                        <dd>@Model.DocumentType</dd>
                        <dt>صادرة لـ</dt>
                        <dd>@Model.EmployeeName</dd>
                        <dt>تاريخ الإصدار</dt>
                        <dd>@Model.IssuedOn?.ToString("yyyy/MM/dd")</dd>
                        @if (Model.ValidUntil is { } until)
                        {
                            <dt>صالحة للتحقق حتى</dt>
                            <dd>@until.ToString("yyyy/MM/dd")</dd>
                        }
                    </dl>
                }
            </div>
        }

        <form method="post">
            <label>
                رمز التحقق
                <input asp-for="Token" dir="ltr" placeholder="ABCD-EFGH-JKMN" autocomplete="off" />
            </label>
            <label>
                عامل التحقق (الرقم الوطني أو رمز PIN)
                <input asp-for="Factor" dir="ltr" placeholder="—" autocomplete="off" />
            </label>
            <button type="submit">تحقّق</button>
        </form>

        <p class="note">
            هذه الصفحة تُثبت أصالة الوثيقة فقط — لا تعرض محتواها ولا بيانات الموظف
            المالية. وإن تعذّر التحقق فراجع الجهة المُصدِرة مباشرةً.
        </p>
    </main>
</body>
</html>

@page "/ShiftTypes"
@model SmartAttendance.Web.Pages.ShiftTypes.IndexModel
@using SmartAttendance.Web.Infrastructure.Hrms
@using System.Text.Json

@*
    أنواع المناوبات — نموذج بأربعة تبويبات متسلسلة (مطابق كيان):
    1) معلومات المناوبة  2) قواعد المناوبة  3) قواعد التعارض مع الحركة  4) معايير الاستحقاق
*@

@{
    ViewData["Title"] = "أنواع المناوبات";
    var shiftsJson = JsonSerializer.Serialize(Model.Shifts.Select(s => new
    {
        s.Id, s.Name, s.NameEn, s.ColorHex, s.IsFlexible, s.FlexDailyHours, s.MultiPeriod, s.IsActive,
        s.FillMissingCheckIn, s.FillMissingCheckOut, s.StripSemantics, s.ConsiderPermissionsOutsideShift,
        s.ExcludePermsOutsideStartFromLate, s.TotalDurationMode, s.AvailableInRoster, s.RequestableFromEss,
        s.LatenessGraceMinutes, s.EarlyLeaveGraceMinutes, s.GraceExceededPolicy,
        s.TimeLimitFrom, s.TimeLimitFromDayBefore,
        s.TimeLimitTo, s.TimeLimitToDayAfter, s.MidShiftTime,
        s.ConflictLateReturnEnabled, s.ConflictLateReturnAction, s.ConflictLateReturnValue,
        s.ConflictEarlyLeaveEnabled, s.ConflictEarlyLeaveAction, s.ConflictEarlyLeaveValue,
        s.OvertimeRateWeekend, s.OvertimeRateRest, s.OvertimeRateHoliday, s.OvertimeRateLeave,
        Days = s.Days.Select(d => new { d.DayIndex, d.DayKind, d.StartTime, d.EndTime }),
        Periods = s.Periods.Select(p => new { p.StartTime, p.EndTime }),
        Eligibility = s.Eligibility.Select(e => new { e.GroupNo, e.Field, e.Value })
    }));
    var lookupsJson = JsonSerializer.Serialize(new
    {
        Department = Model.Departments,
        Branch = Model.Branches,
        Position = Model.Positions,
        Employee = Model.Employees
    });
}
<link rel="stylesheet" href="~/css/pages/index-61a4f08999.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />


<section class="sht-page" dir="rtl">
    <header class="sht-head">
        <div>
            <h1>أنواع المناوبات</h1>
            <p>تعريف المناوبات بأربعة تبويبات (نمط كيان): معلومات · قواعد · التعارض مع الحركة · معايير الاستحقاق.</p>
        </div>
        <button type="button" class="sht-btn" onclick="shtOpen(0)">+ مناوبة جديدة</button>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="sht-alert">@TempData["SuccessMessage"]</div>
    }

    @* استبدال وأرشفة — سيناريو تغيير سياسة الدوام (مثل 9⟵8 ساعات): بلا حذف، التاريخ
       المالي سليم، والمستقبل ينتقل للبديلة. القديمة تختفي من الفرشاة والخدمة الذاتية. *@
    <details class="sht-table-card zyu-62ba3763e99e">
        <summary class="zyu-84bf499459e1">♻️ استبدال وأرشفة مناوبة (تغيير سياسة دوام بلا حذف)</summary>
        <form method="post" asp-page-handler="ReplaceArchive"
              class="zyu-ee0699e2a6ec">
            <label class="zyu-c65196361ade">القديمة (ستُؤرشف)
                <select name="OldShiftId" required class="zyu-07e8e23ed799">
                    <option value="">— اختر —</option>
                    @foreach (var s in Model.Shifts.Where(x => x.IsActive && x.AvailableInRoster))
                    { <option value="@s.Id">@s.Name</option> }
                </select>
            </label>
            <label class="zyu-c65196361ade">البديلة الجديدة
                <select name="NewShiftId" required class="zyu-07e8e23ed799">
                    <option value="">— اختر —</option>
                    @foreach (var s in Model.Shifts.Where(x => x.IsActive))
                    { <option value="@s.Id">@s.Name</option> }
                </select>
            </label>
            <label class="zyu-c65196361ade">سريان الترحيل من
                <input type="date" name="EffectiveFrom" value="@DateTime.Today.ToString("yyyy-MM-dd")"
                       class="zyu-07e8e23ed799" />
            </label>
            <label class="zyu-527cf0f6e59b">
                <input type="checkbox" name="MigrateAssignments" value="true" checked />
                ترحيل الإسناد الافتراضي للموظفين
            </label>
            <button type="submit" class="sht-btn" aria-label="تنفيذ الاستبدال" data-zyconfirm="تنفيذ الاستبدال؟ خلايا الروستر من تاريخ السريان فصاعداً تنتقل للبديلة وتُؤرشف القديمة من الفرشاة (الماضي يبقى كما هو).">تنفيذ الاستبدال</button>
            <span class="zyu-1a5f8aba0f00">
                الأيام الماضية والرواتب المغلقة تبقى مربوطة بالمناوبة القديمة — لا يُحذف شيء. القديمة تختفي فقط من فرشاة الروستر وطلبات الموظفين.
            </span>
        </form>
    </details>

    <div class="sht-table-card">
        @if (Model.Shifts.Count == 0)
        {
            <div class="sht-empty">لا مناوبات معرفة بعد — ابدأ بـ«مناوبة جديدة».</div>
        }
        else
        {
            <table class="sht-table">
                <thead>
                    <tr><th>المناوبة</th><th>النوع</th><th>أيام العطل/الراحة</th><th>ساعات الأسبوع</th><th>الاستحقاق</th><th>الحالة</th><th class="zyu-814fec806937">إجراءات</th></tr>
                </thead>
                <tbody>
                    @foreach (var shift in Model.Shifts)
                    {
                        <tr>
                            <td><span class="sht-color" data-zy-style="background:@shift.ColorHex"></span><b>@shift.Name</b>@(string.IsNullOrWhiteSpace(shift.NameEn) ? "" : $" · {shift.NameEn}")</td>
                            <td>
                                <span class="sht-chip @(shift.IsFlexible ? "flex" : "")">@(shift.IsFlexible ? $"مرنة · {shift.FlexDailyHours:0.##} س/يوم" : "ثابتة")</span>
                                @if (shift.MultiPeriod)
                                { <span class="sht-chip multi">@shift.Periods.Count فترات</span> }
                            </td>
                            <td>@shift.OffDaysText</td>
                            <td class="zyu-6e4c67e3c0a2">@shift.Days.Sum(d => d.WorkHours).ToString("0.##") س</td>
                            <td>@(shift.Eligibility.Count == 0 ? "الكل" : $"{shift.Eligibility.Select(e => e.GroupNo).Distinct().Count()} مجموعة")</td>
                            <td><span class="sht-chip @(shift.IsActive ? "" : "off")">@(shift.IsActive ? "نشطة" : "متوقفة")</span></td>
                            <td class="zyu-667bbbde05a1">
                                <button type="button" class="sht-btn ghost" onclick="shtOpen(@shift.Id)">تعديل</button>
                                <form method="post" asp-page-handler="Delete" class="zyu-6b8b63d565c4">
                                    <input type="hidden" name="id" value="@shift.Id" />
                                    <button type="submit" class="sht-btn ghost zyu-94c76e9c8583" data-zyconfirm="تأكيد الحذف؟">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* ---------- سلايد بناء المناوبة (4 تبويبات) ---------- *@
    <div class="hrms-slideover-backdrop" id="sht-backdrop" onclick="shtClose()"></div>
    <aside class="hrms-slideover wide" id="sht-slide" aria-hidden="true">
        <div class="hrms-slideover-head">
            <h2 id="sht-title">مناوبة جديدة</h2>
            <button type="button" class="hrms-slideover-close" onclick="shtClose()">×</button>
        </div>
        <div class="hrms-slideover-body">
            <form method="post" asp-page-handler="Save" class="sht-form" id="sht-form">
                <input type="hidden" name="Id" id="sht-Id" value="0" />

                <div class="sht-tabs">
                    <button type="button" class="sht-tab active" data-tab="1" onclick="shtTab(1)"><span class="n">1</span> معلومات المناوبة</button>
                    <button type="button" class="sht-tab" data-tab="2" onclick="shtTab(2)"><span class="n">2</span> قواعد المناوبة</button>
                    <button type="button" class="sht-tab" data-tab="3" onclick="shtTab(3)"><span class="n">3</span> التعارض مع الحركة</button>
                    <button type="button" class="sht-tab" data-tab="4" onclick="shtTab(4)"><span class="n">4</span> معايير الاستحقاق</button>
                </div>

                @* ===================== تبويب 1: معلومات المناوبة ===================== *@
                <div class="sht-panel active" data-panel="1">
                    <div class="zyu-71658681447f">
                        <label>اسم المناوبة (عربي) *
                            <input type="text" name="Name" id="sht-Name" required />
                        </label>
                        <label>Shift Name (EN)
                            <input type="text" name="NameEn" id="sht-NameEn" dir="ltr" />
                        </label>
                    </div>

                    <label>لون المناوبة (للمستعرض)</label>
                    <div class="sht-colors">
                        @foreach (var color in ShiftTypeStore.Colors)
                        {
                            <label><input type="radio" name="ColorHex" value="@color" @(color == ShiftTypeStore.Colors[0] ? "checked" : "") /><span data-zy-style="background:@color"></span></label>
                        }
                    </div>

                    <div class="sht-mode">
                        <label class="zyu-76a69fe803c7"><input type="radio" name="ShiftMode" value="fixed" checked onchange="shtModeChanged()" /> ثابتة (أوقات لكل يوم)</label>
                        <label class="zyu-76a69fe803c7"><input type="radio" name="ShiftMode" value="flex" onchange="shtModeChanged()" /> مرنة (ساعات مطلوبة)</label>
                    </div>

                    <label id="sht-flex-wrap" hidden>الساعات المطلوبة يومياً
                        <input type="number" name="FlexDailyHours" id="sht-FlexHours" step="0.25" min="0" max="24" value="8" class="zyu-e0e3ddd79df2" />
                    </label>

                    <div class="sht-mode" id="sht-period-mode">
                        <label class="zyu-76a69fe803c7"><input type="radio" name="PeriodMode" value="single" checked onchange="shtPeriodModeChanged()" /> فترة واحدة</label>
                        <label class="zyu-76a69fe803c7"><input type="radio" name="PeriodMode" value="multi" onchange="shtPeriodModeChanged()" /> فترات متعددة (سبليت شفت)</label>
                    </div>

                    <div id="sht-periods-wrap" hidden class="zyu-0fbf9e859f82">
                        <label class="zyu-ab79ea2b8573">الفترات <span class="sht-hint">— تنطبق على كل أيام العمل؛ ساعات اليوم = مجموع الفترات</span></label>
                        <div id="sht-periods" class="sht-periods"></div>
                        <div class="zyu-99ebfe3d8735">
                            <button type="button" class="sht-btn ghost" onclick="shtAddPeriod()">+ فترة</button>
                            <span class="sht-hint">إجمالي ساعات الفترات: <b id="sht-periods-total" class="zyu-474799ee2243">0</b></span>
                        </div>
                    </div>

                    <label>مصفوفة الأسبوع</label>
                    <div class="sht-daygrid">
                        <div class="sht-dayrow zyu-60ec8b4f68a5">
                            <b>اليوم</b><b>النوع</b><b>الدخول</b><b>الخروج</b><b class="zyu-905008530ca9">ساعات</b>
                        </div>
                        @for (var dayIndex = 0; dayIndex < 7; dayIndex++)
                        {
                            <div class="sht-dayrow" data-day="@dayIndex">
                                <b>@ShiftTypeStore.DayNames[dayIndex]</b>
                                <select name="day_kind_@dayIndex" onchange="shtDayChanged(@dayIndex)">
                                    <option value="Work">يوم عمل</option>
                                    <option value="Weekend">يوم عطلة</option>
                                    <option value="Rest">يوم راحة</option>
                                </select>
                                <input type="time" name="day_start_@dayIndex" value="09:00" onchange="shtDayChanged(@dayIndex)" />
                                <input type="time" name="day_end_@dayIndex" value="17:00" onchange="shtDayChanged(@dayIndex)" />
                                <span class="hours" data-hours="@dayIndex">8</span>
                            </div>
                        }
                    </div>
                </div>

                @* ===================== تبويب 2: قواعد المناوبة ===================== *@
                <div class="sht-panel" data-panel="2">
                    <label>السماحيات والحدود <span class="sht-hint">— فترة السماح، نافذة البصم الصالحة، منتصف المناوبة</span></label>
                    <div class="sht-box">
                        <div class="zyu-71658681447f">
                            <label>فترة السماح للتأخير (دقائق)<input type="number" name="LatenessGraceMinutes" id="sht-LGM" min="0" max="600" value="0" /></label>
                            <label>فترة السماح للخروج المبكر (دقائق)<input type="number" name="EarlyLeaveGraceMinutes" id="sht-ELG" min="0" max="600" value="0" /></label>
                        </div>
                        <label class="zyu-df5afa5a8563">عند تجاوز فترة السماح <span class="sht-hint">— سياسة الشركة في احتساب الفارق</span>
                            <select name="GraceExceededPolicy" id="sht-GXP" class="sht-select">
                                <option value="Subtract">يُطرح المسموح (تأخير 20د وسماحية 15 ⇐ يُسجَّل 5د)</option>
                                <option value="Full">يُحتسب كاملاً (تأخير 20د وسماحية 15 ⇐ يُسجَّل 20د)</option>
                            </select>
                        </label>
                        <div class="zyu-71658681447f">
                            <label>حد وقت بدء المناوبة (أبكر بصمة صالحة)
                                <span class="zyu-d1a8f8bc313b">
                                    <input type="time" name="TimeLimitFrom" id="sht-TLF" class="zyu-83725d2c6e00" />
                                    <select name="TimeLimitFromAnchor" id="sht-TLFA" class="sht-select zyu-5d9090258fef">
                                        <option value="same">نفس اليوم</option>
                                        <option value="before">اليوم السابق</option>
                                    </select>
                                </span>
                            </label>
                            <label>حد وقت انتهاء المناوبة (أحدث بصمة صالحة)
                                <span class="zyu-d1a8f8bc313b">
                                    <input type="time" name="TimeLimitTo" id="sht-TLT" class="zyu-83725d2c6e00" />
                                    <select name="TimeLimitToAnchor" id="sht-TLTA" class="sht-select zyu-5d9090258fef">
                                        <option value="same">نفس اليوم</option>
                                        <option value="after">اليوم التالي</option>
                                    </select>
                                </span>
                            </label>
                        </div>
                        <label class="zyu-63b0844a7154">وقت منتصف المناوبة <span class="sht-hint">(لتقسيم بصمات المناوبة العابرة لمنتصف الليل)</span>
                            <input type="time" name="MidShiftTime" id="sht-MST" class="zyu-eb9e070a2eee" />
                        </label>
                    </div>

                    <label class="zyu-301647f5065e">قواعد سلوك المناوبة <span class="sht-hint">— كيف يعامل محرك الحضور بصمات هذه المناوبة</span></label>
                    <div class="sht-box">
                        <label class="zyu-95e15889185d"><input type="checkbox" name="FillMissingCheckIn" value="true" id="sht-FMI" /> تعبئة وقت بدء المناوبة تلقائياً لأي بصمة دخول مفقودة</label>
                        <label class="zyu-95e15889185d"><input type="checkbox" name="FillMissingCheckOut" value="true" id="sht-FMO" /> تعبئة وقت انتهاء المناوبة تلقائياً لأي بصمة خروج مفقودة</label>
                        <label class="zyu-95e15889185d"><input type="checkbox" name="StripSemantics" value="true" id="sht-STS" /> تجريد فترة الدلالات (استراحة/صلاة…) من مدة الحضور</label>
                        <label class="zyu-95e15889185d"><input type="checkbox" name="RequestableFromEss" value="true" id="sht-RFE" /> قابلة للطلب من الخدمة الذاتية (بوابة الموظف)</label>
                        <label class="zyu-95e15889185d"><input type="checkbox" name="ConsiderPermissionsOutsideShift" value="true" id="sht-CPO" /> احتساب ساعات المغادرة الواقعة خارج المناوبة</label>
                        <label class="zyu-95e15889185d"><input type="checkbox" name="ExcludePermsOutsideStartFromLate" value="true" id="sht-EPL" /> استثناء المغادرات خارج بداية المناوبة من التأخير</label>
                        <label class="zyu-95e15889185d"><input type="checkbox" name="AvailableInRoster" value="true" id="sht-AIR" checked /> متاحة في جدول الحضور (الروستر)</label>
                        <label class="zyu-66ecfda7971b">عند احتساب المدة الإجمالية
                            <select name="TotalDurationMode" id="sht-TDM" class="sht-select">
                                <option value="WorkOnly">أيام العمل فقط</option>
                                <option value="IncludeOff">اشمل أيام العطل</option>
                                <option value="Both">كلاهما</option>
                            </select>
                        </label>
                    </div>

                    <label class="zyu-301647f5065e">سعر ساعة العمل الإضافي <span class="sht-hint">— معامل الأجر بحسب نوع اليوم الذي كُسبت فيه الساعة</span></label>
                    <div class="sht-box">
                        <p class="sht-hint zyu-98a5f06e00b8">
                            اتركه فارغاً ليبقى على الافتراضي (<b>@SmartAttendance.Web.Infrastructure.Hrms.PayrollTransactionStore.DefaultRateFactor</b>) —
                            وهو ما يُطبَّق اليوم على كل ساعة. الصفر يعني «لا أجر إضافيّ لهذه الساعة» وهو قيمة صالحة.
                            المعامل يُطبَّق عند ترحيل حركة الأوفرتايم للرواتب، بحسب سياق اليوم كما حلّله محرّك الحضور.
                        </p>
                        <div class="sht-grid4">
                            <label>في عطلة نهاية الأسبوع
                                <input type="number" step="0.001" min="0" max="99" name="OvertimeRateWeekend" id="sht-ORW" placeholder="افتراضي" />
                            </label>
                            <label>في يوم الراحة
                                <input type="number" step="0.001" min="0" max="99" name="OvertimeRateRest" id="sht-ORR" placeholder="افتراضي" />
                            </label>
                            <label>في عطلة رسمية
                                <input type="number" step="0.001" min="0" max="99" name="OvertimeRateHoliday" id="sht-ORH" placeholder="افتراضي" />
                            </label>
                            <label>في إجازة
                                <input type="number" step="0.001" min="0" max="99" name="OvertimeRateLeave" id="sht-ORL" placeholder="افتراضي" />
                            </label>
                        </div>
                    </div>
                </div>

                @* ===================== تبويب 3: قواعد التعارض مع الحركة ===================== *@
                <div class="sht-panel" data-panel="3">
                    <label>قواعد التعارض مع المغادرات <span class="sht-hint">— الإجراء عندما لا تتطابق المغادرة المعتمدة مع الحضور الفعلي</span></label>
                    <p class="sht-hint zyu-ab79ea2b8573">التعارض المرصود يولّد اقتراحاً معلقاً بشاشة الإجراءات المقترحة — الأثر المالي يُنفَّذ بعد اعتماده يدوياً.</p>

                    <div class="sht-conflict-row off" id="sht-CLR-row">
                        <label class="zyu-af627018678c">
                            <input type="checkbox" name="ConflictLateReturnEnabled" value="true" id="sht-CLRE" onchange="shtConflictChanged()" />
                            عندما يتأخر الموظف في العودة من المغادرة
                        </label>
                        <label>الإجراء
                            <select name="ConflictLateReturnAction" id="sht-CLRA" class="sht-select" onchange="shtConflictChanged()">
                                @foreach (var (key, label) in ShiftTypeStore.ConflictActions)
                                { <option value="@key">@label</option> }
                            </select>
                        </label>
                        <label><span id="sht-CLRV-label">القيمة</span>
                            <input type="number" name="ConflictLateReturnValue" id="sht-CLRV" step="0.25" min="0" value="0" />
                        </label>
                    </div>

                    <div class="sht-conflict-row off" id="sht-CEL-row">
                        <label class="zyu-af627018678c">
                            <input type="checkbox" name="ConflictEarlyLeaveEnabled" value="true" id="sht-CELE" onchange="shtConflictChanged()" />
                            عندما يذهب الموظف في وقت مبكر للمغادرة
                        </label>
                        <label>الإجراء
                            <select name="ConflictEarlyLeaveAction" id="sht-CELA" class="sht-select" onchange="shtConflictChanged()">
                                @foreach (var (key, label) in ShiftTypeStore.ConflictActions)
                                { <option value="@key">@label</option> }
                            </select>
                        </label>
                        <label><span id="sht-CELV-label">القيمة</span>
                            <input type="number" name="ConflictEarlyLeaveValue" id="sht-CELV" step="0.25" min="0" value="0" />
                        </label>
                    </div>
                    <p class="sht-hint zyu-ab79ea2b8573">القيمة = ساعات (للمغادرات) أو مبلغ (للاقتطاع).</p>
                </div>

                @* ===================== تبويب 4: معايير الاستحقاق ===================== *@
                <div class="sht-panel" data-panel="4">
                    <label>معايير الاستحقاق <span class="sht-hint">— اترك فارغاً لتطبيق المناوبة على الجميع، أو حدّد شرائح الموظفين</span></label>
                    <p class="sht-hint zyu-ab79ea2b8573">المناوبة مؤهلة للموظف إن طابق أيّ مجموعة (OR)، والمجموعة تتطلب مطابقة كل قواعدها (AND).</p>
                    <div id="sht-elig-groups" class="zyu-89086d4ee3f5"></div>
                    <button type="button" class="sht-btn ghost zyu-0fd943ffe4c5" onclick="shtAddEligGroup()">+ مجموعة قواعد</button>
                </div>

                <label class="zyu-8d04b9b46e01">
                    <input type="checkbox" name="IsActive" value="true" id="sht-Active" checked /> المناوبة نشطة
                </label>

                <div class="zyu-c4e3b509d354">
                    <button type="button" class="sht-btn ghost" id="sht-prev" onclick="shtNav(-1)">السابق</button>
                    <button type="button" class="sht-btn ghost" id="sht-next" onclick="shtNav(1)">التالي</button>
                    <button type="submit" class="sht-btn zyu-a3d4b1c97186">حفظ المناوبة</button>
                </div>
            </form>
        </div>
    </aside>
</section>

@section Scripts {
    <script>
        var SHT_DATA = @Html.Raw(shiftsJson);
        var SHT_LOOKUPS = @Html.Raw(lookupsJson);
        var SHT_FIELDS = @Html.Raw(JsonSerializer.Serialize(ShiftTypeStore.EligibilityFields.Select(f => new { f.Key, f.Label })));
        var SHT_LOOKUP_FIELDS = ['Department', 'Branch', 'Position', 'Employee']; // منتقيات؛ الباقي نص حر
        var shtTabCur = 1;

        function shtEls(d) {
            return {
                kind: document.querySelector('[name="day_kind_' + d + '"]'),
                start: document.querySelector('[name="day_start_' + d + '"]'),
                end: document.querySelector('[name="day_end_' + d + '"]'),
                hours: document.querySelector('[data-hours="' + d + '"]'),
                row: document.querySelector('.sht-dayrow[data-day="' + d + '"]')
            };
        }

        function shtComputeHours(start, end) {
            if (!start || !end) return 0;
            var s = start.split(':'), e = end.split(':');
            var mins = (parseInt(e[0]) * 60 + parseInt(e[1])) - (parseInt(s[0]) * 60 + parseInt(s[1]));
            if (mins < 0) mins += 1440;
            return Math.round(mins / 60 * 100) / 100;
        }

        function shtIsFlex() { return document.querySelector('[name="ShiftMode"]:checked').value === 'flex'; }
        function shtIsMulti() { var r = document.querySelector('[name="PeriodMode"]:checked'); return !!r && r.value === 'multi' && !shtIsFlex(); }

        function shtDayChanged(d) {
            var el = shtEls(d);
            var isWork = el.kind.value === 'Work';
            var flex = shtIsFlex();
            var multi = shtIsMulti();
            var lockTimes = !isWork || flex || multi;
            el.start.disabled = lockTimes;
            el.end.disabled = lockTimes;
            el.row.classList.toggle('is-off', !isWork);
            el.hours.textContent = !isWork ? '0'
                : flex ? (document.getElementById('sht-FlexHours').value || 0)
                : multi ? (document.getElementById('sht-periods-total').textContent || 0)
                : shtComputeHours(el.start.value, el.end.value);
        }

        function shtModeChanged() {
            var flex = shtIsFlex();
            document.getElementById('sht-flex-wrap').hidden = !flex;
            document.getElementById('sht-period-mode').hidden = flex;
            if (flex) { var single = document.querySelector('[name="PeriodMode"][value="single"]'); if (single) single.checked = true; }
            shtPeriodModeChanged();
        }
        document.getElementById('sht-FlexHours').addEventListener('input', shtModeChanged);

        function shtReindexPeriods() {
            document.querySelectorAll('#sht-periods .sht-period-row').forEach(function (row, i) {
                row.querySelector('.p-start').name = 'period_start_' + i;
                row.querySelector('.p-end').name = 'period_end_' + i;
                row.querySelector('b').textContent = (i + 1);
            });
        }
        function shtAddPeriod(start, end) {
            var wrap = document.getElementById('sht-periods');
            var row = document.createElement('div');
            row.className = 'sht-period-row';
            row.innerHTML = '<b></b>'
                + '<input type="time" class="p-start" value="' + (start || '09:00') + '" onchange="shtPeriodsRecalc()" />'
                + '<input type="time" class="p-end" value="' + (end || '13:00') + '" onchange="shtPeriodsRecalc()" />'
                + '<span class="hours">0</span>'
                + '<button type="button" class="rm" onclick="shtRemovePeriod(this)">×</button>';
            wrap.appendChild(row);
            shtReindexPeriods(); shtPeriodsRecalc();
        }
        function shtRemovePeriod(btn) { var row = btn.closest('.sht-period-row'); row.parentNode.removeChild(row); shtReindexPeriods(); shtPeriodsRecalc(); }
        function shtPeriodsRecalc() {
            var total = 0;
            document.querySelectorAll('#sht-periods .sht-period-row').forEach(function (row) {
                var h = shtComputeHours(row.querySelector('.p-start').value, row.querySelector('.p-end').value);
                row.querySelector('.hours').textContent = h;
                total += h;
            });
            total = Math.round(total * 100) / 100;
            document.getElementById('sht-periods-total').textContent = total;
            if (shtIsMulti()) { for (var d = 0; d < 7; d++) { var el = shtEls(d); if (el.kind.value === 'Work') el.hours.textContent = total; } }
        }
        function shtPeriodModeChanged() {
            var multi = shtIsMulti();
            document.getElementById('sht-periods-wrap').hidden = !multi;
            if (multi && document.querySelectorAll('#sht-periods .sht-period-row').length === 0) {
                shtAddPeriod('09:00', '13:00'); shtAddPeriod('16:00', '20:00');
            }
            for (var d = 0; d < 7; d++) shtDayChanged(d);
            shtPeriodsRecalc();
        }

        // ===== التبويبات =====
        function shtTab(n) {
            shtTabCur = n;
            document.querySelectorAll('.sht-tab').forEach(function (t) { t.classList.toggle('active', +t.dataset.tab === n); });
            document.querySelectorAll('.sht-panel').forEach(function (p) { p.classList.toggle('active', +p.dataset.panel === n); });
            document.getElementById('sht-prev').style.visibility = n === 1 ? 'hidden' : 'visible';
            document.getElementById('sht-next').style.visibility = n === 4 ? 'hidden' : 'visible';
        }
        function shtNav(dir) { var n = Math.min(4, Math.max(1, shtTabCur + dir)); shtTab(n); }

        // ===== تبويب 3: التعارض =====
        function shtConflictChanged() {
            [['CLRE', 'CLR', 'CLRA', 'CLRV'], ['CELE', 'CEL', 'CELA', 'CELV']].forEach(function (ids) {
                var on = document.getElementById('sht-' + ids[0]).checked;
                document.getElementById('sht-' + ids[1] + '-row').classList.toggle('off', !on);
                document.getElementById('sht-' + ids[2]).disabled = !on;
                document.getElementById('sht-' + ids[3]).disabled = !on;
                var isHours = document.getElementById('sht-' + ids[2]).value === 'Permission';
                document.getElementById('sht-' + ids[3] + '-label').textContent = isHours ? 'عدد الساعات' : 'المبلغ';
            });
        }

        // ===== تبويب 4: معايير الاستحقاق =====
        function shtValueControl(field, value) {
            if (SHT_LOOKUP_FIELDS.indexOf(field) >= 0) {
                var opts = '<option value="">اختر…</option>';
                (SHT_LOOKUPS[field] || []).forEach(function (o) {
                    opts += '<option value="' + o.Value + '"' + (String(o.Value) === String(value) ? ' selected' : '') + '>' + o.Label + '</option>';
                });
                return '<select name="EligValue">' + opts + '</select>';
            }
            return '<input type="text" name="EligValue" value="' + (value != null ? String(value).replace(/"/g, '&quot;') : '') + '" placeholder="القيمة" />';
        }
        function shtEligFieldChanged(sel) {
            var rule = sel.closest('.sht-elig-rule');
            var holder = rule.querySelector('.val');
            holder.innerHTML = shtValueControl(sel.value, '');
        }
        function shtAddEligRule(groupEl, field, value) {
            var rules = groupEl.querySelector('.rules');
            var row = document.createElement('div');
            row.className = 'sht-elig-rule';
            var fieldOpts = SHT_FIELDS.map(function (f) {
                return '<option value="' + f.Key + '"' + (f.Key === (field || 'Department') ? ' selected' : '') + '>' + f.Label + '</option>';
            }).join('');
            row.innerHTML = '<input type="hidden" name="EligGroup" class="grp" value="0" />'
                + '<select name="EligField" onchange="shtEligFieldChanged(this)">' + fieldOpts + '</select>'
                + '<span class="val">' + shtValueControl(field || 'Department', value) + '</span>'
                + '<button type="button" class="rm" onclick="shtRemoveEligRule(this)">×</button>';
            rules.appendChild(row);
            shtReindexElig();
        }
        function shtRemoveEligRule(btn) { btn.closest('.sht-elig-rule').remove(); shtReindexElig(); }
        function shtAddEligGroup(rulesData) {
            var wrap = document.getElementById('sht-elig-groups');
            if (wrap.children.length > 0) {
                var or = document.createElement('div'); or.className = 'sht-or'; or.textContent = '— أو —'; wrap.appendChild(or);
            }
            var group = document.createElement('div');
            group.className = 'sht-elig-group';
            group.innerHTML = '<div class="gh"><b class="gt">مجموعة</b>'
                + '<button type="button" class="sht-link zyu-94c76e9c8583" onclick="shtRemoveEligGroup(this)">حذف المجموعة</button></div>'
                + '<div class="rules"></div>'
                + '<button type="button" class="sht-link" onclick="shtAddEligRule(this.closest(\'.sht-elig-group\'))">+ قاعدة</button>';
            wrap.appendChild(group);
            if (rulesData && rulesData.length) {
                rulesData.forEach(function (r) { shtAddEligRule(group, r.Field, r.Value); });
            } else {
                shtAddEligRule(group);
            }
            shtReindexElig();
        }
        function shtRemoveEligGroup(btn) {
            var group = btn.closest('.sht-elig-group');
            var prev = group.previousElementSibling;
            if (prev && prev.classList.contains('sht-or')) prev.remove();
            else { var next = group.nextElementSibling; if (next && next.classList.contains('sht-or')) next.remove(); }
            group.remove();
            shtReindexElig();
        }
        function shtReindexElig() {
            document.querySelectorAll('#sht-elig-groups .sht-elig-group').forEach(function (group, gi) {
                group.querySelector('.gt').textContent = 'مجموعة ' + (gi + 1);
                group.querySelectorAll('.grp').forEach(function (h) { h.value = gi; });
            });
        }

        function shtOpen(id) {
            var form = document.getElementById('sht-form');
            form.reset();
            document.getElementById('sht-Id').value = id || 0;
            document.getElementById('sht-title').textContent = id ? 'تعديل المناوبة' : 'مناوبة جديدة';
            document.getElementById('sht-periods').innerHTML = '';
            document.getElementById('sht-elig-groups').innerHTML = '';
            document.querySelector('[name="PeriodMode"][value="single"]').checked = true;
            shtTab(1);

            if (id) {
                var s = SHT_DATA.find(function (x) { return x.Id === id; });
                if (s) {
                    document.getElementById('sht-Name').value = s.Name || '';
                    document.getElementById('sht-NameEn').value = s.NameEn || '';
                    document.getElementById('sht-Active').checked = !!s.IsActive;
                    var colorInput = document.querySelector('[name="ColorHex"][value="' + s.ColorHex + '"]');
                    if (colorInput) colorInput.checked = true;
                    document.querySelector('[name="ShiftMode"][value="' + (s.IsFlexible ? 'flex' : 'fixed') + '"]').checked = true;
                    document.getElementById('sht-FlexHours').value = s.FlexDailyHours || 8;
                    var multi = !s.IsFlexible && !!s.MultiPeriod;
                    document.querySelector('[name="PeriodMode"][value="' + (multi ? 'multi' : 'single') + '"]').checked = true;
                    if (multi) (s.Periods || []).forEach(function (p) { shtAddPeriod(p.StartTime, p.EndTime); });
                    document.getElementById('sht-FMI').checked = !!s.FillMissingCheckIn;
                    document.getElementById('sht-FMO').checked = !!s.FillMissingCheckOut;
                    document.getElementById('sht-STS').checked = !!s.StripSemantics;
                    document.getElementById('sht-CPO').checked = !!s.ConsiderPermissionsOutsideShift;
                    document.getElementById('sht-EPL').checked = !!s.ExcludePermsOutsideStartFromLate;
                    document.getElementById('sht-AIR').checked = !!s.AvailableInRoster;
                    document.getElementById('sht-RFE').checked = !!s.RequestableFromEss;
                    document.getElementById('sht-TDM').value = s.TotalDurationMode || 'WorkOnly';
                    // معاملات سعر الساعة: null ⟹ حقل فارغ (= «افتراضي»)، والصفر يُعرض صفراً.
                    // `|| ''` وحده كان يمسح الصفر لأنه falsy — فيتحوّل «لا أجر» إلى «افتراضي».
                    ['ORW', 'ORR', 'ORH', 'ORL'].forEach(function (key, i) {
                        var value = [s.OvertimeRateWeekend, s.OvertimeRateRest,
                                     s.OvertimeRateHoliday, s.OvertimeRateLeave][i];
                        document.getElementById('sht-' + key).value =
                            (value === null || value === undefined) ? '' : value;
                    });
                    document.getElementById('sht-LGM').value = s.LatenessGraceMinutes || 0;
                    document.getElementById('sht-ELG').value = s.EarlyLeaveGraceMinutes || 0;
                    document.getElementById('sht-GXP').value = s.GraceExceededPolicy || 'Subtract';
                    document.getElementById('sht-TLF').value = s.TimeLimitFrom || '';
                    document.getElementById('sht-TLFA').value = s.TimeLimitFromDayBefore ? 'before' : 'same';
                    document.getElementById('sht-TLT').value = s.TimeLimitTo || '';
                    document.getElementById('sht-TLTA').value = s.TimeLimitToDayAfter ? 'after' : 'same';
                    document.getElementById('sht-MST').value = s.MidShiftTime || '';
                    // تبويب 3
                    document.getElementById('sht-CLRE').checked = !!s.ConflictLateReturnEnabled;
                    document.getElementById('sht-CLRA').value = s.ConflictLateReturnAction || 'Deduction';
                    document.getElementById('sht-CLRV').value = s.ConflictLateReturnValue || 0;
                    document.getElementById('sht-CELE').checked = !!s.ConflictEarlyLeaveEnabled;
                    document.getElementById('sht-CELA').value = s.ConflictEarlyLeaveAction || 'Deduction';
                    document.getElementById('sht-CELV').value = s.ConflictEarlyLeaveValue || 0;
                    // تبويب 4: أعد بناء المجموعات
                    var byGroup = {};
                    (s.Eligibility || []).forEach(function (e) { (byGroup[e.GroupNo] = byGroup[e.GroupNo] || []).push(e); });
                    Object.keys(byGroup).sort(function (a, b) { return a - b; }).forEach(function (g) { shtAddEligGroup(byGroup[g]); });
                    // مصفوفة الأيام
                    (s.Days || []).forEach(function (day) {
                        var el = shtEls(day.DayIndex);
                        el.kind.value = day.DayKind || 'Work';
                        if (day.StartTime) el.start.value = day.StartTime;
                        if (day.EndTime) el.end.value = day.EndTime;
                    });
                }
            }
            shtModeChanged();
            shtConflictChanged();
            document.getElementById('sht-slide').classList.add('open');
            document.getElementById('sht-backdrop').classList.add('open');
        }

        function shtClose() {
            document.getElementById('sht-slide').classList.remove('open');
            document.getElementById('sht-backdrop').classList.remove('open');
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') shtClose(); });
    </script>
}

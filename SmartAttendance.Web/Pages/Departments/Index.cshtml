@page
@model SmartAttendance.Web.Pages.Departments.IndexModel

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/index-0086522131.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/nexora-setup-pages.css"
          asp-append-version="true" />
}

@{
    ViewData["Title"] = "الأقسام";

    var companies =
        Model.Companies.ToList();

    var hasCompanies =
        companies.Count > 0;

    var firstCompanyId =
        companies.FirstOrDefault()?.Id;

    var editPayloadJson =
        System.Text.Json.JsonSerializer.Serialize(
            Model.EditPayloads);
}

<div class="nexora-setup-page"
     data-setup-page="departments">

    <section class="nexora-setup-hero">

        <div>
            <span class="nexora-setup-kicker">
                الخطوة الثالثة
            </span>

            <h1>الأقسام</h1>

            <p>
                أضف الأقسام على مستوى الشركة.
                يمكن استخدام نفس القسم في أكثر من موقع عمل.
            </p>
        </div>

        <div class="nexora-setup-actions">

            <a asp-page="./Import"
               class="btn-secondary nx-setup-btn nx-setup-btn-secondary">
                استيراد Excel
            </a>

            <button type="button"
                    class="btn-primary nx-setup-btn nx-setup-btn-primary"
                    data-nx-setup-open="department-create-modal"
                    @(hasCompanies ? null : "disabled")>

                + إضافة قسم

            </button>

        </div>

    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success nx-setup-alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!hasCompanies)
    {
        <div class="nx-setup-modal-note">
            يجب إضافة شركة أولاً قبل إنشاء الأقسام.
        </div>
    }

    <section class="table-card nexora-setup-card">

        <div class="nexora-setup-card-head">

            <div>
                <span>سجل الأقسام</span>

                <strong>
                    الأقسام المعرفة داخل كل شركة
                </strong>
            </div>

            <small>
                القسم مستقل عن موقع العمل.
            </small>

        </div>

        <form method="get"
              class="search-form nexora-setup-search">

            <input type="search"
                   name="SearchTerm"
                   value="@Model.SearchTerm"
                   placeholder="ابحث عن القسم أو الشركة..." />

            <button type="submit"
                    class="btn-primary nx-setup-btn nx-setup-btn-primary">
                بحث
            </button>

            <a asp-page="./Index"
               class="btn-secondary nx-setup-btn nx-setup-btn-secondary">
                مسح
            </a>

        </form>

        <div class="nexora-setup-table-wrap">

            <table class="data-table nexora-setup-table">

                <thead>
                    <tr>
                        <th>اسم القسم</th>
                        <th>الشركة</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Departments.Any())
                    {
                        foreach (var department in Model.Departments)
                        {
                            <tr>

                                <td>
                                    <strong class="nx-setup-title">
                                        @department.Name
                                    </strong>

                                    <small class="nx-policy-note">
                                        @department.Code
                                    </small>
                                </td>

                                <td>
                                    @department.CompanyName
                                </td>

                                <td>
                                    <span class="nx-setup-status @(department.IsActive ? "is-active" : "is-inactive")">
                                        @(department.IsActive
                                            ? "فعال"
                                            : "غير فعال")
                                    </span>
                                </td>

                                <td>

                                    <div class="nx-setup-row-actions">

                                        <button type="button"
                                                class="btn-table btn-edit"
                                                data-department-edit-id="@department.Id"
                                                data-nx-setup-open="department-edit-modal">
                                            تعديل
                                        </button>

                                        <button type="button"
                                                class="btn-table btn-delete"
                                                data-department-delete-id="@department.Id"
                                                data-department-delete-name="@department.Name"
                                                data-department-delete-company="@department.CompanyName"
                                                data-department-delete-status="@(department.IsActive ? "فعال" : "غير فعال")"
                                                data-nx-setup-open="department-delete-modal">
                                            حذف
                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4"
                                class="nx-setup-empty">
                                لا توجد أقسام مسجلة.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </section>

</div>

<!-- ========================================================
     CREATE MODAL
     ======================================================== -->

<div class="nx-setup-modal"
     id="department-create-modal"
     style="background:rgba(4,10,20,.32)!important;backdrop-filter:blur(7px) saturate(115%)!important;-webkit-backdrop-filter:blur(7px) saturate(115%)!important;"
     aria-hidden="true">

    <div class="nx-setup-modal__panel zy-department-quick-create"
         role="dialog"
         aria-modal="true"
         aria-labelledby="department-create-title">

        <button type="button"
                class="nx-setup-modal__close"
                data-nx-setup-close
                aria-label="إغلاق">
            &times;
        </button>

        <div class="nx-setup-modal__head">

            <span>الأقسام</span>

            <h2 id="department-create-title">
                إضافة قسم جديد
            </h2>

            <p>
                أدخل اسم القسم حسب لغات بيانات الشركة المفعلة.
            </p>

        </div>

        <form method="post"
              asp-page="./Create"
              class="nx-setup-modal-form"
              id="department-quick-create-form">

            <div class="nx-setup-form-grid">

                <label class="nx-setup-field">

                    <span>الشركة</span>

                    <select name="Department.CompanyId"
                            id="quickDepartmentCompanyId"
                            data-nexora-select="true"
                            required>

                        @foreach (var company in companies)
                        {
                            <option value="@company.Id"
                                    selected="@(company.Id == firstCompanyId ? "selected" : null)">
                                @company.Name
                            </option>
                        }

                    </select>

                </label>

            </div>

            <div class="zy-department-quick-languages">

                @{
                    var quickIndex = 0;
                }

                @foreach (var company in companies)
                {
                    var languageIndexes =
                        Enumerable.Range(
                            0,
                            Model.QuickCreateLanguages.Count)
                        .Where(index =>
                            Model.QuickCreateLanguages[index]
                                .CompanyId ==
                            company.Id)
                        .ToArray();

                    <section class="zy-department-quick-language-company"
                             data-quick-language-company="@company.Id"
                             hidden>

                        @if (languageIndexes.Length == 0)
                        {
                            <div class="zy-department-quick-language-missing">

                                لا توجد لغات بيانات مفعلة لهذه الشركة.

                                <a asp-page="/Settings/DataLanguages"
                                   asp-route-companyId="@company.Id">
                                    إدارة لغات الشركة
                                </a>

                            </div>
                        }
                        else
                        {
                            foreach (var languageIndex in languageIndexes)
                            {
                                var language =
                                    Model.QuickCreateLanguages[
                                        languageIndex];

                                var inputIndex =
                                    quickIndex++;

                                <fieldset class="zy-department-quick-language-card"
                                          dir="@language.Direction"
                                          lang="@language.CultureCode">

                                    <legend>

                                        <span data-zy-no-localize>
                                            @language.NativeName
                                        </span>

                                        <small>

                                            @language.CultureCode

                                            @(language.IsDefault
                                                ? "· اللغة الأساسية"
                                                : "· لغة إضافية")

                                            @(language.IsRequired
                                                ? "· مطلوبة"
                                                : "· اختيارية")

                                        </small>

                                    </legend>

                                    <input type="hidden"
                                           name="DepartmentNameTranslations[@inputIndex].CompanyId"
                                           value="@company.Id" />

                                    <input type="hidden"
                                           name="DepartmentNameTranslations[@inputIndex].CultureCode"
                                           value="@language.CultureCode" />

                                    <label class="zy-department-quick-language-field">

                                        <span>
                                            اسم القسم
                                            @(language.IsRequired ? "*" : "")
                                        </span>

                                        <input name="DepartmentNameTranslations[@inputIndex].Name"
                                               dir="@language.Direction"
                                               autocomplete="off"
                                               data-quick-required="@(language.IsRequired ? "true" : "false")" />

                                    </label>

                                </fieldset>
                            }
                        }

                    </section>
                }

            </div>

            <div class="nx-setup-modal__actions">

                <button type="button"
                        class="nx-setup-btn nx-setup-btn-secondary"
                        data-nx-setup-close>
                    إلغاء
                </button>

                <button type="submit"
                        class="nx-setup-btn nx-setup-btn-primary"
                        @(hasCompanies ? null : "disabled")>
                    حفظ القسم
                </button>

            </div>

        </form>

    </div>

</div>

<!-- ========================================================
     EDIT MODAL
     ======================================================== -->

<div class="nx-setup-modal"
     id="department-edit-modal"
     style="background:rgba(4,10,20,.32)!important;backdrop-filter:blur(7px) saturate(115%)!important;-webkit-backdrop-filter:blur(7px) saturate(115%)!important;"
     aria-hidden="true">

    <div class="nx-setup-modal__panel zy-department-edit-popup"
         role="dialog"
         aria-modal="true"
         aria-labelledby="department-edit-title">

        <button type="button"
                class="nx-setup-modal__close"
                data-nx-setup-close
                aria-label="إغلاق">
            &times;
        </button>

        <div class="nx-setup-modal__head">

            <span>الأقسام</span>

            <h2 id="department-edit-title">
                تعديل القسم
            </h2>

            <p>
                حدّث اسم القسم حسب لغات بيانات الشركة.
            </p>

        </div>

        <form method="post"
              asp-page="./Edit"
              class="nx-setup-modal-form"
              id="department-edit-popup-form">

            <input type="hidden"
                   name="Department.Id"
                   id="editDepartmentId" />

            <div class="nx-setup-form-grid">

                <label class="nx-setup-field">

                    <span>الشركة</span>

                    <select name="Department.CompanyId"
                            id="editDepartmentCompanyId"
                            required>

                        @foreach (var company in companies)
                        {
                            <option value="@company.Id">
                                @company.Name
                            </option>
                        }

                    </select>

                </label>

                <label class="nx-setup-check zy-department-edit-active">

                    <input type="hidden"
                           name="Department.IsActive"
                           value="false" />

                    <input type="checkbox"
                           name="Department.IsActive"
                           id="editDepartmentIsActive"
                           value="true" />

                    <span>القسم فعال</span>

                </label>

            </div>

            <div id="department-edit-language-fields"
                 class="zy-department-edit-language-fields">
            </div>

            <div class="nx-setup-modal__actions">

                <button type="button"
                        class="nx-setup-btn nx-setup-btn-secondary"
                        data-nx-setup-close>
                    إلغاء
                </button>

                <button type="submit"
                        class="nx-setup-btn nx-setup-btn-primary">
                    حفظ التعديلات
                </button>

            </div>

        </form>

    </div>

</div>


<!-- ========================================================
     DELETE MODAL
     ======================================================== -->

<div class="nx-setup-modal"
     id="department-delete-modal"
     style="background:rgba(4,10,20,.32)!important;backdrop-filter:blur(7px) saturate(115%)!important;-webkit-backdrop-filter:blur(7px) saturate(115%)!important;"
     aria-hidden="true">

    <div class="nx-setup-modal__panel zy-department-delete-popup"
         role="dialog"
         aria-modal="true"
         aria-labelledby="department-delete-title">

        <button type="button"
                class="nx-setup-modal__close"
                data-nx-setup-close
                aria-label="إغلاق">
            &times;
        </button>

        <div class="nx-setup-modal__head">

            <span>الأقسام</span>

            <h2 id="department-delete-title">
                حذف القسم
            </h2>

            <p>
                تأكد من بيانات القسم قبل تنفيذ الحذف.
            </p>

        </div>

        <form method="post"
              asp-page="./Delete"
              class="nx-setup-modal-form"
              id="department-delete-popup-form">

            <input type="hidden"
                   name="id"
                   id="deleteDepartmentId" />

            <div class="zy-department-delete-warning">
                <strong>هل تريد حذف هذا القسم؟</strong>
                <span>
                    لا يمكن التراجع عن هذه العملية بعد تنفيذ الحذف.
                </span>
            </div>

            <div class="zy-department-delete-summary">

                <div>
                    <span>اسم القسم</span>
                    <strong id="deleteDepartmentName">—</strong>
                </div>

                <div>
                    <span>الشركة</span>
                    <strong id="deleteDepartmentCompany">—</strong>
                </div>

                <div>
                    <span>الحالة</span>
                    <strong id="deleteDepartmentStatus">—</strong>
                </div>

            </div>

            <div class="nx-setup-modal__actions">

                <button type="button"
                        class="nx-setup-btn nx-setup-btn-secondary"
                        data-nx-setup-close>
                    إلغاء
                </button>

                <button type="submit"
                        class="nx-setup-btn zy-department-delete-confirm">
                    حذف القسم
                </button>

            </div>

        </form>

    </div>

</div>
<script type="application/json"
        id="department-edit-payload-json">
@Html.Raw(editPayloadJson)
</script>

@section Scripts {

<script>
(function () {

    // =====================================================
    // CREATE
    // =====================================================

    const createCompany =
        document.getElementById(
            "quickDepartmentCompanyId");

    const createSections =
        Array.from(
            document.querySelectorAll(
                "[data-quick-language-company]"));

    function syncCreateLanguages() {

        if (!createCompany)
            return;

        const companyId =
            createCompany.value;

        createSections.forEach(section => {

            const active =
                section.dataset
                    .quickLanguageCompany ===
                companyId;

            section.hidden =
                !active;

            section
                .querySelectorAll(
                    "[data-quick-required]")
                .forEach(input => {

                    input.required =
                        active &&
                        input.dataset
                            .quickRequired ===
                        "true";
                });
        });
    }

    if (createCompany) {

        createCompany.addEventListener(
            "change",
            syncCreateLanguages);

        syncCreateLanguages();
    }

    // =====================================================
    // EDIT
    // =====================================================

    const payloadElement =
        document.getElementById(
            "department-edit-payload-json");

    const payloads =
        payloadElement
            ? JSON.parse(
                payloadElement.textContent || "[]")
            : [];

    const languageMetadata =
        @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                Model.QuickCreateLanguages));

    const editId =
        document.getElementById(
            "editDepartmentId");

    const editCompany =
        document.getElementById(
            "editDepartmentCompanyId");

    const editActive =
        document.getElementById(
            "editDepartmentIsActive");

    const editLanguageFields =
        document.getElementById(
            "department-edit-language-fields");

    let activePayload = null;

    const drafts = {};

    function draftKey(
        companyId,
        cultureCode) {

        return `${companyId}|${cultureCode}`;
    }

    function rememberCurrentEditValues() {

        if (!editLanguageFields)
            return;

        editLanguageFields
            .querySelectorAll(
                "[data-edit-language-input]")
            .forEach(input => {

                drafts[
                    draftKey(
                        input.dataset.companyId,
                        input.dataset.cultureCode)
                ] = input.value;
            });
    }

    function getPayloadValue(
        cultureCode) {

        if (!activePayload)
            return "";

        const value =
            activePayload.Values
                .find(item =>
                    item.CultureCode
                        .toLowerCase() ===
                    cultureCode
                        .toLowerCase());

        return value
            ? value.Value
            : "";
    }

    function renderEditLanguages() {

        if (!editCompany ||
            !editLanguageFields)
            return;

        rememberCurrentEditValues();

        const companyId =
            Number(editCompany.value);

        const languages =
            languageMetadata
                .filter(item =>
                    Number(item.CompanyId) ===
                    companyId);

        editLanguageFields.innerHTML = "";

        if (languages.length === 0) {

            editLanguageFields.innerHTML =
                `<div class="zy-department-quick-language-missing">
                    لا توجد لغات بيانات مفعلة لهذه الشركة.
                </div>`;

            return;
        }

        languages.forEach(
            (language, index) => {

                const key =
                    draftKey(
                        companyId,
                        language.CultureCode);

                let value =
                    drafts[key];

                if (value === undefined &&
                    activePayload &&
                    Number(activePayload.CompanyId) ===
                        companyId)
                {
                    value =
                        getPayloadValue(
                            language.CultureCode);
                }

                value =
                    value ?? "";

                const card =
                    document.createElement(
                        "fieldset");

                card.className =
                    "zy-department-quick-language-card";

                card.dir =
                    language.Direction || "ltr";

                const requiredText =
                    language.IsRequired
                        ? "· مطلوبة"
                        : "· اختيارية";

                const typeText =
                    language.IsDefault
                        ? "· اللغة الأساسية"
                        : "· لغة إضافية";

                card.innerHTML = `
                    <legend>
                        <span data-zy-no-localize>
                            ${escapeHtml(language.NativeName)}
                        </span>

                        <small>
                            ${escapeHtml(language.CultureCode)}
                            ${typeText}
                            ${requiredText}
                        </small>
                    </legend>

                    <input type="hidden"
                           name="DepartmentNameTranslations[${index}].CompanyId"
                           value="${companyId}" />

                    <input type="hidden"
                           name="DepartmentNameTranslations[${index}].CultureCode"
                           value="${escapeHtml(language.CultureCode)}" />

                    <label class="zy-department-quick-language-field">

                        <span>
                            اسم القسم
                            ${language.IsRequired ? "*" : ""}
                        </span>

                        <input
                            name="DepartmentNameTranslations[${index}].Name"
                            dir="${escapeHtml(language.Direction || "ltr")}"
                            value="${escapeHtml(value)}"
                            autocomplete="off"
                            data-edit-language-input
                            data-company-id="${companyId}"
                            data-culture-code="${escapeHtml(language.CultureCode)}"
                            ${language.IsRequired ? "required" : ""} />

                    </label>
                `;

                editLanguageFields
                    .appendChild(card);
            });
    }

    function openEditDepartment(
        departmentId) {

        const payload =
            payloads.find(item =>
                Number(item.Id) ===
                Number(departmentId));

        if (!payload)
            return;

        activePayload =
            payload;

        Object.keys(drafts)
            .forEach(key =>
                delete drafts[key]);

        payload.Values
            .forEach(item => {

                drafts[
                    draftKey(
                        payload.CompanyId,
                        item.CultureCode)
                ] =
                    item.Value || "";
            });

        editId.value =
            payload.Id;

        editCompany.value =
            String(payload.CompanyId);

        editActive.checked =
            Boolean(payload.IsActive);

        renderEditLanguages();
    }

    document
        .querySelectorAll(
            "[data-department-edit-id]")
        .forEach(button => {

            button.addEventListener(
                "click",
                () => {

                    openEditDepartment(
                        button.dataset
                            .departmentEditId);
                });
        });

    if (editCompany) {

        editCompany.addEventListener(
            "change",
            renderEditLanguages);
    }

    // =====================================================
    // DELETE
    // =====================================================

    const deleteId =
        document.getElementById(
            "deleteDepartmentId");

    const deleteName =
        document.getElementById(
            "deleteDepartmentName");

    const deleteCompany =
        document.getElementById(
            "deleteDepartmentCompany");

    const deleteStatus =
        document.getElementById(
            "deleteDepartmentStatus");

    document
        .querySelectorAll(
            "[data-department-delete-id]")
        .forEach(button => {

            button.addEventListener(
                "click",
                () => {

                    if (deleteId) {
                        deleteId.value =
                            button.dataset
                                .departmentDeleteId || "";
                    }

                    if (deleteName) {
                        deleteName.textContent =
                            button.dataset
                                .departmentDeleteName || "—";
                    }

                    if (deleteCompany) {
                        deleteCompany.textContent =
                            button.dataset
                                .departmentDeleteCompany || "—";
                    }

                    if (deleteStatus) {
                        deleteStatus.textContent =
                            button.dataset
                                .departmentDeleteStatus || "—";
                    }
                });
        });
    function escapeHtml(value) {

        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

})();
</script>

}


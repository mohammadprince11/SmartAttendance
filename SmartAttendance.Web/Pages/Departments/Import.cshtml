@page
@model SmartAttendance.Web.Pages.Departments.ImportModel

@section Styles {
    <link rel="stylesheet" href="~/css/zynora-setup-pages.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "استيراد الأقسام";
}

<div class="zynora-import-page" data-import-page="departments">
    <section class="zynora-import-hero">
        <div>
            <span class="zynora-setup-kicker">استيراد البيانات</span>
            <h1>استيراد الأقسام</h1>
            <p>&#x0627;&#x0631;&#x0641;&#x0639; &#x0627;&#x0644;&#x0623;&#x0642;&#x0633;&#x0627;&#x0645; &#x0645;&#x0639; &#x0643;&#x0648;&#x062F; &#x0627;&#x0644;&#x0634;&#x0631;&#x0643;&#x0629; &#x0627;&#x0644;&#x062A;&#x0627;&#x0628;&#x0639; &#x0644;&#x0647;&#x0627; &#x0643;&#x0644; &#x0642;&#x0633;&#x0645;.</p>
        </div>

        <div class="zynora-import-hero-actions"> @* ZYNORA_FIX22A_TEMPLATE_LINK *@
            <a href="?handler=Template" class="nx-setup-btn nx-setup-btn-primary">Excel Template</a>
            <a asp-page="/Setup/Index" asp-route-companyId="@Model.CompanyId" asp-fragment="departments" class="nx-setup-btn nx-setup-btn-secondary">&#x0627;&#x0644;&#x0639;&#x0648;&#x062F;&#x0629; &#x0625;&#x0644;&#x0649; &#x0625;&#x0639;&#x062F;&#x0627;&#x062F; &#x0627;&#x0644;&#x0634;&#x0631;&#x0643;&#x0629;</a>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="nx-setup-alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="zynora-import-alert is-error">
            @Model.ErrorMessage
        </div>
    }

    @if (Model.ImportResult != null)
    {
        <section class="zynora-import-card">
            <div class="zynora-import-card-head">
                <div>
                    <span>نتيجة الاستيراد</span>
                    <strong>ملخص العملية بعد الحفظ</strong>
                </div>
            </div>

            <div class="zynora-import-summary">
                <div class="zynora-import-summary-card">
                    <span>تمت الإضافة</span>
                    <strong>@Model.ImportResult.CreatedCount</strong>
                </div>

                <div class="zynora-import-summary-card">
                    <span>تم التحديث</span>
                    <strong>@Model.ImportResult.UpdatedCount</strong>
                </div>

                <div class="zynora-import-summary-card">
                    <span>تم التخطي</span>
                    <strong>@Model.ImportResult.SkippedCount</strong>
                </div>

                <div class="zynora-import-summary-card">
                    <span>الأخطاء</span>
                    <strong>@Model.ImportResult.ErrorCount</strong>
                </div>
            </div>
        </section>
    }

    <section class="zynora-import-card">
        <div class="zynora-import-card-head">
            <div>
                <span>مصدر البيانات</span>
                <strong>اختر ملف Excel أو الصق البيانات مباشرة</strong>
            </div>
            <small>استخدم نفس أسماء الأعمدة المطلوبة حتى تتم قراءة الملف بشكل صحيح.</small>
        </div>

        <form method="post" enctype="multipart/form-data" asp-page-handler="Preview">
            <input asp-for="CompanyId" type="hidden" />
            <div class="zynora-import-two">
                <div class="zynora-import-box">
                    <div class="zynora-import-box-title">
                        <span class="zynora-import-step">1</span>
                        رفع ملف Excel / CSV
                    </div>

                    <p class="zynora-import-help">
                        اختر ملفاً جاهزاً بصيغة .xlsx أو .csv يحتوي على أعمدة الأقسام.
                    </p>

                    <input asp-for="ImportFile" type="file" accept=".xlsx,.csv" class="zynora-import-file" />

                    <div class="zynora-import-note">
                        إذا قمت برفع ملف ولصق بيانات في نفس الوقت، سيتم اعتماد الملف المرفوع.
                    </div>
                </div>

                <div class="zynora-import-box">
                    <div class="zynora-import-box-title">
                        <span class="zynora-import-step">2</span>
                        لصق من Excel
                    </div>

                    <p class="zynora-import-help">
                        حدد الصفوف من Excel ثم اضغط Ctrl + C، وبعدها الصقها هنا باستخدام Ctrl + V.
                    </p>

                    <textarea asp-for="PastedData"
                              class="zynora-import-paste"
                              placeholder="Name&#9;CompanyCode&#10;Human Resources&#9;COMP-001"></textarea>
                </div>
            </div>

            <div class="zynora-import-required">
                <div>
                    <span>الأعمدة المطلوبة</span>
                    <strong>يجب أن يحتوي الملف على هذه الأعمدة</strong>
                </div>

                <div class="zynora-import-badges">
                    @foreach (var column in Model.RequiredColumns)
                    {
                        <span class="zynora-import-badge">@column</span>
                    }
                </div>
            </div>

            <div class="zynora-import-actions">
                <button type="submit" class="nx-setup-btn nx-setup-btn-primary">معاينة البيانات</button>
                <div class="zynora-import-hero-actions"> @* ZYNORA_FIX22A_TEMPLATE_LINK *@
            <a href="?handler=Template" class="nx-setup-btn nx-setup-btn-primary">Excel Template</a>
            <a asp-page="/Setup/Index" asp-route-companyId="@Model.CompanyId" asp-fragment="departments" class="nx-setup-btn nx-setup-btn-secondary">&#x0627;&#x0644;&#x0639;&#x0648;&#x062F;&#x0629; &#x0625;&#x0644;&#x0649; &#x0625;&#x0639;&#x062F;&#x0627;&#x062F; &#x0627;&#x0644;&#x0634;&#x0631;&#x0643;&#x0629;</a>
        </div>
            </div>
        </form>
    </section>

    @if (Model.Preview != null)
    {
        <section class="zynora-import-card">
            <div class="zynora-import-card-head">
                <div>
                    <span>معاينة البيانات</span>
                    <strong>@Model.Preview.FileName</strong>
                </div>
                <small>يتم عرض أول @Model.Preview.PreviewLimit صف فقط، لكن الاستيراد سيعالج كل الصفوف الصالحة.</small>
            </div>

            <div class="zynora-import-summary">
                <div class="zynora-import-summary-card">
                    <span>إجمالي الصفوف</span>
                    <strong>@Model.Preview.TotalRows</strong>
                </div>

                <div class="zynora-import-summary-card">
                    <span>جاهزة</span>
                    <strong>@Model.Preview.ReadyCount</strong>
                </div>

                <div class="zynora-import-summary-card">
                    <span>إضافة</span>
                    <strong>@Model.Preview.CreateCount</strong>
                </div>

                <div class="zynora-import-summary-card">
                    <span>تحديث</span>
                    <strong>@Model.Preview.UpdateCount</strong>
                </div>

                <div class="zynora-import-summary-card">
                    <span>أخطاء</span>
                    <strong>@Model.Preview.ErrorCount</strong>
                </div>
            </div>

            @if (Model.Preview.ReadyCount > 0)
            {
                <form method="post" asp-page-handler="Import" class="zynora-import-confirm">
                    <input asp-for="CompanyId" type="hidden" />
                    <input type="hidden" name="token" value="@Model.Preview.Token" />
                    <button type="submit" class="nx-setup-btn nx-setup-btn-primary">استيراد الصفوف الصالحة</button>
                </form>
            }
        </section>

        <section class="table-card zynora-setup-card">
            <div class="zynora-setup-card-head">
                <div>
                    <span>تفاصيل المعاينة</span>
                    <strong>حالة كل صف قبل الاستيراد</strong>
                </div>
            </div>

            <div class="zynora-setup-table-wrap">
                <table class="data-table zynora-setup-table">
                    <thead>
                        <tr>
                            <th>الصف</th>
                            <th>الحالة</th>
                            <th>الإجراء</th>
                            <th>المفتاح</th>
                            <th>الرسالة</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Preview.Rows.Any())
                        {
                            foreach (var row in Model.Preview.Rows)
                            {
                                var statusClass = row.Status == "Ready" ? "status-ready" : "status-error";
                                var statusText = row.Status == "Ready" ? "جاهز" : "خطأ";
                                var actionText = row.Action == "Create"
                                    ? "إضافة"
                                    : row.Action == "Update"
                                        ? "تحديث"
                                        : row.Action == "Skip"
                                            ? "تخطي"
                                            : row.Action;

                                <tr>
                                    <td>@row.RowNumber</td>
                                    <td class="@statusClass">@statusText</td>
                                    <td>@actionText</td>
                                    <td>@row.Key</td>
                                    <td>@row.Message</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="nx-setup-empty">لا توجد صفوف للمعاينة.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

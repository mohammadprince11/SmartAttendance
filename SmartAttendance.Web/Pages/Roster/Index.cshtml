@page "/Roster"
@model SmartAttendance.Web.Pages.Roster.IndexModel
@using SmartAttendance.Web.Infrastructure.Hrms

@*
    جدولة مناوبات العمل (الروستر) — الصفحة الثالثة بقسم «حضور الموظفين» (نمط كيان):
    شبكة موظف×يوم، خلية = مناوبة/عطلة/راحة، غير المجدول ← الافتراضية. حفظ + نشر.
*@

@{
    ViewData["Title"] = "جدولة مناوبات العمل";
    var (year, month) = Model.Period;

    // لون كل مناوبة = لونها الحقيقي المخزّن (ColorHex) لا لون تلقائي — نفس ألوان مستعرض الحضور.
    string ShiftColor(ShiftTypeStore.ShiftType s) =>
        !string.IsNullOrWhiteSpace(s.ColorHex) ? s.ColorHex : "#12D9E3";

    // بطاقة ساعات العمل المختصرة للخلية: مرنة ⇒ «Nس»؛ ثابتة ⇒ «HH–HH» لأول يوم عمل (تُختصر :00).
    static string Clock(string? t) =>
        t is { Length: >= 5 } ? (t.EndsWith(":00") ? t[..2] : t[..5]) : (t ?? "");
    string HoursLabel(ShiftTypeStore.ShiftType s)
    {
        if (s.IsFlexible) return s.FlexDailyHours > 0 ? $"{s.FlexDailyHours:0.#}س مرن" : "مرن";
        var work = s.Days.FirstOrDefault(d => d.IsWork
            && !string.IsNullOrWhiteSpace(d.StartTime) && !string.IsNullOrWhiteSpace(d.EndTime));
        if (work != null) return $"{Clock(work.StartTime)}–{Clock(work.EndTime)}";
        var wh = s.Days.Where(d => d.IsWork).Select(d => d.WorkHours).FirstOrDefault();
        return wh > 0 ? $"{wh:0.#}س" : "";
    }

    // عائلة المناوبة (صباحية/مسائية/ليلية/مرنة) لتجميع منتقي «كل المناوبات».
    string FamilyLabel(ShiftTypeStore.ShiftType s) => ShiftTypeStore.FamilyOf(
        s.Days.FirstOrDefault(d => d.IsWork && !string.IsNullOrWhiteSpace(d.StartTime))?.StartTime,
        s.IsFlexible);

    var shiftJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Shifts.ToDictionary(s => s.Id.ToString(),
            s => new { n = s.Name, c = ShiftColor(s), h = HoursLabel(s), f = FamilyLabel(s) }));
}

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />

<style>
    .ros-page { display: flex; flex-direction: column; gap: 14px; color: var(--sa-text, #DCEAF4); }
    .ros-head {
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;
        padding: 16px 20px; border: 1px solid rgba(73,111,151,.22); border-radius: 20px;
        background: radial-gradient(circle at 90% 10%, rgba(18,217,227,.12), transparent 36%),
                    linear-gradient(135deg, rgba(9,31,52,.95), rgba(5,16,29,.95));
    }
    html[data-theme="light"] .ros-head { background: linear-gradient(135deg, #fff, #f2f7fb); }
    .ros-head h1 { margin: 0; font-size: 20px; font-weight: 1000; }
    .ros-head p { margin: 2px 0 0; font-size: 12px; color: var(--sa-muted, #8FA8BC); font-weight: 800; }
    .ros-btn { min-height: 38px; padding: 8px 18px; border-radius: 12px; border: 0; font-size: 13px; font-weight: 900; cursor: pointer; background: linear-gradient(135deg, #12D9E3, #0ea5b5); color: #04141d; }
    .ros-btn.ghost { background: transparent; border: 1px solid rgba(73,111,151,.3); color: inherit; }
    .ros-btn.pub { background: linear-gradient(135deg, #4ade80, #22c55e); }

    .ros-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 10px 14px; border: 1px solid rgba(73,111,151,.22); border-radius: 16px; background: var(--sa-surface, rgba(8,25,43,.9)); }
    .ros-bar input { min-height: 36px; border-radius: 10px; border: 1px solid rgba(73,111,151,.25); background: rgba(0,0,0,.16); color: var(--sa-text, #DCEAF4); padding: 6px 10px; font-size: 13px; }
    html[data-theme="light"] .ros-bar input { background: #fff; color: inherit; }
    .ros-note { font-size: 12px; font-weight: 800; padding: 10px 14px; border-radius: 12px; border: 1px solid rgba(250,204,21,.3); background: rgba(250,204,21,.08); color: #facc15; }
    .ros-pub { font-size: 12px; font-weight: 900; padding: 5px 12px; border-radius: 999px; background: rgba(74,222,128,.14); color: #4ade80; }
    .ros-pub.no { background: rgba(143,168,188,.14); color: var(--sa-muted, #8FA8BC); }
    .ros-alert { padding: 10px 14px; border-radius: 12px; font-size: 13px; font-weight: 800; border: 1px solid rgba(74,222,128,.35); background: rgba(74,222,128,.08); }

    /* الاسم لا يحتوي «card/panel/form» عمداً: قاعدة nexora-calendar العامة تفرض overflow:visible!important على أي كلاس يحوي تلك الكلمات */
    .ros-grid-scroll { border: 1px solid rgba(73,111,151,.22); border-radius: 18px; overflow: auto; background: var(--sa-surface, rgba(8,25,43,.9)); max-height: 66vh; }
    .ros-grid { border-collapse: separate; border-spacing: 0; font-size: 11.5px; user-select: none; }
    .ros-grid th, .ros-grid td { border-bottom: 1px solid rgba(143,168,188,.1); border-inline-start: 1px solid rgba(143,168,188,.06); white-space: nowrap; }
    .ros-grid thead th { position: sticky; top: 0; z-index: 3; background: #0a1f33; color: var(--sa-muted, #8FA8BC); font-weight: 1000; padding: 6px 8px; text-align: center; }
    html[data-theme="light"] .ros-grid thead th { background: #eef4f9; }
    .ros-grid th.emp, .ros-grid td.emp { position: sticky; inset-inline-start: 0; z-index: 2; background: var(--sa-surface, #0b2135); text-align: start; padding: 6px 12px; min-width: 190px; }
    .ros-grid thead th.emp { z-index: 4; }
    html[data-theme="light"] .ros-grid th.emp, html[data-theme="light"] .ros-grid td.emp { background: #fff; }
    .ros-grid td.emp b { font-weight: 900; }
    .ros-grid td.emp .dep { font-size: 10px; color: var(--sa-muted, #8FA8BC); font-weight: 800; }
    .ros-dcol { min-width: 58px; }
    .ros-dcol .dn { font-size: 10px; opacity: .8; }
    .ros-dcol.off { color: #f87171; }
    .rc-td { padding: 2px; text-align: center; }
    .rc { width: 58px; min-height: 30px; border-radius: 6px; border: 1px solid rgba(73,111,151,.18); background: rgba(0,0,0,.14); color: var(--sa-muted, #8FA8BC); padding: 2px 3px; cursor: pointer; overflow: hidden; transition: transform .05s; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; line-height: 1.12; }
    .rc .rc-n { font-size: 10.5px; font-weight: 900; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rc .rc-h { font-size: 8.5px; font-weight: 800; opacity: .82; direction: ltr; }
    .rc:hover { transform: scale(1.06); }
    .rc:active { transform: scale(.94); }
    html[data-theme="light"] .rc { background: #f4f8fb; }

    .ros-palette { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; padding: 10px 14px; border: 1px solid rgba(73,111,151,.22); border-radius: 16px; background: var(--sa-surface, rgba(8,25,43,.9)); }
    .ros-palette .lbl { font-weight: 900; font-size: 12px; }
    .pchip { border: 1px solid rgba(73,111,151,.3); border-radius: 999px; padding: 5px 12px; font-size: 12px; font-weight: 800; cursor: pointer; background: transparent; color: inherit; display: flex; gap: 6px; align-items: center; }
    .pchip .dot { width: 12px; height: 12px; border-radius: 50%; }
    .pchip.active { outline: 2px solid #12D9E3; outline-offset: 1px; background: rgba(18,217,227,.12); }
    .pchip.tool.on { outline: 2px solid #facc15; background: rgba(250,204,21,.12); }
    .ros-empty { padding: 28px; text-align: center; color: var(--sa-muted, #8FA8BC); font-weight: 800; }
    .ros-actions { display: flex; gap: 8px; align-items: center; }

    /* منتقي «كل المناوبات»: بحث + تجميع حسب العائلة — الشريط يبقى سطراً مضغوطاً */
    /* display بالكلاس يتغلب على خاصية hidden — نعيد لها الغلبة صراحةً */
    .ros-pick[hidden], .ros-pick-backdrop[hidden] { display: none !important; }
    .ros-pick-backdrop { position: fixed; inset: 0; background: rgba(2,10,18,.55); z-index: 60; }
    .ros-pick { position: fixed; top: 12vh; inset-inline: max(16px, calc(50vw - 330px)); z-index: 61;
        border: 1px solid rgba(73,111,151,.3); border-radius: 18px; background: var(--sa-surface, #0a1f33);
        box-shadow: 0 22px 60px rgba(0,0,0,.5); max-height: 72vh; display: flex; flex-direction: column; }
    html[data-theme="light"] .ros-pick { background: #fff; }
    .ros-pick-head { display: flex; gap: 8px; padding: 12px 14px; border-bottom: 1px solid rgba(73,111,151,.2); }
    .ros-pick-head input { flex: 1; min-height: 38px; border-radius: 10px; border: 1px solid rgba(73,111,151,.3);
        background: rgba(0,0,0,.16); color: inherit; padding: 6px 12px; font-size: 13px; font-weight: 800; }
    html[data-theme="light"] .ros-pick-head input { background: #f4f8fb; }
    .ros-pick-body { overflow: auto; padding: 12px 14px 16px; }
    .ros-pick-group { font-size: 11px; font-weight: 1000; color: var(--sa-muted, #8FA8BC); margin: 10px 0 6px; }
    .ros-pick-row { display: flex; gap: 6px; flex-wrap: wrap; }
</style>

<section class="ros-page" dir="rtl">
    <header class="ros-head">
        <div>
            <h1>جدولة مناوبات العمل</h1>
            <p>شبكة موظف × يوم — عيّن مناوبة أو عطلة/راحة لكل يوم. الأيام غير المجدولة تُحلَّل بالمناوبة الافتراضية.</p>
        </div>
        <form method="get" class="ros-actions">
            <input type="month" name="Month" value="@Model.Month" onchange="this.form.submit()"
                   style="min-height:38px;border-radius:10px;border:1px solid rgba(73,111,151,.3);background:rgba(0,0,0,.16);color:inherit;padding:6px 10px" />
            <input type="hidden" name="Search" value="@Model.Search" />
            @if (Model.PublishedAt != null)
            {
                <span class="ros-pub">منشور · @Model.PublishedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            }
            else
            {
                <span class="ros-pub no">غير منشور</span>
            }
        </form>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ros-alert">@TempData["SuccessMessage"]</div>
    }

    <div class="ros-note">في حال لم تُعيّن مناوبة أو يوم عطلة لموظف في يوم معين، يُجدول تلقائياً وفق مناوبته الافتراضية (تعيينه الدائم/الاستحقاق).</div>

    <form method="get" class="ros-bar">
        <input type="hidden" name="Month" value="@Model.Month" />
        <input type="text" name="Search" value="@Model.Search" placeholder="بحث بالموظف (رمز/اسم)..." />
        <button type="submit" class="ros-btn ghost">عرض</button>
        <span style="margin-inline-start:auto;font-size:12px;font-weight:800;color:var(--sa-muted,#8FA8BC)">
            الموظفون: <b style="direction:ltr;display:inline-block;color:var(--sa-text,#DCEAF4)">@Model.TotalRows</b>
        </span>
    </form>

    @if (Model.Employees.Count > 0)
    {
        @* الشريط يبقى سطراً مهما كبر الكتالوج: ثوابت + آخر المستخدمة + «كل المناوبات» ببحث *@
        <div class="ros-palette">
            <span class="lbl">الفرشاة:</span>
            <button type="button" class="pchip active" data-bv="" onclick="setBrush('')"><span class="dot" style="background:#64748b"></span>افتراضي —</button>
            <button type="button" class="pchip" data-bv="Weekend" onclick="setBrush('Weekend')"><span class="dot" style="background:#f87171"></span>عطلة</button>
            <button type="button" class="pchip" data-bv="Rest" onclick="setBrush('Rest')"><span class="dot" style="background:#facc15"></span>راحة</button>
            <span id="ros-recents" style="display:contents"></span>
            <button type="button" class="pchip" onclick="openPicker()">كل المناوبات (@Model.Shifts.Count) ▾</button>
            <button type="button" class="pchip tool" id="ros-eyedrop" onclick="toggleEyedrop()" title="القطّارة: انقرها ثم انقر خلية لالتقاط مناوبتها فرشاةً — أو انقر أي خلية بالزر الأيمن مباشرة">💧 قطّارة</button>
            <span style="margin-inline-start:auto;font-size:11px;font-weight:800;color:var(--sa-muted,#8FA8BC)">انقر أو اسحب على الخلايا لطليها · الزر الأيمن يلتقط فرشاة الخلية · يُحفظ ما غيّرته فقط</span>
        </div>

        <div class="ros-pick-backdrop" id="ros-pick-backdrop" hidden onclick="closePicker()"></div>
        <div class="ros-pick" id="ros-pick" hidden role="dialog" aria-label="كل المناوبات">
            <div class="ros-pick-head">
                <input type="text" id="ros-pick-search" placeholder="ابحث باسم المناوبة أو وقتها (مثال: 8 أو ليلاً)..." oninput="renderPicker()" />
                <button type="button" class="pchip" onclick="closePicker()">إغلاق ✕</button>
            </div>
            <div class="ros-pick-body" id="ros-pick-body"></div>
        </div>
    }

    <form method="post" id="ros-form">
        <input type="hidden" name="Month" value="@Model.Month" />
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />

        <div class="ros-grid-scroll">
            @if (Model.Employees.Count == 0)
            {
                <div class="ros-empty">لا موظفون مطابقون.</div>
            }
            else
            {
                <table class="ros-grid">
                    <thead>
                        <tr>
                            <th class="emp">الموظف</th>
                            @foreach (var day in Model.Days)
                            {
                                var isFri = day.DayOfWeek == DayOfWeek.Friday;
                                <th class="ros-dcol @(isFri ? "off" : "")">
                                    @day.Day<div class="dn">@Model.DayName(day)</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            <tr>
                                <td class="emp">
                                    <b>@emp.Name</b>
                                    <div class="dep" style="direction:ltr">@emp.No · @emp.Department</div>
                                </td>
                                @foreach (var day in Model.Days)
                                {
                                    var cell = Model.Cells.TryGetValue((emp.Id, day), out var c) ? c : null;
                                    var val = cell == null ? "" : cell.CellType switch
                                    {
                                        RosterStore.CellWeekend => "Weekend",
                                        RosterStore.CellRest => "Rest",
                                        _ => "S" + cell.ShiftTypeId
                                    };
                                    <td class="rc-td">
                                        <button type="button" class="rc" data-v="@val" onclick="rosPaint(this)"></button>
                                        <input type="hidden" disabled name="cell_@(emp.Id)_@(day.ToString("yyyy-MM-dd"))" value="" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="ros-bar" style="justify-content:space-between">
            <div class="ros-actions">
                <button type="submit" asp-page-handler="Save" class="ros-btn" data-zyconfirm="حفظ الجدول للصفحة الحالية؟">حفظ الجدول</button>
                <button type="submit" asp-page-handler="Publish" class="ros-btn pub" data-zyconfirm="حفظ ونشر جدول الشهر؟">نشر الجدول</button>
            </div>
            @if (Model.TotalPages > 1)
            {
                <div class="ros-actions" style="font-size:12px;font-weight:900">
                    @if (Model.PageNumber > 1)
                    {
                        <a class="ros-btn ghost" href="?Month=@Model.Month&Search=@Model.Search&PageNumber=@(Model.PageNumber - 1)">السابق</a>
                    }
                    <span>صفحة @Model.PageNumber / @Model.TotalPages</span>
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a class="ros-btn ghost" href="?Month=@Model.Month&Search=@Model.Search&PageNumber=@(Model.PageNumber + 1)">التالي</a>
                    }
                </div>
            }
        </div>
    </form>
</section>

@section Scripts {
    <script>
        const SHIFTS = @Html.Raw(shiftJson);
        let brush = '';
        let eyedrop = false;
        let painting = false;   // طلاء بالسحب (فأرة)

        // ===== آخر الفرشات المستخدمة (تبقى عبر الجلسات) =====
        const RKEY = 'rosBrushRecent';
        function recents() {
            try { return (JSON.parse(localStorage.getItem(RKEY)) || []).filter(v => SHIFTS[v.slice(1)]); }
            catch (e) { return []; }
        }
        function pushRecent(v) {
            if (!v || !v.startsWith('S')) return;
            const r = [v, ...recents().filter(x => x !== v)].slice(0, 8);
            try { localStorage.setItem(RKEY, JSON.stringify(r)); } catch (e) { }
            renderRecents();
        }
        function chipHtml(v) {
            const s = SHIFTS[v.slice(1)];
            return `<button type="button" class="pchip" data-bv="${v}" onclick="setBrush('${v}')">` +
                `<span class="dot" style="background:${s.c}"></span>${esc(s.n)}${s.h ? ' · ' + esc(s.h) : ''}</button>`;
        }
        function renderRecents() {
            document.getElementById('ros-recents').innerHTML = recents().map(chipHtml).join('');
            refreshChips();
        }
        function refreshChips() {
            document.querySelectorAll('.pchip[data-bv]').forEach(c =>
                c.classList.toggle('active', c.dataset.bv === brush));
        }

        function setBrush(v) {
            brush = v;
            setEyedrop(false);
            pushRecent(v);
            refreshChips();
        }

        // ===== القطّارة: التقاط فرشاة من خلية موجودة =====
        function setEyedrop(on) {
            eyedrop = on;
            document.getElementById('ros-eyedrop').classList.toggle('on', on);
        }
        function toggleEyedrop() { setEyedrop(!eyedrop); }

        // ===== منتقي «كل المناوبات»: بحث + تجميع حسب العائلة =====
        function openPicker() {
            document.getElementById('ros-pick-backdrop').hidden = false;
            document.getElementById('ros-pick').hidden = false;
            renderPicker();
            document.getElementById('ros-pick-search').focus();
        }
        function closePicker() {
            document.getElementById('ros-pick-backdrop').hidden = true;
            document.getElementById('ros-pick').hidden = true;
        }
        function pickShift(v) { setBrush(v); closePicker(); }
        function renderPicker() {
            const q = document.getElementById('ros-pick-search').value.trim();
            const families = ['صباحية', 'مسائية', 'ليلية', 'مرنة', 'أخرى'];
            const icons = { 'صباحية': '🌅', 'مسائية': '🌇', 'ليلية': '🌙', 'مرنة': '⏱', 'أخرى': '·' };
            let html = '';
            for (const fam of families) {
                const items = Object.entries(SHIFTS)
                    .filter(([, s]) => (s.f || 'أخرى') === fam)
                    .filter(([, s]) => !q || s.n.includes(q) || (s.h || '').includes(q))
                    .sort(([, a], [, b]) => (a.h || '').localeCompare(b.h || ''));
                if (!items.length) continue;
                html += `<div class="ros-pick-group">${icons[fam]} ${fam} (${items.length})</div><div class="ros-pick-row">` +
                    items.map(([id, s]) =>
                        `<button type="button" class="pchip" onclick="pickShift('S${id}')">` +
                        `<span class="dot" style="background:${s.c}"></span>${esc(s.n)}${s.h ? ' · ' + esc(s.h) : ''}</button>`).join('') +
                    '</div>';
            }
            document.getElementById('ros-pick-body').innerHTML =
                html || '<div class="ros-empty">لا مناوبات مطابقة للبحث.</div>';
        }

        function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

        // لون نص متباين حسب سطوع لون المناوبة — يبقى مقروءاً مهما كان ColorHex.
        function fgFor(hex) {
            const c = (hex || '').replace('#', '');
            if (c.length < 6) return '#04141d';
            const r = parseInt(c.slice(0, 2), 16), g = parseInt(c.slice(2, 4), 16), b = parseInt(c.slice(4, 6), 16);
            return (0.299 * r + 0.587 * g + 0.114 * b) > 150 ? '#04141d' : '#ffffff';
        }

        function disp(v) {
            if (!v) return { t: '—', h: '', bg: '', fg: '' };
            if (v === 'Weekend') return { t: 'عطلة', h: '', bg: 'rgba(248,113,113,.20)', fg: '#f87171' };
            if (v === 'Rest') return { t: 'راحة', h: '', bg: 'rgba(250,204,21,.18)', fg: '#facc15' };
            const s = SHIFTS[v.slice(1)];
            if (!s) return { t: v, h: '', bg: '#12D9E3', fg: '#04141d' };
            return { t: s.n, h: s.h || '', bg: s.c, fg: fgFor(s.c) };
        }

        function styleCell(btn, v) {
            const d = disp(v);
            btn.innerHTML = d.h
                ? `<span class="rc-n">${esc(d.t)}</span><span class="rc-h">${esc(d.h)}</span>`
                : `<span class="rc-n">${esc(d.t)}</span>`;
            btn.title = d.h ? `${d.t} · ${d.h}` : d.t;
            btn.style.background = d.bg;
            btn.style.color = d.fg;
            btn.dataset.v = v;
        }

        // النقر يطلي الخلية بالفرشاة النشطة، ويفعّل الـinput المخفي ليُرسَل عند الحفظ.
        // والقطّارة المفعّلة تعكس الاتجاه: تلتقط قيمة الخلية فرشاةً بدل طليها.
        function rosPaint(btn) {
            if (eyedrop) { setBrush(btn.dataset.v || ''); return; }
            styleCell(btn, brush);
            const inp = btn.nextElementSibling;
            inp.value = brush;
            inp.disabled = false;   // ما عاد افتراضياً ⇒ يُرسَل ويُحفظ
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderRecents();
            document.addEventListener('pointerup', () => painting = false);
            document.addEventListener('keydown', e => { if (e.key === 'Escape') closePicker(); });

            document.querySelectorAll('.rc').forEach(b => {
                styleCell(b, b.dataset.v || '');
                // طلاء بالسحب (فأرة): اضغط واسحب فتنطلي الخلايا تحت المؤشر.
                b.addEventListener('pointerdown', e => {
                    if (e.pointerType !== 'mouse' || e.button !== 0 || eyedrop) return;
                    painting = true;
                    try { b.releasePointerCapture(e.pointerId); } catch (err) { }
                });
                b.addEventListener('pointerenter', () => { if (painting) rosPaint(b); });
                // الزر الأيمن = قطّارة فورية: يلتقط فرشاة الخلية بلا قائمة سياق.
                b.addEventListener('contextmenu', e => {
                    e.preventDefault();
                    setBrush(b.dataset.v || '');
                });
            });
        });
    </script>
}

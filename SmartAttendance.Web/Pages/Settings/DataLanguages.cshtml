@page
@model SmartAttendance.Web.Pages.Settings.DataLanguagesModel
@{
    ViewData["Title"] = "لغات بيانات الشركة";
}

@section Styles {
    <link rel="stylesheet" href="~/css/zynora-administration.css" asp-append-version="true" />
}

<main class="zy-data-languages" dir="rtl">
    <nav class="zy-data-languages__breadcrumb" aria-label="مسار الصفحة">
        <a asp-page="/Settings/Index">الإعدادات</a><span>/</span><strong>لغات بيانات الشركة</strong>
    </nav>

    <header class="zy-data-languages__hero">
        <div>
            <span>ZYNORA MULTILINGUAL DATA</span>
            <h1>لغات بيانات الشركة</h1>
            <p>حدد لغة أساسية واحدة، وفعّل أي لغات إضافية تحتاجها لأسماء الموظفين والشركات والفروع والأقسام والمناصب والسياسات والمخالفات.</p>
        </div>

        @if (Model.Companies.Count > 0)
        {
            <form method="get" class="zy-data-languages__company">
                <label for="companyId">الشركة</label>
                <select id="companyId" name="companyId" onchange="this.form.submit()">
                    @foreach (var company in Model.Companies)
                    {
                        <option value="@company.Id" selected="@(company.Id == Model.CompanyId)">
                            @company.Name · @company.Code
                        </option>
                    }
                </select>
            </form>
        }
        else
        {
            <div class="zy-data-languages__company">
                <span>الشركة</span>
                <strong>لا توجد شركة مضافة حالياً</strong>
            </div>
        }
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="zy-data-languages__notice success">@success</div>
    }

    <div asp-validation-summary="All" class="zy-data-languages__notice error"></div>

    @if (Model.Companies.Count == 0)
    {
        <section class="zy-data-languages__explain" aria-label="الحالة الأولية">
            <strong>ابدأ بإنشاء شركة</strong>
            <p>
                يمكنك فتح صفحة لغات البيانات وإدارة قاموس اللغات حتى قبل إنشاء أول شركة.
                إعداد اللغة الأساسية واللغات المطلوبة والاختيارية يصبح متاحاً بعد إنشاء الشركة.
            </p>
        </section>

        <footer class="zy-data-languages__actions">
            <a asp-page="/Settings/Dictionary">إدارة قاموس اللغات</a>
            <a asp-page="/Setup/Index">إنشاء شركة</a>
        </footer>
    }
    else
    {
        <form method="post" asp-page-handler="Save" class="zy-data-languages__form">
            <input type="hidden" asp-for="CompanyId" />

            <section class="zy-data-languages__explain">
                <strong>قاعدة الإدخال</strong>
                <p>
                    فعّل اللغات التي تستخدمها الشركة، ثم حدد لكل لغة إن كانت مطلوبة أو اختيارية.
                    اللغة الأساسية تكون مفعلة ومطلوبة دائماً.
                </p>
            </section>

            <section class="zy-data-languages__grid" aria-label="اللغات المتاحة">
                @foreach (var language in Model.AvailableLanguages)
                {
                    var active = Model.ActiveCultureCodes.Contains(
                        language.Code,
                        StringComparer.OrdinalIgnoreCase);

                    var isDefault = string.Equals(
                        Model.DefaultCultureCode,
                        language.Code,
                        StringComparison.OrdinalIgnoreCase);

                    var required = isDefault ||
                        Model.RequiredCultureCodes.Contains(
                            language.Code,
                            StringComparer.OrdinalIgnoreCase);

                    <article class="zy-data-language-card @(active ? "is-active" : "") @(required ? "is-required" : "")">
                        <label class="zy-data-language-card__enable">
                            <input type="checkbox"
                                   name="ActiveCultureCodes"
                                   value="@language.Code"
                                   checked="@active" />
                            <span>تفعيل</span>
                        </label>

                        <div>
                            <strong data-zy-no-localize>@language.NativeName</strong>
                            <small>
                                @language.EnglishName ·
                                @language.Code ·
                                @language.Direction.ToUpperInvariant()
                            </small>
                        </div>

                        <div class="zy-data-language-card__rules">
                            <label class="zy-data-language-card__default">
                                <input type="radio"
                                       name="DefaultCultureCode"
                                       value="@language.Code"
                                       checked="@isDefault" />
                                <span>اللغة الأساسية</span>
                            </label>

                            <label class="zy-data-language-card__required">
                                <input type="checkbox"
                                       name="RequiredCultureCodes"
                                       value="@language.Code"
                                       checked="@required"
                                       disabled="@isDefault" />
                                <span>مطلوبة عند الإدخال</span>
                            </label>
                        </div>
                    </article>
                }
            </section>

            <footer class="zy-data-languages__actions">
                <a asp-page="/Settings/Dictionary">إضافة لغة إلى القاموس</a>
                <button type="submit">حفظ إعدادات اللغات</button>
            </footer>
        </form>
    }
</main>

@section Scripts {
<script>
(function () {
    const form = document.querySelector(".zy-data-languages__form");
    if (!form) return;

    const cards = Array.from(
        form.querySelectorAll(".zy-data-language-card"));

    function syncCard(card) {
        const active = card.querySelector(
            'input[name="ActiveCultureCodes"]');

        const required = card.querySelector(
            'input[name="RequiredCultureCodes"]');

        const primary = card.querySelector(
            'input[name="DefaultCultureCode"]');

        if (!active || !required || !primary) return;

        if (primary.checked) {
            active.checked = true;
            required.checked = true;
        }

        if (!active.checked) {
            required.checked = false;
        }

        required.disabled =
            !active.checked || primary.checked;

        card.classList.toggle(
            "is-active",
            active.checked);

        card.classList.toggle(
            "is-required",
            required.checked);
    }

    cards.forEach(syncCard);

    form.addEventListener("change", function (event) {
        const target = event.target;

        if (target.matches(
            'input[name="DefaultCultureCode"]')) {
            cards.forEach(syncCard);
            return;
        }

        const card = target.closest(
            ".zy-data-language-card");

        if (card) syncCard(card);
    });
})();
</script>
}
@section Scripts {

<script>
(() => {

    /* =====================================================
       CREATE RESET
       ===================================================== */

    const editorForm =
        document.getElementById("positionEditorForm");

    const editorTitle =
        document.querySelector("[data-position-editor-title]");

    function setValue(name, value) {
        const element =
            document.querySelector(`[name="${name}"]`);

        if (element) {
            element.value = value;
        }
    }

    function resetCreateForm() {

        if (!editorForm)
            return;

        setValue("Input.Id", "0");
        setValue("Input.OriginalArabicName", "");
        setValue("Input.ArabicName", "");
        setValue("Input.Description", "");
        setValue("Input.Category", "");
        setValue("Input.Level", "");
        setValue("Input.Competencies", "");
        setValue("Input.Education", "");
        setValue("Input.EducationSpecialization", "");
        setValue("Input.Certifications", "");
        setValue("Input.JobPurpose", "");
        setValue("Input.KeyResponsibilities", "");
        setValue("Input.JobRequirements", "");
        setValue("Input.RequiredSkills", "");
        setValue("Input.JobKpis", "");

        const active =
            document.querySelector(
                '[name="Input.IsActive"][type="checkbox"]'
            );

        if (active) {
            active.checked = true;
        }

        if (editorTitle) {
            editorTitle.textContent =
                "إضافة منصب وظيفي";
        }

        if (window.NexoraSelect &&
            typeof window.NexoraSelect.refreshAll === "function") {

            window.setTimeout(
                () => window.NexoraSelect.refreshAll(),
                30
            );
        }
    }

    document
        .querySelectorAll("[data-position-create]")
        .forEach(button => {

            button.addEventListener(
                "click",
                resetCreateForm
            );

        });



    /* =====================================================
       DELETE
       ===================================================== */

    const deleteId =
        document.getElementById("positionDeleteId");

    const deleteName =
        document.getElementById("positionDeleteName");

    const deleteEmployees =
        document.getElementById("positionDeleteEmployees");

    document
        .querySelectorAll("[data-position-delete]")
        .forEach(button => {

            button.addEventListener("click", () => {

                if (deleteId) {
                    deleteId.value =
                        button.dataset.positionDeleteId || "";
                }

                if (deleteName) {
                    deleteName.textContent =
                        button.dataset.positionDeleteName || "—";
                }

                if (deleteEmployees) {
                    deleteEmployees.textContent =
                        button.dataset.positionDeleteEmployees || "0";
                }

            });

        });



    /* =====================================================
       FILTER + PAGINATION
       ===================================================== */

    const normalize =
        value =>
            (value || "")
                .toString()
                .trim()
                .toLowerCase();

    const search =
        document.getElementById("positionSearch");

    const category =
        document.getElementById("categoryFilter");

    const level =
        document.getElementById("levelFilter");

    const status =
        document.getElementById("statusFilter");

    const rows =
        Array.from(
            document.querySelectorAll(
                "[data-position-row]"
            )
        );

    const pager =
        document.getElementById("positionsPager");

    const pageSummary =
        document.getElementById(
            "positionsPageSummary"
        );

    const pageIndicator =
        document.getElementById(
            "positionsPageIndicator"
        );

    const previousPageButton =
        document.getElementById(
            "positionsPrevPage"
        );

    const nextPageButton =
        document.getElementById(
            "positionsNextPage"
        );

    const pageSize = 25;

    let currentPage = 1;
    let filteredRows = [];


    function renderPage() {

        const totalItems =
            filteredRows.length;

        const totalPages =
            Math.max(
                1,
                Math.ceil(
                    totalItems /
                    pageSize
                )
            );

        if (currentPage > totalPages) {
            currentPage = totalPages;
        }

        const startIndex =
            (currentPage - 1) *
            pageSize;

        const endIndex =
            Math.min(
                startIndex + pageSize,
                totalItems
            );

        rows.forEach(row => {
            row.hidden = true;
        });

        filteredRows
            .slice(
                startIndex,
                endIndex
            )
            .forEach(
                (row, index) => {

                    row.hidden = false;

                    const cell =
                        row.querySelector(
                            "[data-position-sequence]"
                        );

                    if (cell) {
                        cell.textContent =
                            (
                                startIndex +
                                index +
                                1
                            ).toString();
                    }

                });

        if (pager) {
            pager.hidden =
                totalItems <= pageSize;
        }

        if (pageSummary) {

            pageSummary.textContent =
                totalItems === 0
                    ? "لا توجد نتائج مطابقة"
                    : `عرض ${startIndex + 1}-${endIndex} من ${totalItems}`;

        }

        if (pageIndicator) {
            pageIndicator.textContent =
                `${currentPage} / ${totalPages}`;
        }

        if (previousPageButton) {
            previousPageButton.disabled =
                currentPage <= 1;
        }

        if (nextPageButton) {
            nextPageButton.disabled =
                currentPage >= totalPages;
        }

    }


    function applyFilters(resetPage = true) {

        const q =
            normalize(search?.value);

        const categoryValue =
            category?.value || "all";

        const levelValue =
            level?.value || "all";

        const statusValue =
            status?.value || "all";


        filteredRows =
            rows.filter(row => {

                const matchesSearch =
                    !q ||
                    normalize(
                        row.dataset.search
                    ).includes(q);

                const matchesCategory =
                    categoryValue === "all" ||
                    row.dataset.category ===
                        categoryValue;

                const matchesLevel =
                    levelValue === "all" ||
                    row.dataset.level ===
                        levelValue;

                const matchesStatus =
                    statusValue === "all" ||
                    row.dataset.status ===
                        statusValue ||
                    row.dataset.linked ===
                        statusValue;

                return (
                    matchesSearch &&
                    matchesCategory &&
                    matchesLevel &&
                    matchesStatus
                );

            });


        if (resetPage) {
            currentPage = 1;
        }

        renderPage();
    }


    [search, category, level, status]
        .forEach(element => {

            element?.addEventListener(
                "input",
                () => applyFilters(true)
            );

            element?.addEventListener(
                "change",
                () => applyFilters(true)
            );

        });


    previousPageButton?.addEventListener(
        "click",
        () => {

            if (currentPage > 1) {
                currentPage--;
                renderPage();
            }

        });


    nextPageButton?.addEventListener(
        "click",
        () => {

            const totalPages =
                Math.max(
                    1,
                    Math.ceil(
                        filteredRows.length /
                        pageSize
                    )
                );

            if (currentPage < totalPages) {
                currentPage++;
                renderPage();
            }

        });

    applyFilters(true);



    /* =====================================================
       EMPLOYEES
       ===================================================== */

    const employeesOpener =
        document.getElementById(
            "positionEmployeesModalOpener"
        );

    const employeesTitle =
        document.querySelector(
            "[data-employees-title]"
        );

    const employeesLoading =
        document.querySelector(
            "[data-employees-loading]"
        );

    const employeesList =
        document.querySelector(
            "[data-employees-list]"
        );


    const escapeHtml = value =>
        (value ?? "")
            .toString()
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");


    document
        .querySelectorAll("[data-employees-button]")
        .forEach(button => {

            button.addEventListener(
                "click",
                async () => {

                    const id =
                        button.dataset.positionId;

                    employeesList.innerHTML = "";

                    employeesLoading.hidden = false;

                    employeesOpener?.click();

                    try {

                        const response =
                            await fetch(
                                `/Positions?handler=Employees&id=${encodeURIComponent(id)}`,
                                {
                                    headers: {
                                        "Accept":
                                            "application/json"
                                    }
                                }
                            );

                        const data =
                            await response.json();

                        employeesLoading.hidden = true;

                        if (!data.ok) {

                            employeesList.innerHTML =
                                `<div class="zy-pos-empty">${escapeHtml(data.message || "تعذر تحميل البيانات.")}</div>`;

                            return;
                        }

                        employeesTitle.textContent =
                            `الموظفون المرتبطون - ${data.position}`;

                        if (!data.employees ||
                            data.employees.length === 0) {

                            employeesList.innerHTML =
                                '<div class="zy-pos-empty">لا يوجد موظفون مرتبطون بهذا المنصب.</div>';

                            return;
                        }

                        employeesList.innerHTML =
                            data.employees
                                .map(employee => `
                                    <article>
                                        <a href="/Employees/Edit?id=${encodeURIComponent(employee.id)}" class="zy-pos-employee-link" title="فتح ملف الموظف">${escapeHtml(employee.name)}</a>
                                        <span>${escapeHtml(employee.employeeNo || "بدون رقم وظيفي")}</span>
                                        <small>${escapeHtml(employee.status)}</small>
                                    </article>
                                `)
                                .join("");

                    }
                    catch {

                        employeesLoading.hidden = true;

                        employeesList.innerHTML =
                            '<div class="zy-pos-empty">حدث خطأ أثناء تحميل الموظفين.</div>';

                    }

                });

        });

})();
</script>

}


<!-- ZYNORA_POSITIONS_RETURN_STATE_FIX_V15 -->
<script>
(() => {

    const returnKey =
        "zynora.positions.return.clean";


    /* =====================================================
       معرفة هل الرابط يخرج من صفحة المناصب إلى صفحات الإدارة
       ===================================================== */

    function isExternalPositionsManagerLink(anchor) {

        if (!anchor || !anchor.href)
            return false;

        try {

            const url =
                new URL(anchor.href, window.location.origin);

            return (
                url.pathname.startsWith("/Positions/Import") ||
                url.pathname.startsWith("/PositionCategories") ||
                url.pathname.startsWith("/PositionLevels")
            );

        }
        catch {
            return false;
        }
    }


    /* =====================================================
       إغلاق Popups المناصب بالقوة ولكن بدون تخريب وظائفها
       ===================================================== */

    function closePositionModals() {

        const ids = [
            "position-editor-modal",
            "position-job-profile-modal",
            "position-delete-modal",
            "position-reference-competencies",
            "position-reference-education",
            "position-reference-specializations",
            "position-reference-certifications",
            "position-employees-modal"
        ];

        ids.forEach(id => {

            const modal =
                document.getElementById(id);

            if (!modal)
                return;

            modal.classList.remove(
                "is-open",
                "open",
                "active",
                "show"
            );

            modal.setAttribute(
                "aria-hidden",
                "true"
            );
        });


        /* منع Auto Open من الحفظ داخل BFCache */
        const editor =
            document.getElementById(
                "position-editor-modal"
            );

        if (editor) {
            editor.setAttribute(
                "data-auto-open",
                "false"
            );
        }


        /* تنظيف أي Scroll Lock */
        document.documentElement.classList.remove(
            "modal-open",
            "nx-modal-open",
            "nexora-modal-open",
            "nx-setup-modal-open"
        );

        document.body.classList.remove(
            "modal-open",
            "nx-modal-open",
            "nexora-modal-open",
            "nx-setup-modal-open"
        );

        document.documentElement.style.removeProperty(
            "overflow"
        );

        document.body.style.removeProperty(
            "overflow"
        );
    }


    /* =====================================================
       عند الضغط على:
       Import / Categories / Levels
       ===================================================== */

    document.addEventListener(
        "click",
        event => {

            const anchor =
                event.target.closest("a");

            if (!isExternalPositionsManagerLink(anchor))
                return;

            sessionStorage.setItem(
                returnKey,
                "1"
            );

            closePositionModals();

        },
        true
    );


    /* =====================================================
       قبل تخزين الصفحة في Browser Back/Forward Cache
       ===================================================== */

    window.addEventListener(
        "pagehide",
        () => {

            if (
                sessionStorage.getItem(returnKey) === "1"
            ) {
                closePositionModals();
            }

        }
    );


    /* =====================================================
       عند الرجوع Back إلى Positions
       ===================================================== */

    window.addEventListener(
        "pageshow",
        () => {

            const shouldClean =
                sessionStorage.getItem(returnKey) === "1";

            if (!shouldClean)
                return;


            sessionStorage.removeItem(
                returnKey
            );


            closePositionModals();


            /*
               إذا الصفحة القديمة كانت Edit:
               /Positions?companyId=1&editId=1

               نشيل editId حتى Refresh ما يعيد فتح Popup.
            */

            try {

                const url =
                    new URL(window.location.href);

                if (url.searchParams.has("editId")) {

                    url.searchParams.delete(
                        "editId"
                    );

                    history.replaceState(
                        history.state,
                        "",
                        url.pathname +
                        url.search +
                        url.hash
                    );
                }

            }
            catch {
                /* no-op */
            }


            /*
               بعض المتصفحات تعيد CSS state بعد pageshow،
               لذلك نكرر التنظيف مرة واحدة بعد Frame.
            */

            requestAnimationFrame(
                () => closePositionModals()
            );

        }
    );

})();
</script>
<!-- ZYNORA_POSITIONS_RETURN_STATE_FIX_V15_END -->


<!-- ZYNORA_EMPLOYEE_LINK_NAV_FIX_V18 -->
<script>
(() => {

    /*
       فتح ملف الموظف من Popup الموظفين المرتبطين.
       نستخدم Capture Mode حتى لا تمنع مكتبة الـModal الانتقال.
    */

    document.addEventListener(
        "click",
        event => {

            const link =
                event.target.closest(
                    "#position-employees-modal .zy-pos-employee-link"
                );

            if (!link)
                return;

            const href =
                link.getAttribute("href");

            if (!href)
                return;

            event.preventDefault();
            event.stopPropagation();

            if (typeof event.stopImmediatePropagation === "function") {
                event.stopImmediatePropagation();
            }

            window.location.assign(href);

        },
        true
    );

})();
</script>

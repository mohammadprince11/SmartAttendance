@page
@model SmartAttendance.Web.Pages.Positions.IndexModel

@section Styles {
    <link rel="stylesheet"
          href="~/css/nexora-setup-pages.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/zynora-positions-manager-v3.css"
          asp-append-version="true" />
}

@{
    ViewData["Title"] = "المناصب الوظيفية";

    var hasCompanies =
        Model.Companies.Count > 0;

    var isEditing =
        Model.Input.Id > 0;

    var autoOpenEditor = isEditing || !ViewData.ModelState.IsValid;
}

<div class="zy-pos-page"
     dir="rtl">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="zy-pos-alert zy-pos-alert--success">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="zy-pos-alert zy-pos-alert--danger">
            @errorMessage
        </div>
    }


    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="zy-pos-hero">

        <div class="zy-pos-hero__content">

            <span class="zy-pos-eyebrow">
                الهيكل الوظيفي
            </span>

            <h1>
                المناصب الوظيفية
            </h1>

            <p>
                إدارة المسميات الوظيفية وتصنيفها ومتطلباتها
                وربطها بالموظفين ضمن هيكل وظيفي موحد.
            </p>

        </div>


        <div class="zy-pos-hero__actions">

            <a asp-page="/Positions/Import"
               asp-route-companyId="@Model.CompanyId"
               class="zy-pos-btn zy-pos-btn--secondary">
                استيراد Excel
            </a>

            <a asp-page="/PositionCategories/Index"
               class="zy-pos-btn zy-pos-btn--secondary">
                إدارة الفئات
            </a>

            <a asp-page="/PositionLevels/Index"
               class="zy-pos-btn zy-pos-btn--secondary">
                إدارة المستويات
            </a>

            <button type="button"
                    class="zy-pos-btn zy-pos-btn--primary"
                    data-position-create
                    data-nx-setup-open="position-editor-modal"
                    @(hasCompanies ? null : "disabled")>

                + إضافة منصب

            </button>

        </div>


        @if (hasCompanies)
        {
            <form method="get"
                  class="zy-pos-company-bar">

                <div>
                    <span>الشركة الحالية</span>

                    <strong>
                        @Model.SelectedCompanyName
                    </strong>
                </div>

                <select asp-for="CompanyId">
                    @foreach (var company in Model.Companies)
                    {
                        <option value="@company.Id">
                            @company.Name
                        </option>
                    }
                </select>

                <button type="submit"
                        class="zy-pos-btn zy-pos-btn--secondary">
                    تطبيق
                </button>

            </form>
        }

    </section>


    <!-- =====================================================
         KPI
         ===================================================== -->

    <section class="zy-pos-kpis">

        <article>
            <div class="zy-pos-kpi-icon">01</div>

            <div>
                <span>إجمالي المناصب</span>
                <strong>@Model.TotalPositions</strong>
            </div>
        </article>


        <article>
            <div class="zy-pos-kpi-icon">02</div>

            <div>
                <span>المناصب الفعالة</span>
                <strong>@Model.ActivePositions</strong>
            </div>
        </article>


        <article>
            <div class="zy-pos-kpi-icon">03</div>

            <div>
                <span>مرتبطة بموظفين</span>
                <strong>@Model.LinkedPositions</strong>
            </div>
        </article>


        <article>
            <div class="zy-pos-kpi-icon">04</div>

            <div>
                <span>الموظفون المرتبطون</span>
                <strong>@Model.TotalLinkedEmployees</strong>
            </div>
        </article>

    </section>


    <!-- =====================================================
         POSITIONS REGISTRY
         ===================================================== -->

    <section class="zy-pos-card">

        <header class="zy-pos-card__head">

            <div>
                

                <h2>
                    المناصب المعرفة داخل الشركة
                </h2>

                <p>
                    البحث والتصفية تعمل مباشرة على السجل.
                </p>
            </div>

            

        </header>


        <div class="zy-pos-filters">

            <label class="zy-pos-filter zy-pos-filter--search">
                <span>البحث</span>

                <input id="positionSearch"
                       type="search"
                       placeholder="ابحث عن اسم المنصب..." />
            </label>


            <label class="zy-pos-filter">
                <span>الفئة</span>

                <select id="categoryFilter">

                    <option value="all">
                        كل الفئات
                    </option>

                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Name">
                            @category.Name
                        </option>
                    }

                    <option value="none">
                        بدون فئة
                    </option>

                </select>
            </label>


            <label class="zy-pos-filter">
                <span>المستوى</span>

                <select id="levelFilter">

                    <option value="all">
                        كل المستويات
                    </option>

                    @foreach (var level in Model.Levels)
                    {
                        <option value="@level.Name">
                            @level.Name
                        </option>
                    }

                    <option value="none">
                        بدون مستوى
                    </option>

                </select>
            </label>


            <label class="zy-pos-filter">
                <span>الحالة</span>

                <select id="statusFilter">
                    <option value="all">كل الحالات</option>
                    <option value="active">فعال</option>
                    <option value="inactive">غير فعال</option>
                    <option value="linked">مرتبط بموظفين</option>
                    <option value="unlinked">غير مرتبط</option>
                </select>

            </label>

        </div>


        @if (!Model.Positions.Any())
        {
            <div class="zy-pos-empty">
                لا توجد مناصب مسجلة لهذه الشركة.
            </div>
        }
        else
        {
            <div class="zy-pos-table-wrap">

                <table class="zy-pos-table"
                       id="positionsTable">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>المنصب</th>
                            <th>التصنيف</th>
                            <th>الموظفون</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody>

                    @for (var i = 0;
                          i < Model.Positions.Count;
                          i++)
                    {
                        var position =
                            Model.Positions[i];

                        var canDelete =
                            position.EmployeeCount == 0;

                        <tr data-position-row
                            data-search="@position.SearchText"
                            data-category="@(string.IsNullOrWhiteSpace(position.Category) ? "none" : position.Category)"
                            data-level="@(string.IsNullOrWhiteSpace(position.Level) ? "none" : position.Level)"
                            data-status="@(position.IsActive ? "active" : "inactive")"
                            data-linked="@(position.EmployeeCount > 0 ? "linked" : "unlinked")">

                            <td class="zy-pos-sequence"
                                data-position-sequence>
                                @(i + 1)
                            </td>


                            <td>

                                <div class="zy-pos-name">

                                    <strong>
                                        @position.ArabicName
                                    </strong>

                                    <span>
                                        @position.CompanyName
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(position.Description))
                                    {
                                        <small>
                                            @position.Description
                                        </small>
                                    }

                                </div>

                            </td>


                            <td>

                                <div class="zy-pos-classification">

                                    <span>
                                        @(string.IsNullOrWhiteSpace(position.Category)
                                            ? "بدون فئة"
                                            : position.Category)
                                    </span>

                                    <small>
                                        @(string.IsNullOrWhiteSpace(position.Level)
                                            ? "بدون مستوى"
                                            : position.Level)
                                    </small>

                                </div>

                            </td>


                            <td>

                                <div class="zy-pos-employees">

                                    <strong>
                                        @position.EmployeeCount
                                    </strong>

                                    <span>
                                        موظف
                                    </span>

                                </div>

                                @if (position.EmployeeCount > 0)
                                {
                                    <button type="button"
                                            class="zy-pos-link"
                                            data-employees-button
                                            data-position-id="@position.Id">
                                        عرض الموظفين
                                    </button>
                                }

                            </td>


                            <td>

                                <span class="zy-pos-status @(position.IsActive ? "is-active" : "is-inactive")">

                                    @(position.IsActive
                                        ? "فعال"
                                        : "غير فعال")

                                </span>

                            </td>


                            <td>

                                <div class="zy-pos-actions">

                                    <a asp-page="/Positions/Index"
                                       asp-route-companyId="@Model.CompanyId"
                                       asp-route-editId="@position.Id"
                                       class="zy-pos-action zy-pos-action--edit">

                                        تعديل

                                    </a>


                                    <form method="post"
                                          asp-page-handler="Toggle"
                                          asp-route-id="@position.Id"
                                          class="zy-pos-inline-form">

                                        <input type="hidden"
                                               name="CompanyId"
                                               value="@Model.CompanyId" />

                                        <button type="submit"
                                                class="zy-pos-action zy-pos-action--neutral">

                                            @(position.IsActive
                                                ? "إيقاف"
                                                : "تفعيل")

                                        </button>

                                    </form>


                                    <button type="button"
                                            class="zy-pos-action zy-pos-action--delete"
                                            data-position-delete
                                            data-position-delete-id="@position.Id"
                                            data-position-delete-name="@position.ArabicName"
                                            data-position-delete-employees="@position.EmployeeCount"
                                            data-nx-setup-open="position-delete-modal"
                                            disabled="@(!canDelete)"
                                            title="@(canDelete
                                                ? "حذف المنصب"
                                                : "لا يمكن حذف منصب مرتبط بموظفين")">

                                        حذف

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>


            <div class="zy-pos-pagination"
                 id="positionsPager"
                 hidden>

                <div id="positionsPageSummary"
                     class="zy-pos-pagination__summary">
                </div>

                <div class="zy-pos-pagination__controls">

                    <button type="button"
                            id="positionsPrevPage">
                        السابق
                    </button>

                    <span id="positionsPageIndicator">
                    </span>

                    <button type="button"
                            id="positionsNextPage">
                        التالي
                    </button>

                </div>

            </div>
        }

    </section>

</div>



<!-- =========================================================
     ADD / EDIT MODAL
     ========================================================= -->

<div class="nx-setup-modal"
     id="position-editor-modal"
     data-auto-open="@(autoOpenEditor ? "true" : "false")"
     aria-hidden="true">

    <div class="nx-setup-modal__panel zy-pos-editor-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="position-editor-title">

        <button type="button"
                class="nx-setup-modal__close"
                data-nx-setup-close
                aria-label="إغلاق">
            &times;
        </button>


        <header class="nx-setup-modal__head">

            <span>
                المناصب الوظيفية
            </span>

            <h2 id="position-editor-title"
                data-position-editor-title>

                @(isEditing
                    ? "تعديل المنصب الوظيفي"
                    : "إضافة منصب وظيفي")

            </h2>

            <p>
                أدخل البيانات الأساسية والتصنيف
                ومتطلبات المنصب.
            </p>

        </header>


        <form method="post"
              asp-page-handler="Save"
              id="positionEditorForm"
              class="zy-pos-editor-form"
              autocomplete="off">

            <input asp-for="Input.Id"
                   type="hidden" />

            <input type="hidden"
                   name="Input.CompanyId"
                   value="@Model.CompanyId" />

            <input asp-for="Input.OriginalArabicName"
                   type="hidden" />


            <div asp-validation-summary="All"
                 class="zy-pos-validation">
            </div>


            <!-- BASIC -->

            <section class="zy-pos-form-section">

                <header>
                    <div>
                        <span>01</span>

                        <div>
                            <h3>البيانات الأساسية</h3>
                            <p>المسمى والتصنيف والحالة.</p>
                        </div>
                    </div>
                </header>


                <div class="zy-pos-form-grid">

                    <label class="zy-pos-field zy-pos-field--wide">

                        <span>
                            اسم المنصب
                            <b>*</b>
                        </span>

                        <input asp-for="Input.ArabicName"
                               required
                               maxlength="200"
                               placeholder="مثال: مشرف عمليات الموارد البشرية" />

                    </label>


                    <label class="zy-pos-field">

                        <span>
                            الشركة
                        </span>

                        <input value="@Model.SelectedCompanyName"
                               readonly />

                    </label>


                    <div class="zy-pos-field zy-pos-reference-field">

                        <label for="Input_Category">
                            الفئة
                        </label>

                        <div class="zy-pos-reference-control">

                            <select asp-for="Input.Category">

                                <option value="">
                                    غير محدد
                                </option>

                                @foreach (
                                    var category in
                                    Model.Categories.Where(
                                        item =>
                                            item.IsActive ||
                                            item.Name ==
                                            Model.Input.Category))
                                {
                                    <option value="@category.Name">
                                        @category.Name
                                    </option>
                                }

                            </select>

                            <a asp-page="/PositionCategories/Index"
                               class="zy-pos-manage">
                                إدارة
                            </a>

                        </div>

                    </div>


                    <div class="zy-pos-field zy-pos-reference-field">

                        <label for="Input_Level">
                            المستوى
                        </label>

                        <div class="zy-pos-reference-control">

                            <select asp-for="Input.Level">

                                <option value="">
                                    غير محدد
                                </option>

                                @foreach (
                                    var level in
                                    Model.Levels.Where(
                                        item =>
                                            item.IsActive ||
                                            item.Name ==
                                            Model.Input.Level))
                                {
                                    <option value="@level.Name">
                                        @level.Name
                                    </option>
                                }

                            </select>

                            <a asp-page="/PositionLevels/Index"
                               class="zy-pos-manage">
                                إدارة
                            </a>

                        </div>

                    </div>


                    <label class="zy-pos-field zy-pos-field--wide">

                        <span>
                            وصف مختصر
                        </span>

                        <textarea asp-for="Input.Description"
                                  rows="2"
                                  maxlength="1000"
                                  placeholder="ملخص مختصر عن طبيعة المنصب...">
                        </textarea>

                    </label>


                    <label class="zy-pos-check">

                        <input type="hidden"
                               name="Input.IsActive"
                               value="false" />

                        <input asp-for="Input.IsActive"
                               value="true" />

                        <span>
                            المنصب فعال
                        </span>

                    </label>

                </div>

            </section>


            <!-- REQUIREMENTS -->

            <section class="zy-pos-form-section">

                <header>
                    <div>
                        <span>02</span>

                        <div>
                            <h3>متطلبات المنصب</h3>
                            <p>
                                المؤهلات والكفاءات المهنية المطلوبة.
                            </p>
                        </div>
                    </div>
                </header>


                <div class="zy-pos-form-grid">

                    <label class="zy-pos-field zy-pos-reference-field">

                        <span>
                            الكفاءات
                        </span>

                        <div class="zy-pos-reference-control">

                            <select asp-for="Input.Competencies">

                                <option value="">
                                    غير محدد
                                </option>

                                @foreach (
                                    var item in
                                    Model.CompetencyOptions.Where(
                                        item =>
                                            item.IsActive ||
                                            item.Name ==
                                            Model.Input.Competencies))
                                {
                                    <option value="@item.Name">
                                        @item.Name
                                    </option>
                                }

                            </select>

                            <button type="button"
                                    class="zy-pos-manage"
                                    data-nx-setup-open="position-reference-competencies">
                                إدارة
                            </button>

                        </div>

                    </label>


                    <label class="zy-pos-field zy-pos-reference-field">

                        <span>
                            الدرجة العلمية
                        </span>

                        <div class="zy-pos-reference-control">

                            <select asp-for="Input.Education">

                                <option value="">
                                    غير محدد
                                </option>

                                @foreach (
                                    var item in
                                    Model.EducationOptions.Where(
                                        item =>
                                            item.IsActive ||
                                            item.Name ==
                                            Model.Input.Education))
                                {
                                    <option value="@item.Name">
                                        @item.Name
                                    </option>
                                }

                            </select>

                            <button type="button"
                                    class="zy-pos-manage"
                                    data-nx-setup-open="position-reference-education">
                                إدارة
                            </button>

                        </div>

                    </label>


                    <label class="zy-pos-field zy-pos-reference-field">

                        <span>
                            التخصص
                        </span>

                        <div class="zy-pos-reference-control">

                            <select asp-for="Input.EducationSpecialization">

                                <option value="">
                                    غير محدد
                                </option>

                                @foreach (
                                    var item in
                                    Model.EducationSpecializationOptions.Where(
                                        item =>
                                            item.IsActive ||
                                            item.Name ==
                                            Model.Input.EducationSpecialization))
                                {
                                    <option value="@item.Name">
                                        @item.Name
                                    </option>
                                }

                            </select>

                            <button type="button"
                                    class="zy-pos-manage"
                                    data-nx-setup-open="position-reference-specializations">
                                إدارة
                            </button>

                        </div>

                    </label>


                    <label class="zy-pos-field zy-pos-reference-field">

                        <span>
                            الشهادات
                        </span>

                        <div class="zy-pos-reference-control">

                            <select asp-for="Input.Certifications">

                                <option value="">
                                    غير محدد
                                </option>

                                @foreach (
                                    var item in
                                    Model.CertificationOptions.Where(
                                        item =>
                                            item.IsActive ||
                                            item.Name ==
                                            Model.Input.Certifications))
                                {
                                    <option value="@item.Name">
                                        @item.Name
                                    </option>
                                }

                            </select>

                            <button type="button"
                                    class="zy-pos-manage"
                                    data-nx-setup-open="position-reference-certifications">
                                إدارة
                            </button>

                        </div>

                    </label>

                </div>

            </section>


            <!-- JOB PROFILE -->

                        <!-- ZYNORA_JOB_PROFILE_SECTION_V10 -->
            <section class="zy-pos-job-section">

                <header class="zy-pos-job-section__head">

                    <div class="zy-pos-job-section__identity">

                        <span class="zy-pos-job-section__step">
                            03
                        </span>

                        <div>
                            <h3>
                                الوصف الوظيفي
                            </h3>

                            <p>
                                الهدف، المهام، المتطلبات، المهارات ومؤشرات KPI الخاصة بالمنصب.
                            </p>
                        </div>

                    </div>

                </header>


                <div class="zy-pos-job-section__body">

                    <div class="zy-pos-job-section__info">

                        <strong>
                            بطاقة المنصب الوظيفية
                        </strong>

                        <span>
                            أدخل التفاصيل التشغيلية للمنصب ومؤشرات الأداء الرئيسية.
                        </span>

                    </div>


                    <button type="button"
                            class="zy-pos-job-section__action"
                            data-nx-setup-open="position-job-profile-modal">

                        فتح بطاقة المنصب

                    </button>

                </div>

            </section>
            <!-- ZYNORA_JOB_PROFILE_SECTION_V10_END -->


            <footer class="nx-setup-modal__actions">

                @if (isEditing)
                {
                    <a asp-page="/Positions/Index"
                       asp-route-companyId="@Model.CompanyId"
                       class="zy-pos-btn zy-pos-btn--secondary">

                        إلغاء

                    </a>
                }
                else
                {
                    <button type="button"
                            class="zy-pos-btn zy-pos-btn--secondary"
                            data-nx-setup-close>

                        إلغاء

                    </button>
                }


                <button type="submit"
                        class="zy-pos-btn zy-pos-btn--primary">

                    @(isEditing
                        ? "حفظ التعديلات"
                        : "حفظ المنصب")

                </button>

            </footer>

        </form>

    </div>

</div>



<!-- =========================================================
     JOB PROFILE
     ========================================================= -->

<div class="nx-setup-modal"
     id="position-job-profile-modal"
     aria-hidden="true">

    <div class="nx-setup-modal__panel zy-pos-job-modal"
         role="dialog"
         aria-modal="true">

        <button type="button"
                class="nx-setup-modal__close"
                data-nx-setup-close>
            &times;
        </button>


        <header class="nx-setup-modal__head">

            <span>
                بطاقة المنصب
            </span>

            <h2>
                الوصف الوظيفي
            </h2>

            <p>
                تحديد الهدف والمسؤوليات
                والمتطلبات ومؤشرات الأداء.
            </p>

        </header>


        <div class="zy-pos-job-body">

            <label class="zy-pos-field zy-pos-field--wide">

                <span>هدف المنصب</span>

                <textarea asp-for="Input.JobPurpose"
                          form="positionEditorForm"
                          rows="3"
                          maxlength="2000"
                          placeholder="ما الغرض من هذا المنصب؟">
                </textarea>

            </label>


            <label class="zy-pos-field zy-pos-field--wide">

                <span>
                    المهام والمسؤوليات
                </span>

                <textarea asp-for="Input.KeyResponsibilities"
                          form="positionEditorForm"
                          rows="5"
                          maxlength="4000"
                          placeholder="اكتب المهام والمسؤوليات الرئيسية...">
                </textarea>

            </label>


            <label class="zy-pos-field">

                <span>
                    المتطلبات
                </span>

                <textarea asp-for="Input.JobRequirements"
                          form="positionEditorForm"
                          rows="4"
                          maxlength="3000"
                          placeholder="الخبرة، المؤهل، اللغات...">
                </textarea>

            </label>


            <label class="zy-pos-field">

                <span>
                    المهارات المطلوبة
                </span>

                <textarea asp-for="Input.RequiredSkills"
                          form="positionEditorForm"
                          rows="4"
                          maxlength="3000"
                          placeholder="المهارات الفنية والشخصية...">
                </textarea>

            </label>


            <label class="zy-pos-field zy-pos-field--wide">

                <span>
                    KPI
                </span>

                <textarea asp-for="Input.JobKpis"
                          form="positionEditorForm"
                          rows="4"
                          maxlength="3000"
                          placeholder="مؤشرات الأداء الرئيسية للمنصب...">
                </textarea>

            </label>

        </div>


        <footer class="nx-setup-modal__actions">

            <button type="button"
                    class="zy-pos-btn zy-pos-btn--primary"

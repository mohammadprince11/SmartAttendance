@page
@model SmartAttendance.Web.Pages.Documents.ViewModel

@{
    ViewData["Title"] = Model.Document?.TemplateName ?? "وثيقة";
}

<style>
    .zydv-bar { display:flex; gap:10px; align-items:center; justify-content:space-between;
        margin-bottom:16px; flex-wrap:wrap; }
    .zydv-bar a, .zydv-bar button { border:1px solid var(--zy-border); background:var(--zy-surface);
        color:var(--zy-text); border-radius:var(--zy-radius-sm); padding:8px 16px;
        font-family:inherit; font-size:.8125rem; text-decoration:none; cursor:pointer; }
    .zydv-bar button.primary { background:var(--zy-electric-teal); color:#fff; border-color:transparent; font-weight:600; }
    .zydv-warn { border-inline-start:3px solid var(--zy-warning); background:var(--zy-warning-soft);
        padding:10px 14px; border-radius:var(--zy-radius-xs); font-size:.8125rem; margin-bottom:14px; }

    /* الوثيقة بيضاء دائماً — المخرَج ورقٌ لا واجهة، فلا يتبع الوضع الداكن. */
    .zydv-paper { background:#fff; color:#111; max-width:820px; margin:0 auto; padding:56px 64px;
        border:1px solid var(--zy-border); border-radius:var(--zy-radius-md); line-height:2.1; font-size:15px; }
    .zydv-head { display:flex; justify-content:space-between; align-items:flex-start;
        border-bottom:1px solid #ddd; padding-bottom:14px; margin-bottom:28px; font-size:13px; color:#555; }
    .zydv-foot { border-top:1px solid #ddd; margin-top:36px; padding-top:12px; font-size:12px; color:#777; }
    .zydv-paper table { border-collapse:collapse; }
    .zydv-paper td, .zydv-paper th { border:1px solid #ccc; padding:6px 10px; }

    @@media print {
        .zydv-bar, .zydv-warn, .nexora-sidebar, .nexora-topbar, header, nav, footer { display:none !important; }
        .zydv-paper { border:0; max-width:100%; padding:0; margin:0; }
        body { background:#fff !important; }
    }
</style>

<section dir="rtl" style="padding:20px">
    <div class="zydv-bar">
        <a asp-page="./Generate">← الأرشيف</a>
        <button type="button" class="primary" onclick="window.print()">طباعة / حفظ PDF</button>
    </div>

    @if (Model.Document is null)
    {
        <p>الوثيقة غير موجودة.</p>
    }
    else
    {
        @if (Model.Document.HasUnresolved)
        {
            <div class="zydv-warn">
                ⚠ هذه الوثيقة صدرت وفيها رموز بلا قيمة: <b>@Model.Document.UnresolvedTokens</b>
                — راجعها قبل تسليمها.
            </div>
        }

        <article class="zydv-paper">
            <div class="zydv-head">
                <div>
                    <b>@Model.CompanyName</b>
                    <div>@Model.Document.TemplateName</div>
                </div>
                <div style="text-align:end">
                    <div>الرقم المرجعي: <b>@Model.Document.ReferenceNo</b></div>
                    <div>التاريخ: @Model.Document.IssuedOn.ToString("yyyy/MM/dd")</div>
                </div>
            </div>

            @Html.Raw(Model.SafeBody())

            <div class="zydv-foot">
                صدرت عن @Model.Document.IssuedBy — @Model.Document.EmployeeName (@Model.Document.EmployeeNo)
            </div>
        </article>
    }
</section>

@section Scripts {

}

@page
@model SmartAttendance.Web.Pages.Documents.ViewModel

@{
    ViewData["Title"] = Model.Document?.TemplateName ?? "وثيقة";
}
<link rel="stylesheet" href="~/css/pages/view-b76a2fe2a0.css" asp-append-version="true" />


<section dir="rtl" class="zyu-46e678a98ac3">
    <div class="zydv-bar">
        <a asp-page="./Generate">← الأرشيف</a>
        <div class="zyu-0d76d82849c1">
            @if (Model.Document is { IsVerifiable: true, IsRevoked: false })
            {
                <form method="post" asp-page-handler="Revoke" class="zyu-6b8b63d565c4">
                    <input type="hidden" name="id" value="@Model.Document.Id" />
                    <button type="submit" data-zyconfirm="سحب الوثيقة؟ سيُبطل التحقق منها.">اسحب الوثيقة</button>
                </form>
            }
            @if (Model.Document is not null && !Model.Document.IsFiled)
            {
                <form method="post" asp-page-handler="File" class="zyu-6b8b63d565c4">
                    <input type="hidden" name="id" value="@Model.Document.Id" />
                    <button type="submit">أودِع بملف الموظف</button>
                </form>
            }
            else if (Model.Document is not null)
            {
                <span class="zyu-a7d49b249fc4">✓ مودعة بملف الموظف</span>
            }
            <button type="button" class="primary" onclick="window.print()">طباعة / حفظ PDF</button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="zydv-warn zyu-879fab2cc8c5">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model.Document is null)
    {
        <p>الوثيقة غير موجودة.</p>
    }
    else
    {
        @if (Model.Document.IsRevoked)
        {
            <div class="zydv-warn">
                ⚠ <b>هذه الوثيقة مسحوبة</b> — سحبها @Model.Document.RevokedBy
                بتاريخ @Model.Document.RevokedAt?.ToLocalTime().ToString("yyyy/MM/dd").
                التحقق منها يُظهر أنها مسحوبة.
            </div>
        }

        @if (Model.Document.HasUnresolved)
        {
            <div class="zydv-warn">
                ⚠ هذه الوثيقة صدرت وفيها رموز بلا قيمة: <b>@Model.Document.UnresolvedTokens</b>
                — راجعها قبل تسليمها.
            </div>
        }

        <article class="zydv-paper">
            @{ var customHeader = Model.SafeHeader(); }
            @if (!string.IsNullOrWhiteSpace(customHeader))
            {
                <div class="zydv-custom-head">@Html.Raw(customHeader)</div>
            }
            else
            {
                <div class="zydv-head">
                    <div>
                        <b>@Model.CompanyName</b>
                        <div>@Model.Document.TemplateName</div>
                    </div>
                    <div class="zyu-814fec806937">
                        <div>الرقم المرجعي: <b>@Model.Document.ReferenceNo</b></div>
                        <div>التاريخ: @Model.Document.IssuedOn.ToString("yyyy/MM/dd")</div>
                    </div>
                </div>
            }

            @Html.Raw(Model.SafeBody())

            @if (Model.Document.HasStamp)
            {
                <div class="zydv-stamp">
                    <img src="@Url.Page("./View", "Stamp", new { id = Model.Document.Id })" alt="ختم الشركة" />
                </div>
            }

            @if (Model.Document.IsVerifiable)
            {
                <div class="zydv-verify">
                    <b>التحقق من أصالة هذه الوثيقة</b>
                    <div>افتح <span dir="ltr">@Model.VerifyUrl()</span></div>
                    <div>رمز التحقق: <b dir="ltr">@Model.Document.VerifyToken</b></div>
                    <div>
                        عامل التحقق المطلوب:
                        @SmartAttendance.Web.Infrastructure.Hrms.DocumentVerificationPolicy.FactorLabel(Model.Document.VerifyFactor)
                    </div>
                    @if (Model.Document.VerifyValidUntil is { } until)
                    {
                        <div>صالحة للتحقق حتى @until.ToString("yyyy/MM/dd")</div>
                    }
                </div>
            }

            @{ var customFooter = Model.SafeFooter(); }
            @if (!string.IsNullOrWhiteSpace(customFooter))
            {
                <div class="zydv-custom-foot">@Html.Raw(customFooter)</div>
            }
            else
            {
                <div class="zydv-foot">
                    صدرت عن @Model.Document.IssuedBy — @Model.Document.EmployeeName (@Model.Document.EmployeeNo)
                </div>
            }
        </article>
    }
</section>

<script src="~/js/zynora-confirm.js" asp-append-version="true" defer></script>

@section Scripts {

}

@page
@model SmartAttendance.Web.Pages.Employees.DeleteModel
@using SmartAttendance.Web.Infrastructure.Theming
@inject IThemeContextService ThemeContextService
@{
    var brandName = (await ThemeContextService.GetCurrentAsync(default)).DisplayName is string dn && !string.IsNullOrWhiteSpace(dn) ? dn : "ZYNORA";
}

@{
    ViewData["Title"] = "حذف إداريّ";
}

<link rel="stylesheet" href="~/css/employee-lifecycle-action.css" asp-append-version="true" />

<div class="lifecycle-page">
    <div class="lifecycle-header">
        <div>
            <div class="lifecycle-eyebrow">@brandName Employee Lifecycle</div>
            <h1>حذف إداريّ</h1>
            <p>الحذف الإداريّ مخصّصٌ للسجلات الباطلة التي أُنشئت خطأً وليس لها أيّ تاريخ تشغيليّ. الموظف الحقيقيّ الذي له تاريخ يُنهى عبر «إنهاء الخدمة» لا الحذف.</p>
        </div>

        <a asp-page="./Index" class="hrms-btn-secondary">رجوع للموظفين</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="lifecycle-alert danger">
            @Model.ErrorMessage
        </div>
    }

    <div class="lifecycle-card">
        <div class="lifecycle-warning">
            <strong>تنبيه مهم</strong>
            <span>الحذف الإداريّ إزالةٌ نهائية للسجل من القوائم، ولا يُسمح به إلا إذا كان السجل باطلاً بلا تاريخ تشغيليّ. إن كان للموظف تاريخ حضور أو رواتب أو عقود أو طلبات، استخدم «إنهاء الخدمة» للحفاظ على التاريخ.</span>
        </div>

        <div class="lifecycle-details">
            <div>
                <span>كود الموظف</span>
                <strong>@Model.Employee.EmployeeNo</strong>
            </div>

            <div>
                <span>اسم الموظف</span>
                <strong>@Model.Employee.FullName</strong>
            </div>

            <div>
                <span>القسم</span>
                <strong>@Model.Employee.DepartmentName</strong>
            </div>

            <div>
                <span>الفرع</span>
                <strong>@Model.Employee.BranchName</strong>
            </div>

            <div>
                <span>الهاتف</span>
                <strong>@Model.Employee.Phone</strong>
            </div>

            <div>
                <span>الحالة الحالية</span>
                <strong>@(Model.Employee.IsActive ? "فعال" : "غير فعال")</strong>
            </div>
        </div>

        @if (Model.HasOperationalHistory)
        {
            <div class="lifecycle-alert danger">
                للموظف تاريخ تشغيليّ، فلا يمكن حذفه إدارياً. استخدم «إنهاء الخدمة» بدلاً من ذلك.
            </div>

            <div class="lifecycle-actions">
                <a asp-page="./EndService" asp-route-id="@Model.Employee.Id" class="lifecycle-btn-warning">إنهاء الخدمة</a>
                <a asp-page="./Index" class="hrms-btn-secondary">رجوع</a>
            </div>
        }
        else
        {
            <form method="post" class="lifecycle-actions">
                <input type="hidden" name="id" value="@Model.Employee.Id" />

                <button type="submit" class="lifecycle-btn-warning">حذف إداريّ</button>
                <a asp-page="./Index" class="hrms-btn-secondary">إلغاء</a>
            </form>
        }
    </div>
</div>


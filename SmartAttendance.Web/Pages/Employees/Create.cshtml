@page
@model SmartAttendance.Web.Pages.Employees.CreateModel
@using SmartAttendance.Web.Infrastructure.Theming
@inject IThemeContextService ThemeContextService
@{
    var brandName = (await ThemeContextService.GetCurrentAsync(default)).DisplayName is string dn && !string.IsNullOrWhiteSpace(dn) ? dn : "ZYNORA";
}

@{
    ViewData["Title"] = "إضافة موظف جديد";
    var employeePhotoFallback = Url.Content("~/brand/employee-photo-placeholder.svg");
}
<link rel="stylesheet" href="~/css/pages/create-105041754d.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/zynora-employee-create-documents-final.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/zynora-employee-create-clean-fix.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/zynora-employee-create-stable.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/zynora-employee-photo-upload.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/zynora-employee-profile-dynamic-fields.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/zynora-employee-create-designlab-v1.css" asp-append-version="true" />
<link rel="stylesheet"
      href="~/css/zynora-employee-create-language-cards-v1.css"
      asp-append-version="true" />

<div class="nxr-page nxr-create-clean-page" dir="rtl">
    <section class="nxr-topline nxr-create-clean-header">
        <div class="nxr-title">
            <div class="nxr-brand-mini">@brandName HR</div>
            <h1>إضافة موظف جديد</h1>
            <p>إدخال بيانات الموظف الأساسية والوظيفية مع إمكانية رفع المستمسكات عند الإنشاء.</p>
        </div>

        <div class="nxr-actions">
            <a asp-page="./Index" class="nxr-btn">رجوع للقائمة</a>
            <button form="employee-create-form" type="submit" class="nxr-btn primary">إنشاء الموظف</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="nxr-error">@Model.ErrorMessage</div>
    }

    <form id="employee-create-form" method="post" enctype="multipart/form-data" class="nxr-form nxr-create-clean-form">

        <section class="nxr-card nxr-form-section nxr-create-section nxr-photo-upload-card">
            <div class="nxr-section-title">
                <div>
                    <h2>صورة الموظف</h2>
                    <p>اضغط على مساحة الصورة نفسها أو اسحب الصورة فوقها. لا يوجد زر رفع منفصل.</p>
                </div>
                <span class="nxr-chip">اختياري</span>
            </div>

            <div class="nxr-photo-upload-wrap">
                <label class="nxr-photo-drop has-image has-brand-placeholder" data-employee-photo-drop>
                    <input asp-for="EmployeePhoto" type="file" accept="image/png,image/jpeg,image/webp" />
                    <img class="nxr-photo-preview" src="@employeePhotoFallback" data-employee-photo-preview data-placeholder-src="@employeePhotoFallback" alt="Employee photo preview" onerror="this.onerror=null;this.src='@employeePhotoFallback';" />
                    <span class="nxr-photo-placeholder">
                        <strong>+</strong>
                        <span>اضغط لإضافة صورة</span>
                    </span>
                </label>

                <div class="nxr-photo-hint">
                    <strong>مساحة الصورة هي زر الرفع</strong>
                    <span>ارفع صورة واضحة للموظف بصيغة PNG أو JPG أو WEBP.</span>
                    <small>الحد الأقصى 5MB. سيتم حفظ الصورة داخل ملف الموظف بعد الإنشاء.</small>
                </div>
            </div>
        </section>

        <section class="nxr-card nxr-form-section nxr-create-section">
            <div class="nxr-section-title">
                <div>
                    <h2>البيانات الأساسية</h2>
                    <p>الحقول الرئيسية لتعريف الموظف داخل النظام.</p>
                </div>
                <span class="nxr-chip gold">مطلوب</span>
            </div>

            <div class="nxr-form-grid nxr-create-grid nxr-basic-grid">
                <div class="nxr-field nxr-employee-code-priority">
                    <label asp-for="Employee.EmployeeNo">كود الموظف</label>
                    @if (Model.CodeSchemaActive)
                    {
                        @* بلا asp-for حتى لا يفرض تحقق «مطلوب» بجهة العميل — التوليد يصير بالسيرفر *@
                        <input name="Employee.EmployeeNo" id="Employee_EmployeeNo" value="@Model.Employee.EmployeeNo"
                               placeholder="اتركه فارغاً للتوليد التلقائي (@Model.CodeSchemaPreview)" />
                        <span class="zyu-fb3651e6581b">توليد تلقائي مفعّل — الفارغ يأخذ الرقم التالي</span>
                    }
                    else
                    {
                        <input asp-for="Employee.EmployeeNo" placeholder="مثال: EMP-250601" />
                    }
                    <span asp-validation-for="Employee.EmployeeNo" class="text-danger"></span>
                </div>

                <div class="nxr-field nxr-employee-company-first">
                    <label asp-for="SelectedCompanyId">الشركة</label>
                    <select asp-for="SelectedCompanyId" class="nxr-native-select" id="SelectedCompanyId">
                        @foreach (var company in Model.CompanyOptions)
                        {
                            <option value="@company.Id" selected="@(company.Id == Model.SelectedCompanyId ? "selected" : null)">@company.Name</option>
                        }
                    </select>
                    <small>تحدد الشركة لغات اسم الموظف، أما موقع العمل فيُختار لاحقاً ضمن المعلومات الوظيفية.</small>
                    <span asp-validation-for="SelectedCompanyId" class="text-danger"></span>
                </div>

                @* الأعمدة القديمة تُملأ من اللغة الأساسية في السيرفر للتوافق فقط. *@
                <input type="hidden" asp-for="Employee.FullName" />
                <input type="hidden" asp-for="Employee.FirstName" />
                <input type="hidden" asp-for="Employee.SecondName" />
                <input type="hidden" asp-for="Employee.ThirdName" />
                <input type="hidden" asp-for="Employee.LastName" />
                <input type="hidden" asp-for="Employee.FirstNameEn" />
                <input type="hidden" asp-for="Employee.SecondNameEn" />
                <input type="hidden" asp-for="Employee.ThirdNameEn" />
                <input type="hidden" asp-for="Employee.LastNameEn" />

                <div class="zy-employee-multilingual" data-employee-multilingual>
                    @foreach (var companyId in Model.CompanyOptions.Select(item => item.Id).Distinct())
                    {
                        var selectedCompany = Model.SelectedCompanyId == companyId;
                        var indexes = Enumerable.Range(0, Model.EmployeeNameTranslations.Count)
                            .Where(index => Model.EmployeeNameTranslations[index].CompanyId == companyId)
                            .ToArray();
                        <section class="zy-employee-language-company" data-language-company="@companyId" hidden="@(!selectedCompany)">
                            @if (indexes.Length == 0)
                            {
                                <div class="zy-employee-language-missing">
                                    يجب تفعيل لغة أساسية واحدة على الأقل لهذه الشركة قبل إنشاء موظف جديد.
                                    <a asp-page="/Settings/DataLanguages" asp-route-companyId="@companyId">فتح إعدادات اللغات</a>
                                </div>
                            }
                            else
                            {
                                @foreach (var index in indexes)
                                {
                                    var language = Model.EmployeeNameTranslations[index];
                                    <fieldset class="zy-employee-language-card" dir="@language.Direction" lang="@language.CultureCode" data-culture="@language.CultureCode">
                                        <legend>
                                            <span data-zy-no-localize>@language.NativeName</span>
                                            <small>
                                            @language.CultureCode
                                            @(language.IsDefault ? "· اللغة الأساسية" : "· لغة إضافية")
                                            @(language.IsRequired ? "· مطلوبة" : "· اختيارية")
                                        </small>
                                        </legend>
                                        <input type="hidden" asp-for="EmployeeNameTranslations[index].CompanyId" disabled="@(!selectedCompany)" />
                                        <input type="hidden" asp-for="EmployeeNameTranslations[index].CultureCode" disabled="@(!selectedCompany)" />
                                        <div class="zy-employee-language-fields">
                                            <label>
                                                <span>@language.FirstNameLabel @(language.IsRequired ? "*" : "")</span>
                                                <input asp-for="EmployeeNameTranslations[index].FirstName"
                                                       dir="@language.Direction"
                                                       required="@(language.IsRequired ? "required" : null)"
                                                       disabled="@(!selectedCompany)" />
                                            </label>

                                            <label>
                                                <span>@language.SecondNameLabel</span>
                                                <input asp-for="EmployeeNameTranslations[index].SecondName"
                                                       dir="@language.Direction"
                                                       disabled="@(!selectedCompany)" />
                                            </label>

                                            <label>
                                                <span>@language.ThirdNameLabel</span>
                                                <input asp-for="EmployeeNameTranslations[index].ThirdName"
                                                       dir="@language.Direction"
                                                       disabled="@(!selectedCompany)" />
                                            </label>

                                            <label>
                                                <span>@language.LastNameLabel @(language.IsRequired ? "*" : "")</span>
                                                <input asp-for="EmployeeNameTranslations[index].LastName"
                                                       dir="@language.Direction"
                                                       required="@(language.IsRequired ? "required" : null)"
                                                       disabled="@(!selectedCompany)" />
                                            </label>
                                        </div>
                                    </fieldset>
                                }
                            }
                        </section>
                    }
                    <span asp-validation-for="EmployeeNameTranslations" class="text-danger"></span>
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.NationalId">رقم الهوية</label>
                    <input asp-for="Employee.NationalId" placeholder="أدخل رقم الهوية" />
                    <span asp-validation-for="Employee.NationalId" class="text-danger"></span>
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.BirthDate">تاريخ الميلاد</label>
                    <input asp-for="Employee.BirthDate" type="date" />
                    <span asp-validation-for="Employee.BirthDate" class="text-danger"></span>
                </div>
@* ZYNORA_DEMOGRAPHIC_FIELDS_START *@
                <div class="nxr-field">
                    <label asp-for="Employee.Gender">&#x0627;&#x0644;&#x062C;&#x0646;&#x0633;</label>
                    <select asp-for="Employee.Gender" class="nxr-native-select">
                        <option value="">&#x0627;&#x062E;&#x062A;&#x0631;...</option>
                        <option value="Male">&#x0630;&#x0643;&#x0631;</option>
                        <option value="Female">&#x0623;&#x0646;&#x062B;&#x0649;</option>
                    </select>
                    <span asp-validation-for="Employee.Gender" class="text-danger"></span>
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.MaritalStatus">&#x0627;&#x0644;&#x062D;&#x0627;&#x0644;&#x0629; &#x0627;&#x0644;&#x0627;&#x062C;&#x062A;&#x0645;&#x0627;&#x0639;&#x064A;&#x0629;</label>
                    <select asp-for="Employee.MaritalStatus" class="nxr-native-select">
                        <option value="">&#x0627;&#x062E;&#x062A;&#x0631;...</option>
                        <option value="Single">&#x0623;&#x0639;&#x0632;&#x0628;</option>
                        <option value="Married">&#x0645;&#x062A;&#x0632;&#x0648;&#x062C;</option>
                        <option value="Divorced">&#x0645;&#x0637;&#x0644;&#x0642;</option>
                        <option value="Widowed">&#x0623;&#x0631;&#x0645;&#x0644;</option>
                        <option value="Separated">&#x0645;&#x0646;&#x0641;&#x0635;&#x0644;</option>
                    </select>
                    <span asp-validation-for="Employee.MaritalStatus" class="text-danger"></span>
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.Country">&#x0627;&#x0644;&#x0628;&#x0644;&#x062F;</label>
                    <select asp-for="Employee.Country" class="nxr-native-select">
                        <option value="">&#x0627;&#x062E;&#x062A;&#x0631; &#x0627;&#x0644;&#x0628;&#x0644;&#x062F;</option>
                        <option value="Iraq">&#x0627;&#x0644;&#x0639;&#x0631;&#x0627;&#x0642;</option>
                        <option value="Syria">&#x0633;&#x0648;&#x0631;&#x064A;&#x0627;</option>
                        <option value="Jordan">&#x0627;&#x0644;&#x0623;&#x0631;&#x062F;&#x0646;</option>
                        <option value="Lebanon">&#x0644;&#x0628;&#x0646;&#x0627;&#x0646;</option>
                        <option value="Saudi Arabia">&#x0627;&#x0644;&#x0633;&#x0639;&#x0648;&#x062F;&#x064A;&#x0629;</option>
                        <option value="United Arab Emirates">&#x0627;&#x0644;&#x0625;&#x0645;&#x0627;&#x0631;&#x0627;&#x062A;</option>
                        <option value="Qatar">&#x0642;&#x0637;&#x0631;</option>
                        <option value="Kuwait">&#x0627;&#x0644;&#x0643;&#x0648;&#x064A;&#x062A;</option>
                        <option value="Bahrain">&#x0627;&#x0644;&#x0628;&#x062D;&#x0631;&#x064A;&#x0646;</option>
                        <option value="Oman">&#x0639;&#x0645;&#x0627;&#x0646;</option>
                        <option value="Egypt">&#x0645;&#x0635;&#x0631;</option>
                        <option value="Turkey">&#x062A;&#x0631;&#x0643;&#x064A;&#x0627;</option>
                        <option value="Iran">&#x0625;&#x064A;&#x0631;&#x0627;&#x0646;</option>
                        <option value="India">&#x0627;&#x0644;&#x0647;&#x0646;&#x062F;</option>
                        <option value="Pakistan">&#x0628;&#x0627;&#x0643;&#x0633;&#x062A;&#x0627;&#x0646;</option>
                        <option value="Bangladesh">&#x0628;&#x0646;&#x063A;&#x0644;&#x0627;&#x062F;&#x0634;</option>
                        <option value="Philippines">&#x0627;&#x0644;&#x0641;&#x0644;&#x0628;&#x064A;&#x0646;</option>
                        <option value="Nepal">&#x0646;&#x064A;&#x0628;&#x0627;&#x0644;</option>
                        <option value="Other">&#x0623;&#x062E;&#x0631;&#x0649;</option>
                    </select>
                    <span asp-validation-for="Employee.Country" class="text-danger"></span>
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.Nationality">&#x0627;&#x0644;&#x062C;&#x0646;&#x0633;&#x064A;&#x0629;</label>
                    <select asp-for="Employee.Nationality" class="nxr-native-select">
                        <option value="">&#x0627;&#x062E;&#x062A;&#x0631; &#x0627;&#x0644;&#x062C;&#x0646;&#x0633;&#x064A;&#x0629;</option>
                        <option value="Iraqi">&#x0639;&#x0631;&#x0627;&#x0642;&#x064A;</option>
                        <option value="Syrian">&#x0633;&#x0648;&#x0631;&#x064A;</option>
                        <option value="Jordanian">&#x0623;&#x0631;&#x062F;&#x0646;&#x064A;</option>
                        <option value="Lebanese">&#x0644;&#x0628;&#x0646;&#x0627;&#x0646;&#x064A;</option>
                        <option value="Saudi">&#x0633;&#x0639;&#x0648;&#x062F;&#x064A;</option>
                        <option value="Emirati">&#x0625;&#x0645;&#x0627;&#x0631;&#x0627;&#x062A;&#x064A;</option>
                        <option value="Qatari">&#x0642;&#x0637;&#x0631;&#x064A;</option>
                        <option value="Kuwaiti">&#x0643;&#x0648;&#x064A;&#x062A;&#x064A;</option>
                        <option value="Bahraini">&#x0628;&#x062D;&#x0631;&#x064A;&#x0646;&#x064A;</option>
                        <option value="Omani">&#x0639;&#x0645;&#x0627;&#x0646;&#x064A;</option>
                        <option value="Egyptian">&#x0645;&#x0635;&#x0631;&#x064A;</option>
                        <option value="Turkish">&#x062A;&#x0631;&#x0643;&#x064A;</option>
                        <option value="Iranian">&#x0625;&#x064A;&#x0631;&#x0627;&#x0646;&#x064A;</option>
                        <option value="Indian">&#x0647;&#x0646;&#x062F;&#x064A;</option>
                        <option value="Pakistani">&#x0628;&#x0627;&#x0643;&#x0633;&#x062A;&#x0627;&#x0646;&#x064A;</option>
                        <option value="Bangladeshi">&#x0628;&#x0646;&#x063A;&#x0644;&#x0627;&#x062F;&#x0634;&#x064A;</option>
                        <option value="Filipino">&#x0641;&#x0644;&#x0628;&#x064A;&#x0646;&#x064A;</option>
                        <option value="Nepali">&#x0646;&#x064A;&#x0628;&#x0627;&#x0644;&#x064A;</option>
                        <option value="Other">&#x0623;&#x062E;&#x0631;&#x0649;</option>
                    </select>
                    <span asp-validation-for="Employee.Nationality" class="text-danger"></span>
                </div>
@* ZYNORA_DEMOGRAPHIC_FIELDS_END *@
@* ZYNORA_MARITAL_STATUS_FIELD_END *@

                @* ---------- الجنسية والإقامة (نمط كيان — مطابق لصفحة التعديل) ---------- *@
                <div class="nxr-field">
                    <label asp-for="Employee.IsCitizen">مواطن</label>
                    <select asp-for="Employee.IsCitizen" class="nxr-native-select">
                        <option value="true">مواطن</option>
                        <option value="false">غير مواطن (وافد)</option>
                    </select>
                </div>
                <div class="nxr-field">
                    <label asp-for="Employee.PassportNo">رقم جواز السفر</label>
                    <input asp-for="Employee.PassportNo" />
                </div>
                <div class="nxr-field">
                    <label asp-for="Employee.SponsorName">الكفيل</label>
                    <select asp-for="Employee.SponsorName" class="nxr-native-select">
                        <option value="">بدون كفيل</option>
                        @foreach (var sponsor in Model.SponsorOptions) { <option value="@sponsor">@sponsor</option> }
                    </select>
                </div>
                <div class="nxr-field">
                    <label asp-for="Employee.Religion">الديانة</label>
                    <select asp-for="Employee.Religion" class="nxr-native-select">
                        <option value="">اختر...</option>
                        @foreach (var religion in Model.ReligionOptions) { <option value="@religion">@religion</option> }
                    </select>
                </div>
                <div class="nxr-field">
                    <label asp-for="Employee.MotherCountry">@T["البلد الأم"]</label>

                    <select asp-for="Employee.MotherCountry"
                            class="nxr-native-select"
                            id="Employee_MotherCountry">

                        <option value="">@T["اختر البلد الأم"]</option>

                        @if (!string.IsNullOrWhiteSpace(Model.Employee.MotherCountry) &&
                             !SmartAttendance.Web.Infrastructure.Ui.ZynoraEmployeeGeoLookups.IsKnownCountry(Model.Employee.MotherCountry))
                        {
                            <option value="@Model.Employee.MotherCountry">
                                @Model.Employee.MotherCountry
                            </option>
                        }

                        @foreach (var country in SmartAttendance.Web.Infrastructure.Ui.ZynoraEmployeeGeoLookups.Countries)
                        {
                            <option value="@country.Value">
                                @T[country.Label]
                            </option>
                        }

                    </select>

                    <span asp-validation-for="Employee.MotherCountry"
                          class="text-danger"></span>
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.MotherCity">@T["المدينة الأم"]</label>

                    <select asp-for="Employee.MotherCity"
                            class="nxr-native-select"
                            id="Employee_MotherCity">

                        <option value="">@T["اختر المدينة الأم"]</option>

                        @if (!string.IsNullOrWhiteSpace(Model.Employee.MotherCity) &&
                             !SmartAttendance.Web.Infrastructure.Ui.ZynoraEmployeeGeoLookups.IsKnownCity(
                                 Model.Employee.MotherCountry,
                                 Model.Employee.MotherCity))
                        {
                            <option value="@Model.Employee.MotherCity"
                                    data-country="@Model.Employee.MotherCountry">
                                @Model.Employee.MotherCity
                            </option>
                        }

                        @foreach (var city in SmartAttendance.Web.Infrastructure.Ui.ZynoraEmployeeGeoLookups.Cities)
                        {
                            <option value="@city.Value"
                                    data-country="@city.CountryValue">
                                @T[city.Label]
                            </option>
                        }

                    </select>

                    <span asp-validation-for="Employee.MotherCity"
                          class="text-danger"></span>
                </div>
            </div>
        </section>

        <section class="nxr-card nxr-form-section nxr-create-section">
            <div class="nxr-section-title">
                <div>
                    <h2>المعلومات الوظيفية</h2>
                    <p>اختيار القسم وتحديد المنصب وتاريخ التعيين.</p>
                </div>
                <span class="nxr-chip gold">مطلوب</span>
            </div>

            <div class="nxr-form-grid nxr-create-grid nxr-employment-grid">
                <div class="nxr-field">
                    <label asp-for="Employee.BranchId">موقع العمل</label>
                    <select asp-for="Employee.BranchId" class="nxr-native-select" id="Employee_BranchId">
                        <option value="">اختر موقع العمل</option>
                        @foreach (var branch in Model.Branches.OrderBy(x => x.Name))
                        {
                            <option value="@branch.Id"
                                    data-company-id="@branch.CompanyId"
                                    selected="@(branch.Id == Model.Employee.BranchId ? "selected" : null)">
                                @branch.Name
                            </option>
                        }
                    </select>
                    <span asp-validation-for="Employee.BranchId" class="text-danger"></span>
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.DepartmentId">&#x0627;&#x0644;&#x0642;&#x0633;&#x0645;</label>
                    <select data-zynora-select="true" asp-for="Employee.DepartmentId" class="nxr-native-select" id="Employee_DepartmentId">
                        <option value="">&#x0627;&#x062E;&#x062A;&#x0631; &#x0627;&#x0644;&#x0642;&#x0633;&#x0645;</option>
                        @foreach (var department in Model.Departments.OrderBy(x => x.CompanyName).ThenBy(x => x.Name))
                        {
                            <option value="@department.Id"
                                    data-company-id="@department.CompanyId"
                                    selected="@(department.Id == Model.Employee.DepartmentId ? "selected" : null)">
                                @department.Name
                            </option>
                        }
                    </select>
                    <span asp-validation-for="Employee.DepartmentId" class="text-danger"></span>
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.PositionId">&#x0627;&#x0644;&#x0645;&#x0646;&#x0635;&#x0628;</label>
                    <select asp-for="Employee.PositionId" class="nxr-native-select" id="Employee_PositionId">
                        <option value="">&#x0627;&#x062E;&#x062A;&#x0631; &#x0627;&#x0644;&#x0645;&#x0646;&#x0635;&#x0628;</option>
                        @foreach (var position in Model.PositionOptions.OrderBy(x => x.Name))
                        {
                            <option value="@position.Id"
                                    data-company-id="@position.CompanyId"
                                    selected="@(position.Id == Model.Employee.PositionId ? "selected" : null)">
                                @position.Name
                            </option>
                        }
                    </select>
                    <span asp-validation-for="Employee.PositionId" class="text-danger"></span>
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.HireDate">تاريخ التعيين (العقد)</label>
                    <input asp-for="Employee.HireDate" type="date" />
                    <span asp-validation-for="Employee.HireDate" class="text-danger"></span>
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.JoiningDate">تاريخ المباشرة الفعلية (إن اختلفت)</label>
                    <input asp-for="Employee.JoiningDate" type="date" />
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.WorkType">نوع الدوام</label>
                    <select asp-for="Employee.WorkType" class="nxr-native-select">
                        <option value="">اختر...</option>
                        @foreach (var workType in Model.WorkTypeOptions) { <option value="@workType">@workType</option> }
                    </select>
                </div>

                <div class="nxr-field">
                    <label asp-for="Employee.JobGrade">الدرجة الوظيفية</label>
                    <select asp-for="Employee.JobGrade" class="nxr-native-select">
                        <option value="">اختر...</option>
                        @foreach (var grade in Model.GradeOptions) { <option value="@grade">@grade</option> }
                    </select>
                </div>


    <!-- ZYNORA_CREATE_ORGANIZATION_FILTER_START -->
    <script>
        (() => {
            const company = document.getElementById("SelectedCompanyId");
            const workLocation = document.getElementById("Employee_BranchId");
            const department = document.getElementById("Employee_DepartmentId");
            const position = document.getElementById("Employee_PositionId");

            if (!company || !workLocation || !department || !position) {
                return;
            }

            function refreshSelect(select) {
                if (window.ZynoraSelect && typeof window.ZynoraSelect.refresh === "function") {
                    window.ZynoraSelect.refresh(select);
                }

                select.dispatchEvent(new Event("change", { bubbles: true }));
            }

            function filterByCompany(select, companyId) {
                let currentIsValid = false;

                Array.from(select.options).forEach(option => {
                    if (!option.value) {
                        option.hidden = false;
                        option.disabled = false;
                        return;
                    }

                    const belongsToCompany =
                        companyId &&
                        option.dataset.companyId === companyId;

                    option.hidden = !belongsToCompany;
                    option.disabled = !belongsToCompany;

                    if (belongsToCompany && option.value === select.value) {
                        currentIsValid = true;
                    }
                });

                if (!currentIsValid) {
                    select.value = "";
                }

                refreshSelect(select);
            }

            function filterOrganization() {
                const companyId = company.value || "";

                filterByCompany(department, companyId);
                filterByCompany(position, companyId);
            }

            function filterCompany() {
                const companyId = company.value || "";

                filterByCompany(workLocation, companyId);
                document.querySelectorAll("[data-language-company]").forEach(section => {
                    const active = companyId && section.dataset.languageCompany === companyId;
                    section.hidden = !active;
                    section.querySelectorAll("input").forEach(input => input.disabled = !active);
                });
            }

            company.addEventListener("change", filterCompany);
            workLocation.addEventListener("change", filterOrganization);
            filterCompany();

            window.ZynoraCreateFilterOrganization = filterOrganization;
            window.ZynoraCreateFilterCompany = filterCompany;
        })();
    </script>
    <!-- ZYNORA_CREATE_ORGANIZATION_FILTER_END -->

    <!-- ZYNORA_MARITAL_BY_GENDER_START -->
    <script>
        (() => {
            const labels = {
                Male: {
                    Single: "\u0623\u0639\u0632\u0628",
                    Married: "\u0645\u062A\u0632\u0648\u062C",
                    Divorced: "\u0645\u0637\u0644\u0642",
                    Widowed: "\u0623\u0631\u0645\u0644",
                    Separated: "\u0645\u0646\u0641\u0635\u0644"
                },
                Female: {
                    Single: "\u0639\u0632\u0628\u0627\u0621",
                    Married: "\u0645\u062A\u0632\u0648\u062C\u0629",
                    Divorced: "\u0645\u0637\u0644\u0642\u0629",
                    Widowed: "\u0623\u0631\u0645\u0644\u0629",
                    Separated: "\u0645\u0646\u0641\u0635\u0644\u0629"
                }
            };

            const placeholder = "\u0627\u062E\u062A\u0631...";

            function getGenderGroup(genderValue) {
                const value = (genderValue || "").trim();

                if (value === "Female" || value === "\u0623\u0646\u062B\u0649" || value === "\u0627\u0646\u062B\u0649") {
                    return labels.Female;
                }

                return labels.Male;
            }

            function applyMaritalLabels() {
                const gender = document.getElementById("Employee_Gender");
                const marital = document.getElementById("Employee_MaritalStatus");

                if (!gender || !marital) {
                    return;
                }

                const group = getGenderGroup(gender.value);

                Array.from(marital.options).forEach(option => {
                    if (!option.value) {
                        option.textContent = placeholder;
                        return;
                    }

                    if (group[option.value]) {
                        option.textContent = group[option.value];
                    }
                });

                if (window.ZynoraSelect && typeof window.ZynoraSelect.refresh === "function") {
                    window.ZynoraSelect.refresh(marital);
                } else {
                    marital.dispatchEvent(new Event("change", { bubbles: true }));
                }
            }

            function bind() {
                const gender = document.getElementById("Employee_Gender");

                if (gender && !gender.dataset.maritalGenderBound) {
                    gender.dataset.maritalGenderBound = "1";
                    gender.addEventListener("change", applyMaritalLabels);
                    gender.addEventListener("input", applyMaritalLabels);
                }

                applyMaritalLabels();
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", bind);
            } else {
                bind();
            }

            setTimeout(bind, 100);
            setTimeout(bind, 400);
            setTimeout(bind, 900);
        })();
    </script>
    <!-- ZYNORA_MARITAL_BY_GENDER_END -->
    <script>
        // الاسم الرباعي → يبني "الاسم الكامل" المخفي تلقائياً أثناء الكتابة.
        (function () {
            var full = document.getElementById("Employee_FullName");
            var parts = Array.prototype.slice.call(document.querySelectorAll("[data-quad-name]"));
            if (!full || !parts.length) return;
            function compose() {
                var values = parts.map(function (p) { return p.value.trim(); }).filter(Boolean);
                full.value = values.join(" ");
            }
            parts.forEach(function (p) { p.addEventListener("input", compose); });
        })();
    </script>
    <script>
        // استوديو الحقول: إخفاء/تسمية مخصصة/ترتيب + علامة * و required — كلها معرّفة مركزياً.
        (function () {
            var fields = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.FieldSettings.Values.Select(s => new { k = s.Key, v = s.IsVisible, r = Model.RequiredFieldKeys.Contains(s.Key), l = s.CustomLabel, o = s.DisplayOrder })));
            var skipEmployeeNoRequired = @(Model.CodeSchemaActive ? "true" : "false");
            var items = [];

            fields.forEach(function (f) {
                var input = document.querySelector('[name="Employee.' + f.k + '"]');
                if (!input || input.type === "hidden") return;
                var box = input.closest(".nxr-field") || input.parentElement;
                var label = (input.id && document.querySelector('label[for="' + input.id + '"]')) || box.querySelector("label");

                if (!f.v) { box.style.setProperty("display", "none", "important"); input.removeAttribute("required"); return; }
                if (f.l && label) label.textContent = f.l;
                if (f.r && !(f.k === "EmployeeNo" && skipEmployeeNoRequired)) {
                    input.setAttribute("required", "required");
                    if (label && !label.querySelector(".nx-req-star")) {
                        var star = document.createElement("span");
                        star.className = "nx-req-star";
                        star.textContent = " *";
                        star.style.cssText = "color:#f87171;font-weight:900";
                        label.appendChild(star);
                    }
                }
                items.push({ box: box, order: f.o });
            });

            // إعادة الترتيب: داخل كل حاوية، تُرتّب الحقول المُدارة حسب ترتيب الاستوديو.
            var byParent = new Map();
            items.forEach(function (it) {
                var parent = it.box.parentElement;
                if (!byParent.has(parent)) byParent.set(parent, []);
                byParent.get(parent).push(it);
            });
            byParent.forEach(function (list, parent) {
                if (list.length < 2) return;
                var domFirst = list.map(function (x) { return x.box; }).sort(function (a, b) {
                    return (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING) ? -1 : 1;
                })[0];
                var anchor = document.createComment("fc-anchor");
                parent.insertBefore(anchor, domFirst);
                list.sort(function (a, b) { return a.order - b.order; })
                    .forEach(function (it) { parent.insertBefore(it.box, anchor); });
                parent.removeChild(anchor);
            });

            // البيانات الأساسية تبدأ دائماً بكود الموظف ثم الشركة وحقول الاسم.
            // استوديو الحقول يعيد ترتيب حقول Employee فقط، لذلك نثبت العناصر
            // المرتبطة باللغات في المقدمة بعد انتهاء ترتيبه.
            var basicGrid = document.querySelector(".nxr-basic-grid");
            if (basicGrid) {
                var priorityFields = [
                    basicGrid.querySelector(".nxr-employee-code-priority"),
                    basicGrid.querySelector(".nxr-employee-company-first"),
                    basicGrid.querySelector("[data-employee-multilingual]")
                ].filter(Boolean);
                var priorityFragment = document.createDocumentFragment();
                priorityFields.forEach(function (field) { priorityFragment.appendChild(field); });
                basicGrid.prepend(priorityFragment);
            }
        })();
    </script>

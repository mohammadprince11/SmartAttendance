@page "/Employees/SmartOnboardingReview"
@model SmartAttendance.Web.Pages.Employees.SmartOnboardingReviewModel
@using SmartAttendance.Application.PeopleAi
@{
    ViewData["Title"] = "مراجعة Smart Onboarding";

    string StatusLabel(string value) => value switch
    {
        "Queued" => "بانتظار المعالجة",
        "Processing" => "قيد المعالجة",
        "NeedsReview" => "تحتاج مراجعة",
        "Ready" => "جاهزة للإنشاء",
        "Completed" => "مكتملة",
        "Cancelled" => "ملغاة",
        "Failed" => "فشلت",
        _ => value
    };

    string DocumentTypeFor(
        SmartAttendance.Web.Infrastructure.Hrms.PeopleAiReviewStore.ReviewField field)
    {
        var document = Model.Documents.FirstOrDefault(x => x.Id == field.DocumentId);
        return document?.DetectedDocumentType
            ?? document?.DeclaredDocumentType
            ?? PeopleAiDocumentTypes.Unknown;
    }

    PeopleAiFieldPolicy? FieldPolicy(
        SmartAttendance.Web.Infrastructure.Hrms.PeopleAiReviewStore.ReviewField field)
    {
        var type = DocumentTypeFor(field);

        return Model.FieldPolicies.FirstOrDefault(x =>
            x.IsActive &&
            x.DocumentType.Equals(type, StringComparison.OrdinalIgnoreCase) &&
            x.FieldKey.Equals(field.FieldKey, StringComparison.OrdinalIgnoreCase));
    }

    string DefaultFieldLabel(string key) => key switch
    {
        "DocumentNumber" => "رقم المستند",
        "NationalNumber" => "الرقم الوطني",
        "FamilyNumber" => "الرقم العائلي",
        "FirstName" => "الاسم",
        "SecondName" => "اسم الأب",
        "ThirdName" => "اسم الجد",
        "LastName" => "اللقب",
        "MotherName" => "اسم الأم",
        "Surname" => "اللقب / اسم العائلة (MRZ)",
        "GivenNames" => "الأسماء اللاتينية (MRZ)",
        "DateOfBirth" => "تاريخ الميلاد",
        "ExpiryDate" => "تاريخ الانتهاء",
        "IssueDate" => "تاريخ الإصدار",
        "Nationality" => "الجنسية",
        "IssuingCountry" => "بلد الإصدار",
        "IssuingAuthority" => "جهة الإصدار",
        "PlaceOfIssue" => "مكان الإصدار",
        "PlaceOfBirth" => "مكان الميلاد",
        "Sex" => "الجنس",
        "Phone" => "الهاتف",
        "Email" => "البريد الإلكتروني للعمل",
        "PersonalEmail" => "البريد الشخصي",
        "MRZ.Format" => "صيغة MRZ",
        _ => key
    };

    string FieldLabel(
        SmartAttendance.Web.Infrastructure.Hrms.PeopleAiReviewStore.ReviewField field) =>
        FieldPolicy(field)?.DisplayLabel ?? DefaultFieldLabel(field.FieldKey);

    string EffectiveValue(SmartAttendance.Web.Infrastructure.Hrms.PeopleAiReviewStore.ReviewField field)
    {
        if (field.ReviewStatus == "Rejected")
        {
            return string.Empty;
        }

        return field.ReviewedValue
            ?? field.NormalizedValue
            ?? field.RawValue
            ?? string.Empty;
    }

    string ConfidenceBand(
        SmartAttendance.Web.Infrastructure.Hrms.PeopleAiReviewStore.ReviewField field)
    {
        if (!field.ProviderConfidence.HasValue)
        {
            return "unknown";
        }

        return field.ProviderConfidence.Value switch
        {
            >= 0.90m => "high",
            >= 0.70m => "medium",
            _ => "low"
        };
    }

    string ConfidenceLabel(
        SmartAttendance.Web.Infrastructure.Hrms.PeopleAiReviewStore.ReviewField field)
    {
        if (!field.ProviderConfidence.HasValue)
        {
            return field.ExtractionMethod == "Manual"
                ? "Manual"
                : "بدون درجة";
        }

        var percentage = field.ProviderConfidence.Value * 100m;
        return ConfidenceBand(field) switch
        {
            "high" => $"High · {percentage:0.0}%",
            "medium" => $"Medium · {percentage:0.0}%",
            _ => $"Low · {percentage:0.0}%"
        };
    }

    var cvVisibleFieldKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "Phone",
        "PersonalEmail",
        "Skills"
    };

    var semanticFields = Model.Fields
        .Where(x => !x.FieldKey.StartsWith("OCR.", StringComparison.OrdinalIgnoreCase)
                 && !x.FieldKey.StartsWith("MRZ.Check.", StringComparison.OrdinalIgnoreCase))
        .Where(x =>
            !DocumentTypeFor(x).Equals(
                PeopleAiDocumentTypes.Cv,
                StringComparison.OrdinalIgnoreCase) ||
            cvVisibleFieldKeys.Contains(x.FieldKey))
        .Where(x => FieldPolicy(x) is not null)
        .GroupBy(
            x => $"{DocumentTypeFor(x)}\u001f{x.FieldKey}",
            StringComparer.OrdinalIgnoreCase)
        .Select(group => group
            .OrderByDescending(x => x.ReviewStatus is "Accepted" or "Modified" or "Rejected")
            .ThenByDescending(x => !string.IsNullOrWhiteSpace(EffectiveValue(x)))
            .ThenByDescending(x => x.ValidationStatus == "Valid")
            .ThenByDescending(x => x.Id)
            .First())
        .OrderBy(x => DocumentTypeFor(x))
        .ThenBy(x => FieldPolicy(x)!.SortOrder)
        .ThenBy(x => FieldLabel(x))
        .ToList();

    var reviewFields = semanticFields
        .Where(x => x.ReviewStatus == "Pending")
        .ToList();

    var acceptedFields = semanticFields
        .Where(x => x.ReviewStatus is "Accepted" or "Modified")
        .ToList();

    var reviewStructuredRecords = Model.StructuredRecords
        .Where(x => x.ReviewStatus == "Pending")
        .Where(x => x.RecordType is "Experience" or "Education")
        .ToList();

    DateOnly? EffectiveDocumentExpiry(
        SmartAttendance.Web.Infrastructure.Hrms.EmployeeOnboardingStore.DocumentRow document)
    {
        if (document.ReviewedExpiryDate.HasValue)
        {
            return document.ReviewedExpiryDate;
        }

        var expiryValue = acceptedFields
            .Where(x =>
                x.DocumentId == document.Id &&
                x.FieldKey.Equals(
                    "ExpiryDate",
                    StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.Id)
            .Select(EffectiveValue)
            .FirstOrDefault();

        return DateOnly.TryParse(
            expiryValue,
            out var parsed)
            ? parsed
            : null;
    }

    bool DocumentReviewComplete(
        SmartAttendance.Web.Infrastructure.Hrms.EmployeeOnboardingStore.DocumentRow document)
    {
        var type = document.DetectedDocumentType
            ?? document.DeclaredDocumentType
            ?? PeopleAiDocumentTypes.Unknown;

        var policies = Model.DocumentPolicies
            .Where(x =>
                x.IsActive &&
                x.DocumentType.Equals(
                    type,
                    StringComparison.OrdinalIgnoreCase))
            .ToList();

        var requireExpiry =
            policies.Any(x => x.RequireExpiryDate);
        var requireOriginal =
            policies.Any(x => x.RequireOriginalVerification);

        var processingDone =
            document.ProcessingStatus is not (
                "Queued" or "Processing" or "Failed");

        var expiryDone =
            !requireExpiry ||
            EffectiveDocumentExpiry(document).HasValue;

        var originalDone =
            !requireOriginal ||
            document.OriginalVerificationStatus == "Verified";

        return processingDone &&
               expiryDone &&
               originalDone &&
               document.OriginalVerificationStatus != "Rejected";
    }

    var documentsToReview = Model.Documents
        .Where(x => !DocumentReviewComplete(x))
        .ToList();

    var reviewedDocuments = Model.Documents
        .Where(DocumentReviewComplete)
        .ToList();

    var openIssues = Model.Issues.Where(x => x.Status == "Open").ToList();


}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/smart-onboarding-review.css" asp-append-version="true" />
}

<div class="sor-shell" dir="rtl">
    <div class="zy-breadcrumb">
        <span>زينورا</span><span>/</span><span>الأشخاص</span><span>/</span>
        <a asp-page="./SmartOnboarding"
           asp-route-CompanyId="@Model.CompanyId"
           asp-route-SessionId="@Model.SessionId">Smart Onboarding</a>
        <span>/</span><b>المراجعة</b>
    </div>

    <header class="zy-page-header sor-head">
        <div>
            <h1>مراجعة Smart Onboarding</h1>
            <div class="zy-desc">مراجعة بشرية إلزامية قبل تحويل البيانات المستخرجة إلى سجل موظف.</div>
        </div>
        <div class="zy-spacer"></div>
        @if (Model.Session is not null)
        {
            <span class="zy-badge zy-badge--info">@StatusLabel(Model.Session.Status)</span>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="sor-alert sor-alert--success">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="sor-alert sor-alert--danger">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.PageError))
    {
        <div class="sor-alert sor-alert--danger">@Model.PageError</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.DocumentPolicyError))
    {
        <div class="sor-alert sor-alert--warning">
            متطلب قبل الإنشاء: @Model.DocumentPolicyError
        </div>
    }
    @if (Model.Session is not null)
    {
        <section class="sor-summary">
            <div><span>Session</span><strong>#@Model.Session.Id</strong></div>
            <div><span>الحالة</span><strong>@StatusLabel(Model.Session.Status)</strong></div>
            <div><span>المستندات</span><strong>@Model.Documents.Count</strong></div>
            <div><span>الحقول الدلالية</span><strong>@semanticFields.Count</strong></div>
            <div><span>مشاكل مفتوحة</span><strong>@openIssues.Count</strong></div>
            <div><span>المراجع</span><strong>@(Model.CanReview ? "مسموح" : "عرض فقط")</strong></div>
        </section>

        @if (reviewedDocuments.Count > 0)
        {
            <details class="sor-card sor-reviewed">
                <summary>
                    <span>المستندات المعتمدة</span>
                    <small>@reviewedDocuments.Count مستند — مخفية من قائمة الإجراءات</small>
                </summary>

                <div class="sor-reviewed-list">
                    @foreach (var document in reviewedDocuments)
                    {
                        <div>
                            <strong>@document.OriginalFileName</strong>
                            <span>
                                المعلن: @(document.DeclaredDocumentType ?? "Unknown")
                                · المكتشف: @(document.DetectedDocumentType ?? "غير محدد")
                            </span>
                            <small>
                                @(document.OriginalVerificationStatus == "Verified"
                                    ? "تم التحقق"
                                    : "لا يتطلب تحققاً إضافياً")
                            </small>
                        </div>
                    }
                </div>
            </details>
        }

        @if (openIssues.Count > 0)
        {
            <section class="sor-card">
                <div class="sor-section-head">
                    <div>
                        <h2>المشاكل التي تحتاج قرار</h2>
                        <p>المشاكل المانعة يجب حلها قبل تحويل الجلسة إلى Ready.</p>
                    </div>
                    <span class="zy-badge zy-badge--info">@openIssues.Count مفتوحة</span>
                </div>

                <div class="sor-issues">
                    @foreach (var issue in openIssues)
                    {
                        var isBlock = issue.RuleCode.StartsWith("DUPLICATE_BLOCK_", StringComparison.Ordinal);
                        <article class="sor-issue sor-issue--@issue.Severity.ToLowerInvariant()">
                            <div class="sor-issue-main">
                                <div class="sor-tags">
                                    <span>@issue.Severity</span>
                                    <span>@issue.Category</span>
                                    <span>@issue.RuleCode</span>
                                </div>
                                <strong>@issue.Message</strong>
                                @if (!string.IsNullOrWhiteSpace(issue.FieldKey))
                                {
                                    <small>الحقل: @DefaultFieldLabel(issue.FieldKey)</small>
                                }
                            </div>

                            @if (Model.CanReview && !isBlock)
                            {
                                <form method="post" asp-page-handler="ResolveIssue" class="sor-resolution">
                                    <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                                    <input type="hidden" name="SessionId" value="@Model.SessionId" />
                                    <input type="hidden" name="issueId" value="@issue.Id" />
                                    <input name="resolution" placeholder="قرار المراجع / سبب قبول الحالة" required />
                                    <button type="submit" class="zy-btn">توثيق وإغلاق</button>
                                </form>
                            }
                            else if (isBlock)
                            {
                                <span class="sor-lock">مانع حسب سياسة الشركة</span>
                            }
                        </article>
                    }
                </div>
            </section>
        }

        @if (Model.DuplicateMatches.Count > 0)
        {
            <section class="sor-card">
                <div class="sor-section-head">
                    <div>
                        <h2>مطابقات الهوية</h2>
                        <p>النتيجة محكومة بنطاق المستخدم وسياسة الشركة، ولا تُكشف تفاصيل خارج الصلاحية.</p>
                    </div>
                </div>

                <div class="sor-duplicates">
                    @foreach (var match in Model.DuplicateMatches)
                    {
                        <article class="sor-duplicate">
                            <div>
                                <strong>@match.DocumentType</strong>
                                <small>@match.Action · @match.Candidates.Count مطابقة</small>
                            </div>
                            <div class="sor-candidate-list">
                                @foreach (var candidate in match.Candidates)
                                {
                                    <span>
                                        @if (candidate.IsVisibleToRequester)
                                        {
                                            <b>@candidate.EmployeeNo</b>
                                            <span>@candidate.DisplayName</span>
                                            <small>@(candidate.IsActive ? "فعال" : "غير فعال — راجع إعادة التعيين")</small>
                                        }
                                        else
                                        {
                                            <b>مطابقة محمية</b>
                                            <span>@candidate.DisplayName</span>
                                        }
                                    </span>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
        @if (Model.CrossDocumentComparisons.Count > 0)
        {
            var conflictCount = Model.CrossDocumentComparisons.Count(x => x.HasConflict);
            <section class="sor-card sor-cross-doc">
                <div class="sor-section-head">
                    <div>
                        <h2>مقارنة البيانات بين المستندات</h2>
                        <p>زينورا يقارن الحقول المشتركة بين الهوية والجواز وبقية المستندات قبل الاعتماد النهائي.</p>
                    </div>
                    <span class="zy-badge zy-badge--info">
                        @(conflictCount == 0
                            ? "القيم المشتركة متطابقة"
                            : $"{conflictCount} تعارض")
                    </span>
                </div>

                <div class="sor-cross-list">
                    @foreach (var comparison in Model.CrossDocumentComparisons)
                    {
                        <article class="sor-cross-item @(comparison.HasConflict ? "is-conflict" : "is-match")">
                            <header>
                                <div>
                                    <strong>@DefaultFieldLabel(comparison.FieldKey)</strong>
                                    <small>@comparison.Severity</small>
                                </div>
                                <span>
                                    @(comparison.HasConflict ? "تعارض يحتاج قرار" : "متطابق")
                                </span>
                            </header>
                            <div class="sor-cross-values">
                                @foreach (var value in comparison.Values)
                                {
                                    <div>
                                        <small>@value.DocumentType · @value.DocumentName</small>
                                        <strong>@value.Value</strong>
                                        <span>
                                            @value.ReviewStatus
                                            @if (value.Confidence.HasValue)
                                            {
                                                <text> · @($"{value.Confidence.Value * 100m:0.0}%")</text>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        @if (reviewFields.Count > 0)
        {
        <section class="sor-card">
            <div class="sor-section-head">
                <div>
                    <h2>الحقول المستخرجة</h2>
                    <p>اعتمد القيمة، عدّلها ثم اعتمدها، أو ارفضها. الحقول الظاهرة وترتيبها تأتي من إعدادات People AI للشركة.</p>
                </div>
                <div class="sor-section-actions">
                    <span class="zy-badge zy-badge--info">@reviewFields.Count بحاجة مراجعة</span>
                    @if (Model.CanReview && (
                        reviewFields.Any(x =>
                            x.ReviewStatus == "Pending" &&
                            x.ProviderConfidence >=
                                SmartAttendance.Web.Infrastructure.Hrms.PeopleAiReviewStore.HighConfidenceThreshold &&
                            !string.IsNullOrWhiteSpace(EffectiveValue(x)) &&
                            FieldPolicy(x)?.AllowBulkApprove == true) ||
                        reviewStructuredRecords.Any(x =>
                            x.ProviderConfidence >=
                                SmartAttendance.Web.Infrastructure.Hrms.PeopleAiStructuredRecordStore.HighConfidenceThreshold)))
                    {
                        <form method="post"
                              asp-page-handler="AcceptAll"
                              data-preserve-scroll>
                            <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                            <input type="hidden" name="SessionId" value="@Model.SessionId" />
                            <button type="submit" class="zy-btn zy-btn--primary">
                                اعتماد عالي الثقة
                            </button>
                        </form>
                    }
                </div>
            </div>

            <div class="sor-fields">
                    @foreach (var field in reviewFields)
                    {
                        var document = Model.Documents.FirstOrDefault(x => x.Id == field.DocumentId);
                        var policy = FieldPolicy(field)!;
                        var effectiveValue = EffectiveValue(field);
                        var confidenceBand = ConfidenceBand(field);
                        var confidenceLabel = ConfidenceLabel(field);

                        <article id="field-@field.Id"
                                 class="sor-field sor-field--@field.ReviewStatus.ToLowerInvariant()">
                            <div class="sor-field-meta">
                                <div>
                                    <strong>@FieldLabel(field)</strong>
                                    <small>
                                        @(document?.DetectedDocumentType ?? document?.DeclaredDocumentType ?? "Unknown")
                                        · @field.ExtractionMethod
                                        · @(policy.Requirement == "Required" ? "مطلوب" : "اختياري")
                                    </small>
                                </div>
                                <div class="sor-field-badges">
                                    @if (policy.Requirement == "Required")
                                    {
                                        <span class="is-required">Required</span>
                                    }
                                    <span>@field.ValidationStatus</span>
                                    <span class="sor-confidence sor-confidence--@confidenceBand">
                                        @confidenceLabel
                                    </span>
                                    <span>@field.ReviewStatus</span>
                                </div>
                            </div>

                            <form method="post"
                                  asp-page-handler="ReviewField"
                                  class="sor-field-form"
                                  data-preserve-scroll
                                  data-field-id="@field.Id">
                                <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                                <input type="hidden" name="SessionId" value="@Model.SessionId" />
                                <input type="hidden" name="fieldId" value="@field.Id" />
                                <input name="reviewedValue"
                                       value="@effectiveValue"
                                       readonly="@(!Model.CanReview)"
                                       aria-label="@FieldLabel(field)" />
                                @if (Model.CanReview)
                                {
                                    <div class="sor-field-actions">
                                        <button type="submit" name="action" value="Accept" class="zy-btn">اعتماد</button>
                                        <button type="submit" name="action" value="Modify" class="zy-btn zy-btn--primary">تعديل واعتماد</button>
                                        <button type="submit" name="action" value="Reject" class="zy-btn">رفض</button>
                                    </div>
                                }
                            </form>
                        </article>
                    }
                </div>
        </section>
        }


        @if (reviewStructuredRecords.Count > 0)
        {
            var pendingStructured = reviewStructuredRecords.Count;
            <section class="sor-card sor-cv-records">
                <div class="sor-section-head">
                    <div>
                        <h2>CV Intelligence — الخبرة والتعليم</h2>
                        <p>كل سجل مستخرج يبقى Staging إلى أن تعتمده أو تعدله. لا يُكتب إلى ملف الموظف قبل Finalize.</p>
                    </div>
                    <span class="zy-badge zy-badge--info">
                        @(pendingStructured > 0
                            ? $"{pendingStructured} بحاجة مراجعة"
                            : "تمت مراجعة كل السجلات")
                    </span>
                </div>

                <div class="sor-cv-record-list">
                    @foreach (var record in reviewStructuredRecords)
                    {
                        var recordLabel = record.RecordType switch
                        {
                            "Experience" => "خبرة عملية",
                            "Education" => "مؤهل علمي",
                            _ => record.RecordType
                        };
                        var confidence = record.ProviderConfidence.HasValue
                            ? $"{record.ProviderConfidence.Value * 100m:0.0}%"
                            : "بدون درجة";
                        var confidenceBand = !record.ProviderConfidence.HasValue
                            ? "unknown"
                            : record.ProviderConfidence.Value >= 0.90m
                                ? "high"
                                : record.ProviderConfidence.Value >= 0.70m
                                    ? "medium"
                                    : "low";
                        var primaryLabel = record.RecordType switch
                        {
                            "Experience" => "الشركة / جهة العمل",
                            "Education" => "الجهة التعليمية",
                            "Certificate" => "اسم الشهادة",
                            _ => "العنوان الرئيسي"
                        };
                        var secondaryLabel = record.RecordType switch
                        {
                            "Experience" => "المسمى الوظيفي",
                            "Education" => "المؤهل / الدرجة",
                            "Certificate" => "الجهة المانحة / التفاصيل",
                            _ => "التفصيل / المسمى"
                        };

                        <article class="sor-cv-record sor-cv-record--@record.ReviewStatus.ToLowerInvariant()">
                            <header>
                                <div>
                                    <strong>@recordLabel</strong>
                                    <small>@record.DocumentName · @record.ExtractionMethod</small>
                                </div>
                                <div class="sor-field-badges">
                                    <span class="sor-confidence sor-confidence--@confidenceBand">@confidence</span>
                                    <span>@record.ReviewStatus</span>
                                </div>
                            </header>

                            <form method="post"
                                  asp-page-handler="ReviewStructuredRecord"
                                  class="sor-cv-record-form sor-cv-record-form--@record.RecordType.ToLowerInvariant()"
                                  data-preserve-scroll>
                                <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                                <input type="hidden" name="SessionId" value="@Model.SessionId" />
                                <input type="hidden" name="recordId" value="@record.Id" />

                                <label>
                                    <span>@primaryLabel</span>
                                    <input name="title"
                                           value="@record.EffectiveTitle"
                                           dir="auto"
                                           readonly="@(!Model.CanReview)"
                                           required />
                                </label>

                                <label>
                                    <span>@secondaryLabel</span>
                                    <input name="subtitle"
                                           value="@record.EffectiveSubtitle"
                                           dir="auto"
                                           readonly="@(!Model.CanReview)" />
                                </label>

                                <label>
                                    <span>الدولة</span>
                                    <input name="country"
                                           value="@record.EffectiveCountry"
                                           dir="auto"
                                           readonly="@(!Model.CanReview)" />
                                </label>

                                <label>
                                    <span>الرقم المرجعي</span>
                                    <input name="refNo"
                                           value="@record.EffectiveRefNo"
                                           dir="auto"
                                           readonly="@(!Model.CanReview)" />
                                </label>

                                <label>
                                    <span>من</span>
                                    <input type="date"
                                           name="fromDate"
                                           value="@(record.EffectiveFromDate?.ToString("yyyy-MM-dd"))"
                                           readonly="@(!Model.CanReview)" />
                                </label>

                                <label>
                                    <span>إلى</span>
                                    <input type="date"
                                           name="toDate"
                                           value="@(record.EffectiveToDate?.ToString("yyyy-MM-dd"))"
                                           readonly="@(!Model.CanReview || record.EffectiveIsCurrent)" />
                                </label>

                                <label class="sor-cv-current">
                                    <input type="checkbox"
                                           name="isCurrent"
                                           value="true"
                                           checked="@record.EffectiveIsCurrent"
                                           disabled="@(!Model.CanReview)" />
                                    <span>مستمر / حالي</span>
                                </label>

                                <label class="sor-cv-note">
                                    <span>ملاحظات / وصف الخبرة</span>
                                    <textarea name="note"
                                              rows="3"
                                              dir="auto"
                                              readonly="@(!Model.CanReview)">@record.EffectiveNote</textarea>
                                </label>

                                @if (Model.CanReview)
                                {
                                    <div class="sor-field-actions sor-cv-actions">
                                        <button type="submit" name="action" value="Accept" class="zy-btn">اعتماد</button>
                                        <button type="submit" name="action" value="Modify" class="zy-btn zy-btn--primary">تعديل واعتماد</button>
                                        <button type="submit" name="action" value="Reject" class="zy-btn">رفض</button>
                                    </div>
                                }
                            </form>
                        </article>
                    }
                </div>
            </section>
        }

        @if (acceptedFields.Count > 0)
        {
            <details class="sor-card sor-reviewed">
                <summary>
                    <span>الحقول المعتمدة</span>
                    <small>@acceptedFields.Count حقل — مخفية من قائمة المراجعة الرئيسية</small>
                </summary>

                <div class="sor-reviewed-list">
                    @foreach (var field in acceptedFields)
                    {
                        <div>
                            <strong>@FieldLabel(field)</strong>
                            <span>@EffectiveValue(field)</span>
                            <small>
                                @DocumentTypeFor(field)
                                · @(field.ReviewStatus == "Modified" ? "معدل ومعتمد" : "معتمد")
                            </small>
                        </div>
                    }
                </div>
            </details>
        }

        @if (Model.Session.Status is "NeedsReview" or "Processing" or "Queued")
        {
            <section class="sor-ready">
                <div>
                    <strong>إنهاء المراجعة</strong>
                    <span>لا تتحول الجلسة إلى Ready إذا بقي حقل مطلوب غير معتمد أو مشكلة Blocking مفتوحة. الحقول الاختيارية لا تمنع الإكمال.</span>
                </div>
                @if (Model.CanReview)
                {
                    <form method="post" asp-page-handler="MarkReady">
                        <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                        <input type="hidden" name="SessionId" value="@Model.SessionId" />
                        <button type="submit"
                                class="zy-btn zy-btn--primary"
                                disabled="@(!Model.CanMarkReady)">
                            اعتماد المراجعة
                        </button>
                    </form>
                }
            </section>
        }
        @if (Model.Session.Status == "Ready")
        {
            <section class="sor-card sor-final">
                <div class="sor-section-head">
                    <div>
                        <h2>Final Preview — إنشاء الموظف</h2>
                        <p>هذه آخر نقطة قبل الكتابة إلى Employees. الشركة ثابتة ويُعاد فحص النطاق والتكرار عند الضغط على إنشاء.</p>
                    </div>
                    <span class="zy-badge zy-badge--info">Human Confirmed</span>
                </div>

                @if (Model.CanReview)
                {
                    <form method="post"
                          asp-page-handler="ReopenReview"
                          data-preserve-scroll
                          class="sor-reopen-review">
                        <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                        <input type="hidden" name="SessionId" value="@Model.SessionId" />
                        <button type="submit" class="zy-btn">
                            إعادة فتح المراجعة
                        </button>
                    </form>
                }

                @if (!Model.CanCreateEmployee)
                {
                    <div class="sor-alert sor-alert--danger">
                        تملك صلاحية المراجعة، لكن لا تملك People.Create. يجب أن ينفذ الإنشاء مستخدم مخول.
                    </div>
                }

                <form method="post" asp-page-handler="Finalize" enctype="multipart/form-data" class="sor-final-form">
                    <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                    <input type="hidden" name="SessionId" value="@Model.SessionId" />

                    <div class="sor-form-section">
                        <h3>صورة الموظف</h3>
                        <label class="sor-span-2">
                            <span>صورة الموظف</span>
                            <input asp-for="EmployeePhoto"
                                   type="file"
                                   accept="image/png,image/jpeg,image/webp" />
                            <small>PNG / JPG / WEBP · الحد الأقصى 5MB</small>
                        </label>
                    </div>

                    <div class="sor-form-section">
                        <h3>البيانات الأساسية</h3>
                        <label>
                            @if (Model.CodeSchemaActive)
                            {
                                <span>كود الموظف — تلقائي</span>
                                <input value="@Model.CodeSchemaPreview" readonly dir="ltr" aria-label="معاينة كود الموظف التلقائي" />
                                <input type="hidden" name="Finalize.EmployeeNo" value="" />
                                <small>سيتم حجز الرقم فعلياً عند إنشاء الموظف.</small>
                            }
                            else
                            {
                                <span>كود الموظف *</span>
                                <input asp-for="Finalize.EmployeeNo" />
                                <span asp-validation-for="Finalize.EmployeeNo" class="sor-validation"></span>
                            }
                        </label>
                        <label>
                            <span>الشركة</span>
                            <input value="@Model.CompanyName" readonly aria-readonly="true" />
                        </label>
                        <input type="hidden" asp-for="Finalize.FullName" />
                        <label>
                            <span>تاريخ الميلاد</span>
                            <input asp-for="Finalize.BirthDate" type="date" />
                        </label>
                        <label>
                            <span>البلد</span>
                            <select asp-for="Finalize.Country">
                                <option value="">—</option>
                                @foreach (var option in SmartAttendance.Web.Infrastructure.Ui.ZynoraEmployeeLookups.PrimaryCountries)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>الجنسية</span>
                            <select asp-for="Finalize.Nationality">
                                <option value="">—</option>
                                @foreach (var option in SmartAttendance.Web.Infrastructure.Ui.ZynoraEmployeeLookups.PrimaryNationalities)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>الجنس</span>
                            <select asp-for="Finalize.Gender">
                                <option value="">—</option>
                                <option value="Male">ذكر</option>
                                <option value="Female">أنثى</option>
                                <option value="Unspecified">غير محدد</option>
                            </select>
                        </label>
                        <label>
                            <span>مواطن</span>
                            <select asp-for="Finalize.IsCitizen">
                                <option value="true">مواطن</option>
                                <option value="false">غير مواطن (وافد)</option>
                            </select>
                        </label>
                    </div>

                    <div class="sor-form-section sor-name-languages">
                        <h3>اسم الموظف حسب لغات بيانات الشركة</h3>
                        <span asp-validation-for="EmployeeNameTranslations" class="sor-validation sor-span-2"></span>
                        @for (var index = 0; index < Model.EmployeeNameTranslations.Count; index++)
                        {
                            var language = Model.EmployeeNameTranslations[index];
                            <fieldset class="sor-language-card sor-span-2"
                                      dir="@language.Direction"
                                      lang="@language.CultureCode">
                                <legend>
                                    <strong>@language.NativeName</strong>
                                    <small>@language.CultureCode · @(language.IsDefault ? "اللغة الأساسية" : "لغة إضافية")</small>
                                </legend>
                                <input type="hidden" asp-for="EmployeeNameTranslations[index].CompanyId" />
                                <input type="hidden" asp-for="EmployeeNameTranslations[index].CultureCode" />
                                <input type="hidden" asp-for="EmployeeNameTranslations[index].NativeName" />
                                <input type="hidden" asp-for="EmployeeNameTranslations[index].Direction" />
                                <input type="hidden" asp-for="EmployeeNameTranslations[index].IsDefault" />
                                <input type="hidden" asp-for="EmployeeNameTranslations[index].IsRequired" />
                                <div class="sor-language-grid">
                                    <label>
                                        <span>الاسم الأول @(language.IsRequired ? "*" : "")</span>
                                        <input asp-for="EmployeeNameTranslations[index].FirstName" dir="@language.Direction" />
                                    </label>
                                    <label>
                                        <span>الاسم الثاني</span>
                                        <input asp-for="EmployeeNameTranslations[index].SecondName" dir="@language.Direction" />
                                    </label>
                                    <label>
                                        <span>الاسم الثالث</span>
                                        <input asp-for="EmployeeNameTranslations[index].ThirdName" dir="@language.Direction" />
                                    </label>
                                    <label>
                                        <span>اللقب @(language.IsRequired ? "*" : "")</span>
                                        <input asp-for="EmployeeNameTranslations[index].LastName" dir="@language.Direction" />
                                    </label>
                                </div>
                            </fieldset>
                        }
                    </div>

                    <div class="sor-form-section">
                        <h3>الهوية</h3>
                        <label>
                            <span>الرقم الوطني</span>
                            <input asp-for="Finalize.NationalId" autocomplete="off" />
                            <span asp-validation-for="Finalize.NationalId" class="sor-validation"></span>
                        </label>
                        <label>
                            <span>الرقم العائلي</span>
                            <input asp-for="Finalize.FamilyNumber" autocomplete="off" />
                            <span asp-validation-for="Finalize.FamilyNumber" class="sor-validation"></span>
                        </label>
                        <label>
                            <span>رقم الجواز</span>
                            <input asp-for="Finalize.PassportNo" autocomplete="off" />
                            <span asp-validation-for="Finalize.PassportNo" class="sor-validation"></span>
                        </label>
                    </div>

                    <div class="sor-form-section">
                        <h3>المعلومات الشخصية والإقامة</h3>
                        <label>
                            <span>الحالة الاجتماعية</span>
                            <select asp-for="Finalize.MaritalStatus">
                                <option value="">—</option>
                                <option value="Single">أعزب</option>
                                <option value="Married">متزوج</option>
                                <option value="Divorced">مطلق</option>
                                <option value="Widowed">أرمل</option>
                                <option value="Separated">منفصل</option>
                            </select>
                        </label>
                        <label>
                            <span>الديانة</span>
                            <select asp-for="Finalize.Religion">
                                <option value="">—</option>
                                @if (!string.IsNullOrWhiteSpace(Model.Finalize.Religion) &&
                                     !Model.ReligionOptions.Contains(Model.Finalize.Religion, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@Model.Finalize.Religion">@Model.Finalize.Religion</option>
                                }
                                @foreach (var religion in Model.ReligionOptions)
                                {
                                    <option value="@religion">@religion</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>البلد الأم</span>
                            <select asp-for="Finalize.MotherCountry" id="sor-mother-country">
                                <option value="">—</option>
                                @foreach (var country in SmartAttendance.Web.Infrastructure.Ui.ZynoraEmployeeGeoLookups.Countries)
                                {
                                    <option value="@country.Value">@country.Label</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>المدينة الأم</span>
                            <select asp-for="Finalize.MotherCity" id="sor-mother-city">
                                <option value="">—</option>
                                @foreach (var city in SmartAttendance.Web.Infrastructure.Ui.ZynoraEmployeeGeoLookups.Cities)
                                {
                                    <option value="@city.Value" data-country="@city.CountryValue">@city.Label</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>الكفيل</span>
                            <select asp-for="Finalize.SponsorName">
                                <option value="">بدون كفيل</option>
                                @if (!string.IsNullOrWhiteSpace(Model.Finalize.SponsorName) &&
                                     !Model.SponsorOptions.Contains(Model.Finalize.SponsorName, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@Model.Finalize.SponsorName">@Model.Finalize.SponsorName</option>
                                }
                                @foreach (var sponsor in Model.SponsorOptions)
                                {
                                    <option value="@sponsor">@sponsor</option>
                                }
                            </select>
                        </label>
                    </div>

                    <div class="sor-form-section">
                        <h3>البيانات الوظيفية</h3>
                        <label>
                            <span>تاريخ التعيين *</span>
                            <input asp-for="Finalize.HireDate" type="date" />
                        </label>
                        <label>
                            <span>تاريخ المباشرة الفعلية</span>
                            <input asp-for="Finalize.JoiningDate" type="date" />
                        </label>
                        <label>
                            <span>موقع العمل *</span>
                            <select asp-for="Finalize.BranchId" id="sor-branch">
                                <option value="0">اختر موقع العمل</option>
                                @foreach (var branch in Model.Branches)
                                {
                                    <option value="@branch.Id">@branch.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Finalize.BranchId" class="sor-validation"></span>
                        </label>
                        <label>
                            <span>القسم *</span>
                            <input asp-for="Finalize.DepartmentId"
                                   type="hidden"
                                   id="sor-department-value" />
                            <select id="sor-department"
                                    name="departmentSelectionId"
                                    aria-label="Department">
                                <option value="0">اختر القسم</option>
                                @foreach (var department in Model.Departments)
                                {
                                    <option value="@department.Id" data-branch="@department.BranchId">@department.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Finalize.DepartmentId" class="sor-validation"></span>
                        </label>
                        <label>
                            <span>المنصب</span>
                            <select asp-for="Finalize.PositionId">
                                <option value="">—</option>
                                @foreach (var position in Model.Positions)
                                {
                                    <option value="@position.Id">@position.Name</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>نوع الدوام</span>
                            <select asp-for="Finalize.WorkType">
                                <option value="">—</option>
                                @if (!string.IsNullOrWhiteSpace(Model.Finalize.WorkType) &&
                                     !Model.WorkTypeOptions.Contains(Model.Finalize.WorkType, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@Model.Finalize.WorkType">@Model.Finalize.WorkType</option>
                                }
                                @foreach (var workType in Model.WorkTypeOptions)
                                {
                                    <option value="@workType">@workType</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>الدرجة الوظيفية</span>
                            <select asp-for="Finalize.JobGrade">
                                <option value="">—</option>
                                @if (!string.IsNullOrWhiteSpace(Model.Finalize.JobGrade) &&
                                     !Model.GradeOptions.Contains(Model.Finalize.JobGrade, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@Model.Finalize.JobGrade">@Model.Finalize.JobGrade</option>
                                }
                                @foreach (var grade in Model.GradeOptions)
                                {
                                    <option value="@grade">@grade</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>المدير المباشر</span>
                            <select asp-for="Finalize.DirectManagerId">
                                <option value="">— بدون مدير —</option>
                                @foreach (var manager in Model.ManagerOptions)
                                {
                                    <option value="@manager.Id">@manager.FullName — @manager.EmployeeNo</option>
                                }
                            </select>
                        </label>
                        @if (Model.CanEditCompensation)
                        {
                            <label>
                                <span>الراتب الأساسي</span>
                                <input asp-for="BasicSalary"
                                       type="text"
                                       inputmode="decimal"
                                       dir="ltr"
                                       autocomplete="off"
                                       data-zynora-salary-format
                                       data-zynora-salary-raw="@(Model.BasicSalary?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
                                       placeholder="0" />
                                <span asp-validation-for="BasicSalary" class="sor-validation"></span>
                            </label>
                        }
                        <label>
                            <span>توقيع الموظف</span>
                            <input asp-for="EmployeeSignature"
                                   type="file"
                                   accept="image/png,image/jpeg,image/webp" />
                            <small>PNG / JPG / WEBP · الحد الأقصى 2MB</small>
                        </label>
                    </div>

                    <div class="sor-form-section">
                        <h3>بيانات الاتصال</h3>
                        <label>
                            <span>الهاتف</span>
                            <input asp-for="Finalize.Phone" autocomplete="tel" />
                        </label>
                        <label>
                            <span>امتداد الهاتف</span>
                            <input asp-for="Finalize.PhoneExtension" />
                        </label>
                        <label>
                            <span>البريد الإلكتروني للعمل</span>
                            <input asp-for="Finalize.Email" type="email" autocomplete="email" />
                            <span asp-validation-for="Finalize.Email" class="sor-validation"></span>
                        </label>
                        <label>
                            <span>البريد الشخصي</span>
                            <input asp-for="Finalize.PersonalEmail" type="email" />
                            <span asp-validation-for="Finalize.PersonalEmail" class="sor-validation"></span>
                        </label>
                    </div>

                    @if (Model.ProfileDynamicSections.Any(section => section.Fields.Count > 0))
                    {
                        <div class="sor-form-section sor-dynamic-profile">
                            <h3>حقول ملف الموظف</h3>
                            @foreach (var profileSection in Model.ProfileDynamicSections.Where(section => section.Fields.Count > 0))
                            {
                                <h4 class="sor-span-2">@profileSection.Label</h4>
                                @foreach (var field in profileSection.Fields)
                                {
                                    var inputId = $"OnboardingProfileCustomValues_{field.FieldKey}";
                                    var requiredAttribute = field.IsRequired ? "required" : null;
                                    <label class="@(field.IsTextArea ? "sor-span-2" : "")">
                                        <span>@field.FieldLabel @(field.IsRequired ? "*" : "")</span>
                                        @if (field.IsTextArea)
                                        {
                                            <textarea id="@inputId"
                                                      name="ProfileCustomValues[@field.FieldKey]"
                                                      required="@requiredAttribute"
                                                      rows="3">@field.FieldValue</textarea>
                                        }
                                        else if (field.IsSelect)
                                        {
                                            <select id="@inputId"
                                                    name="ProfileCustomValues[@field.FieldKey]"
                                                    required="@requiredAttribute">
                                                <option value="">اختر</option>
                                                @foreach (var option in field.Options)
                                                {
                                                    <option value="@option" selected="@(option == field.FieldValue ? "selected" : null)">@option</option>
                                                }
                                            </select>
                                        }
                                        else if (field.IsCheckbox)
                                        {
                                            <input id="@inputId"
                                                   name="ProfileCustomValues[@field.FieldKey]"
                                                   type="checkbox"
                                                   value="true"
                                                   checked="@(field.IsCheckedValue ? "checked" : null)" />
                                        }
                                        else
                                        {
                                            <input id="@inputId"
                                                   name="ProfileCustomValues[@field.FieldKey]"
                                                   type="@field.InputType"
                                                   value="@field.FieldValue"
                                                   required="@requiredAttribute" />
                                        }
                                    </label>
                                }
                            }
                        </div>
                    }

                    <div class="sor-final-warning">
                        <strong>لن ينشئ ZYNORA الموظف تلقائياً.</strong>
                        <span>عند الضغط على إنشاء الموظف سيعاد فحص Data Scope وDuplicate Policy والمستندات المطلوبة، ثم تتم العملية داخل Transaction واحدة.</span>
                    </div>

                    <div class="sor-final-actions">
                        <a asp-page="./SmartOnboarding"
                           asp-route-CompanyId="@Model.CompanyId"
                           asp-route-SessionId="@Model.SessionId"
                           class="zy-btn">رجوع للمستندات</a>
                        <button type="submit"
                                class="zy-btn zy-btn--primary"
                                disabled="@(!Model.CanCreateEmployee)">
                            إنشاء الموظف وربط المستندات
                        </button>
                    </div>
                </form>
            </section>
        }
        else if (Model.Session.Status == "Completed" && Model.Session.CreatedEmployeeId is > 0)
        {
            <section class="sor-completed">
                <div>
                    <strong>Smart Onboarding مكتمل</strong>
                    <span>تم إنشاء الموظف وربط المستندات بنجاح.</span>
                </div>
                <a asp-page="./Profile"
                   asp-route-id="@Model.Session.CreatedEmployeeId"
                   class="zy-btn zy-btn--primary">فتح ملف الموظف</a>
            </section>
        }

        <dialog class="sor-preview-dialog"
                data-review-preview-dialog
                aria-labelledby="sor-preview-title">
            <div class="sor-preview-shell">
                <header class="sor-preview-head">
                    <div>
                        <span>Protected Document Preview</span>
                        <strong id="sor-preview-title"
                                data-review-preview-title>معاينة المستند</strong>
                    </div>
                    <button type="button"
                            class="zy-btn"
                            data-review-preview-close>إغلاق</button>
                </header>
                <div class="sor-preview-body">
                    <img data-review-preview-image
                         class="sor-preview-image"
                         alt="معاينة المستند المحمي"
                         hidden />
                    <iframe data-review-preview-frame
                            title="معاينة المستند المحمي"></iframe>
                </div>
                <footer class="sor-preview-foot">
                    المعاينة محمية ولا تكشف مسار التخزين الفعلي.
                </footer>
            </div>
        </dialog>
    }
</div>

@section Scripts {
    <script src="~/js/smart-onboarding-review.js" asp-append-version="true"></script>
    <script src="~/js/zynora-salary-input.js" asp-append-version="true"></script>
    <script>
        (() => {
            const fields = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.FieldSettings.Values.Select(s => new
                {
                    k = s.Key,
                    v = s.IsVisible,
                    r = Model.RequiredFieldKeys.Contains(s.Key),
                    l = s.CustomLabel,
                    o = s.DisplayOrder
                })));
            const skipEmployeeNoRequired = @(Model.CodeSchemaActive ? "true" : "false");

            fields.forEach(f => {
                const input =
                    document.querySelector('[name="Finalize.' + f.k + '"]') ||
                    document.querySelector('[name="' + f.k + '"]');
                if (!input || input.type === "hidden") return;

                const box = input.closest("label") || input.parentElement;
                if (!box) return;
                const label = box.querySelector("span");

                if (!f.v) {
                    box.style.setProperty("display", "none", "important");
                    input.removeAttribute("required");
                    return;
                }

                if (f.l && label) label.textContent = f.l;
                if (f.r && !(f.k === "EmployeeNo" && skipEmployeeNoRequired)) {
                    input.setAttribute("required", "required");
                    if (label && !label.querySelector(".nx-req-star")) {
                        const star = document.createElement("span");
                        star.className = "nx-req-star";
                        star.textContent = " *";
                        star.style.cssText = "color:#f87171;font-weight:900";
                        label.appendChild(star);
                    }
                }
            });
        })();
    </script>
}

@page
@model SmartAttendance.Web.Pages.Branches.IndexModel

@section Styles {
    <link rel="stylesheet" href="~/css/zynora-setup-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/zynora-branches-theme-v2.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "مواقع العمل والفروع";

    var companies =
        Model.Companies.ToList();

    var firstCompanyId =
        companies.FirstOrDefault()?.Id;
}

<div class="zynora-setup-page" data-setup-page="branches">
    <section class="zynora-setup-hero">
        <div>
            <span class="zynora-setup-kicker">&#x0627;&#x0644;&#x062E;&#x0637;&#x0648;&#x0629; &#x0627;&#x0644;&#x062B;&#x0627;&#x0646;&#x064A;&#x0629;</span>
            <h1>&#x0645;&#x0648;&#x0627;&#x0642;&#x0639; &#x0627;&#x0644;&#x0639;&#x0645;&#x0644; &#x0648;&#x0627;&#x0644;&#x0641;&#x0631;&#x0648;&#x0639;</h1>
            <p>&#x0623;&#x0636;&#x0641; &#x0627;&#x0644;&#x0645;&#x0643;&#x062A;&#x0628; &#x0627;&#x0644;&#x0631;&#x0626;&#x064A;&#x0633;&#x064A;&#x060C; &#x0627;&#x0644;&#x0641;&#x0631;&#x0648;&#x0639;&#x060C; &#x0627;&#x0644;&#x0645;&#x0648;&#x0627;&#x0642;&#x0639; &#x0627;&#x0644;&#x062A;&#x0634;&#x063A;&#x064A;&#x0644;&#x064A;&#x0629;&#x060C; &#x0627;&#x0644;&#x0645;&#x0634;&#x0627;&#x0631;&#x064A;&#x0639; &#x0623;&#x0648; &#x0646;&#x0642;&#x0627;&#x0637; &#x0627;&#x0644;&#x0639;&#x0645;&#x0644;.</p>
        </div>

        <div class="zynora-setup-actions">
            <a asp-page="./Import" class="btn-secondary nx-setup-btn nx-setup-btn-secondary">&#x0627;&#x0633;&#x062A;&#x064A;&#x0631;&#x0627;&#x062F; Excel</a>
            <button type="button"
                    class="btn-primary nx-setup-btn nx-setup-btn-primary"
                    data-nx-setup-open="branch-create-modal"
                    @(Model.Companies.Any() ? null : "disabled")>
                + &#x0625;&#x0636;&#x0627;&#x0641;&#x0629; &#x0645;&#x0648;&#x0642;&#x0639; &#x0639;&#x0645;&#x0644;
            </button>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success nx-setup-alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <section class="table-card zynora-setup-card">
        <div class="zynora-setup-card-head">
            <div>
                <span>&#x0633;&#x062C;&#x0644; &#x0645;&#x0648;&#x0627;&#x0642;&#x0639; &#x0627;&#x0644;&#x0639;&#x0645;&#x0644;</span>
                <strong>&#x0627;&#x0644;&#x0641;&#x0631;&#x0648;&#x0639; &#x0648;&#x0627;&#x0644;&#x0645;&#x0648;&#x0627;&#x0642;&#x0639; &#x0627;&#x0644;&#x0645;&#x0639;&#x0631;&#x0641;&#x0629; &#x062F;&#x0627;&#x062E;&#x0644; &#x0627;&#x0644;&#x0646;&#x0638;&#x0627;&#x0645;</strong>
            </div>
            <small>&#x0643;&#x0644; &#x0642;&#x0633;&#x0645; &#x0648;&#x0645;&#x0648;&#x0638;&#x0641; &#x064A;&#x0631;&#x062A;&#x0628;&#x0637; &#x0628;&#x0645;&#x0648;&#x0642;&#x0639; &#x0639;&#x0645;&#x0644; &#x0645;&#x062D;&#x062F;&#x062F;.</small>
        </div>

        <form method="get" class="search-form zynora-setup-search">
            <input type="search"
                   name="SearchTerm"
                   value="@Model.SearchTerm"
                   placeholder="&#x0627;&#x0628;&#x062D;&#x062B; &#x0639;&#x0646; &#x0627;&#x0633;&#x0645; &#x0627;&#x0644;&#x0645;&#x0648;&#x0642;&#x0639; &#x0623;&#x0648; &#x0627;&#x0644;&#x0643;&#x0648;&#x062F;..." />

            <button type="submit" class="btn-primary nx-setup-btn nx-setup-btn-primary">&#x0628;&#x062D;&#x062B;</button>
            <a asp-page="./Index" class="btn-secondary nx-setup-btn nx-setup-btn-secondary">&#x0645;&#x0633;&#x062D;</a>
        </form>

        <div class="zynora-setup-table-wrap">
            <table class="data-table zynora-setup-table">
                <thead>
                    <tr>
                        <th>&#x0645;&#x0648;&#x0642;&#x0639; &#x0627;&#x0644;&#x0639;&#x0645;&#x0644;</th>
                        <th>&#x0627;&#x0644;&#x0634;&#x0631;&#x0643;&#x0629;</th>
                        <th>&#x0627;&#x0644;&#x0639;&#x0646;&#x0648;&#x0627;&#x0646;</th>
                        <th>&#x0627;&#x0644;&#x062D;&#x0627;&#x0644;&#x0629;</th>
                        <th>&#x0627;&#x0644;&#x0625;&#x062C;&#x0631;&#x0627;&#x0621;&#x0627;</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Branches.Any())
                    {
                        foreach (var branch in Model.Branches)
                        {
                            <tr>
                                <td>
                                    <strong class="nx-setup-title">@branch.Name</strong>
                                </td>
                                <td>@branch.CompanyName</td>
                                <td>@branch.Address</td>
                                <td>
                                    <span class="nx-setup-status @(branch.IsActive ? "is-active" : "is-inactive")">
                                        @(branch.IsActive ? "\u0641\u0639\u0627\u0644" : "\u063A\u064A\u0631 \u0641\u0639\u0627\u0644")
                                    </span>
                                </td>
                                <td>
                                    <div class="nx-setup-row-actions">
                                        <button type="button"
        class="btn-table btn-edit"
        data-branch-edit-id="@branch.Id"
        data-branch-edit-company-id="@branch.CompanyId"
        data-branch-edit-name="@branch.Name"
        data-branch-edit-address="@branch.Address"
        data-branch-edit-active="@(branch.IsActive ? "true" : "false")"
        data-nx-setup-open="branch-edit-modal">
    تعديل
</button>
                                        <button type="button"
        class="btn-table btn-delete"
        data-branch-delete-id="@branch.Id"
        data-branch-delete-name="@branch.Name"
        data-branch-delete-company="@branch.CompanyName"
        data-branch-delete-address="@branch.Address"
        data-branch-delete-status="@(branch.IsActive ? "فعال" : "غير فعال")"
        data-nx-setup-open="branch-delete-modal">
    حذف
</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="nx-setup-empty">&#x0644;&#x0627; &#x062A;&#x0648;&#x062C;&#x062F; &#x0645;&#x0648;&#x0627;&#x0642;&#x0639; &#x0639;&#x0645;&#x0644; &#x0645;&#x0633;&#x062C;&#x0644;&#x0629; &#x062D;&#x0627;&#x0644;&#x064A;&#x0627;.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="nx-setup-modal" id="branch-create-modal" aria-hidden="true">
    <div class="nx-setup-modal__panel" role="dialog" aria-modal="true" aria-labelledby="branch-create-title">
        <button type="button" class="nx-setup-modal__close" data-nx-setup-close aria-label="Close">&times;</button>

        <div class="nx-setup-modal__head">
            <span>&#x0645;&#x0648;&#x0627;&#x0642;&#x0639; &#x0627;&#x0644;&#x0639;&#x0645;&#x0644;</span>
            <h2 id="branch-create-title">&#x0625;&#x0636;&#x0627;&#x0641;&#x0629; &#x0645;&#x0648;&#x0642;&#x0639; &#x0639;&#x0645;&#x0644; &#x062C;&#x062F;&#x064A;&#x062F;</h2>
            <p>&#x0627;&#x0631;&#x0628;&#x0637; &#x0627;&#x0644;&#x0645;&#x0648;&#x0642;&#x0639; &#x0628;&#x0627;&#x0644;&#x0634;&#x0631;&#x0643;&#x0629; &#x062D;&#x062A;&#x0649; &#x064A;&#x0645;&#x0643;&#x0646; &#x0625;&#x0636;&#x0627;&#x0641;&#x0629; &#x0627;&#x0644;&#x0623;&#x0642;&#x0633;&#x0627;&#x0645; &#x0648;&#x0627;&#x0644;&#x0645;&#x0648;&#x0638;&#x0641;&#x064A;&#x0646; &#x0644;&#x0627;&#x062D;&#x0642;&#x0627;.</p>
        </div>

        @if (!Model.Companies.Any())
        {
            <div class="nx-setup-modal-note">&#x064A;&#x062C;&#x0628; &#x0625;&#x0636;&#x0627;&#x0641;&#x0629; &#x0634;&#x0631;&#x0643;&#x0629; &#x0623;&#x0648;&#x0644;&#x0627; &#x0642;&#x0628;&#x0644; &#x0625;&#x0646;&#x0634;&#x0627;&#x0621; &#x0645;&#x0648;&#x0642;&#x0639; &#x0639;&#x0645;&#x0644;.</div>
        }

        <form method="post" asp-page="./Create" class="nx-setup-modal-form">
            <div class="nx-setup-form-grid">
                <label class="nx-setup-field">
                    <span>&#x0627;&#x0644;&#x0634;&#x0631;&#x0643;&#x0629;</span>
                    <select name="Branch.CompanyId" data-zynora-select="true" required>
                        <option value="">&#x0627;&#x062E;&#x062A;&#x0631; &#x0627;&#x0644;&#x0634;&#x0631;&#x0643;&#x0629;</option>
                        @foreach (var company in Model.Companies)
                        {
                            <option value="@company.Id">@company.Name</option>
                        }
                    </select>
                </label>

                <label class="nx-setup-field">
                    <span>&#x0627;&#x0633;&#x0645; &#x0645;&#x0648;&#x0642;&#x0639; &#x0627;&#x0644;&#x0639;&#x0645;&#x0644;</span>
                    <input name="Branch.Name" autocomplete="off" placeholder="Main Office" required />
                </label>

                <label class="nx-setup-field nx-setup-field-wide">
                    <span>&#x0627;&#x0644;&#x0639;&#x0646;&#x0648;&#x0627;&#x0646;</span>
                    <input name="Branch.Address" autocomplete="off" placeholder="Address or geographic location" />
                </label>
            </div>

            <div class="nx-setup-modal__actions">
                <button type="button" class="nx-setup-btn nx-setup-btn-secondary" data-nx-setup-close>&#x0625;&#x0644;&#x063A;&#x0627;&#x0621;</button>
                <button type="submit"
                        class="nx-setup-btn nx-setup-btn-primary"
                        @(Model.Companies.Any() ? null : "disabled")>
                    &#x062D;&#x0641;&#x0638; &#x0645;&#x0648;&#x0642;&#x0639; &#x0627;&#x0644;&#x0639;&#x0645;&#x0644;
                </button>
            </div>
        </form>
    </div>
</div>


<!-- ========================================================
     ZYNORA_BRANCH_MODAL_PARITY_V1
     Same interaction/design model as Departments
     ======================================================== -->


<!-- ========================================================
     EDIT MODAL
     ======================================================== -->

<div class="nx-setup-modal"
     id="branch-edit-modal"
     style="background:rgba(4,10,20,.32)!important;backdrop-filter:blur(7px) saturate(115%)!important;-webkit-backdrop-filter:blur(7px) saturate(115%)!important;"
     aria-hidden="true">

    <div class="nx-setup-modal__panel zy-department-edit-popup zy-branch-edit-popup"
         role="dialog"
         aria-modal="true"
         aria-labelledby="branch-edit-title">

        <button type="button"
                class="nx-setup-modal__close"
                data-nx-setup-close
                aria-label="إغلاق">
            &times;
        </button>

        <div class="nx-setup-modal__head">

            <span>مواقع العمل</span>

            <h2 id="branch-edit-title">
                تعديل موقع العمل
            </h2>

            <p>
                حدّث بيانات موقع العمل والشركة والحالة.
            </p>

        </div>

        <form method="post"
              asp-page="./Edit"
              class="nx-setup-modal-form"
              id="branch-edit-popup-form">

            <input type="hidden"
                   name="Branch.Id"
                   id="editBranchId" />

            <div class="nx-setup-form-grid">

                <label class="nx-setup-field">

                    <span>الشركة</span>

                    <select name="Branch.CompanyId"
                            id="editBranchCompanyId"
                            required>

                        @foreach (var company in companies)
                        {
                            <option value="@company.Id">
                                @company.Name
                            </option>
                        }

                    </select>

                </label>


                <label class="nx-setup-field">

                    <span>اسم موقع العمل</span>

                    <input type="text"
                           name="Branch.Name"
                           id="editBranchName"
                           autocomplete="off"
                           required />

                </label>


                <label class="nx-setup-field nx-setup-field-wide">

                    <span>العنوان</span>

                    <input type="text"
                           name="Branch.Address"
                           id="editBranchAddress"
                           autocomplete="off" />

                </label>


                <!-- نفس Style حالة القسم -->
                <label class="nx-setup-check zy-department-edit-active">

                    <input type="hidden"
                           name="Branch.IsActive"
                           value="false" />

                    <input type="checkbox"
                           name="Branch.IsActive"
                           id="editBranchIsActive"
                           value="true" />

                    <span>موقع العمل فعال</span>

                </label>

            </div>


            <div class="nx-setup-modal__actions">

                <button type="button"
                        class="nx-setup-btn nx-setup-btn-secondary"
                        data-nx-setup-close>
                    إلغاء
                </button>

                <button type="submit"
                        class="nx-setup-btn nx-setup-btn-primary">
                    حفظ التعديلات
                </button>

            </div>

        </form>

    </div>

</div>



<!-- ========================================================
     DELETE MODAL
     ======================================================== -->

<div class="nx-setup-modal"
     id="branch-delete-modal"
     style="background:rgba(4,10,20,.32)!important;backdrop-filter:blur(7px) saturate(115%)!important;-webkit-backdrop-filter:blur(7px) saturate(115%)!important;"
     aria-hidden="true">

    <div class="nx-setup-modal__panel zy-department-delete-popup zy-branch-delete-popup"
         role="dialog"
         aria-modal="true"
         aria-labelledby="branch-delete-title">

        <button type="button"
                class="nx-setup-modal__close"
                data-nx-setup-close
                aria-label="إغلاق">
            &times;
        </button>


        <div class="nx-setup-modal__head">

            <span>مواقع العمل</span>

            <h2 id="branch-delete-title">
                حذف موقع العمل
            </h2>

            <p>
                تأكد من بيانات موقع العمل قبل تنفيذ الحذف.
            </p>

        </div>


        <form method="post"
              asp-page="./Delete"
              class="nx-setup-modal-form"
              id="branch-delete-popup-form">

            <input type="hidden"
                   name="id"
                   id="deleteBranchId" />


            <!-- نفس Warning الأقسام -->
            <div class="zy-department-delete-warning">

                <strong>
                    هل تريد حذف موقع العمل؟
                </strong>

                <span>
                    لا يمكن التراجع عن هذه العملية بعد تنفيذ الحذف.
                </span>

            </div>


            <!-- نفس Summary الأقسام -->
            <div class="zy-department-delete-summary">

                <div>
                    <span>اسم موقع العمل</span>
                    <strong id="deleteBranchName">—</strong>
                </div>

                <div>
                    <span>الشركة</span>
                    <strong id="deleteBranchCompany">—</strong>
                </div>

                <div>
                    <span>العنوان</span>
                    <strong id="deleteBranchAddress">—</strong>
                </div>

                <div>
                    <span>الحالة</span>
                    <strong id="deleteBranchStatus">—</strong>
                </div>

            </div>


            <div class="nx-setup-modal__actions">

                <button type="button"
                        class="nx-setup-btn nx-setup-btn-secondary"
                        data-nx-setup-close>
                    إلغاء
                </button>

                <button type="submit"
                        class="nx-setup-btn zy-department-delete-confirm">
                    حذف موقع العمل
                </button>

            </div>

        </form>

    </div>

</div>


<script>
(() => {

    /* =====================================================
       EDIT — same model as Departments
       ===================================================== */

    const editId =
        document.getElementById("editBranchId");

    const editCompany =
        document.getElementById("editBranchCompanyId");

    const editName =
        document.getElementById("editBranchName");

    const editAddress =
        document.getElementById("editBranchAddress");

    const editActive =
        document.getElementById("editBranchIsActive");


    document
        .querySelectorAll("[data-branch-edit-id]")
        .forEach(button => {

            button.addEventListener(
                "click",
                () => {

                    if (editId)
                        editId.value =
                            button.dataset.branchEditId || "";

                    if (editCompany)
                        editCompany.value =
                            button.dataset.branchEditCompanyId || "";

                    if (editName)
                        editName.value =
                            button.dataset.branchEditName || "";

                    if (editAddress)
                        editAddress.value =
                            button.dataset.branchEditAddress || "";

                    if (editActive)
                        editActive.checked =
                            button.dataset.branchEditActive === "true";


                    if (window.ZynoraSelect &&
                        typeof window.ZynoraSelect.refresh === "function" &&
                        editCompany) {

                        window.ZynoraSelect.refresh(editCompany);
                    }

                });
        });



    /* =====================================================
       DELETE — same model as Departments
       ===================================================== */

    const deleteId =
        document.getElementById("deleteBranchId");

    const deleteName =
        document.getElementById("deleteBranchName");

    const deleteCompany =
        document.getElementById("deleteBranchCompany");

    const deleteAddress =
        document.getElementById("deleteBranchAddress");

    const deleteStatus =
        document.getElementById("deleteBranchStatus");


    document
        .querySelectorAll("[data-branch-delete-id]")
        .forEach(button => {

            button.addEventListener(
                "click",
                () => {

                    if (deleteId)
                        deleteId.value =
                            button.dataset.branchDeleteId || "";

                    if (deleteName)
                        deleteName.textContent =
                            button.dataset.branchDeleteName || "—";

                    if (deleteCompany)
                        deleteCompany.textContent =
                            button.dataset.branchDeleteCompany || "—";

                    if (deleteAddress)
                        deleteAddress.textContent =
                            button.dataset.branchDeleteAddress || "—";

                    if (deleteStatus)
                        deleteStatus.textContent =
                            button.dataset.branchDeleteStatus || "—";

                });
        });

})();
</script>

<!-- ZYNORA_BRANCH_MODAL_PARITY_V1_END -->



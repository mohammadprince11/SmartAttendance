@page
@model SmartAttendance.Web.Pages.Account.FarewellModel
@{
    Layout = null;
}
<!doctype html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>إشعار الوداع — ZYNORA</title>
    <link rel="stylesheet" href="~/css/zynora-design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/farewell.css" asp-append-version="true" />
</head>
<body class="zy-app zy-scope zy-ui-contract">
    <main class="farewell-page">
        <section class="zy-card">
            <h1>إشعار الوداع</h1>
            <p>هذا الوصول مخصص لإشعار الوداع فقط. بقية صفحات النظام غير متاحة.</p>
            @if (Model.Messages.Count == 0)
            {
                <div class="zy-empty">لا يوجد إشعار وداع متاح حالياً.</div>
            }
            @foreach (var message in Model.Messages)
            {
                <p class="farewell-message">@message</p>
            }
            <p>ينتهي الوصول تلقائياً عند @Model.AccessEndsAtUtc.ToOffset(TimeSpan.FromHours(3)).ToString("yyyy-MM-dd HH:mm") بتوقيت بغداد.</p>
            <a href="/Account/Logout" class="zy-btn zy-btn--secondary">تسجيل الخروج</a>
        </section>
    </main>
    <link rel="stylesheet" href="~/css/zynora-unified-pages.css" asp-append-version="true" />
    <script src="~/js/zynora-unified-pages.js" asp-append-version="true" defer></script>
</body>
</html>

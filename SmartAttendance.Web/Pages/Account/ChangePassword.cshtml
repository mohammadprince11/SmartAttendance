@page
@model SmartAttendance.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}
<link rel="stylesheet" href="~/css/pages/changepassword-c91cdc5956.css" asp-append-version="true" />

<section dir="rtl" class="zyu-413e6c239273">
    <header class="zyu-4b545251f185">
        <h1 class="zyu-dc51d6b86e65">تغيير كلمة المرور</h1>
        <p class="zyu-c8bdd9743ae3">حدّث كلمة مرور دخولك. ستحتاجها في المرّة القادمة لتسجيل الدخول.</p>
    </header>

    @if (Model.Success)
    {
        <div class="zyu-bef5c26b68bb">
            ✅ تم تغيير كلمة المرور بنجاح.
            <div class="zyu-0ee7f66ad9c0">
                <a href="@Model.HomePath" class="zyu-f4d930c7defe">المتابعة إلى النظام ←</a>
            </div>
        </div>
    }
    else
    {
        @if (Model.IsForced)
        {
            <div class="zyu-921cfe0ee66f">
                🔒 لأسباب أمنية، يجب تعيين كلمة مرورٍ جديدة قبل متابعة استخدام النظام.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="zyu-ec8000b5aa06">
                @Model.ErrorMessage
            </div>
        }

        <form method="post"
              class="zyu-8132948aef2d">
            <label class="zyu-5ecf86738409">
                كلمة المرور الحالية
                <input type="password" name="CurrentPassword" dir="ltr" autocomplete="current-password" required
                       class="zyu-39bc8ce11f8c" />
            </label>
            <label class="zyu-5ecf86738409">
                كلمة المرور الجديدة
                <input type="password" name="NewPassword" dir="ltr" autocomplete="new-password" minlength="8" required
                       class="zyu-39bc8ce11f8c" />
            </label>
            <label class="zyu-5ecf86738409">
                تأكيد كلمة المرور الجديدة
                <input type="password" name="ConfirmPassword" dir="ltr" autocomplete="new-password" required
                       class="zyu-39bc8ce11f8c" />
            </label>
            <p class="zyu-71613a99d34f">8 محارف على الأقل. يُفضّل مزج أحرف وأرقام.</p>
            <button type="submit"
                    class="zyu-8a56a52cfc69">
                تغيير كلمة المرور
            </button>
        </form>
    }
</section>

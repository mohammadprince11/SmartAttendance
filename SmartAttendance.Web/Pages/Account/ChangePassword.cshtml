@page
@model SmartAttendance.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<section dir="rtl" style="max-width:520px;margin:32px auto;padding:0 16px">
    <header style="margin-bottom:18px">
        <h1 style="font-size:22px;font-weight:800;margin:0 0 6px">تغيير كلمة المرور</h1>
        <p style="color:var(--muted,#6b7280);margin:0">حدّث كلمة مرور دخولك. ستحتاجها في المرّة القادمة لتسجيل الدخول.</p>
    </header>

    @if (Model.Success)
    {
        <div style="border:1px solid rgba(34,197,94,.4);background:rgba(34,197,94,.10);color:#15803d;border-radius:12px;padding:14px 16px">
            ✅ تم تغيير كلمة المرور بنجاح.
            <div style="margin-top:12px">
                <a href="@Model.HomePath" style="color:var(--accent,#0ea5a5);font-weight:800;text-decoration:none">المتابعة إلى النظام ←</a>
            </div>
        </div>
    }
    else
    {
        @if (Model.IsForced)
        {
            <div style="border:1px solid rgba(245,158,11,.45);background:rgba(245,158,11,.12);color:#92400e;border-radius:12px;padding:14px 16px;margin-bottom:14px">
                🔒 لأسباب أمنية، يجب تعيين كلمة مرورٍ جديدة قبل متابعة استخدام النظام.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div style="border:1px solid rgba(239,68,68,.4);background:rgba(239,68,68,.10);color:#b91c1c;border-radius:12px;padding:14px 16px;margin-bottom:14px">
                @Model.ErrorMessage
            </div>
        }

        <form method="post"
              style="background:var(--card,#fff);border:1px solid var(--border,#e5e7eb);border-radius:16px;padding:20px;display:flex;flex-direction:column;gap:14px">
            <label style="display:flex;flex-direction:column;gap:6px;font-weight:700">
                كلمة المرور الحالية
                <input type="password" name="CurrentPassword" dir="ltr" autocomplete="current-password" required
                       style="padding:10px 12px;border:1px solid var(--border,#d1d5db);border-radius:10px" />
            </label>
            <label style="display:flex;flex-direction:column;gap:6px;font-weight:700">
                كلمة المرور الجديدة
                <input type="password" name="NewPassword" dir="ltr" autocomplete="new-password" minlength="8" required
                       style="padding:10px 12px;border:1px solid var(--border,#d1d5db);border-radius:10px" />
            </label>
            <label style="display:flex;flex-direction:column;gap:6px;font-weight:700">
                تأكيد كلمة المرور الجديدة
                <input type="password" name="ConfirmPassword" dir="ltr" autocomplete="new-password" required
                       style="padding:10px 12px;border:1px solid var(--border,#d1d5db);border-radius:10px" />
            </label>
            <p style="color:var(--muted,#6b7280);font-size:13px;margin:0">8 محارف على الأقل. يُفضّل مزج أحرف وأرقام.</p>
            <button type="submit"
                    style="padding:11px 16px;border:0;border-radius:10px;background:var(--accent,#0ea5a5);color:#fff;font-weight:800;cursor:pointer">
                تغيير كلمة المرور
            </button>
        </form>
    }
</section>

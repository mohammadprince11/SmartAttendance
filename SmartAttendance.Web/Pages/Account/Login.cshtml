@page
@model SmartAttendance.Web.Pages.Account.LoginModel
@using System.Text.Json
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities

@{
    ViewData["Title"] = T["تسجيل الدخول"];
    var passkeyStartError = JsonSerializer.Serialize(T["تعذّر بدء الدخول."].Value);
    var passkeyVerifyError = JsonSerializer.Serialize(T["فشل الدخول بالمفتاح."].Value);
    var passkeyCancelledError = JsonSerializer.Serialize(T["أُلغيت العملية أو لا يوجد مفتاح مسجَّل على هذا الجهاز."].Value);
    var passkeyGenericError = JsonSerializer.Serialize(T["تعذّر الدخول بالمفتاح."].Value);
    var currentCultureName = CultureInfo.CurrentUICulture.Name;
    var requestedReturnUrl = Request.Query["ReturnUrl"].ToString();
    var cultureReturnUrl = string.IsNullOrWhiteSpace(requestedReturnUrl)
        ? Request.Path.Value ?? "/Account/Login"
        : QueryHelpers.AddQueryString(Request.Path.Value ?? "/Account/Login", "ReturnUrl", requestedReturnUrl);
}
<link rel="stylesheet" href="~/css/pages/login-316e15b025.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/login-foundation.css" asp-append-version="true" />

<div class="login-page">
    <div class="login-stage">
        <section class="login-visual" aria-label="ZYNORA HR">
            <div class="login-visual__brand">
                <img src="~/brand/zynora-logo-horizontal-light.svg" alt="ZYNORA HR" />
            </div>
            <div class="login-visual__copy">
                <span>ZYNORA WORKSPACE</span>
                <h2>@T["الموظفون"] · @T["الحضور والانصراف"] · @T["الرواتب"]</h2>
            </div>
            <div class="login-visual__modules" aria-hidden="true">
                <span>@T["الموظفون"]</span>
                <span>@T["الحضور والانصراف"]</span>
                <span>@T["الرواتب"]</span>
            </div>
        </section>
    <div class="login-card">
        <form method="post" asp-page="/Culture/Set" class="login-language-switcher">
            <input type="hidden" name="returnUrl" value="@cultureReturnUrl" />
            <label for="login-culture">@T["لغة الواجهة"]</label>
            <select id="login-culture" name="culture" aria-label="@T["لغة الواجهة"]">
                @foreach (var language in ZynoraSupportedCultures.All)
                {
                    <option value="@language.Code"
                            selected="@(string.Equals(currentCultureName, language.Code, StringComparison.OrdinalIgnoreCase))">
                        @language.NativeName
                    </option>
                }
            </select>
            <button type="submit">@T["تطبيق"]</button>
        </form>

        <div class="login-logo">
            <img src="~/brand/zynora-symbol.svg" alt="" aria-hidden="true" />
        </div>

        <h1>@T["تسجيل الدخول"]</h1>
        <p>@T["دخول مستخدمي نظام Smart Attendance."]</p>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="login-error">@Model.ErrorMessage</div>
        }

        <form method="post" class="login-form">
            <input asp-for="ReturnUrl" type="hidden" />

            <div class="login-field">
                <label asp-for="Username">@T["اسم المستخدم"]</label>
                <input asp-for="Username" autocomplete="username" autofocus />
            </div>

            <div class="login-field">
                <label asp-for="Password">@T["كلمة المرور"]</label>
                <div class="login-password-control">
                    <input asp-for="Password" type="password" autocomplete="current-password" />
                    <button type="button"
                            id="password-visibility-toggle"
                            class="login-password-toggle"
                            data-nexora-hover="off"
                            aria-controls="Password"
                            aria-pressed="false"
                            aria-label="@T["إظهار كلمة المرور"]"
                            title="@T["إظهار كلمة المرور"]"
                            data-show-label="@T["إظهار كلمة المرور"]"
                            data-hide-label="@T["إخفاء كلمة المرور"]">
                        <svg class="login-password-toggle__show" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                            <circle cx="12" cy="12" r="2.75" />
                        </svg>
                        <svg class="login-password-toggle__hide" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
                            <path d="M4 4 20 20" />
                            <path d="M9.4 6.45A10.7 10.7 0 0 1 12 6c6 0 9.5 6 9.5 6a15 15 0 0 1-2.3 3.05M14.6 17.55A10.7 10.7 0 0 1 12 18c-6 0-9.5-6-9.5-6a15 15 0 0 1 2.3-3.05" />
                            <path d="M9.95 9.95A2.75 2.75 0 0 0 14.05 14.05" />
                        </svg>
                    </button>
                </div>
            </div>

            <label class="login-check">
                <input asp-for="RememberMe" />
                <span>@T["تذكرني"]</span>
            </label>

            <button type="submit" class="login-button">@T["دخول"]</button>
        </form>

        <script>
        (function () {
            var input = document.getElementById("Password");
            var toggle = document.getElementById("password-visibility-toggle");
            if (!input || !toggle) return;

            var showIcon = toggle.querySelector(".login-password-toggle__show");
            var hideIcon = toggle.querySelector(".login-password-toggle__hide");

            toggle.addEventListener("click", function () {
                var willShow = input.type === "password";
                input.type = willShow ? "text" : "password";
                toggle.setAttribute("aria-pressed", willShow ? "true" : "false");

                var label = willShow ? toggle.dataset.hideLabel : toggle.dataset.showLabel;
                toggle.setAttribute("aria-label", label);
                toggle.setAttribute("title", label);
                showIcon.hidden = willShow;
                hideIcon.hidden = !willShow;
                input.focus({ preventScroll: true });
            });
        })();
        </script>

        @* الدخول بالبصمة/الوجه (Passkey): يظهر فقط حين يدعمه المتصفح — يتطلب مفتاحاً
           مسجَّلاً من بوابة الموظف ومعتمَداً من الموارد البشرية. كلمة المرور تبقى بديلاً. *@
        <button type="button" id="bio-login-btn" class="login-button zyu-8d3380c010b4" hidden
               >
            🔐 @T["الدخول بالبصمة/الوجه"]
        </button>
        <div id="bio-login-error" class="login-error zyu-df928149c547" hidden></div>

        <script>
        (function () {
            var btn = document.getElementById("bio-login-btn");
            var err = document.getElementById("bio-login-error");
            var messages = {
                start: @Html.Raw(passkeyStartError),
                verify: @Html.Raw(passkeyVerifyError),
                cancelled: @Html.Raw(passkeyCancelledError),
                generic: @Html.Raw(passkeyGenericError)
            };
            if (!window.PublicKeyCredential) return;
            btn.hidden = false;

            function a2b(s) {
                s = s.replace(/-/g, "+").replace(/_/g, "/");
                while (s.length % 4) s += "=";
                var bin = atob(s), u8 = new Uint8Array(bin.length);
                for (var i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i);
                return u8.buffer;
            }
            function b2a(buf) {
                var u8 = new Uint8Array(buf), bin = "";
                for (var i = 0; i < u8.length; i++) bin += String.fromCharCode(u8[i]);
                return btoa(bin).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
            }

            btn.addEventListener("click", async function () {
                err.hidden = true;
                btn.disabled = true;
                try {
                    var r = await fetch("/api/webauthn/login/options", { method: "POST" });
                    var data = await r.json();
                    if (!r.ok) throw new Error(data.message || messages.start);
                    var o = data.options;
                    o.challenge = a2b(o.challenge);
                    (o.allowCredentials || []).forEach(function (c) { c.id = a2b(c.id); });
                    var cred = await navigator.credentials.get({ publicKey: o });
                    var r2 = await fetch("/api/webauthn/login/verify", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            key: data.key,
                            assertion: {
                                id: cred.id,
                                rawId: b2a(cred.rawId),
                                type: cred.type,
                                extensions: cred.getClientExtensionResults(),
                                response: {
                                    authenticatorData: b2a(cred.response.authenticatorData),
                                    clientDataJSON: b2a(cred.response.clientDataJSON),
                                    signature: b2a(cred.response.signature),
                                    userHandle: cred.response.userHandle ? b2a(cred.response.userHandle) : null
                                }
                            }
                        })
                    });
                    var d2 = await r2.json();
                    if (!r2.ok) throw new Error(d2.message || messages.verify);
                    window.location.href = d2.redirect || "/";
                } catch (e) {
                    err.textContent = e.name === "NotAllowedError"
                        ? messages.cancelled
                        : (e.message || messages.generic);
                    err.hidden = false;
                    btn.disabled = false;
                }
            });
        })();
        </script>

        @* أُزيل عرض «الدخول الافتراضي» — كان يكشف حساب الأدمن وكلمة مروره لأي زائر
           لصفحة الدخول (بما فيهم غير المصادَقين على الإنترنت العام). بيانات الدخول
           تُسلَّم للمسؤول خارج التطبيق. راجع docs/SECURITY-CREDENTIAL-ROTATION.md *@
    </div>
    </div>
</div>

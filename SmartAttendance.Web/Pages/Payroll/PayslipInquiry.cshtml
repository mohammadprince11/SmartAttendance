@page "/Payroll/PayslipInquiry"
@model SmartAttendance.Web.Pages.Payroll.PayslipInquiryModel
@{
    ViewData["Title"] = "استعلام القسائم";
}

<style>
    .pq-page { display:flex; flex-direction:column; gap:14px; color:var(--sa-text,#DCEAF4); }
    .pq-head { padding:16px 20px; border:1px solid rgba(73,111,151,.22); border-radius:20px;
        background:radial-gradient(circle at 92% 8%,rgba(18,217,227,.12),transparent 38%),linear-gradient(135deg,rgba(9,31,52,.95),rgba(5,16,29,.95)); }
    html[data-theme="light"] .pq-head { background:linear-gradient(135deg,#fff,#f2f7fb); }
    .pq-head h1 { margin:0; font-size:20px; font-weight:1000; }
    .pq-head p { margin:2px 0 0; font-size:12px; color:var(--sa-muted,#8FA8BC); font-weight:800; }

    .pq-filters { display:flex; align-items:flex-end; gap:12px; flex-wrap:wrap; padding:14px 16px;
        border:1px solid rgba(73,111,151,.22); border-radius:16px; background:var(--sa-surface,rgba(8,25,43,.9)); }
    .pq-filters label { display:flex; flex-direction:column; gap:5px; font-size:12px; font-weight:900; color:var(--sa-muted,#8FA8BC); }
    .pq-filters select { min-height:36px; border-radius:10px; border:1px solid rgba(73,111,151,.25); background:rgba(0,0,0,.16); color:inherit; padding:5px 10px; font-weight:900; min-width:180px; max-width:300px; }
    html[data-theme="light"] .pq-filters select { background:#fff; }

    .pq-card { border:1px solid rgba(73,111,151,.22); border-radius:18px; overflow-x:auto; background:var(--sa-surface,rgba(8,25,43,.9)); }
    .pq-table { width:100%; border-collapse:collapse; font-size:13px; min-width:820px; }
    .pq-table th { text-align:start; white-space:nowrap; padding:12px 14px; font-size:11px; font-weight:1000; color:var(--sa-muted,#8FA8BC); border-bottom:1px solid rgba(73,111,151,.22); background:rgba(0,0,0,.14); }
    html[data-theme="light"] .pq-table th { background:#f2f7fb; }
    .pq-table td { padding:11px 14px; border-bottom:1px solid rgba(143,168,188,.08); white-space:nowrap; }
    .pq-table tbody tr:hover td { background:rgba(18,217,227,.04); }
    .pq-num { direction:ltr; font-weight:900; text-align:start; unicode-bidi:plaintext; }
    .pq-net { color:#4ade80; }
    .pq-st { display:inline-block; font-size:11px; font-weight:900; padding:2px 9px; border-radius:999px; }
    .st-Draft { background:rgba(143,168,188,.16); color:#8FA8BC; }
    .st-Calculated { background:rgba(18,217,227,.14); color:#12D9E3; }
    .st-Locked { background:rgba(250,204,21,.14); color:#facc15; }
    .st-Issued { background:rgba(74,222,128,.14); color:#4ade80; }
    .st-PayslipSent { background:rgba(167,139,250,.16); color:#a78bfa; }
    .pq-view { min-height:29px; padding:4px 12px; border-radius:9px; border:1px solid rgba(73,111,151,.3); background:transparent; color:inherit; font-size:12px; font-weight:900; text-decoration:none; }
    .pq-view:hover { background:rgba(18,217,227,.12); color:#12D9E3; }
    .pq-empty { padding:34px; text-align:center; color:var(--sa-muted,#8FA8BC); font-weight:800; }
    .pq-sum { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:2px; }
    .pq-sum .chip { font-size:12px; font-weight:900; padding:6px 12px; border-radius:999px; background:rgba(18,217,227,.1); color:#12D9E3; }
</style>

<section class="pq-page" dir="rtl">
    <header class="pq-head">
        <h1>استعلام القسائم</h1>
        <p>اختر موظفاً لعرض قسائمه عبر كل دورات المسير، مع رابط لعرض القسيمة الكاملة.</p>
    </header>

    <form method="get" class="pq-filters">
        @if (Model.Companies.Count > 1)
        {
            <label>الشركة
                <select name="CompanyId" onchange="this.value=='0'?this.form.submit():this.form.submit()">
                    <option value="0" selected="@(!(Model.CompanyId > 0))">اختر الشركة</option>
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.Id" selected="@(Model.CompanyId == c.Id)">@c.Name</option>
                    }
                </select>
            </label>
        }
        <label>الموظف
            <select name="EmployeeId" onchange="this.form.submit()" @(Model.CompanyId > 0 ? "" : "disabled")>
                <option value="">— اختر موظفاً —</option>
                @foreach (var e in Model.Employees)
                {
                    <option value="@e.Id" selected="@(Model.EmployeeId == e.Id)">@e.No — @e.Name</option>
                }
            </select>
        </label>
        <label>السنة
            <select name="Year" onchange="this.form.submit()">
                <option value="" selected="@(!Model.Year.HasValue)">كل السنوات</option>
                @foreach (var y in Model.AvailableYears)
                {
                    <option value="@y" selected="@(Model.Year == y)">@y</option>
                }
            </select>
        </label>
    </form>

    @if (Model.EmployeeId is > 0)
    {
        <div class="pq-card">
            @if (Model.Payslips.Count == 0)
            {
                <div class="pq-empty">لا قسائم لهذا الموظف @(Model.Year.HasValue ? $"لسنة {Model.Year}" : "") — لم يدخل مسيراً محتسباً بعد.</div>
            }
            else
            {
                <div style="padding:12px 14px 0"><div class="pq-sum">
                    <span class="chip">@Model.SelectedEmployeeName</span>
                    <span class="chip">@Model.Payslips.Count قسيمة</span>
                    <span class="chip">صافي تراكمي: @Model.Payslips.Sum(p => p.Net).ToString("#,0.##")</span>
                </div></div>
                <table class="pq-table">
                    <thead>
                        <tr>
                            <th>الفترة</th><th>الدفعة</th><th>الحالة</th><th>الأساسي</th><th>العلاوات</th>
                            <th>الإجمالي</th><th>الضريبة</th><th>الضمان</th><th>الصافي</th><th style="text-align:end">القسيمة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Payslips)
                        {
                            <tr>
                                <td class="pq-num">@p.PeriodText</td>
                                <td class="pq-num">@p.BatchNo</td>
                                <td><span class="pq-st st-@p.Status">@p.StatusLabelText</span></td>
                                <td class="pq-num">@p.Basic.ToString("#,0.##")</td>
                                <td class="pq-num">@p.Allowances.ToString("#,0.##")</td>
                                <td class="pq-num">@p.Gross.ToString("#,0.##")</td>
                                <td class="pq-num">@p.Tax.ToString("#,0.##")</td>
                                <td class="pq-num">@p.GosiEmployee.ToString("#,0.##")</td>
                                <td class="pq-num pq-net">@p.Net.ToString("#,0.##")</td>
                                <td style="text-align:end"><a class="pq-view" href="/Payroll/RunDetail?id=@p.RunId">عرض</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else
    {
        <div class="pq-card"><div class="pq-empty">اختر @(Model.Companies.Count > 1 ? "الشركة ثم " : "")الموظف لعرض قسائمه.</div></div>
    }
</section>

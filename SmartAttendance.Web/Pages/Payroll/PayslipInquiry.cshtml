@page "/Payroll/PayslipInquiry"
@model SmartAttendance.Web.Pages.Payroll.PayslipInquiryModel
@{
    ViewData["Title"] = "استعلام قسائم الراتب";
    var months = new[] { "يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر" };
    var years = Enumerable.Range(DateTime.Today.Year - 5, 7).Reverse().ToList();
}
<link rel="stylesheet" href="~/css/pages/payslipinquiry-7a0a30dbe1.css" asp-append-version="true" />


<section class="pq-page" dir="rtl">
    <form method="get" class="pq-bar">
        <partial name="_EmployeePicker" model="@(new SmartAttendance.Web.Pages.Shared.EmployeePickerModel {
            Name = "EmployeeId",
            Label = "اسم الموظف",
            SelectedId = Model.EmployeeId ?? 0,
            SelectedCode = Model.SelectedEmployeeCode,
            SelectedName = Model.SelectedEmployeeName
        })" />
        <label class="pq-field">
            <span>الفترة</span>
            <select name="Month" class="pq-sm" required
                    oninvalid="this.setCustomValidity('يرجى اختيار الفترة (الشهر) أولاً')" oninput="this.setCustomValidity('')">
                <option value="" disabled hidden selected="@(!Model.Month.HasValue)">— اختر الشهر —</option>
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(Model.Month == m)">@months[m - 1] (@m)</option>
                }
            </select>
        </label>
        <label class="pq-field">
            <span>سنة</span>
            @{ var selYear = Model.Year ?? DateTime.Today.Year; }
            <select name="Year" class="pq-sm">
                @foreach (var y in years)
                {
                    <option value="@y" selected="@(selYear == y)">@y</option>
                }
            </select>
        </label>
        <div class="pq-spacer"></div>
        <button type="submit" class="pq-view">عرض</button>
    </form>

    <div class="pq-card">
        @if (Model.Current != null)
        {
            var c = Model.Current;
            <div class="ps">
                <div class="ps-print-head">
                    <div class="pph-brand">ZYNORA <span>HR</span></div>
                    <div class="pph-mid">
                        <div class="pph-title">قسيمة راتب</div>
                        <div class="pph-period">@Model.CurrentPeriodText</div>
                    </div>
                    <div class="pph-net">صافي الراتب<b>@c.NetSalary.ToString("#,0.##")</b></div>
                </div>
                <div class="ps-hdr">
                    <div class="f"><span>رمز الموظف</span><b>@Model.SelectedEmployeeCode</b></div>
                    <div class="f"><span>الاسم الكامل</span><b>@Model.SelectedEmployeeName</b></div>
                    <div class="f"><span>المسمى الوظيفي</span><b>@(string.IsNullOrWhiteSpace(c.Position) ? "—" : c.Position)</b></div>
                    <div class="f"><span>وحدة العمل</span><b>@(string.IsNullOrWhiteSpace(c.Department) ? "—" : c.Department)</b></div>
                    <div class="f"><span>فترة الراتب</span><b>@Model.CurrentPeriodText</b></div>
                    <div class="f"><span>الراتب الأساسي</span><b>@c.BasicSalary.ToString("#,0.##")</b></div>
                    <div class="f"><span>العلاوات</span><b>@c.TotalAllowances.ToString("#,0.##")</b></div>
                    <div class="f"><span>الراتب الكلي</span><b>@c.GrossSalary.ToString("#,0.##")</b></div>
                    @{
                        // أساس أيام الاستحقاق: 30/الفترة حين توجد سياسة WorkingDays (العطل مدفوعة)،
                        // وإلا أيام الحضور (السلوك القديم). القسيمة تعرض أيام الاستحقاق لا الحضور.
                        var psBasis = c.DaysBasis > 0 ? c.DaysBasis : c.WorkDays;
                    }
                    <div class="f"><span>أيام العمل / الغياب</span><b>@psBasis / @c.AbsentDays</b></div>
                </div>

                <div class="ps-mon">
                    <h3>الشهر الحالي — @Model.CurrentPeriodText</h3>
                    <div class="ps-cols">
                        <div class="ps-box inc">
                            <table>
                                <colgroup><col /><col class="amount-col" /></colgroup>
                                <thead><tr><th>الدخل</th><th class="zyu-814fec806937">المبلغ</th></tr></thead>
                                <tbody>
                                    <tr><td>الراتب المستحق</td><td class="amt zyu-814fec806937">@c.BasicSalary.ToString("#,0.##")</td></tr>
                                    @foreach (var e in c.Earnings)
                                    {
                                        <tr><td>@e.ItemName</td><td class="amt zyu-814fec806937">@e.Amount.ToString("#,0.##")</td></tr>
                                    }
                                    <tr class="sum"><td>مجموع الدخل</td><td class="amt zyu-814fec806937">@c.GrossSalary.ToString("#,0.##")</td></tr>
                                    <tr class="net"><td>صافي الراتب</td><td class="amt zyu-814fec806937">@c.NetSalary.ToString("#,0.##")</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="ps-box ded">
                            <table>
                                <colgroup><col /><col class="amount-col" /></colgroup>
                                <thead><tr><th>الإقتطاعات</th><th class="zyu-814fec806937">المبلغ</th></tr></thead>
                                <tbody>
                                    @if (c.TaxAmount > 0)
                                    {
                                        <tr><td>ضريبة الدخل</td><td class="amt zyu-814fec806937">@c.TaxAmount.ToString("#,0.##")</td></tr>
                                    }
                                    @if (c.GosiEmployee > 0)
                                    {
                                        <tr><td>الضمان الاجتماعي</td><td class="amt zyu-814fec806937">@c.GosiEmployee.ToString("#,0.##")</td></tr>
                                    }
                                    @* الضريبة والضمان يُعرَضان أعلاه من الحقول الصريحة — نستثني
                                       مكوّنيهما هنا كي لا يتكرّرا (المجموع أصلاً لا يضاعفهما). *@
                                    @foreach (var d in c.Deductions.Where(d => d.Kind != "Tax" && d.Kind != "Gosi"))
                                    {
                                        <tr><td>@d.ItemName</td><td class="amt zyu-814fec806937">@d.Amount.ToString("#,0.##")</td></tr>
                                    }
                                    <tr class="sum"><td>مجموع الاقتطاعات</td><td class="amt zyu-814fec806937">@c.TotalDeductions.ToString("#,0.##")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="ps-words">@Model.NetInWords فقط لا غير.</div>
                </div>

                @if (Model.Previous != null)
                {
                    <div class="ps-prev">
                        <span>الشهر السابق (@Model.PreviousPeriodText):</span>
                        <span>الإجمالي <b>@Model.Previous.Gross.ToString("#,0.##")</b></span>
                        <span>الصافي <b>@Model.Previous.Net.ToString("#,0.##")</b></span>
                    </div>
                }

                <div class="ps-sign">
                    <div>توقيع الموظف</div>
                    <div>المحاسب / الموارد البشرية</div>
                    <div>الاعتماد</div>
                </div>
            </div>
            <div class="ps-actions"><button type="button" class="ps-print" onclick="printPayslip()">🖨 طباعة</button></div>
        }
        else if (Model.EmployeeId is > 0 && Model.Payslips.Count > 0)
        {
            <div class="pq-sum">
                <span class="chip">@Model.SelectedEmployeeCode — @Model.SelectedEmployeeName</span>
                <span class="chip">@Model.Payslips.Count قسيمة</span>
                <span class="chip">صافي تراكمي: @Model.Payslips.Sum(p => p.Net).ToString("#,0.##")</span>
            </div>
            <div class="pq-wrap">
                <table class="pq-table">
                    <thead>
                        <tr>
                            <th>الفترة</th><th>الدفعة</th><th>الحالة</th><th>الأساسي</th><th>العلاوات</th>
                            <th>الإجمالي</th><th>الضريبة</th><th>الضمان</th><th>الصافي</th><th class="zyu-814fec806937">القسيمة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Payslips)
                        {
                            <tr>
                                <td class="pq-num">@p.PeriodText</td>
                                <td class="pq-num">@p.BatchNo</td>
                                <td><span class="pq-st st-@p.Status">@p.StatusLabelText</span></td>
                                <td class="pq-num">@p.Basic.ToString("#,0.##")</td>
                                <td class="pq-num">@p.Allowances.ToString("#,0.##")</td>
                                <td class="pq-num">@p.Gross.ToString("#,0.##")</td>
                                <td class="pq-num">@p.Tax.ToString("#,0.##")</td>
                                <td class="pq-num">@p.GosiEmployee.ToString("#,0.##")</td>
                                <td class="pq-num pq-net">@p.Net.ToString("#,0.##")</td>
                                <td class="zyu-814fec806937"><a class="pq-viewbtn" href="/Payroll/RunDetail?id=@p.RunId&emp=@Model.EmployeeId">عرض القسيمة</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="pq-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="zyu-c8664f4c9a37">
                    <rect x="4" y="2.5" width="16" height="19" rx="2"></rect>
                    <path d="M8 7h8M8 11h8M8 15h5"></path>
                    <path d="M15.5 18.5l1.5 1.5 2.5-2.5"></path>
                </svg>
                <p>
                    @(Model.EmployeeId is > 0
                        ? $"لا قسائم لهذا الموظف {(Model.Month.HasValue ? months[Model.Month.Value - 1] + " " : "")}{(Model.Year.HasValue ? Model.Year.ToString() : "")}"
                        : "حدد الموظف للإستعلام عن قسيمة الراتب")
                </p>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        // زرّ «عرض» مُعطَّل حتى يُختار الموظف **و** الشهر معاً.
        (function () {
            var bar = document.querySelector('.pq-bar');
            if (!bar) return;
            var btn = bar.querySelector('.pq-view');
            var month = bar.querySelector('select[name="Month"]');
            var empId = bar.querySelector('.zyep-id'); // الحقل المخفيّ لمعرّف الموظف
            function sync() {
                var ok = !!(empId && empId.value && month && month.value);
                btn.disabled = !ok;
            }
            if (month) month.addEventListener('change', sync);
            // المنتقي يضبط معرّف الموظف برمجياً (بلا حدث) ⟹ نفحص دورياً أيضاً.
            setInterval(sync, 300);
            sync();
        })();

        // نطبع القسيمة في مستند iframe مستقلّ لا يحتوي قوقعة الموقع أصلاً. هذا يمنع
        // خلفيات وثيمات .nexora-main من الوصول إلى الورقة بدلاً من محاولة تغطيتها.
        (function () {
            window.printPayslip = function () {
                var slip = document.querySelector('.ps');
                var pageStyles = document.getElementById('payslip-page-styles');
                if (!slip || !pageStyles) return;

                var frame = document.createElement('iframe');
                frame.setAttribute('title', 'قسيمة الراتب للطباعة');
                frame.setAttribute('aria-hidden', 'true');
                frame.style.cssText = 'position:fixed;top:0;left:-10000px;width:210mm;height:297mm;border:0;';
                document.body.appendChild(frame);

                var frameDoc = frame.contentDocument;
                var frameWindow = frame.contentWindow;
                if (!frameDoc || !frameWindow) {
                    frame.remove();
                    return;
                }

                frameDoc.open();
                frameDoc.write('<!doctype html><html lang="ar" dir="rtl" data-theme="light"><head>' +
                    '<meta charset="utf-8"><title>قسيمة راتب</title></head><body>' + slip.outerHTML + '</body></html>');
                frameDoc.close();

                var cleaned = false;
                function cleanup() {
                    if (cleaned) return;
                    cleaned = true;
                    window.setTimeout(function () { frame.remove(); }, 0);
                }

                frameWindow.addEventListener('afterprint', cleanup, { once: true });
                window.setTimeout(function () {
                    frameWindow.focus();
                    frameWindow.print();
                }, 50);
                // مخرج أمان إذا لم يطلق المتصفح afterprint بعد إلغاء المعاينة.
                window.setTimeout(cleanup, 60000);
            };
        })();
    </script>
}

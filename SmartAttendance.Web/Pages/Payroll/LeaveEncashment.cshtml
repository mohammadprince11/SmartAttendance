@page "/Payroll/LeaveEncashment"
@model SmartAttendance.Web.Pages.Payroll.LeaveEncashmentModel
@using System.Text.Json

@{
    ViewData["Title"] = "بدل إجازة";
    var months = new[] { "يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر" };
    var acc = "#34d399";
    var catalogJson = JsonSerializer.Serialize(Model.Catalog.Select(i => new { i.Id, i.Name }));
    var empJson = JsonSerializer.Serialize(Model.Employees.Select(e => new { e.Id, e.No, e.Name }));
    string J(object o) => JsonSerializer.Serialize(o);
    string Dt(DateOnly? d) => d?.ToString("yyyy-MM-dd") ?? "";
}
<link rel="stylesheet" href="~/css/pages/leaveencashment-0bb92cec72.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/mass-scope.css" asp-append-version="true" />


<section class="sd-page" dir="rtl">
    <header class="sd-head">
        <div>
            <h1>🌴 بدل إجازة</h1>
            <p>صرف أيام رصيد الإجازة نقداً — القيمة تُحتسب بالمسير من الأجر اليومي للموظف (الأساسي ÷ 30) كاستحقاق.</p>
        </div>
        <div class="zyu-d0cb022ba49e">
            @if (!Model.IsReadOnly)
            {
                <button type="button" class="sd-btn ghost icon" title="إدخال جماعي — لعدة موظفين" aria-label="إدخال جماعي" onclick="massOpen()">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </button>
                <button type="button" class="sd-btn ghost icon" title="استيراد من إكسل (رمز الموظف + الأيام)" aria-label="استيراد إكسل" onclick="impOpen()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                </button>
                <button type="button" class="sd-btn" onclick="sdOpen(0)">+ بدل إجازة</button>
            }
        </div>
    </header>

    <div class="sd-tabs">
        <a href="/Payroll/LeaveEncashment?Year=@Model.Year&Month=@Model.Month&Lock=Open" class="@(Model.IsReadOnly ? "" : "on")">حركات غير مقفلة</a>
        <a href="/Payroll/LeaveEncashment?Year=@Model.Year&Month=@Model.Month&Lock=Locked" class="@(Model.IsReadOnly ? "on" : "")">🔒 حركات مقفلة</a>
    </div>

    @if (Model.IsReadOnly && Model.Items.Count > 0)
    {
        <div class="sd-lockbanner">🔒 هذه الحركات دخلت مسيراً مقفلاً/معتمداً — للعرض فقط، لا تُعدّل ولا تُحذف.</div>
    }

    <div class="sd-kpis">
        <div class="sd-kpi"><b>@Model.TotalCount</b><span>عدد الحركات</span></div>
        <div class="sd-kpi"><b data-zy-style="color:@acc">@Model.TotalDays.ToString("#,0.##")</b><span>إجمالي أيام مصروفة</span></div>
        <div class="sd-kpi"><b>@Model.EmployeesCovered</b><span>موظفون</span></div>
        <div class="sd-kpi"><b>@($"{Model.Month:00}/{Model.Year}")</b><span>الفترة الحالية</span></div>
    </div>

    <form method="get" class="sd-bar">
        <input type="hidden" name="Lock" value="@Model.Lock" />
        <div class="sd-filter">
            <span>الفترة:</span>
            <select name="Month" onchange="this.form.submit()">
                @for (var m = 1; m <= 12; m++)
                { <option value="@m" selected="@(m == Model.Month)">@months[m-1]</option> }
            </select>
            <select name="Year" onchange="this.form.submit()">
                @for (var y = DateTime.Today.Year - 3; y <= DateTime.Today.Year + 1; y++)
                { <option value="@y" selected="@(y == Model.Year)">@y</option> }
            </select>
        </div>
        <div class="sd-filter">
            <input type="text" name="Search" value="@Model.Search" placeholder="بحث: موظف/بند/رقم مرجعي" class="zyu-0eddd0ab78c0" />
            <button type="submit" class="sd-btn ghost sm">بحث</button>
        </div>
    </form>

    @if (TempData["PayrollMessage"] != null)
    {
        <div class="sd-alert @((TempData["PayrollOk"] as bool?) == false ? "err" : "")">@TempData["PayrollMessage"]</div>
    }

    <form method="post">
    <input type="hidden" name="Year" value="@Model.Year" />
    <input type="hidden" name="Month" value="@Model.Month" />
    <input type="hidden" name="Lock" value="@Model.Lock" />
    <div class="sd-card">
        @if (Model.Items.Count == 0)
        {
            <div class="sd-empty">
                @if (Model.IsReadOnly)
                { <text>لا حركات مقفلة لفترة @($"{Model.Month:00}/{Model.Year}").</text> }
                else
                { <text>لا بدلات إجازة لفترة @($"{Model.Month:00}/{Model.Year}") — أضف بـ«+ بدل إجازة».</text> }
            </div>
        }
        else
        {
            <table class="sd-table">
                <thead>
                    <tr>
                        <th class="zyu-d12729b3d536"><input type="checkbox" onclick="sdAll(this)" /></th>
                        <th>الرقم المرجعي</th><th>الموظف</th><th>البند</th>
                        <th>أيام الصرف</th><th>تاريخ الحركة</th><th>الحالة</th>
                        @if (!Model.IsReadOnly)
                        { <th class="zyu-814fec806937">إجراءات</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Items)
                    {
                        var d = t.Days ?? 0;
                        <tr>
                            <td><input type="checkbox" name="SelectedIds" value="@t.Id" onchange="sdSel()" /></td>
                            <td class="sd-ref">@t.ReferenceNo</td>
                            <td class="sd-emp"><b>@t.EmployeeName</b><span>@t.EmployeeNo</span></td>
                            <td><b>@t.ItemName</b></td>
                            <td class="sd-num" data-zy-style="color:@acc">@d.ToString("#,0.##") يوم</td>
                            <td class="sd-ref">@(t.TransactionDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td><span class="sd-chip @(t.Status == "Approved" ? "ap" : "dr")">@t.StatusText</span></td>
                            @if (!Model.IsReadOnly)
                            {
                            <td>
                                <div class="sd-actions">
                                    <button type="button" class="sd-btn ghost sm" onclick="sdEdit(this)" data-tx="@J(new {
                                        Id = t.Id, t.EmployeeId, t.SalaryItemId, t.ItemName, t.Days,
                                        TransactionDate=Dt(t.TransactionDate), t.Note, t.Status, t.Year, t.Month })">تعديل</button>
                                    <button type="submit" asp-page-handler="Delete" name="id" value="@t.Id" class="sd-btn danger sm" data-zyconfirm="حذف الحركة؟">حذف</button>
                                </div>
                            </td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="4">الإجمالي (@Model.Items.Count حركة)</td><td class="sd-num" data-zy-style="color:@acc">@Model.TotalDays.ToString("#,0.##") يوم</td><td colspan="@(Model.IsReadOnly ? 2 : 3)"></td></tr>
                </tfoot>
            </table>
        }
    </div>
    @if (Model.Items.Count > 0)
    {
        <div class="sd-bulkbar" id="sd-bulkbar">
            <b>المحدد: <span id="sd-selcount">0</span></b>
            @if (Model.IsReadOnly)
            {
                <button type="submit" asp-page-handler="UnlockSelected" class="sd-btn warn" data-zyconfirm="إلغاء قفل الحركات المحددة؟">🔓 إلغاء قفل المحدد</button>
            }
            else
            {
                <button type="submit" asp-page-handler="LockSelected" class="sd-btn warn" data-zyconfirm="إقفال الحركات المحددة؟">🔒 إقفال المحدد</button>
                <button type="submit" asp-page-handler="DeleteMany" class="sd-btn danger" data-zyconfirm="حذف الحركات المحددة؟">🗑 حذف المحدد</button>
            }
        </div>
    }
    </form>

    @* ===== نموذج بدل إجازة ===== *@
    <div class="hrms-slideover-backdrop" id="sd-backdrop" onclick="sdClose()"></div>
    <aside class="hrms-slideover" id="sd-slide" aria-hidden="true">
        <div class="hrms-slideover-head">
            <h2 id="sd-title">بدل إجازة جديد</h2>
            <button type="button" class="hrms-slideover-close" onclick="sdClose()">×</button>
        </div>
        <div class="hrms-slideover-body">
            <form method="post" asp-page-handler="Save" class="sd-form zyu-f0de252a84a8">
                <input type="hidden" name="Id" id="sd-Id" value="0" />
                <input type="hidden" name="ItemName" id="sd-ItemName" />
                <input type="hidden" name="SalaryItemId" id="sd-SalaryItemId" value="0" />

                <label>اسم الموظف *
                    <div class="empk-field">
                        <input type="text" id="sd-emp-name" class="empk-name" placeholder="اسم الموظف" readonly />
                        <input type="text" id="sd-emp-code" class="empk-code" placeholder="رمز" autocomplete="off" />
                    </div>
                    <input type="hidden" name="EmployeeId" id="sd-EmployeeId" />
                </label>

                <div class="sd-bal" id="sd-bal"><span class="sd-bal-empty">اختر الموظف لعرض رصيده المتاح للصرف.</span></div>

                <label>البند
                    <select id="sd-ItemSelect" onchange="sdItemChanged()">
                        <option value="">بدل إجازة (افتراضي)</option>
                        @foreach (var i in Model.Catalog)
                        { <option value="@i.Id">@i.Name</option> }
                        <option value="__custom">أخرى (نص حر)…</option>
                    </select>
                </label>
                <label id="sd-CustomWrap" hidden>اسم البند (نص حر)
                    <input type="text" id="sd-CustomName" oninput="document.getElementById('sd-ItemName').value=this.value" />
                </label>

                <label>عدد أيام الصرف *<input type="number" id="sd-Days" name="Days" step="0.5" min="0" required oninput="sdPreview()" /></label>

                <div class="sd-preview" id="sd-preview">القيمة = <b>الأيام × الأجر اليومي</b> (الأساسي ÷ 30) — تُحتسب بالمسير.</div>

                <div class="sd-grid2">
                    <label>الشهر
                        <select name="FMonth" id="sd-FMonth" onchange="sdReloadBalance()">
                            @for (var m = 1; m <= 12; m++)
                            { <option value="@m" selected="@(m == Model.Month)">@months[m-1]</option> }
                        </select>
                    </label>
                    <label>السنة<input type="number" name="FYear" id="sd-FYear" min="2000" max="2100" value="@Model.Year" onchange="sdReloadBalance()" /></label>
                </div>

                <label>تاريخ الحركة<input type="date" name="TransactionDate" id="sd-TransactionDate" /></label>

                <label>الحالة
                    <select name="Status" id="sd-Status">
                        <option value="Approved">معتمد</option>
                        <option value="Draft">مسودة</option>
                    </select>
                </label>

                <label>ملاحظة<textarea name="Note" id="sd-Note" rows="2"></textarea></label>

                <button type="submit" class="sd-btn">حفظ بدل الإجازة</button>
            </form>
        </div>
    </aside>

    @* ===== إدخال جماعي ===== *@
    <div class="hrms-slideover-backdrop" id="mass-backdrop" onclick="massClose()"></div>
    <aside class="hrms-slideover wide" id="mass-slide" aria-hidden="true">
        <div class="hrms-slideover-head">
            <h2>👥 إدخال جماعي — بدل إجازة</h2>
            <button type="button" class="hrms-slideover-close" onclick="massClose()">×</button>
        </div>
        <div class="hrms-slideover-body">
            <form method="post" asp-page-handler="MassEntry" enctype="multipart/form-data" class="sd-form zyu-f0de252a84a8">
                <input type="hidden" name="MassItemName" id="mass-ItemName" />
                <input type="hidden" name="MassSalaryItemId" id="mass-SalaryItemId" value="0" />
                <input type="hidden" name="ScopeMode" id="mass-ScopeMode" value="Manual" />

                <div class="mass-sec">معلومات الحركة</div>
                <label>البند
                    <select id="mass-ItemSelect" onchange="massItemChanged()">
                        <option value="">بدل إجازة (افتراضي)</option>
                        @foreach (var i in Model.Catalog)
                        { <option value="@i.Id">@i.Name</option> }
                        <option value="__custom">أخرى (نص حر)…</option>
                    </select>
                </label>
                <label id="mass-CustomWrap" hidden>اسم البند (نص حر)
                    <input type="text" id="mass-CustomName" oninput="document.getElementById('mass-ItemName').value=this.value" />
                </label>

                <label>عدد أيام الصرف *<input type="number" name="MassDays" step="0.5" min="0" required /></label>
                <label>الفترة
                    <span class="zyu-69374f356aba">
                        <select name="MassMonth">
                            @for (var m = 1; m <= 12; m++)
                            { <option value="@m" selected="@(m == Model.Month)">@months[m-1]</option> }
                        </select>
                        <input type="number" name="MassYear" value="@Model.Year" min="2000" max="2100" class="zyu-2b524186b864" />
                    </span>
                </label>
                <label>ملاحظة<textarea name="MassNote" rows="2"></textarea></label>

                @* ===== النطاق (لمن يُطبَّق) — 4 طرق ===== *@
                <div class="mass-sec">النطاق — لمن يُطبَّق</div>
                <div class="mass-tabs">
                    <button type="button" class="mass-tab on" data-m="Manual" onclick="massTab('Manual')">اختيار يدوي</button>
                    <button type="button" class="mass-tab" data-m="Paste" onclick="massTab('Paste')">لصق أكواد</button>
                    <button type="button" class="mass-tab" data-m="File" onclick="massTab('File')">ملف إكسل</button>
                    <button type="button" class="mass-tab" data-m="Criteria" onclick="massTab('Criteria')">حسب معايير</button>
                </div>

                <div class="mass-pane" id="mass-pane-Manual">
                    <label>الموظفون <span id="mass-count" class="zyu-07fa33e9aa03">(0 محدد)</span></label>
                    <div class="zyu-69374f356aba">
                        <input type="text" id="mass-empsearch" placeholder="بحث بالاسم أو الرمز" oninput="massRenderEmps()"
                               class="zyu-e038610b695a" />
                        <button type="button" class="sd-btn ghost sm" onclick="massSelectAll(true)">تحديد الظاهر</button>
                        <button type="button" class="sd-btn ghost sm" onclick="massSelectAll(false)">مسح الكل</button>
                    </div>
                    <div id="mass-emplist" class="mass-list"></div>
                </div>

                <div class="mass-pane" id="mass-pane-Paste" hidden>
                    <div class="mass-paste-head">
                        <b>أكواد الموظفين <span id="mass-codecount">(0 كود)</span></b>
                        <button type="button" class="sd-btn ghost sm" onclick="massPasteClip()">📋 لصق من الحافظة</button>
                    </div>
                    <textarea name="MassCodes" id="mass-codes" rows="6" placeholder="انقر «لصق من الحافظة» أو ألصق مباشرة (Ctrl+V) — أكواد إكسل (سطر لكل كود) تتحوّل لفواصل تلقائياً"
                              oninput="massCodeCount()" onpaste="massOnPaste(event)"></textarea>
                    <p class="sd-hint">تُحلّ الأكواد إلى موظفين تلقائياً — غير المطابق يُتخطّى مع إظهار عدده.</p>
                </div>

                <div class="mass-pane" id="mass-pane-File" hidden>
                    <div class="mass-file-hint"><b class="zyu-07fa33e9aa03">تنسيق الملف:</b> عمود واحد يحوي <b>رمز الموظف</b>.</div>
                    <label>الملف (.xlsx أو .csv)<input type="file" name="massFile" accept=".xlsx,.csv" class="zyu-b87a8c000a7e" /></label>
                </div>

                <div class="mass-pane" id="mass-pane-Criteria" hidden>
                    <p class="sd-hint">يُطبَّق على <b>كل الموظفين النشطين</b> المطابقين للمعايير.</p>
                    <div class="sd-grid2">
                        <label>القسم<select name="MassDept"><option value="">كل الأقسام</option>@foreach (var s in Model.AllDepartments){<option value="@s">@s</option>}</select></label>
                        <label>الفرع<select name="MassBranch"><option value="">كل الفروع</option>@foreach (var s in Model.AllBranches){<option value="@s">@s</option>}</select></label>
                    </div>
                    <label>المسمى الوظيفي<select name="MassJobTitle"><option value="">كل المسميات</option>@foreach (var s in Model.AllJobTitles){<option value="@s">@s</option>}</select></label>
                </div>

                <button type="submit" class="sd-btn">حفظ الإدخال الجماعي</button>
            </form>
        </div>
    </aside>

    @* ===== استيراد إكسل ===== *@
    <div class="hrms-slideover-backdrop" id="imp-backdrop" onclick="impClose()"></div>
    <aside class="hrms-slideover" id="imp-slide" aria-hidden="true">
        <div class="hrms-slideover-head">
            <h2>⬆ استيراد بدل الإجازة (إكسل / CSV)</h2>
            <button type="button" class="hrms-slideover-close" onclick="impClose()">×</button>
        </div>
        <div class="hrms-slideover-body">
            <form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="sd-form zyu-f0de252a84a8">
                <div class="mass-file-hint">
                    <b class="zyu-07fa33e9aa03">أعمدة الملف (الصف الأول ترويسة تُتجاهل):</b><br />
                    A: رمز الموظف · B: عدد أيام الصرف · C: البند (اختياري)
                </div>
                <div class="sd-grid2">
                    <label>الشهر
                        <select name="ImportMonth">
                            @for (var m = 1; m <= 12; m++)
                            { <option value="@m" selected="@(m == Model.Month)">@months[m-1]</option> }
                        </select>
                    </label>
                    <label>السنة<input type="number" name="ImportYear" value="@Model.Year" min="2000" max="2100" /></label>
                </div>
                <label>الملف (.xlsx أو .csv) *<input type="file" name="importFile" accept=".xlsx,.csv" required class="zyu-b87a8c000a7e" /></label>
                <button type="submit" class="sd-btn">استيراد</button>
            </form>
        </div>
    </aside>
</section>

@section Scripts {
    <script src="~/js/emp-picker.js" asp-append-version="true"></script>
    <script src="~/js/mass-scope.js" asp-append-version="true"></script>
    <script>
        var SD_ITEMS = @Html.Raw(catalogJson);
        var SD_EMP = @Html.Raw(empJson);
        window.MASS_EMP = SD_EMP;
        var sdEmpPicker = EmpPicker.init({
            code: document.getElementById('sd-emp-code'),
            name: document.getElementById('sd-emp-name'),
            hidden: document.getElementById('sd-EmployeeId'),
            employees: SD_EMP,
            onChange: sdReloadBalance
        });

        function sdAll(cb){ document.querySelectorAll('[name=SelectedIds]').forEach(function(x){x.checked=cb.checked;}); sdSel(); }
        function sdSel(){
            var bar = document.getElementById('sd-bulkbar'); if(!bar) return;
            var n = document.querySelectorAll('[name=SelectedIds]:checked').length;
            var c = document.getElementById('sd-selcount'); if(c) c.textContent = n;
            bar.classList.toggle('show', n > 0);
        }
        function setVal(id, v){ var el=document.getElementById(id); if(el) el.value = (v==null?'':v); }

        function sdPreview(){
            var d = parseFloat(document.getElementById('sd-Days').value) || 0;
            var el = document.getElementById('sd-preview');
            if (d > 0){
                el.innerHTML = 'صرف <b>' + d.toFixed(2) + '</b> يوم × الأجر اليومي (الأساسي ÷ 30) — تُحتسب بالمسير كاستحقاق.';
            } else {
                el.innerHTML = 'القيمة = <b>الأيام × الأجر اليومي</b> (الأساسي ÷ 30) — تُحتسب بالمسير.';
            }
        }

        // عرض رصيد الموظف المتاح (سنوي/مرضي) عند اختياره أو تغيير السنة.
        function sdReloadBalance(){
            var empId = parseInt(document.getElementById('sd-EmployeeId').value) || 0;
            var year = parseInt(document.getElementById('sd-FYear').value) || new Date().getFullYear();
            var box = document.getElementById('sd-bal');
            if (!empId){ box.innerHTML = '<span class="sd-bal-empty">اختر الموظف لعرض رصيده المتاح للصرف.</span>'; return; }
            box.innerHTML = '<span class="sd-bal-empty">جارٍ تحميل الرصيد…</span>';
            fetch('/Payroll/LeaveEncashment?handler=Balance&employeeId=' + empId + '&year=' + year, { headers: { 'RequestVerificationToken': '' } })
                .then(function(r){ return r.json(); })
                .then(function(d){
                    if (!d.ok || !d.types || !d.types.length){ box.innerHTML = '<span class="sd-bal-empty">لا رصيد متتبَّع لهذا الموظف.</span>'; return; }
                    box.innerHTML = d.types.map(function(t){
                        return '<span class="sd-bal-chip">' + t.label + ' — المتاح <b>' + (+t.remaining).toFixed(1) + '</b> يوم</span>';
                    }).join('') + '<span class="sd-bal-empty zyu-b7aa1ec0049d">رصيد سنة ' + d.year + ' (إرشادي، لا يمنع الصرف).</span>';
                })
                .catch(function(){ box.innerHTML = '<span class="sd-bal-empty">تعذّر تحميل الرصيد.</span>'; });
        }

        function sdItemChanged(){
            var sel = document.getElementById('sd-ItemSelect'), val = sel.value;
            var cw = document.getElementById('sd-CustomWrap');
            if (val === '__custom'){ cw.hidden=false; document.getElementById('sd-SalaryItemId').value=0; document.getElementById('sd-ItemName').value=document.getElementById('sd-CustomName').value||''; return; }
            cw.hidden=true;
            if (!val){ document.getElementById('sd-ItemName').value=''; document.getElementById('sd-SalaryItemId').value=0; return; }
            var it = SD_ITEMS.find(function(x){ return String(x.Id)===val; });
            if (it){ document.getElementById('sd-ItemName').value = it.Name; document.getElementById('sd-SalaryItemId').value = it.Id; }
        }

        function sdEdit(btn){
            try { var d = JSON.parse(btn.getAttribute('data-tx')); sdOpen(d.Id, d); }
            catch (e) { alert('تعذّر فتح التعديل: ' + e.message); }
        }

        function sdOpen(id, d){
            var f = document.querySelector('#sd-slide form'); f.reset();
            document.getElementById('sd-Id').value = id || 0;
            document.getElementById('sd-title').textContent = id ? 'تعديل بدل إجازة' : 'بدل إجازة جديد';
            document.getElementById('sd-CustomWrap').hidden = true;
            document.getElementById('sd-ItemSelect').value=''; document.getElementById('sd-ItemName').value=''; document.getElementById('sd-SalaryItemId').value=0;
            sdEmpPicker.set(null);

            if (id && d){
                sdEmpPicker.set(SD_EMP.find(function(x){ return x.Id === d.EmployeeId; }) || null);
                setVal('sd-FMonth', d.Month); setVal('sd-FYear', d.Year);
                setVal('sd-Days', d.Days == null ? '' : Math.abs(d.Days));
                setVal('sd-TransactionDate', d.TransactionDate); setVal('sd-Note', d.Note); setVal('sd-Status', d.Status || 'Approved');
                document.getElementById('sd-ItemName').value = d.ItemName || '';
                if (d.SalaryItemId && SD_ITEMS.find(function(x){return x.Id===d.SalaryItemId;})){
                    document.getElementById('sd-ItemSelect').value = String(d.SalaryItemId);
                    document.getElementById('sd-SalaryItemId').value = d.SalaryItemId;
                } else if (d.ItemName){
                    document.getElementById('sd-ItemSelect').value='__custom';
                    document.getElementById('sd-CustomWrap').hidden=false;
                    document.getElementById('sd-CustomName').value=d.ItemName;
                }
            } else {
                setVal('sd-TransactionDate', new Date().toISOString().slice(0,10));
            }
            sdPreview();
            sdReloadBalance();
            document.getElementById('sd-slide').classList.add('open');
            document.getElementById('sd-backdrop').classList.add('open');
        }
        function sdClose(){ document.getElementById('sd-slide').classList.remove('open'); document.getElementById('sd-backdrop').classList.remove('open'); }

        // ===== إدخال جماعي =====
        function massItemChanged(){
            var sel=document.getElementById('mass-ItemSelect'), val=sel.value, cw=document.getElementById('mass-CustomWrap');
            if(val==='__custom'){ cw.hidden=false; document.getElementById('mass-SalaryItemId').value=0; document.getElementById('mass-ItemName').value=document.getElementById('mass-CustomName').value||''; return; }
            cw.hidden=true;
            if(!val){ document.getElementById('mass-ItemName').value=''; document.getElementById('mass-SalaryItemId').value=0; return; }
            var it=SD_ITEMS.find(function(x){ return String(x.Id)===val; });
            if(it){ document.getElementById('mass-ItemName').value=it.Name; document.getElementById('mass-SalaryItemId').value=it.Id; }
        }
        function massOpen(){
            document.querySelector('#mass-slide form').reset();
            document.getElementById('mass-ItemName').value=''; document.getElementById('mass-SalaryItemId').value=0;
            document.getElementById('mass-CustomWrap').hidden=true;
            massBuildEmps(); massRenderEmps(); massCount(); massTab('Manual');
            document.getElementById('mass-slide').classList.add('open'); document.getElementById('mass-backdrop').classList.add('open');
        }
        function massClose(){ document.getElementById('mass-slide').classList.remove('open'); document.getElementById('mass-backdrop').classList.remove('open'); }
        function impOpen(){ document.getElementById('imp-slide').classList.add('open'); document.getElementById('imp-backdrop').classList.add('open'); }
        function impClose(){ document.getElementById('imp-slide').classList.remove('open'); document.getElementById('imp-backdrop').classList.remove('open'); }

        document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ sdClose(); massClose(); impClose(); } });
    </script>
}

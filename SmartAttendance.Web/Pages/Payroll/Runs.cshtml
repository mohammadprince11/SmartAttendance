@page "/Payroll/Runs"
@model SmartAttendance.Web.Pages.Payroll.RunsModel
@using SmartAttendance.Web.Infrastructure.Hrms
@using System.Text.Json

@{
    ViewData["Title"] = "المسير";
    var empJson = JsonSerializer.Serialize(Model.Employees.Select(e => new { e.Id, e.No, e.Name }));
    var months = new[] { "يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر" };
}
<link rel="stylesheet" href="~/css/pages/runs-0e69354927.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/mass-scope.css" asp-append-version="true" />


<section class="pr-page" dir="rtl">
    <header class="pr-head">
        <div>
            <h1>المسير — دفعات الرواتب</h1>
            <p>احتساب الرواتب من الأساسي والعلاوات والحضور المعتمد وخصومات المخالفات، بدورة اعتماد وقسائم.</p>
        </div>
        <div class="zyu-c9dc9b564810">
            <button type="button" class="pr-btn" onclick="prOpen()">+ دفعة مسير جديدة</button>
        </div>
    </header>

    <div class="pr-kpis">
        <div class="pr-kpi zyu-7198287e0e8a"><b>@Model.TotalRuns</b><span>إجمالي الدفعات</span></div>
        <div class="pr-kpi zyu-8b6a7c0b3c73"><b>@Model.PaidRuns</b><span>دفعات معتمدة/مصروفة</span></div>
        <div class="pr-kpi zyu-1107ff14a820"><b>@(Model.LatestRun?.BatchNo ?? "—")</b><span>آخر دفعة · @(Model.LatestRun?.StatusLabelText ?? "")</span></div>
        <div class="pr-kpi zyu-0089fb1aa1e1"><b>@Model.LatestEmployees</b><span>موظفو آخر مسير</span></div>
        <div class="pr-kpi zyu-7198287e0e8a"><b>@Model.YearGross.ToString("#,0")</b><span>إجمالي رواتب السنة</span></div>
        <div class="pr-kpi zyu-2b7d3f92b385"><b class="pr-net">@Model.YearNet.ToString("#,0")</b><span>صافي مدفوع السنة</span></div>
    </div>

    <div class="pr-bar">
        <form method="get" class="pr-filter">
            <span>السنة:</span>
            @{ var selectedYear = Model.Year ?? DateTime.Today.Year; }
            <select name="Year" onchange="this.form.submit()">
                <option value="0" selected="@(Model.Year == 0)">الكل</option>
                @foreach (var y in Model.AvailableYears)
                {
                    <option value="@y" selected="@(Model.Year != 0 && selectedYear == y)">@y</option>
                }
            </select>
            @if (Model.Companies.Count > 1)
            {
                <span>الشركة:</span>
                <select name="CompanyId" onchange="this.form.submit()" class="zyu-101bfa174da6">

                    <option value="0" selected="@(!(Model.CompanyId > 0))">كل الشركات</option>
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.Id" selected="@(Model.CompanyId == c.Id)">@c.Name</option>
                    }
                </select>
            }
        </form>
    </div>

    @if (TempData["PayrollMessage"] != null)
    {
        <div class="pr-alert @((TempData["PayrollOk"] as bool?) == false ? "err" : "")">@TempData["PayrollMessage"]</div>
    }
    @if (TempData["PayrollMissingCodes"] != null)
    {
        <div class="pr-alert err">@TempData["PayrollMissingCodes"]</div>
    }

    @* بوابة فحص ما قبل المسير (نظير الشاشة الاعتراضية بكيان) *@
    @if (Model.PreflightRunId is int preflightId && Model.PreflightRun != null)
    {
        <div class="pr-card zyu-1dc9c358bf0b">
            <h3 class="zyu-a0925a28f0a3">⚠️ حركات غير معتمدة بفترة الدفعة @Model.PreflightRun.Month/@Model.PreflightRun.Year</h3>
            <p>
                تم العثور على <b>@Model.PreflightDrafts.Count</b> حركة مسودّة داخل الراتب لموظفين ضمن نطاق هذه الدفعة —
                <b>لن يشملها الاحتساب</b> ما لم تُعتمد أولاً. اعتمدها من شاشة الحركات ثم عد، أو انتقل إلى الاحتساب عن علم.
            </p>
            <div class="zhr-table-responsive">
                <table class="zhr-table">
                    <thead><tr><th>المرجع</th><th>الموظف</th><th>النوع</th><th>العنصر</th><th>المبلغ</th><th>الحالة</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.PreflightDrafts.Take(50))
                        {
                            <tr>
                                <td>@d.ReferenceNo</td>
                                <td>@d.EmployeeNo — @d.EmployeeName</td>
                                <td>@PayrollTransactionStore.TypeLabel(d.TxType)</td>
                                <td>@d.ItemName</td>
                                <td>@d.Amount.ToString("#,0.##")</td>
                                <td>@d.StatusText</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.PreflightDrafts.Count > 50)
            {
                <p class="mass-hint">يُعرض أول 50 من @Model.PreflightDrafts.Count.</p>
            }
            <div class="zyu-87f7de7b6dc8">
                <a class="pr-mi" href="/Payroll/Transactions?year=@Model.PreflightRun.Year&month=@Model.PreflightRun.Month&status=Draft">فتح الحركات المسودّة للاعتماد</a>
                <form method="post" asp-page-handler="Calculate" class="zyu-6b8b63d565c4">
                    <input type="hidden" name="id" value="@preflightId" />
                    <button class="pr-mi" type="submit" data-zyconfirm="المتابعة ستحتسب الدفعة بدون الحركات المسودّة المعروضة. متأكد؟">انتقل إلى الاحتساب بدونها</button>
                </form>
            </div>
        </div>
    }

    <div class="pr-card">
        @if (Model.Runs.Count == 0)
        {
            <div class="pr-empty">لا دفعات مسير @(Model.Year.HasValue ? $"لسنة {Model.Year}" : "") — ابدأ بـ«دفعة مسير جديدة» ثم شغّل الاحتساب.</div>
        }
        else
        {
            <table class="pr-table">
                <thead>
                    <tr>
                        <th>رقم الدفعة</th><th>النوع</th><th>الفترة</th><th>الموظفون</th>
                        <th>الإجمالي</th><th>الاستقطاعات</th><th>الصافي</th><th>محتسب بواسطة</th><th>مقفل</th><th>تم إصدارها</th><th>تم إرسال القسيمة</th>
                        <th class="zyu-814fec806937">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in Model.Runs)
                    {
                        var deductions = run.TotalGross - run.TotalNet;
                        // موضع الحالة في دورة الحياة ⟹ أعلام تراكمية (مقفل ⊇ مُصدَر ⊇ قسائم).
                        var stageIdx = Array.IndexOf(PayrollRunStore.Lifecycle, run.Status);
                        var isLocked = stageIdx >= Array.IndexOf(PayrollRunStore.Lifecycle, "Locked");
                        var isIssued = stageIdx >= Array.IndexOf(PayrollRunStore.Lifecycle, "Issued");
                        var isSent = stageIdx >= Array.IndexOf(PayrollRunStore.Lifecycle, "PayslipSent");
                        <tr>
                            <td class="pr-num">@run.BatchNo</td>
                            <td><span class="pr-scope @(run.RunType == PayrollRunStore.RunTypeRegular ? "" : "narrow")" title="@run.AdjustmentReason">@run.RunTypeText</span></td>
                            <td class="pr-num">@run.PeriodText</td>
                            <td class="pr-num">@run.EmployeeCount</td>
                            <td class="pr-num">@run.TotalGross.ToString("#,0.##")</td>
                            <td class="pr-num">@deductions.ToString("#,0.##")</td>
                            <td class="pr-num pr-net">@run.TotalNet.ToString("#,0.##")</td>
                            <td class="zyu-a49cca52becd">@(run.CalculatedBy ?? "—")<br /><span class="zyu-c8664f4c9a37">@(run.CalculatedAt?.ToString("yyyy-MM-dd") ?? "")</span></td>
                            <td><span class="pr-yn @(isLocked ? "yes" : "no")">@(isLocked ? "نعم" : "لا")</span></td>
                            <td><span class="pr-yn @(isIssued ? "yes" : "no")">@(isIssued ? "نعم" : "لا")</span></td>
                            <td><span class="pr-yn @(isSent ? "yes" : "no")">@(isSent ? "نعم" : "لا")</span></td>
                            <td class="pr-actions-cell">
                                <div class="pr-menu">
                                    <button type="button" class="pr-kebab" onclick="prMenuToggle(event, this)" aria-haspopup="true" aria-label="إجراءات">⋯</button>
                                    <div class="pr-menu-panel" role="menu">
                                    @if (run.EmployeeCount > 0)
                                    {
                                        <a class="pr-mi" href="/Payroll/RunDetail?id=@run.Id">تفاصيل</a>
                                    }
                                    @if (run.Status is "Draft" or "Calculated")
                                    {
                                        <button type="button" class="pr-mi" onclick="prScopeEdit(@run.Id, '@run.ScopeMode')">النطاق</button>
                                        @if (run.RunType == PayrollRunStore.RunTypeRegular)
                                        {
                                            <form method="post" asp-page-handler="Preflight"><input type="hidden" name="id" value="@run.Id" /><button class="pr-mi" type="submit" title="يفحص الحركات المسودّة بالفترة قبل الاحتساب">@(run.Status == "Draft" ? "احتساب" : "إعادة")</button></form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="Calculate"><input type="hidden" name="id" value="@run.Id" /><button class="pr-mi" type="submit">@(run.Status == "Draft" ? "احتساب التسوية" : "إعادة احتساب التسوية")</button></form>
                                        }
                                    }
                                    @if (run.Status == "Calculated")
                                    {
                                        <form method="post" asp-page-handler="Lock"><input type="hidden" name="id" value="@run.Id" /><button class="pr-mi" type="submit" data-zyconfirm="قفل الدفعة؟">قفل</button></form>
                                    }
                                    @if (run.Status == "Locked")
                                    {
                                        @if (Model.RequireCommitteeApproval && !run.IsApproved)
                                        {
                                            <form method="post" asp-page-handler="Approve" class="zyu-ff78d7a09cfd">
                                                <input type="hidden" name="id" value="@run.Id" />
                                                <input type="text" name="note" placeholder="ملاحظة اللجنة (اختياري)" class="zyu-745a1bacedc5" />
                                                <button class="pr-mi" type="submit" data-zyconfirm="اعتماد اللجنة لهذه الدفعة؟ يفتح باب الإصدار.">اعتماد اللجنة</button>
                                            </form>
                                        }
                                        @if (run.IsApproved)
                                        {
                                            <span class="pr-yn yes" title="@run.ApprovalNote">✓ لجنة: @run.ApprovedBy</span>
                                        }
                                        <form method="post" asp-page-handler="Issue"><input type="hidden" name="id" value="@run.Id" /><button class="pr-mi" type="submit" data-zyconfirm="اعتماد للصرف؟" title="@(Model.RequireCommitteeApproval && !run.IsApproved ? "يتطلب اعتماد اللجنة أولاً" : "")">إصدار</button></form>
                                        <form method="post" asp-page-handler="Unlock"><input type="hidden" name="id" value="@run.Id" /><button class="pr-mi" type="submit" data-zyconfirm="إلغاء قفل الدفعة؟ ستعود قابلة للتعديل والاحتساب.">إلغاء القفل</button></form>
                                    }
                                    @if (run.Status == "Issued")
                                    {
                                        <form method="post" asp-page-handler="Send"><input type="hidden" name="id" value="@run.Id" /><button class="pr-mi" type="submit" data-zyconfirm="إرسال القسائم؟">قسائم</button></form>
                                    }
                                    @if (run.Status is "Draft" or "Calculated")
                                    {
                                        <form method="post" asp-page-handler="Delete"><input type="hidden" name="id" value="@run.Id" /><button class="pr-mi danger" type="submit" data-zyconfirm="حذف الدفعة؟">حذف</button></form>
                                    }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="hrms-slideover-backdrop" id="pr-backdrop" onclick="prClose()"></div>
    <aside class="hrms-slideover wide" id="pr-slide" aria-hidden="true">
        <div class="hrms-slideover-head">
            <h2 id="pr-slide-title">دفعة مسير جديدة</h2>
            <button type="button" class="hrms-slideover-close" onclick="prClose()">×</button>
        </div>
        <div class="hrms-slideover-body">
            <form method="post" id="pr-form" asp-page-handler="Create" enctype="multipart/form-data" class="pr-form zyu-f0de252a84a8">
                <input type="hidden" name="id" id="pr-run-id" value="0" />
                <input type="hidden" name="ScopeMode" id="mass-ScopeMode" value="All" />

                <div id="pr-period-block" class="zyu-f0de252a84a8">
                    <label>الشركة
                        <select name="companyId" id="pr-company" required
                                onchange="prLoadCompany(this.value)">
                            @if (Model.Companies.Count != 1)
                            {
                                <option value="">اختر الشركة</option>
                            }
                            @foreach (var company in Model.Companies)
                            {
                                <option value="@company.Id" selected="@(Model.CompanyId == company.Id)">@company.Name</option>
                            }
                        </select>
                    </label>
                    <label>السنة<input type="number" name="year" min="2000" max="2100" value="@Model.NewYear" /></label>
                    <label>الشهر
                        <select name="month">
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(m == Model.NewMonth)">@months[m-1] (@m)</option>
                            }
                        </select>
                    </label>
                    <label>نوع المسير
                        <select name="runType" id="pr-run-type" onchange="prRunTypeChanged()">
                            <option value="Regular">اعتيادي — الأساسي والعلاوات والحضور</option>
                            <option value="OffCycle">إضافي خارج الدورة — حركات «خارج الراتب» فقط</option>
                            <option value="Retroactive">أثر رجعي — الحركات المؤشرة «بأثر رجعي» فقط</option>
                            <option value="Reversal">عكسي — يعكس مسيراً مقفلاً سابقاً</option>
                        </select>
                    </label>
                    <div id="pr-adjustment-fields" hidden>
                        <label>سبب التسوية
                            <input type="text" name="adjustmentReason" id="pr-adjustment-reason" maxlength="500" placeholder="سبب واضح يظهر في أثر المسير" />
                        </label>
                        <label id="pr-original-run-wrap" hidden>المسير الأصلي
                            <select name="originalRunId" id="pr-original-run">
                                <option value="">اختر مسيراً مقفلاً/صادراً</option>
                                @foreach (var source in Model.ReversibleRuns)
                                {
                                    <option value="@source.Id" data-company="@source.CompanyId">@source.BatchNo — @source.PeriodText — @source.RunTypeText</option>
                                }
                            </select>
                        </label>
                        <p class="mass-hint" id="pr-adjustment-hint"></p>
                    </div>
                </div>

                @* ===== النطاق — من يشمله هذا التشغيل (نمط كيان «النطاق») ===== *@
                <div class="mass-sec">النطاق — من يشمله هذا التشغيل</div>
                <div class="mass-tabs">
                    <button type="button" class="mass-tab on" data-m="All" onclick="prScope('All')">كل الموظفين</button>
                    <button type="button" class="mass-tab" data-m="Manual" onclick="prScope('Manual')">تحديد أشخاص</button>
                    <button type="button" class="mass-tab" data-m="Paste" onclick="prScope('Paste')">لصق أكواد</button>
                    <button type="button" class="mass-tab" data-m="File" onclick="prScope('File')">ملف إكسل</button>
                    <button type="button" class="mass-tab" data-m="Criteria" onclick="prScope('Criteria')">قسم/فرع</button>
                </div>

                <div class="mass-pane" id="mass-pane-All">
                    <p class="mass-hint">يشمل التشغيل <b>كل الموظفين النشطين</b> — السلوك الافتراضي. من لا راتب أساسي له يُتخطّى ويُعرض عدده بعد الاحتساب.</p>
                </div>

                <div class="mass-pane" id="mass-pane-Manual" hidden>
                    <label>الموظفون <span id="mass-count" class="zyu-07fa33e9aa03">(0 محدد)</span></label>
                    <div class="zyu-69374f356aba">
                        <input type="text" id="mass-empsearch" placeholder="بحث بالاسم أو الرمز" oninput="massRenderEmps()"
                               class="zyu-e038610b695a" />
                        <button type="button" class="pr-btn ghost sm" onclick="massSelectAll(true)">تحديد الظاهر</button>
                        <button type="button" class="pr-btn ghost sm" onclick="massSelectAll(false)">مسح الكل</button>
                    </div>
                    <div id="mass-emplist" class="mass-list"></div>
                </div>

                <div class="mass-pane" id="mass-pane-Paste" hidden>
                    <div class="mass-paste-head">
                        <b>أكواد الموظفين <span id="mass-codecount">(0 كود)</span></b>
                        <span class="zyu-69374f356aba">
                            <button type="button" class="pr-btn ghost sm" onclick="massPasteClip()">📋 لصق من الحافظة</button>
                            <button type="button" class="pr-btn sm" onclick="prCheckCodes()">تحقّق من الأكواد</button>
                        </span>
                    </div>
                    <textarea name="MassCodes" id="mass-codes" rows="6" placeholder="انسخ عمود الأكواد من إكسل وألصقه هنا (Ctrl+V) — الأسطر والتاب والفواصل تُفكَّك تلقائياً"
                              oninput="massCodeCount()" onpaste="massOnPaste(event)"></textarea>
                    <p class="mass-hint">اضغط «تحقّق من الأكواد» لترى <b>الموجود مقابل المفقود قبل التشغيل</b> — كود مخطئ واحد يعني موظفاً يغيب عن راتب الشهر.</p>
                    <div class="pr-prev" id="pr-prev" hidden>
                        <h4 id="pr-prev-ok" class="zyu-22d70a2892cd"></h4>
                        <div class="pr-chips" id="pr-prev-ok-list"></div>
                        <h4 id="pr-prev-bad" class="zyu-94c76e9c8583"></h4>
                        <div class="pr-chips" id="pr-prev-bad-list"></div>
                    </div>
                </div>

                <div class="mass-pane" id="mass-pane-File" hidden>
                    <div class="mass-file-hint"><b class="zyu-07fa33e9aa03">تنسيق الملف:</b> عمود واحد يحوي <b>رمز الموظف</b> (صف الترويسة يُتخطّى تلقائياً إن لم يكن كوداً).</div>
                    <label>الملف (.xlsx أو .csv)<input type="file" name="massFile" accept=".xlsx,.csv" class="zyu-b87a8c000a7e" /></label>
                </div>

                <div class="mass-pane" id="mass-pane-Criteria" hidden>
                    <p class="mass-hint">يشمل التشغيل <b>كل الموظفين النشطين</b> المطابقين للمعايير المختارة.</p>
                    <label>القسم
                        <select name="MassDept">
                            <option value="">كل الأقسام</option>
                            @foreach (var s in Model.AllDepartments)
                            { <option value="@s">@s</option> }
                        </select>
                    </label>
                    <label>الفرع
                        <select name="MassBranch">
                            <option value="">كل الفروع</option>
                            @foreach (var s in Model.AllBranches)
                            { <option value="@s">@s</option> }
                        </select>
                    </label>
                    <label>المسمى الوظيفي
                        <select name="MassJobTitle">
                            <option value="">كل المسميات</option>
                            @foreach (var s in Model.AllJobTitles)
                            { <option value="@s">@s</option> }
                        </select>
                    </label>
                </div>

                <p class="zyu-5040f64097e1" id="pr-foot-hint">
                    تُنشأ الدفعة كمسودة. بعدها «احتساب» يبني رواتب من يشملهم النطاق من الأساسي والعلاوات والحضور المعتمد وخصومات المخالفات.
                </p>
                <button type="submit" class="pr-btn" id="pr-submit">إنشاء الدفعة</button>
            </form>
        </div>
    </aside>
</section>

@section Scripts {
    <script src="~/js/mass-scope.js" asp-append-version="true"></script>
    <script>
        window.MASS_EMP = @Html.Raw(empJson);
        var PR_PANES = ['All', 'Manual', 'Paste', 'File', 'Criteria'];

        // الأكواد نصٌّ يكتبه المستخدم والأسماء تأتي من القاعدة — كلاهما يُهرَّب قبل الحقن.
        function prEsc(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        // تبويبات النطاق: نسخة الصفحة تضيف تبويب «الكل» فوق الأربعة المشتركة.
        function prScope(mode) {
            document.getElementById('mass-ScopeMode').value = mode;
            document.querySelectorAll('#pr-slide .mass-tab').forEach(function (t) {
                t.classList.toggle('on', t.getAttribute('data-m') === mode);
            });
            PR_PANES.forEach(function (k) {
                var p = document.getElementById('mass-pane-' + k); if (p) p.hidden = (k !== mode);
            });
            if (mode === 'Paste') massCodeCount();
        }

        function prReset() {
            document.getElementById('pr-form').reset();
            massBuildEmps(); massCount(); massCodeCount();
            document.getElementById('pr-prev').hidden = true;
            prScope('All');
            prRunTypeChanged();
        }

        function prRunTypeChanged() {
            var type = document.getElementById('pr-run-type').value;
            var fields = document.getElementById('pr-adjustment-fields');
            var reason = document.getElementById('pr-adjustment-reason');
            var originalWrap = document.getElementById('pr-original-run-wrap');
            var original = document.getElementById('pr-original-run');
            var hint = document.getElementById('pr-adjustment-hint');
            var adjustment = type !== 'Regular';
            fields.hidden = !adjustment;
            reason.required = adjustment;
            originalWrap.hidden = type !== 'Reversal';
            original.required = type === 'Reversal';
            hint.textContent = type === 'OffCycle'
                ? 'يحتسب فقط الحركات المعتمدة من نوع «خارج الراتب» غير المقفلة وبمبلغ صريح؛ لا يعيد الراتب الأساسي.'
                : type === 'Retroactive'
                    ? 'يحتسب فقط الحركات المعتمدة المؤشرة «بأثر رجعي» وغير المقفلة؛ لا يعيد الراتب الأساسي.'
                    : type === 'Reversal'
                        ? 'ينشئ قيوداً معاكسة للمسير الأصلي. لا يحذف المسير الأصلي ولا يعدّله.'
                        : '';
        }

        function prOpen() {
            var f = document.getElementById('pr-form');
            f.setAttribute('action', window.location.pathname + '?handler=Create');
            document.getElementById('pr-slide-title').textContent = 'دفعة مسير جديدة';
            document.getElementById('pr-submit').textContent = 'إنشاء الدفعة';
            document.getElementById('pr-period-block').hidden = false;
            prReset();
            document.getElementById('pr-run-id').value = '0';
            document.getElementById('pr-slide').classList.add('open');
            document.getElementById('pr-backdrop').classList.add('open');
        }

        // اختيار الشركة يحمّل موظفيها وأقسامها عبر AJAX ويحدّث منتقيات النطاق **دون إعادة
        // تحميل الصفحة** — النافذة تبقى مفتوحة كما هي. النطاق يُعاد لـ«الكل» لأن التحديد
        // السابق قد يخصّ شركة أخرى.
        function prFillSelect(name, items, allLabel) {
            var sel = document.querySelector('#pr-slide select[name="' + name + '"]');
            if (!sel) return;
            sel.innerHTML = '<option value="">' + allLabel + '</option>' +
                (items || []).map(function (s) { return '<option value="' + prEsc(s) + '">' + prEsc(s) + '</option>'; }).join('');
        }
        function prLoadCompany(id) {
            prScope('All');
            if (!id) { window.MASS_EMP = []; massBuildEmps(); massCount(); return; }
            fetch(window.location.pathname + '?handler=CompanyScope&companyId=' + encodeURIComponent(id),
                  { headers: { 'X-Requested-With': 'fetch' } })
                .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
                .then(function (d) {
                    window.MASS_EMP = (d.employees || []).map(function (e) { return { Id: e.id, No: e.no, Name: e.name }; });
                    massBuildEmps(); massCount();
                    prFillSelect('MassDept', d.departments, 'كل الأقسام');
                    prFillSelect('MassBranch', d.branches, 'كل الفروع');
                    prFillSelect('MassJobTitle', d.jobTitles, 'كل المسميات');
                })
                .catch(function () { /* تجاهُل صامت — يبقى التحديد السابق */ });
        }

        // قائمة الإجراءات (⋯) بنمط كيان: زرّ واحد يفتح لوحة الخيارات.
        // اللوحة position:fixed فتُموضَع يدوياً تحت الزرّ لتفادي قصّ الجدول المُمرَّر.
        function prCloseMenus() {
            document.querySelectorAll('.pr-menu.open').forEach(function (m) { m.classList.remove('open'); });
        }
        function prMenuToggle(ev, btn) {
            ev.stopPropagation();
            var menu = btn.closest('.pr-menu');
            var isOpen = menu.classList.contains('open');
            prCloseMenus();
            if (isOpen) return;
            menu.classList.add('open');
            var panel = menu.querySelector('.pr-menu-panel');
            var r = btn.getBoundingClientRect();
            panel.style.top = (r.bottom + 4) + 'px';
            // محاذاة يمين اللوحة مع يمين الزرّ (RTL)
            var pw = panel.offsetWidth;
            var left = r.right - pw;
            if (left < 8) left = 8;
            panel.style.left = left + 'px';
            // لو تجاوزت أسفل الشاشة، افتحها للأعلى.
            if (r.bottom + 4 + panel.offsetHeight > window.innerHeight - 8) {
                panel.style.top = (r.top - 4 - panel.offsetHeight) + 'px';
            }
        }
        document.addEventListener('click', prCloseMenus);
        window.addEventListener('resize', prCloseMenus);
        window.addEventListener('scroll', prCloseMenus, true);

        // تعديل نطاق دفعة قائمة قبل قفلها — نفس النموذج بلا حقول الفترة.
        function prScopeEdit(runId, mode) {
            var f = document.getElementById('pr-form');
            f.setAttribute('action', window.location.pathname + '?handler=SetScope');
            document.getElementById('pr-slide-title').textContent = 'نطاق الدفعة #' + runId;
            document.getElementById('pr-submit').textContent = 'حفظ النطاق';
            document.getElementById('pr-foot-hint').textContent = 'النطاق يُحفظ مع الدفعة، فإعادة الاحتساب لاحقاً تلتزم به. بعد الحفظ شغّل «الاحتساب» ليأخذ أثره.';
            prReset();
            document.getElementById('pr-period-block').hidden = true;
            document.getElementById('pr-run-id').value = runId;
            prScope(mode && mode !== 'All' ? mode : 'All');
            document.getElementById('pr-slide').classList.add('open');
            document.getElementById('pr-backdrop').classList.add('open');
        }

        function prClose() { document.getElementById('pr-slide').classList.remove('open'); document.getElementById('pr-backdrop').classList.remove('open'); }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') prClose(); });

        // معاينة الأكواد قبل التشغيل: الموجود مقابل المفقود — الفارق عن كيان/ZenHR
        // حيث لا يظهر الكود المخطئ إلا بعد الاحتساب (وقد غاب موظف عن راتبه).
        function prCheckCodes() {
            var codes = document.getElementById('mass-codes').value || '';
            var token = document.querySelector('#pr-form input[name="__RequestVerificationToken"]');
            var body = new FormData();
            body.append('codes', codes);
            body.append('companyId', document.getElementById('pr-company').value || '0');
            fetch(window.location.pathname + '?handler=PreviewCodes', {
                method: 'POST',
                headers: token ? { 'RequestVerificationToken': token.value } : {},
                body: body
            })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                var box = document.getElementById('pr-prev');
                var ok = d.matched || [], bad = d.missing || [];
                document.getElementById('pr-prev-ok').textContent = '✓ موجود: ' + ok.length;
                document.getElementById('pr-prev-ok-list').innerHTML = ok.map(function (e) {
                    return '<span class="pr-chip">' + prEsc(e.no) + ' — ' + prEsc(e.name) + '</span>';
                }).join('');
                document.getElementById('pr-prev-bad').textContent = bad.length ? ('✕ غير موجود: ' + bad.length) : '';
                document.getElementById('pr-prev-bad-list').innerHTML = bad.map(function (c) {
                    return '<span class="pr-chip bad">' + prEsc(c) + '</span>';
                }).join('');
                box.hidden = false;
            })
            .catch(function () { alert('تعذّر التحقق من الأكواد — أعد المحاولة.'); });
        }

        massBuildEmps();
    </script>
}

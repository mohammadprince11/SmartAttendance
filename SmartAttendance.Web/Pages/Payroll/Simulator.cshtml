@page
@model SmartAttendance.Web.Pages.Payroll.SimulatorModel

@{
    ViewData["Title"] = "نظام المحاكاة";
}
<link rel="stylesheet" href="~/css/pages/simulator-002c7dad7e.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/zynora-hr-settings-v16.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/zynora-conditions.css" asp-append-version="true" />


<section class="nxhs-page" dir="rtl">
    <header class="nxhs-titlebar">
        <a href="/Payroll/Runs">الرواتب</a>
        <h1>نظام المحاكاة</h1>
    </header>

    <form method="get" class="nxhs-panel zyp-editor">
        <h3>ما هي عناصر الراتب التي ترغب في محاكاتها؟</h3>
        <p class="zyp-hint">
            قم بإجراء تحليل ومطابقة عناصر الراتب المحددة لموظفيك قبل اتخاذ القرار النهائي —
            لكل موظف: <b>مؤهل</b> وفق شروط العنصر؟ · <b>مُسند</b> بملفه؟ · القيمة أو الصيغة.
            <b>قراءة فقط</b> — لا يمسّ أي بيانات ولا يحتسب مسيراً.
        </p>

        <div class="sim-items">
            @foreach (var item in Model.Items)
            {
                <label>
                    <input type="checkbox" name="ItemIds" value="@item.Id" checked="@(Model.ItemIds.Contains(item.Id) ? "checked" : null)" />
                    @item.Name
                    <small class="zyu-acc22d4dbe8e">(@(item.ValueKind == "Formula" ? "معادلة" : item.ValueKind == "Fixed" ? "ثابت" : "لكل موظف"))</small>
                </label>
            }
        </div>

        <div class="zyu-6f67ae5b70ce">
            <input type="search" name="Search" value="@Model.Search" placeholder="بحث بالاسم أو الرقم (اختياري)" />
            <input type="number" name="CompanyId" value="@Model.CompanyId" placeholder="معرّف الشركة (اختياري)" class="zyu-ffcb6e42ab67" />
            <label class="zyu-7ecbd5b5991b">
                <input type="checkbox" name="GapsOnly" value="true" checked="@(Model.GapsOnly ? "checked" : null)" /> الفجوات فقط
            </label>
            <button type="submit">محاكاة</button>
        </div>
    </form>

    @if (Model.Ran)
    {
        <div class="nxhs-panel">
            <h3>ملخص نتائج المحاكاة</h3>
            <p>تم إجراء المحاكاة على <b>@Model.EmployeesCount</b> موظف.</p>
            <div class="sim-kpi">
                <div><span>مؤهل وليس بملفه</span><b class="zyu-fdb0105499d1">@Model.GapCount</b></div>
                <div><span>بملفه وغير مؤهل</span><b class="zyu-d80273a5ade9">@Model.OverCount</b></div>
                <div><span>مطابق</span><b class="zyu-29145437e040">@Model.MatchCount</b></div>
            </div>
            @if (Model.GapCount > 0)
            {
                <p class="zyp-hint">@Model.GapCount ليس لديهم عنصر الراتب ويجب أن يكون موجوداً في ملفهم لأنهم مؤهلون للحصول عليه.</p>
            }

            <div class="zhr-table-responsive">
                <table class="zyp-table zyu-b7aa1ec0049d">
                    <thead>
                        <tr>
                            <th>الرمز</th><th>الموظف</th><th>الأساسي</th><th>عنصر الراتب</th>
                            <th>الحكم</th><th>القيمة المحاكاة</th><th>الصيغة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr><td colspan="7">لا نتائج ضمن هذا النطاق/المرشح.</td></tr>
                        }
                        @foreach (var r in Model.Rows.Take(500))
                        {
                            <tr>
                                <td>@r.EmployeeNo</td>
                                <td><a href="/Employees/Profile?id=@r.EmployeeId">@r.EmployeeName</a></td>
                                <td>@r.Basic.ToString("#,0.##")</td>
                                <td>@r.ItemName</td>
                                <td><span class="sim-verdict @r.VerdictClass">@r.Verdict</span></td>
                                <td>@(r.Error != null ? "⚠ " + r.Error : r.SimulatedValue?.ToString("#,0.##") ?? "—")</td>
                                <td><code class="zyu-33ee29812798">@(r.Formula ?? "—")</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Rows.Count > 500)
            {
                <p class="zyp-hint">يُعرض أول 500 من @Model.Rows.Count — ضيّق النطاق أو فعّل «الفجوات فقط».</p>
            }
        </div>
    }
</section>

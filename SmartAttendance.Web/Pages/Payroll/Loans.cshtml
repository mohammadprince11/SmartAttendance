@page "/Payroll/Loans"
@model SmartAttendance.Web.Pages.Payroll.LoansModel
@using System.Text.Json
@using SmartAttendance.Web.Infrastructure.Hrms
@{
    ViewData["Title"] = "القروض والسُّلف";
    var acc = "#f59e0b";
    var total = Model.Loans.Sum(l => l.Amount);
    var remaining = Model.Loans.Where(l => l.Status != LoanStore.Rejected).Sum(l => l.Remaining);
    var active = Model.Loans.Count(l => l.Status == LoanStore.Approved);
}
@Html.AntiForgeryToken()
<link rel="stylesheet" href="~/css/pages/loans-73f3517eb4.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />


<section class="ln-page" dir="rtl">
    <header class="ln-head">
        <div>
            <h1>القروض والسُّلف</h1>
            <p>قرض/سُلفة بأقساط شهرية ← اعتماد ← خصم آلي كاقتطاع بالمسير عند الاستحقاق.</p>
        </div>
        <div class="ln-actions">
            <form method="post" asp-page-handler="PostDue" class="ln-filter ln-post">
                <span>ترحيل أقساط:</span>
                <select name="PostMonth">
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.PostMonth)">@m.ToString("00")</option>
                    }
                </select>
                <input name="PostYear" type="number" value="@Model.PostYear" class="zyu-2b524186b864" />
                <button type="submit" class="ln-btn warn">ترحيل المستحق</button>
            </form>
            <button type="button" class="ln-btn" onclick="lnOpen(0)">+ قرض / سُلفة</button>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="hrms-alert">@TempData["SuccessMessage"]</div>
    }

    <div class="ln-kpis">
        <div class="ln-kpi"><b>@Model.Loans.Count</b><span>إجمالي السجلات</span></div>
        <div class="ln-kpi"><b>@total.ToString("N0")</b><span>إجمالي مبالغ القروض</span></div>
        <div class="ln-kpi"><b>@remaining.ToString("N0")</b><span>الرصيد المتبقّي</span></div>
        <div class="ln-kpi"><b>@active</b><span>معتمدة نشطة (تُخصم)</span></div>
    </div>

    <div class="ln-bar">
        <form method="get" class="ln-filter ln-filters">
            <input name="Search" value="@Model.Search" placeholder="بحث (اسم/رقم/مرجع)" />
            <select name="LoanType" onchange="this.form.submit()">
                <option value="">كل الأنواع</option>
                <option value="Loan" selected="@(Model.LoanType == "Loan")">قرض</option>
                <option value="Advance" selected="@(Model.LoanType == "Advance")">سُلفة</option>
            </select>
            <select name="Status" onchange="this.form.submit()">
                <option value="">كل الحالات</option>
                <option value="Pending" selected="@(Model.Status == "Pending")">قيد الموافقة</option>
                <option value="Approved" selected="@(Model.Status == "Approved")">معتمد</option>
                <option value="Closed" selected="@(Model.Status == "Closed")">مُغلق</option>
                <option value="Rejected" selected="@(Model.Status == "Rejected")">مرفوض</option>
            </select>
            <button type="submit" class="ln-btn ghost sm">تطبيق</button>
        </form>
    </div>

    <div class="ln-card">
        <table class="ln-table">
            <thead>
                <tr>
                    <th>المرجع</th><th>الموظف</th><th>النوع</th><th>المبلغ</th><th>الأقساط</th>
                    <th>القسط الشهري</th><th>المدفوع</th><th>المتبقّي</th><th>يبدأ</th><th>الحالة</th><th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Loans)
                {
                    <tr>
                        <td class="ln-num">@l.ReferenceNo</td>
                        <td><b>@l.EmployeeName</b><br /><span class="zyu-7ef101cd4277">@l.EmployeeNo · @l.Department</span></td>
                        <td>@l.TypeText</td>
                        <td class="ln-num">@l.Amount.ToString("N0")</td>
                        <td class="ln-num">@l.PaidCount / @l.InstallmentCount</td>
                        <td class="ln-num">@l.MonthlyAmount.ToString("N0")</td>
                        <td class="ln-num zyu-c15fd6731792">@l.PaidAmount.ToString("N0")</td>
                        <td class="ln-num" data-zy-style="color:@acc">@l.Remaining.ToString("N0")</td>
                        <td class="ln-num">@l.StartPeriodText</td>
                        <td><span class="ln-pill @l.Status">@l.StatusText</span></td>
                        <td class="zyu-eb99a4c193ed">
                            <button type="button" class="ln-btn ghost sm" onclick="lnSchedule(@l.Id)">جدول</button>
                            @if (l.Status == LoanStore.Pending)
                            {
                                <button type="button" class="ln-btn ghost sm" onclick="lnOpen(@l.Id)">تعديل</button>
                                <form method="post" asp-page-handler="SetStatus" class="zyu-6b8b63d565c4">
                                    <input type="hidden" name="id" value="@l.Id" /><input type="hidden" name="status" value="Approved" />
                                    <button type="submit" class="ln-btn apply sm">اعتماد</button>
                                </form>
                                <form method="post" asp-page-handler="SetStatus" class="zyu-6b8b63d565c4">
                                    <input type="hidden" name="id" value="@l.Id" /><input type="hidden" name="status" value="Rejected" />
                                    <button type="submit" class="ln-btn danger sm">رفض</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" class="zyu-6b8b63d565c4" data-zyconfirm="حذف القرض @l.ReferenceNo؟">
                                    <input type="hidden" name="id" value="@l.Id" />
                                    <button type="submit" class="ln-btn danger sm">حذف</button>
                                </form>
                            }
                            else if (l.Status == LoanStore.Approved)
                            {
                                <form method="post" asp-page-handler="SetStatus" class="zyu-6b8b63d565c4" data-zyconfirm="إغلاق القرض يدوياً؟ لن تُخصم أقساطه القادمة.">
                                    <input type="hidden" name="id" value="@l.Id" /><input type="hidden" name="status" value="Closed" />
                                    <button type="submit" class="ln-btn warn sm">إغلاق</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Loans.Any())
                {
                    <tr><td colspan="11" class="zyu-a86ea7877c05">لا قروض — أنشئ قرضاً أو سُلفة من الزر أعلاه.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="ln-modal-bg" id="lnModalBg">
    <div class="ln-modal">
        <h2 id="lnTitle">قرض / سُلفة جديدة</h2>
        <form method="post" asp-page-handler="Save" enctype="multipart/form-data" id="lnForm">
            <input type="hidden" name="Id" id="f_Id" value="0" />
            <div class="ln-grid">
                <label class="ln-field full">الموظف
                    <div class="empk-field">
                        <input type="text" id="f_EmpName" class="empk-name" placeholder="اسم الموظف — انقر للبحث" readonly />
                        <input type="text" id="f_EmpCode" class="empk-code" placeholder="رمز" autocomplete="off" />
                    </div>
                    <input type="hidden" name="EmployeeId" id="f_Emp" />
                </label>
                <label class="ln-field">النوع
                    <select name="LoanType" id="f_Type">
                        <option value="Loan">قرض</option>
                        <option value="Advance">سُلفة</option>
                    </select>
                </label>
                <label class="ln-field">المبلغ الإجمالي
                    <input name="Amount" id="f_Amount" type="number" step="0.01" min="1" required oninput="lnCalc()" />
                </label>
                <label class="ln-field">عدد الأقساط الشهرية
                    <input name="InstallmentCount" id="f_Count" type="number" min="1" value="1" oninput="lnCalc()" />
                </label>
                <label class="ln-field">يبدأ الخصم — الشهر
                    <select name="StartMonth" id="f_SMonth">
                        @for (var m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == DateTime.Today.Month)">@m.ToString("00")</option>
                        }
                    </select>
                </label>
                <label class="ln-field">السنة
                    <input name="StartYear" id="f_SYear" type="number" value="@DateTime.Today.Year" />
                </label>
                <div class="ln-preview" id="f_Preview">القسط الشهري: —</div>
                <label class="ln-field full">السبب
                    <input name="Reason" id="f_Reason" maxlength="200" />
                </label>
                <label class="ln-field full">ملاحظة
                    <textarea name="Note" id="f_Note" rows="2" maxlength="500"></textarea>
                </label>
                <label class="ln-field full">مرفق (اختياري)
                    <input name="attachment" type="file" accept="image/*,application/pdf" />
                </label>
                <input type="hidden" name="Status" id="f_Status" value="Pending" />
            </div>
            <div class="ln-modal-actions">
                <button type="button" class="ln-btn ghost" onclick="lnClose()">إلغاء</button>
                <button type="submit" class="ln-btn apply">حفظ</button>
            </div>
        </form>
    </div>
</div>

<div class="ln-modal-bg" id="lnSchedBg">
    <div class="ln-modal zyu-eff172f03ec0">
        <h2>جدول الأقساط</h2>
        <div id="lnSchedBody" class="zyu-5e461f0709b6">جارٍ التحميل…</div>
        <div class="ln-modal-actions"><button type="button" class="ln-btn ghost" onclick="document.getElementById('lnSchedBg').classList.remove('open')">إغلاق</button></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/emp-picker.js" asp-append-version="true"></script>
    <script>
        var lnLoans = @Html.Raw(JsonSerializer.Serialize(Model.Loans.Select(l => new {
            l.Id, l.EmployeeId, l.LoanType, l.Amount, l.InstallmentCount, l.StartYear, l.StartMonth, l.Reason, l.Note, l.Status
        })));

        var LN_EMP = @Html.Raw(JsonSerializer.Serialize(Model.Employees));
        var lnEmpPicker = EmpPicker.init({
            code: document.getElementById("f_EmpCode"),
            name: document.getElementById("f_EmpName"),
            hidden: document.getElementById("f_Emp"),
            employees: LN_EMP
        });

        function lnCalc() {
            var amt = parseFloat(document.getElementById("f_Amount").value) || 0;
            var cnt = parseInt(document.getElementById("f_Count").value) || 1;
            if (cnt < 1) cnt = 1;
            var monthly = Math.round((amt / cnt) * 100) / 100;
            document.getElementById("f_Preview").textContent = "القسط الشهري: " + monthly.toLocaleString() + " × " + cnt + " قسط";
        }

        function lnOpen(id) {
            var f = document.getElementById("lnForm");
            f.reset();
            document.getElementById("f_Id").value = id || 0;
            document.getElementById("f_Status").value = "Pending";
            document.getElementById("lnTitle").textContent = id ? "تعديل القرض" : "قرض / سُلفة جديدة";
            lnEmpPicker.set(null);
            if (id) {
                var l = lnLoans.find(function (x) { return x.Id === id; });
                if (l) {
                    lnEmpPicker.set(LN_EMP.find(function (x) { return x.Id === l.EmployeeId; }) || null);
                    document.getElementById("f_Type").value = l.LoanType;
                    document.getElementById("f_Amount").value = l.Amount;
                    document.getElementById("f_Count").value = l.InstallmentCount;
                    document.getElementById("f_SMonth").value = l.StartMonth;
                    document.getElementById("f_SYear").value = l.StartYear;
                    document.getElementById("f_Reason").value = l.Reason || "";
                    document.getElementById("f_Note").value = l.Note || "";
                    document.getElementById("f_Status").value = l.Status;
                }
            }
            lnCalc();
            document.getElementById("lnModalBg").classList.add("open");
        }
        function lnClose() { document.getElementById("lnModalBg").classList.remove("open"); }

        function lnSchedule(id) {
            var bg = document.getElementById("lnSchedBg");
            var body = document.getElementById("lnSchedBody");
            body.textContent = "جارٍ التحميل…";
            bg.classList.add("open");
            fetch("?handler=Schedule&id=" + id, { credentials: "same-origin" })
                .then(function (r) { return r.json(); })
                .then(function (rows) {
                    if (!rows.length) { body.textContent = "لا أقساط."; return; }
                    var html = '<table class="ln-sched"><thead><tr><th>#</th><th>الاستحقاق</th><th>المبلغ</th><th>الحالة</th></tr></thead><tbody>';
                    rows.forEach(function (r) {
                        html += "<tr><td>" + r.seqNo + "</td><td>" + r.dueText + "</td><td class='ln-num'>" +
                            (r.amount).toLocaleString() + "</td><td>" +
                            (r.isPosted ? "<span data-zy-style='color:#34d399'>مُخصَم</span>" : "<span data-zy-style='color:#facc15'>مستحق</span>") + "</td></tr>";
                    });
                    body.innerHTML = html + "</tbody></table>";
                })
                .catch(function () { body.textContent = "تعذّر التحميل."; });
        }

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") { lnClose(); document.getElementById("lnSchedBg").classList.remove("open"); }
        });
    </script>
}

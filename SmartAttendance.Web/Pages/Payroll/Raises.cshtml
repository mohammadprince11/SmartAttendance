@page "/Payroll/Raises"
@model SmartAttendance.Web.Pages.Payroll.RaisesModel
@using System.Text.Json

@{
    ViewData["Title"] = "زيادات الراتب";
    var empJson = JsonSerializer.Serialize(Model.Employees.Select(e => new { e.Id, e.No, e.Name, e.Basic }));
    string J(object o) => JsonSerializer.Serialize(o);
    string Dt(DateOnly? d) => d?.ToString("yyyy-MM-dd") ?? "";
}
<link rel="stylesheet" href="~/css/pages/raises-867dc597c8.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/mass-scope.css" asp-append-version="true" />


<section class="rz-page" dir="rtl">
    <header class="rz-head">
        <div>
            <h1>📈 زيادات الراتب</h1>
            <p>تغيير دائم للراتب الأساسي (بمبلغ أو نسبة). عند «التطبيق» يُحدَّث راتب الموظف الأساسي فوراً.</p>
        </div>
        <div class="zyu-d0cb022ba49e">
            <button type="button" class="rz-btn ghost icon" title="زيادة جماعية — نفس الزيادة لعدة موظفين" aria-label="زيادة جماعية" onclick="massOpen()">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </button>
            <button type="button" class="rz-btn ghost icon" title="استيراد من إكسل (رمز الموظف + القيمة)" aria-label="استيراد إكسل" onclick="impOpen()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </button>
            <button type="button" class="rz-btn" onclick="rzOpen(0)">+ زيادة راتب</button>
        </div>
    </header>

    <div class="rz-tabs">
        <a href="/Payroll/Raises?Tab=Pending" class="@(Model.IsApplied ? "" : "on")">قيد الانتظار (@Model.PendingCount)</a>
        <a href="/Payroll/Raises?Tab=Applied" class="@(Model.IsApplied ? "on" : "")">✔ مُطبَّقة (@Model.AppliedCount)</a>
    </div>

    <div class="rz-kpis">
        <div class="rz-kpi"><b>@Model.PendingCount</b><span>زيادات قيد الانتظار</span></div>
        <div class="rz-kpi"><b>@Model.AppliedCount</b><span>زيادات مُطبَّقة</span></div>
        <div class="rz-kpi"><b class="zyu-c15fd6731792">+@Model.TotalIncrease.ToString("#,0.##")</b><span>إجمالي الزيادة الشهرية المُطبَّقة</span></div>
        <div class="rz-kpi"><b>@Model.Employees.Count</b><span>الموظفون النشطون</span></div>
    </div>

    <form method="get" class="rz-bar">
        <input type="hidden" name="Tab" value="@Model.Tab" />
        <div class="rz-filter">
            <input type="text" name="Search" value="@Model.Search" placeholder="بحث: موظف/سبب/رقم مرجعي" class="zyu-b7e63b9b8145" />
            <button type="submit" class="rz-btn ghost sm">بحث</button>
        </div>
    </form>

    @if (TempData["PayrollMessage"] != null)
    {
        <div class="rz-alert @((TempData["PayrollOk"] as bool?) == false ? "err" : "")">@TempData["PayrollMessage"]</div>
    }

    <form method="post">
    <div class="rz-card">
        @if (Model.Items.Count == 0)
        {
            <div class="rz-empty">
                @if (Model.IsApplied)
                { <text>لا زيادات مُطبَّقة بعد.</text> }
                else
                { <text>لا زيادات قيد الانتظار — أضف بـ«+ زيادة راتب» أو زيادة جماعية.</text> }
            </div>
        }
        else
        {
            <table class="rz-table">
                <thead>
                    <tr>
                        @if (!Model.IsApplied)
                        { <th class="zyu-d12729b3d536"><input type="checkbox" onclick="rzAll(this)" /></th> }
                        <th>الرقم المرجعي</th><th>الموظف</th><th>النوع</th><th>الأساسي (قبل ← بعد)</th>
                        <th>الزيادة</th><th>تاريخ السريان</th><th>السبب</th><th>@(Model.IsApplied ? "طُبّقت في" : "الحالة")</th>
                        <th class="zyu-814fec806937">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            @if (!Model.IsApplied)
                            { <td><input type="checkbox" name="SelectedIds" value="@r.Id" onchange="rzSel()" /></td> }
                            <td class="rz-ref">@r.ReferenceNo</td>
                            <td class="rz-emp"><b>@r.EmployeeName</b><span>@r.EmployeeNo</span></td>
                            <td>
                                <span class="rz-chip @(r.RaiseType == "Percentage" ? "pct" : "amt")">
                                    @(r.RaiseType == "Percentage" ? $"{r.RaiseValue:#,0.##}%" : r.RaiseValue.ToString("#,0.##"))
                                </span>
                            </td>
                            <td class="rz-flow"><span class="old">@r.OldBasic.ToString("#,0.##")</span><span class="arrow">←</span><span class="new">@r.NewBasic.ToString("#,0.##")</span></td>
                            <td class="rz-inc">+@r.Increase.ToString("#,0.##")</td>
                            <td class="rz-ref">@(r.EffectiveDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="zyu-a49cca52becd">@(r.Reason ?? "—")</td>
                            <td>
                                @if (r.IsApplied)
                                { <span class="rz-ref zyu-a49cca52becd">@(r.AppliedAt?.ToString("yyyy-MM-dd HH:mm") ?? "")</span> }
                                else
                                { <span class="rz-chip pend">قيد الانتظار (غير مقفلة)</span> }
                            </td>
                            <td>
                                <div class="rz-actions">
                                    @if (!r.IsApplied)
                                    {
                                        <button type="submit" asp-page-handler="Apply" name="id" value="@r.Id" class="rz-btn apply sm" data-zyconfirm="تطبيق (قفل) الزيادة؟">✔ تطبيق</button>
                                        <button type="button" class="rz-btn ghost sm" onclick="rzEdit(this)" data-rz="@J(new {
                                            r.Id, r.EmployeeId, r.RaiseType, r.RaiseValue, EffectiveDate=Dt(r.EffectiveDate), r.Reason, r.Note })">تعديل</button>
                                        <button type="submit" asp-page-handler="Delete" name="id" value="@r.Id" class="rz-btn danger sm" data-zyconfirm="حذف الزيادة؟">حذف</button>
                                    }
                                    else
                                    {
                                        <span class="rz-chip ap">✔ مُطبَّقة (مقفلة)</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (!Model.IsApplied && Model.Items.Count > 0)
    {
        <div class="rz-bulkbar" id="rz-bulkbar">
            <b>المحدد: <span id="rz-selcount">0</span></b>
            <button type="submit" asp-page-handler="ApplyMany" class="rz-btn apply" data-zyconfirm="تطبيق (قفل) الزيادات المحددة على الرواتب الأساسية؟">✔ تطبيق المحدد</button>
            <button type="submit" asp-page-handler="DeleteMany" class="rz-btn danger" data-zyconfirm="حذف الزيادات المحددة؟">🗑 حذف المحدد</button>
        </div>
    }
    </form>

    @* ===== نموذج زيادة راتب ===== *@
    <div class="hrms-slideover-backdrop" id="rz-backdrop" onclick="rzClose()"></div>
    <aside class="hrms-slideover" id="rz-slide" aria-hidden="true">
        <div class="hrms-slideover-head">
            <h2 id="rz-title">زيادة راتب جديدة</h2>
            <button type="button" class="hrms-slideover-close" onclick="rzClose()">×</button>
        </div>
        <div class="hrms-slideover-body">
            <form method="post" asp-page-handler="Save" class="rz-form zyu-f0de252a84a8">
                <input type="hidden" name="Id" id="rz-Id" value="0" />
                <input type="hidden" name="RaiseType" id="rz-RaiseType" value="Amount" />

                <label>اسم الموظف *
                    <div class="empk-field">
                        <input type="text" id="rz-emp-name" class="empk-name" placeholder="اسم الموظف" readonly />
                        <input type="text" id="rz-emp-code" class="empk-code" placeholder="رمز" autocomplete="off" />
                    </div>
                    <input type="hidden" name="EmployeeId" id="rz-EmployeeId" />
                </label>

                <div class="rz-grid2">
                    <label>نوع الزيادة *
                        <span class="rz-seg" id="rz-seg">
                            <label class="on" data-type="Amount" onclick="rzSetType('Amount')"><input type="radio" name="_t" checked /> مبلغ</label>
                            <label data-type="Percentage" onclick="rzSetType('Percentage')"><input type="radio" name="_t" /> نسبة %</label>
                        </span>
                    </label>
                    <label><span id="rz-valLabel">قيمة الزيادة (مبلغ) *</span><input type="number" id="rz-RaiseValue" name="RaiseValue" step="0.01" min="0" required oninput="rzPreview()" /></label>
                </div>

                <div class="rz-preview" id="rz-preview">اختر موظفاً وأدخل قيمة الزيادة لعرض الأساسي الجديد.</div>

                <div class="rz-grid2">
                    <label>تاريخ السريان<input type="date" name="EffectiveDate" id="rz-EffectiveDate" /></label>
                    <label>السبب
                        <select name="Reason" id="rz-Reason">
                            <option value="">— اختر —</option>
                            <option value="علاوة سنوية">علاوة سنوية</option>
                            <option value="ترقية">ترقية</option>
                            <option value="تعديل هيكل الرواتب">تعديل هيكل الرواتب</option>
                            <option value="استحقاق أداء">استحقاق أداء</option>
                            <option value="أخرى">أخرى</option>
                        </select>
                    </label>
                </div>

                <label>ملاحظة<textarea name="Note" id="rz-Note" rows="2"></textarea></label>

                <p class="zyu-956cd6dad157">تُحفظ الزيادة قيد الانتظار — لا يتغيّر الراتب الأساسي إلا بعد الضغط على «تطبيق».</p>
                <button type="submit" class="rz-btn">حفظ الزيادة</button>
            </form>
        </div>
    </aside>

    @* ===== زيادة جماعية (نطاق كيان) ===== *@
    <div class="hrms-slideover-backdrop" id="mass-backdrop" onclick="massClose()"></div>
    <aside class="hrms-slideover wide" id="mass-slide" aria-hidden="true">
        <div class="hrms-slideover-head">
            <h2>👥 زيادة جماعية</h2>
            <button type="button" class="hrms-slideover-close" onclick="massClose()">×</button>
        </div>
        <div class="hrms-slideover-body">
            <form method="post" asp-page-handler="MassEntry" enctype="multipart/form-data" class="rz-form zyu-f0de252a84a8">
                <input type="hidden" name="RaiseType" id="mass-RaiseType" value="Amount" />
                <input type="hidden" name="ScopeMode" id="mass-ScopeMode" value="Manual" />

                <div class="mass-sec">معلومات الزيادة</div>
                <div class="rz-grid2">
                    <label>نوع الزيادة *
                        <span class="rz-seg" id="mass-seg">
                            <label class="on" data-type="Amount" onclick="massSetType('Amount')"><input type="radio" name="_mt" checked /> مبلغ</label>
                            <label data-type="Percentage" onclick="massSetType('Percentage')"><input type="radio" name="_mt" /> نسبة %</label>
                        </span>
                    </label>
                    <label><span id="mass-valLabel">قيمة الزيادة (مبلغ) *</span><input type="number" name="RaiseValue" step="0.01" min="0" required /></label>
                </div>
                <div class="rz-grid2">
                    <label>تاريخ السريان<input type="date" name="EffectiveDate" /></label>
                    <label>السبب
                        <select name="Reason">
                            <option value="">— اختر —</option>
                            <option value="علاوة سنوية">علاوة سنوية</option>
                            <option value="ترقية">ترقية</option>
                            <option value="تعديل هيكل الرواتب">تعديل هيكل الرواتب</option>
                            <option value="استحقاق أداء">استحقاق أداء</option>
                            <option value="أخرى">أخرى</option>
                        </select>
                    </label>
                </div>

                @* ===== النطاق — لمن تُطبَّق ===== *@
                <div class="mass-sec">النطاق — لمن تُطبَّق</div>
                <div class="mass-tabs">
                    <button type="button" class="mass-tab on" data-m="Manual" onclick="massTab('Manual')">اختيار يدوي</button>
                    <button type="button" class="mass-tab" data-m="Paste" onclick="massTab('Paste')">لصق أكواد</button>
                    <button type="button" class="mass-tab" data-m="File" onclick="massTab('File')">ملف إكسل</button>
                    <button type="button" class="mass-tab" data-m="Criteria" onclick="massTab('Criteria')">حسب معايير</button>
                </div>

                <div class="mass-pane" id="mass-pane-Manual">
                    <label>الموظفون <span id="mass-count" class="zyu-07fa33e9aa03">(0 محدد)</span></label>
                    <div class="zyu-69374f356aba">
                        <input type="text" id="mass-empsearch" placeholder="بحث بالاسم أو الرمز" oninput="massRenderEmps()"
                               class="zyu-e038610b695a" />
                        <button type="button" class="rz-btn ghost sm" onclick="massSelectAll(true)">تحديد الظاهر</button>
                        <button type="button" class="rz-btn ghost sm" onclick="massSelectAll(false)">مسح الكل</button>
                    </div>
                    <div id="mass-emplist" class="mass-list"></div>
                </div>

                <div class="mass-pane" id="mass-pane-Paste" hidden>
                    <div class="mass-paste-head">
                        <b>أكواد الموظفين <span id="mass-codecount">(0 كود)</span></b>
                        <button type="button" class="rz-btn ghost sm" onclick="massPasteClip()">📋 لصق من الحافظة</button>
                    </div>
                    <textarea name="MassCodes" id="mass-codes" rows="6" placeholder="انقر «لصق من الحافظة» أو ألصق مباشرة (Ctrl+V) — أكواد إكسل (سطر لكل كود) تتحوّل لفواصل تلقائياً"
                              oninput="massCodeCount()" onpaste="massOnPaste(event)"></textarea>
                    <p class="mass-hint">تُحلّ الأكواد إلى موظفين تلقائياً — غير المطابق يُتخطّى مع إظهار عدده.</p>
                </div>

                <div class="mass-pane" id="mass-pane-File" hidden>
                    <div class="mass-file-hint"><b class="zyu-07fa33e9aa03">تنسيق الملف:</b> عمود واحد يحوي <b>رمز الموظف</b>.</div>
                    <label>الملف (.xlsx أو .csv)<input type="file" name="massFile" accept=".xlsx,.csv" class="zyu-b87a8c000a7e" /></label>
                </div>

                <div class="mass-pane" id="mass-pane-Criteria" hidden>
                    <p class="mass-hint">تُطبَّق على <b>كل الموظفين النشطين</b> المطابقين للمعايير.</p>
                    <div class="rz-grid2">
                        <label>القسم<select name="MassDept"><option value="">كل الأقسام</option>@foreach (var s in Model.AllDepartments){<option value="@s">@s</option>}</select></label>
                        <label>الفرع<select name="MassBranch"><option value="">كل الفروع</option>@foreach (var s in Model.AllBranches){<option value="@s">@s</option>}</select></label>
                    </div>
                    <label>المسمى الوظيفي<select name="MassJobTitle"><option value="">كل المسميات</option>@foreach (var s in Model.AllJobTitles){<option value="@s">@s</option>}</select></label>
                </div>

                <p class="mass-hint">تُنشأ زيادة <b>قيد الانتظار</b> لكل موظف — طبّقها لاحقاً فردياً أو بالتحديد الجماعي.</p>
                <button type="submit" class="rz-btn">حفظ الزيادات الجماعية</button>
            </form>
        </div>
    </aside>

    @* ===== استيراد إكسل ===== *@
    <div class="hrms-slideover-backdrop" id="imp-backdrop" onclick="impClose()"></div>
    <aside class="hrms-slideover" id="imp-slide" aria-hidden="true">
        <div class="hrms-slideover-head">
            <h2>⬆ استيراد الزيادات (إكسل / CSV)</h2>
            <button type="button" class="hrms-slideover-close" onclick="impClose()">×</button>
        </div>
        <div class="hrms-slideover-body">
            <form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="rz-form zyu-f0de252a84a8">
                <div class="mass-file-hint">
                    <b class="zyu-07fa33e9aa03">أعمدة الملف (الصف الأول ترويسة تُتجاهل):</b><br />
                    A: رمز الموظف · B: القيمة · C: النوع (مبلغ / نسبة — اختياري، افتراضي مبلغ) · D: السبب (اختياري)
                </div>
                <label>الملف (.xlsx أو .csv) *<input type="file" name="importFile" accept=".xlsx,.csv" required class="zyu-b87a8c000a7e" /></label>
                <button type="submit" class="rz-btn">استيراد</button>
            </form>
        </div>
    </aside>
</section>

@section Scripts {
    <script src="~/js/emp-picker.js" asp-append-version="true"></script>
    <script src="~/js/mass-scope.js" asp-append-version="true"></script>
    <script>
        var RZ_EMP = @Html.Raw(empJson);
        window.MASS_EMP = RZ_EMP;
        var rzCurrentBasic = 0;

        function fmt(n){ return (Math.round(n*100)/100).toLocaleString('en-US', {minimumFractionDigits:0, maximumFractionDigits:2}); }

        var rzPicker = EmpPicker.init({
            code: document.getElementById('rz-emp-code'),
            name: document.getElementById('rz-emp-name'),
            hidden: document.getElementById('rz-EmployeeId'),
            employees: RZ_EMP,
            onChange: function(e){ rzCurrentBasic = e ? (e.Basic || 0) : 0; rzPreview(); }
        });

        function rzSetType(t){
            document.getElementById('rz-RaiseType').value = t;
            document.querySelectorAll('#rz-seg label').forEach(function(l){ l.classList.toggle('on', l.getAttribute('data-type')===t); });
            document.getElementById('rz-valLabel').textContent = t==='Percentage' ? 'نسبة الزيادة (%) *' : 'قيمة الزيادة (مبلغ) *';
            rzPreview();
        }

        function rzPreview(){
            var el = document.getElementById('rz-preview');
            var v = parseFloat(document.getElementById('rz-RaiseValue').value) || 0;
            var type = document.getElementById('rz-RaiseType').value;
            if (!document.getElementById('rz-EmployeeId').value){ el.innerHTML = 'اختر موظفاً وأدخل قيمة الزيادة لعرض الأساسي الجديد.'; return; }
            var oldB = rzCurrentBasic;
            var newB = type==='Percentage' ? oldB*(1+v/100) : oldB+v;
            var inc = newB - oldB;
            el.innerHTML = '<span class="flow"><span class="old">' + fmt(oldB) + '</span><span class="arrow">←</span><span class="new">' + fmt(newB) + '</span></span>'
                + '<small>الزيادة: +' + fmt(inc) + (type==='Percentage' ? (' (' + fmt(v) + '%)') : '') + '</small>';
        }

        function setVal(id, v){ var el=document.getElementById(id); if(el) el.value = (v==null?'':v); }

        function rzEdit(btn){
            try { var d = JSON.parse(btn.getAttribute('data-rz')); rzOpen(d.Id, d); }
            catch (e) { alert('تعذّر فتح التعديل: ' + e.message); }
        }

        function rzOpen(id, d){
            var f = document.querySelector('#rz-slide form'); f.reset();
            document.getElementById('rz-Id').value = id || 0;
            document.getElementById('rz-title').textContent = id ? 'تعديل زيادة' : 'زيادة راتب جديدة';
            rzCurrentBasic = 0;
            rzPicker.set(null);
            rzSetType('Amount');

            if (id && d){
                var emp = RZ_EMP.find(function(x){ return x.Id === d.EmployeeId; });
                rzPicker.set(emp || null);   // يضبط rzCurrentBasic عبر onChange
                rzSetType(d.RaiseType || 'Amount');
                setVal('rz-RaiseValue', d.RaiseValue);
                setVal('rz-EffectiveDate', d.EffectiveDate);
                setVal('rz-Reason', d.Reason || '');
                setVal('rz-Note', d.Note);
            } else {
                setVal('rz-EffectiveDate', new Date().toISOString().slice(0,10));
            }
            rzPreview();
            document.getElementById('rz-slide').classList.add('open');
            document.getElementById('rz-backdrop').classList.add('open');
        }
        function rzClose(){ document.getElementById('rz-slide').classList.remove('open'); document.getElementById('rz-backdrop').classList.remove('open'); }

        // ===== تحديد الصفوف + بار عائم =====
        function rzAll(cb){ document.querySelectorAll('[name=SelectedIds]').forEach(function(x){x.checked=cb.checked;}); rzSel(); }
        function rzSel(){
            var bar = document.getElementById('rz-bulkbar'); if(!bar) return;
            var n = document.querySelectorAll('[name=SelectedIds]:checked').length;
            var c = document.getElementById('rz-selcount'); if(c) c.textContent = n;
            bar.classList.toggle('show', n > 0);
        }

        // ===== زيادة جماعية =====
        function massSetType(t){
            document.getElementById('mass-RaiseType').value = t;
            document.querySelectorAll('#mass-seg label').forEach(function(l){ l.classList.toggle('on', l.getAttribute('data-type')===t); });
            document.getElementById('mass-valLabel').textContent = t==='Percentage' ? 'نسبة الزيادة (%) *' : 'قيمة الزيادة (مبلغ) *';
        }
        function massOpen(){
            document.querySelector('#mass-slide form').reset();
            massSetType('Amount');
            massBuildEmps(); massRenderEmps(); massCount(); massTab('Manual');
            document.getElementById('mass-slide').classList.add('open'); document.getElementById('mass-backdrop').classList.add('open');
        }
        function massClose(){ document.getElementById('mass-slide').classList.remove('open'); document.getElementById('mass-backdrop').classList.remove('open'); }
        function impOpen(){ document.getElementById('imp-slide').classList.add('open'); document.getElementById('imp-backdrop').classList.add('open'); }
        function impClose(){ document.getElementById('imp-slide').classList.remove('open'); document.getElementById('imp-backdrop').classList.remove('open'); }

        document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ rzClose(); massClose(); impClose(); } });
    </script>
}

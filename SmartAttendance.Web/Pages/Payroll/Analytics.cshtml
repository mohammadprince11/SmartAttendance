@page "/Payroll/Analytics"
@model SmartAttendance.Web.Pages.Payroll.AnalyticsModel
@{
    ViewData["Title"] = "رسوم الرواتب";
    decimal Pct(decimal v, decimal max) => max <= 0 ? 0 : Math.Round(v / max * 100m, 1);
    var b = Model.Breakdown;
    var totalOut = b.Basic + b.Allowances; // إجمالي قبل الاستقطاع
    decimal Seg(decimal v) => totalOut <= 0 ? 0 : Math.Round(v / totalOut * 100m, 1);
}
<link rel="stylesheet" href="~/css/pages/analytics-4497d48a04.css" asp-append-version="true" />


<section class="pa-page" dir="rtl">
    <header class="pa-head">
        <div>
            <h1>رسوم الرواتب</h1>
            <p>اتجاه الأجور شهرياً وتفكيك آخر مسير — مشتقّة من الدفعات المحتسبة.</p>
        </div>
        @if (Model.Companies.Count > 1)
        {
            <form method="get" class="pa-filter">
                <span>الشركة:</span>
                <select name="CompanyId" onchange="this.form.submit()">
                    <option value="0" selected="@(!(Model.CompanyId > 0))">كل الشركات</option>
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.Id" selected="@(Model.CompanyId == c.Id)">@c.Name</option>
                    }
                </select>
            </form>
        }
    </header>

    <div class="pa-kpis">
        <div class="pa-kpi zyu-7198287e0e8a"><b>@Model.YearGross.ToString("#,0")</b><span>إجمالي الأجور (12 شهراً)</span></div>
        <div class="pa-kpi zyu-2b7d3f92b385"><b>@Model.YearNet.ToString("#,0")</b><span>صافي مدفوع (12 شهراً)</span></div>
        <div class="pa-kpi zyu-8b6a7c0b3c73"><b>@Model.YearGosi.ToString("#,0")</b><span>حصة الشركة — الضمان</span></div>
        <div class="pa-kpi zyu-1107ff14a820"><b>@Model.Breakdown.Employees</b><span>موظفو آخر مسير · @Model.Breakdown.PeriodLabel</span></div>
    </div>

    <div class="pa-grid">
        <div class="pa-card">
            <h3>الإجمالي مقابل الصافي — شهرياً</h3>
            <div class="sub">آخر 12 دورة مسير</div>
            <div class="pa-legend">
                <span><i class="zyu-e5ea0bf4d874"></i>الإجمالي</span>
                <span><i class="zyu-f71302e3f7df"></i>الصافي</span>
            </div>
            @if (Model.Series.Count == 0)
            {
                <div class="pa-empty">لا دفعات محتسبة بعد.</div>
            }
            else
            {
                <div class="pa-chart">
                    @foreach (var p in Model.Series)
                    {
                        <div class="pa-col">
                            <div class="pa-bars">
                                <div class="pa-bar g" data-zy-style="height:@(Pct(p.Gross, Model.MaxGross))%" title="إجمالي @p.Label: @p.Gross.ToString("#,0")"></div>
                                <div class="pa-bar n" data-zy-style="height:@(Pct(p.Net, Model.MaxGross))%" title="صافي @p.Label: @p.Net.ToString("#,0")"></div>
                            </div>
                            <div class="pa-xlabel">@p.Label</div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="pa-card">
            <h3>حصة الشركة — الضمان الاجتماعي شهرياً</h3>
            <div class="sub">تكلفة صاحب العمل عبر الدورات</div>
            <div class="pa-legend"><span><i class="zyu-c847403c4978"></i>حصة الشركة</span></div>
            @if (Model.Series.Count == 0)
            {
                <div class="pa-empty">لا بيانات.</div>
            }
            else
            {
                <div class="pa-chart">
                    @foreach (var p in Model.Series)
                    {
                        <div class="pa-col">
                            <div class="pa-bars">
                                <div class="pa-bar gs" data-zy-style="width:20px;height:@(Pct(p.GosiCompany, Model.MaxGosi))%" title="@p.Label: @p.GosiCompany.ToString("#,0")"></div>
                            </div>
                            <div class="pa-xlabel">@p.Label</div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="pa-card zyu-75be3216d07d">
            <h3>تفكيك آخر مسير — @Model.Breakdown.PeriodLabel</h3>
            <div class="sub">كيف يتكوّن الإجمالي وأين يذهب</div>
            @if (Model.Breakdown.Employees == 0)
            {
                <div class="pa-empty">لا مسير محتسب لعرض تركيبه.</div>
            }
            else
            {
                <div class="pa-stack">
                    <div class="pa-seg" data-zy-style="flex:@Seg(b.Basic);background:#12D9E3" title="أساسي">@(Seg(b.Basic) >= 8 ? "أساسي" : "")</div>
                    <div class="pa-seg" data-zy-style="flex:@Seg(b.Allowances);background:#60a5fa" title="علاوات">@(Seg(b.Allowances) >= 8 ? "علاوات" : "")</div>
                </div>
                <div class="pa-rows">
                    <div class="pa-row"><span class="lbl"><i class="zyu-e5ea0bf4d874"></i>الأساسي</span><span class="val">@b.Basic.ToString("#,0.##")</span></div>
                    <div class="pa-row"><span class="lbl"><i class="zyu-6564e555e13a"></i>العلاوات</span><span class="val">@b.Allowances.ToString("#,0.##")</span></div>
                    <div class="pa-row zyu-3808165fdccb"><span class="lbl"><i class="zyu-16280ad178fd"></i>الضريبة</span><span class="val">@b.Tax.ToString("#,0.##")</span></div>
                    <div class="pa-row"><span class="lbl"><i class="zyu-f9437ec20e24"></i>ضمان الموظف</span><span class="val">@b.GosiEmployee.ToString("#,0.##")</span></div>
                    <div class="pa-row"><span class="lbl"><i class="zyu-e272c5493a75"></i>استقطاعات أخرى</span><span class="val">@b.OtherDeductions.ToString("#,0.##")</span></div>
                    <div class="pa-row zyu-3808165fdccb"><span class="lbl"><i class="zyu-f71302e3f7df"></i>الصافي المدفوع</span><span class="val zyu-22d70a2892cd">@b.Net.ToString("#,0.##")</span></div>
                    <div class="pa-row"><span class="lbl"><i class="zyu-c847403c4978"></i>حصة الشركة (الضمان)</span><span class="val zyu-82b0a99c0d42">@b.GosiCompany.ToString("#,0.##")</span></div>
                </div>
            }
        </div>
    </div>
</section>

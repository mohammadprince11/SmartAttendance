@page "/Payroll/RunDetail"
@model SmartAttendance.Web.Pages.Payroll.RunDetailModel
@using System.Text.Json

@{
    ViewData["Title"] = "تفاصيل المسير";
    var payslipJson = JsonSerializer.Serialize(Model.Lines.Select(l => new
    {
        l.EmployeeId, l.EmployeeNo, l.EmployeeName, l.Department, l.Position,
        l.BasicSalary, l.TotalAllowances, l.GrossSalary,
        l.TaxAmount, l.GosiEmployee, l.GosiCompany, l.OtherDeductions,
        l.TotalDeductions, l.NetSalary, l.EmployerCost, l.WorkDays, l.AbsentDays, l.DaysBasis,
        l.AttendanceBase, l.AttendanceFactor, l.TaxBase, l.TaxBaseSource, l.GosiBase, l.GosiBaseSource,
        l.SourceCurrency, l.PayrollCurrency, l.ExchangeRate, l.ExchangeRateDate,
        Earnings = l.Earnings.Select(c => new { c.ItemName, c.Amount }),
        Deductions = l.Deductions.Select(c => new { c.ItemName, c.Amount })
    }));
}
<link rel="stylesheet" href="~/css/pages/rundetail-261651ce56.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />


<section class="pd-page" dir="rtl">
    <header class="pd-head">
        <div>
            <h1>مسير @Model.Run!.BatchNoText — @Model.Run.PeriodText</h1>
            <p>@Model.CompanyName · الحالة: @Model.Run.StatusLabelText · @Model.Run.EmployeeCount موظفاً · محتسب بواسطة @(Model.Run.CalculatedBy ?? "—") @(Model.Run.CalculatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "")</p>
        </div>
        <div class="zyu-39c68df36fcc">
            @* ملف البنك بعد الإصدار فقط؛ القفل يثبت الأرقام لكنه ليس إذن صرف. *@
            @if (Model.Run.Status is "Issued" or "PayslipSent")
            {
                <span class="zyu-7c98e3f28444">
                    <select id="bankTemplate" class="pd-btn ghost zyu-9463ff4798ce">
                        @foreach (var t in Model.BankTemplates)
                        { <option value="@t.Id" selected="@t.IsDefault">@t.Name@(string.IsNullOrWhiteSpace(t.BankName) ? "" : $" — {t.BankName}")</option> }
                    </select>
                    <a class="pd-btn" id="bankExport" href="/Payroll/RunDetail?id=@Model.Id&handler=BankFile"
                       onclick="this.href='/Payroll/RunDetail?id=@Model.Id&handler=BankFile&templateId='+document.getElementById('bankTemplate').value">🏦 ملف البنك</a>
                    <a class="pd-btn ghost" href="/Payroll/BankTemplates" title="إدارة قوالب البنوك">⚙</a>
                </span>
            }
            @if (Model.Run.Status is "Issued" or "PayslipSent")
            {
                <span class="zyu-f219d26e03dc">
                    <a class="pd-btn" href="/Payroll/RunDetail?id=@Model.Id&handler=ExportAccountingJournal&format=csv">📒 قيد CSV</a>
                    <a class="pd-btn ghost" href="/Payroll/RunDetail?id=@Model.Id&handler=ExportAccountingJournal&format=json">JSON</a>
                    <a class="pd-btn ghost" href="/Integrations/Accounting?CompanyId=@Model.Run.CompanyId" title="خرائط الحسابات">⚙</a>
                </span>
            }
            else
            {
                <span class="pd-btn ghost zyu-d48f9c56ca36"
                      title="أصدر الدفعة للصرف أولاً">🏦 ملف البنك</span>
            }
            <a class="pd-btn ghost" href="/Payroll/Runs">← عودة للمسيرات</a>
        </div>
    </header>

    <div class="pd-totals">
        <div class="pd-stat zyu-7198287e0e8a"><b>@Model.Run.TotalGross.ToString("#,0.##")</b><span>إجمالي الرواتب</span></div>
        <div class="pd-stat zyu-26ddd0fbdc9d"><b>@Model.TotalDeductions.ToString("#,0.##")</b><span>إجمالي الاستقطاعات</span></div>
        <div class="pd-stat zyu-2b7d3f92b385"><b class="pd-net">@Model.Run.TotalNet.ToString("#,0.##")</b><span>صافي المدفوع</span></div>
        <div class="pd-stat zyu-1107ff14a820"><b>@Model.Run.TotalTax.ToString("#,0.##")</b><span>ضريبة الدخل</span></div>
        <div class="pd-stat zyu-8b6a7c0b3c73"><b>@Model.TotalGosiEmployee.ToString("#,0.##")</b><span>ضمان (موظفون)</span></div>
        <div class="pd-stat zyu-0089fb1aa1e1"><b>@Model.TotalEmployerCost.ToString("#,0.##")</b><span>تكلفة صاحب العمل</span></div>
    </div>

    <div class="pd-card">
        <table class="pd-table">
            <thead>
                <tr>
                    <th>الموظف</th><th>القسم</th><th>الأساسي</th><th>العلاوات</th><th>الإجمالي</th>
                    <th>الضريبة</th><th>الضمان</th><th>خصومات أخرى</th><th>الصافي</th><th>حضور/غياب</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr onclick="pdSlip(@l.EmployeeId)">
                        <td class="pd-emp"><b>@l.EmployeeName</b><span>@l.EmployeeNo@(string.IsNullOrWhiteSpace(l.Position) ? "" : $" · {l.Position}")</span></td>
                        <td class="zyu-a49cca52becd">@(string.IsNullOrWhiteSpace(l.Department) ? "—" : l.Department)</td>
                        <td class="pd-n">@l.BasicSalary.ToString("#,0.##")</td>
                        <td class="pd-n">@l.TotalAllowances.ToString("#,0.##")</td>
                        <td class="pd-n">@l.GrossSalary.ToString("#,0.##")</td>
                        <td class="pd-n">@l.TaxAmount.ToString("#,0.##")</td>
                        <td class="pd-n">@l.GosiEmployee.ToString("#,0.##")</td>
                        <td class="pd-n">@l.OtherDeductions.ToString("#,0.##")</td>
                        <td class="pd-n pd-net">@l.NetSalary.ToString("#,0.##")</td>
                        @{ var basis = l.DaysBasis > 0 ? l.DaysBasis : l.WorkDays; }
                        <td class="pd-n">@(basis > 0 ? (int)Math.Round(basis * (l.AttendanceFactor == 0 ? 1m : l.AttendanceFactor), MidpointRounding.AwayFromZero) : 0)/@basis</td>
                        <td><button type="button" class="pd-btn ghost" onclick="event.stopPropagation();pdSlip(@l.EmployeeId)">قسيمة</button></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2">الإجمالي (@Model.Lines.Count موظفاً)</td>
                    <td class="pd-n">@Model.Lines.Sum(l => l.BasicSalary).ToString("#,0.##")</td>
                    <td class="pd-n">@Model.Lines.Sum(l => l.TotalAllowances).ToString("#,0.##")</td>
                    <td class="pd-n">@Model.Run.TotalGross.ToString("#,0.##")</td>
                    <td class="pd-n">@Model.Run.TotalTax.ToString("#,0.##")</td>
                    <td class="pd-n">@Model.TotalGosiEmployee.ToString("#,0.##")</td>
                    <td class="pd-n">@Model.TotalOther.ToString("#,0.##")</td>
                    <td class="pd-n pd-net">@Model.Run.TotalNet.ToString("#,0.##")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>

    @*
        الرواتب المستثناة — نظير تبويب كيان. كانت الأسباب عدّاداً مجمّعاً بسطر
        الرسالة فقط، فسؤال «لماذا لم يُحتسب فلان؟» يحتاج قراءة كود. الآن كل اسم
        بسببه وبسبيل معالجته. لا يظهر القسم أصلاً حين لا يُستبعَد أحد.
    *@
    @if (Model.Exclusions.Count > 0)
    {
        <div class="pd-card zyu-92c18f6bdac1">
            <div class="zyu-9ff0dc70c8af">
                <b class="zyu-a3970b9f8a9d">الرواتب المستثناة (@Model.Exclusions.Count)</b>
                <div class="zyu-c1212ea2dbff">
                    موظفون ضمن نطاق الدفعة ولم تُحتسب رواتبهم — عالِج السبب ثم أعد الاحتساب.
                </div>
            </div>
            <table class="pd-table">
                <thead>
                    <tr><th>الموظف</th><th>التصنيف</th><th>السبب وسبيل المعالجة</th></tr>
                </thead>
                <tbody>
                    @foreach (var x in Model.Exclusions)
                    {
                        <tr>
                            <td class="pd-emp"><b>@x.EmployeeName</b><span>@x.EmployeeNo</span></td>
                            <td class="zyu-be1cb027d677">@x.ReasonLabel</td>
                            <td class="zyu-a49cca52becd">@x.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* قسيمة راتب احترافية *@
    <div class="hrms-slideover-backdrop" id="pd-backdrop" onclick="pdClose()"></div>
    <aside class="hrms-slideover wide" id="pd-slide" aria-hidden="true">
        <div class="hrms-slideover-head">
            <h2>قسيمة راتب</h2>
            <div class="zyu-9c40389b4ad8">
                <button type="button" class="pd-btn pd-print-btn" onclick="window.print()">🖨 طباعة</button>
                <button type="button" class="hrms-slideover-close" onclick="pdClose()">×</button>
            </div>
        </div>
        <div class="hrms-slideover-body" id="pd-slip"></div>
    </aside>
</section>

@section Scripts {
    <script>
        var PD_DATA = @Html.Raw(payslipJson);
        var PD_PERIOD = "@Model.Run.PeriodText";
        var PD_BATCH = "@Model.Run.BatchNoText";
        var PD_CO = @Html.Raw(JsonSerializer.Serialize(Model.CompanyName));

        function fmt(n) { return Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
        function traceSrc(s) {
            if (s === 'Employee') return 'راتب مُدخَل بالملف المالي';
            if (s === 'EmployeeMissing') return '⚠ مُعرَّف بلا قيمة — من المكوّنات مؤقتاً';
            return 'مُركَّب من المكوّنات';
        }

        function pdSlip(empId) {
            var l = PD_DATA.find(function (x) { return x.EmployeeId === empId; });
            if (!l) return;
            var earnRows = (l.Earnings || []).map(function (c) {
                return '<div class="row"><span>' + c.ItemName + '</span><b>' + fmt(c.Amount) + '</b></div>';
            }).join('');
            var dedRows = (l.Deductions || []).map(function (c) {
                return '<div class="row"><span>' + c.ItemName + '</span><b>' + fmt(c.Amount) + '</b></div>';
            }).join('');
            if (!dedRows) dedRows = '<div class="row"><span>لا استقطاعات</span><b>0.00</b></div>';

            var html =
              '<div class="pd-slip-doc">' +
                '<div class="pd-slip-top">' +
                  '<div class="co">' + PD_CO + '<small>قسيمة راتب رسمية</small></div>' +
                  '<div class="lbl"><b>' + PD_PERIOD + '</b><span>دفعة ' + PD_BATCH + '</span></div>' +
                '</div>' +
                '<div class="pd-slip-emp">' +
                  '<div><span>الموظف</span> <b>' + l.EmployeeName + '</b></div>' +
                  '<div><span>الرقم الوظيفي</span> <b>' + l.EmployeeNo + '</b></div>' +
                  '<div><span>القسم</span> <b>' + (l.Department || '—') + '</b></div>' +
                  '<div><span>المنصب</span> <b>' + (l.Position || '—') + '</b></div>' +
                  // «0 / 0» كانت تعني «لا بيانات حضور» وتُدفع كاملاً بلا تمييز عن الدوام
                  // الكامل. الحالة تُعلَن الآن نصّاً بالقسيمة نفسها لا تُترك للتخمين.
                  (l.WorkDays > 0
                    ? (function(){ var basis = l.DaysBasis > 0 ? l.DaysBasis : l.WorkDays;
                        return '<div><span>أيام مدفوعة (مكافئة)</span> <b>' + Math.round(basis * (Number(l.AttendanceFactor) || 1)) + ' / ' + basis + '</b></div>' +
                      '<div><span>أيام الغياب</span> <b>' + l.AbsentDays + '</b></div>'; })()
                    : '<div class="zyu-51377a917eb3"><span>الحضور</span> <b class="zyu-c42b22562633">بلا بيانات حضور لهذا الشهر — دُفع الأساسي كاملاً</b></div>') +
                '</div>' +
                '<div class="pd-slip-cols">' +
                  '<div class="pd-slip-box earn"><h4>الاستحقاقات</h4>' + earnRows +
                    '<div class="sum"><span>إجمالي الاستحقاقات</span><b>' + fmt(l.GrossSalary) + '</b></div></div>' +
                  '<div class="pd-slip-box ded"><h4>الاستقطاعات</h4>' + dedRows +
                    '<div class="sum"><span>إجمالي الاستقطاعات</span><b>' + fmt(l.TotalDeductions) + '</b></div></div>' +
                '</div>' +
                '<div class="pd-slip-net"><span>صافي الراتب المستحق</span><b>' + fmt(l.NetSalary) + ' ' + (l.PayrollCurrency || '') + '</b></div>' +
                // أثر الاحتساب (Phase 15): من أين جاء كل وعاء ولماذا — للموارد البشرية.
                '<div class="pd-slip-trace">' +
                  '<h4>أثر الاحتساب</h4>' +
                  '<div class="row"><span>وعاء الحضور</span><b>' + fmt(l.AttendanceBase) + ' × معامل ' + Number(l.AttendanceFactor || 1).toFixed(4) + '</b></div>' +
                  '<div class="row"><span>وعاء الضريبة</span><b>' + fmt(l.TaxBase) + ' <small>(' + traceSrc(l.TaxBaseSource) + ')</small></b></div>' +
                  '<div class="row"><span>وعاء الضمان</span><b>' + fmt(l.GosiBase) + ' <small>(' + traceSrc(l.GosiBaseSource) + ')</small></b></div>' +
                  ((l.SourceCurrency && l.PayrollCurrency && l.SourceCurrency !== l.PayrollCurrency)
                    ? '<div class="row"><span>تحويل العملة</span><b>1 ' + l.SourceCurrency + ' = ' + Number(l.ExchangeRate).toFixed(8) + ' ' + l.PayrollCurrency + ' <small>(' + (l.ExchangeRateDate || '—') + ')</small></b></div>'
                    : '') +
                '</div>' +
                '<div class="pd-slip-emp2">' +
                  '<div>مساهمة الشركة (ضمان): <b>' + fmt(l.GosiCompany) + '</b></div>' +
                  '<div>التكلفة الكلية على صاحب العمل: <b>' + fmt(l.EmployerCost) + '</b></div>' +
                '</div>' +
                '<div class="pd-slip-sign">' +
                  '<div><div class="line"></div>توقيع الموظف</div>' +
                  '<div><div class="line"></div>الموارد البشرية / المالية</div>' +
                '</div>' +
              '</div>';

            document.getElementById('pd-slip').innerHTML = html;
            document.getElementById('pd-slide').classList.add('open');
            document.getElementById('pd-backdrop').classList.add('open');
        }
        function pdClose() {
            document.getElementById('pd-slide').classList.remove('open');
            document.getElementById('pd-backdrop').classList.remove('open');
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') pdClose(); });

        // القدوم من «استعلام القسائم» (?emp=): افتح قسيمة ذلك الموظف تحديداً تلقائياً.
        (function () {
            var emp = parseInt(new URLSearchParams(location.search).get('emp') || '0', 10);
            if (emp > 0 && typeof pdSlip === 'function') pdSlip(emp);
        })();
    </script>
}

@page "/DayAttendance"
@model SmartAttendance.Web.Pages.DayAttendance.IndexModel
@using SmartAttendance.Web.Infrastructure.Hrms

@*
    الحضور اليومي — المرحلة 3 من مودل الحضور الجديد (نمط كيان):
    يوميات بالحقول المشتقة + «تحديث الحضور» (إعادة بناء الشهر من البصمات).
*@

@{
    ViewData["Title"] = "الحضور اليومي";
}
<link rel="stylesheet" href="~/css/pages/index-f84a9abfe5.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/hrms-core.css" asp-append-version="true" />


<section class="dat-page" dir="rtl">
    <partial name="_AttendanceViews" />
    <header class="dat-head">
        <div>
            <h1>الحضور اليومي</h1>
            <p>يوميات موظف×يوم بالحقول المشتقة: تأخير، خروج مبكر، ساعات عمل، حالة — المرحلة 3 من محرك الحضور.</p>
        </div>
        <form method="post" asp-page-handler="Analyze" class="zyu-103386265ead">
            <input type="hidden" name="Month" value="@Model.Month" />
            <input type="hidden" name="Search" value="@Model.Search" />
            @* بلا `required`: التحليل يقرأ مناوبة كل موظف المسنَدة، وهذا الحقل احتياطُ
               غير المسنَدين وحدهم. إجبار الاختيار كان يوهم أن التحليل «على مناوبة». *@
            <label class="zyu-dd4fdd075935">
                احتياط غير المسنَدين (اختياري)
                <select name="ShiftTypeId" class="zyu-60557d7c6632">
                    <option value="">— تلقائي: مناوبة كل موظف —</option>
                    @foreach (var shift in Model.Shifts)
                    {
                        <option value="@shift.Id">@shift.Name</option>
                    }
                </select>
            </label>
            <button type="submit" class="dat-btn" data-zyconfirm="يعيد بناء الشهر — تأكيد؟">تحديث الحضور</button>
        </form>

        @* 🔔 إشعار الموظفين — نطاقه **العرض الحالي** لا مؤلّف نطاقٍ مستقل. العدد
           على الزرّ كي يُعرف حجم الإرسال قبل الضغط. *@
        <button type="button" class="dat-btn ghost" onclick="datNotify(true)"
                title="إشعار موظفي العرض الحالي بملخّص حضورهم"
                disabled="@(Model.NotifyEmployeeCount == 0)">
            🔔 إشعار الموظفين <b>@Model.NotifyEmployeeCount</b>
        </button>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="dat-alert">@TempData["SuccessMessage"]</div>
    }

    @if (Model.LastSkips.Count > 0)
    {
        <div class="dat-skips">
            <h4>استُثني @Model.LastSkips.Count موظفاً — ولماذا</h4>
            <ul>
                @foreach (var skip in Model.LastSkips)
                {
                    <li>@skip.EmployeeName — @skip.Reason</li>
                }
            </ul>
        </div>
    }

    <form method="get" class="dat-bar">
        <label>الشهر
            <input type="month" name="Month" value="@Model.Month" />
        </label>
        <label>بحث (رمز/اسم موظف)
            <input type="text" name="Search" value="@Model.Search" placeholder="بحث..." />
            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
        </label>
        <button type="submit" class="dat-btn ghost">عرض</button>
        <div class="dat-stats zyu-a3d4b1c97186">
@{
    // الضغط على عدّاد يفلتر عليه، والضغط عليه وهو نشط يرفع الفلتر — فلا يعلق
    // المستخدم بحالةٍ لا يعرف كيف يخرج منها.
    Func<string, string?> toggle = key => Model.StatusFilter == key ? null : key;
}
            <a class="dat-stat present @(Model.StatusFilter == "Present" ? "is-active" : null)"
               asp-route-Month="@Model.Month" asp-route-Search="@Model.Search"
               asp-route-StatusFilter="@toggle("Present")" asp-route-PageNumber="1"
               title="اعرض الحاضرين فقط">حاضر <b>@Model.PresentCount</b></a>
            <a class="dat-stat late @(Model.StatusFilter == "Late" ? "is-active" : null)"
               asp-route-Month="@Model.Month" asp-route-Search="@Model.Search"
               asp-route-StatusFilter="@toggle("Late")" asp-route-PageNumber="1"
               title="اعرض المتأخرين فقط">متأخر <b>@Model.LateCount</b></a>
            <a class="dat-stat incomplete @(Model.StatusFilter == "Incomplete" ? "is-active" : null)"
               asp-route-Month="@Model.Month" asp-route-Search="@Model.Search"
               asp-route-StatusFilter="@toggle("Incomplete")" asp-route-PageNumber="1"
               title="اعرض البصمات الناقصة فقط">بصمة ناقصة <b>@Model.IncompleteCount</b></a>
            <a class="dat-stat absent @(Model.StatusFilter == "Absent" ? "is-active" : null)"
               asp-route-Month="@Model.Month" asp-route-Search="@Model.Search"
               asp-route-StatusFilter="@toggle("Absent")" asp-route-PageNumber="1"
               title="اعرض الغائبين فقط">غائب <b>@Model.AbsentCount</b></a>
            <a class="dat-stat stale @(Model.StatusFilter == IndexModel.StaleFilterKey ? "is-active" : null)"
               asp-route-Month="@Model.Month" asp-route-Search="@Model.Search"
               asp-route-StatusFilter="@toggle(IndexModel.StaleFilterKey)" asp-route-PageNumber="1"
               title="يوميات طرأ عليها تغيير بعد التحليل (طلب معتمد أو تعديل بصمة) ولم تُحتسب بعد">لم تُحلَّل <b>@Model.StaleCount</b></a>
            @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
            {
                <a class="dat-stat dat-stat-clear"
                   asp-route-Month="@Model.Month" asp-route-Search="@Model.Search"
                   asp-route-PageNumber="1">✕ إلغاء الفلتر</a>
            }
        </div>
    </form>

    <div class="dat-table-card">
        @if (Model.Rows.Count == 0)
        {
            <div class="dat-empty">لا يوميات لهذا الشهر — استخدم «تحديث الحضور» لبنائها من البصمات الخام.</div>
        }
        else
        {
            <table class="dat-table">
                <thead>
                    <tr>
                        <th class="dat-pick-col">
                            @* تحديد الكل = صفوف **هذه الصفحة** لا الشهر كلّه: الإرسال
                               يحمل ما تراه، فوعدُ «الكل» على 50 صفاً معروضاً صادق. *@
                            <input type="checkbox" class="dat-pick" id="dat-pick-all"
                                   onchange="datPickAll(this.checked)" title="تحديد كل صفوف الصفحة" />
                        </th>
                        <th>الكود</th><th>الموظف</th><th>التاريخ</th><th>المناوبة</th><th>ختم الدخول</th><th>ختم الخروج</th>
                        <th>ساعات العمل</th><th>ساعات التأخير</th><th>الخروج المبكر</th><th>الحالة</th><th>تم التحليل</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        @* نافذة الدوام والبصمتان تُحمَل على الصفّ نفسه ليقترح المتصفح وقت
                           المغادرة من التأخير/الخروج المبكر بلا رحلة خادم — والقيم هي
                           عين ما يعرضه الصفّ، فلا يُقترح ما لا يراه المستخدم. *@
                        var window = Model.ShiftWindow(row);
                        <tr>
                            <td class="dat-pick-col">
                                <input type="checkbox" class="dat-pick dat-row-pick"
                                       value="@row.EmployeeId|@row.WorkDate.ToString("yyyy-MM-dd")"
                                       data-name="@row.EmployeeName"
                                       data-start="@window.Start" data-end="@window.End"
                                       data-in="@(row.CheckIn?.ToString("HH:mm"))"
                                       data-out="@(row.CheckOut?.ToString("HH:mm"))"
                                       data-late="@row.LateHours.ToString("0.##")"
                                       data-early="@row.EarlyLeaveHours.ToString("0.##")"
                                       aria-label="تحديد يومية @row.EmployeeName @row.WorkDate.ToString("yyyy-MM-dd")"
                                       onchange="datPickChanged(this)" />
                            </td>
                            <td class="dat-num">@row.EmployeeNo</td>
                            <td><b>@row.EmployeeName</b></td>
                            <td class="dat-num">@row.WorkDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (row.ShiftName != null)
                                {
                                    <span class="dat-shift"><i data-zy-style="background:@(row.ShiftColor ?? "#12D9E3")"></i>@row.ShiftName</span>
                                }
                                else { <text>—</text> }
                            </td>
                            <td class="dat-num">@(row.CheckIn?.ToString("HH:mm") ?? "—")</td>
                            <td class="dat-num">@(row.CheckOut?.ToString("HH:mm") ?? "—")</td>
                            <td class="dat-num">@row.WorkedHours.ToString("0.##")</td>
                            <td class="dat-num @(row.LateHours > 0 ? "warn" : "")">@row.LateHours.ToString("0.##")</td>
                            <td class="dat-num @(row.EarlyLeaveHours > 0 ? "bad" : "")">@row.EarlyLeaveHours.ToString("0.##")</td>
                            <td><span class="dat-chip @row.Status">@DayAttendanceStore.StatusLabel(row.Status)</span></td>
                            <td>
                                @if (row.IsUpToDate)
                                {
                                    <span class="dat-check" title="محلّلة وحديثة">✓</span>
                                }
                                else if (row.IsStale)
                                {
                                    <span class="dat-stale" title="طرأ تغيير بعد التحليل (اعتماد نسيان بصمة · إجازة · مغادرة · تعديل بصمة) — شغّل «تحديث الحضور» ليُحتسب">✗</span>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="dat-pager">
            @if (Model.PageNumber > 1)
            {
                <a class="dat-btn ghost" href="?Month=@Model.Month&Search=@Model.Search&StatusFilter=@Model.StatusFilter&PageNumber=@(Model.PageNumber - 1)">السابق</a>
            }
            <span>صفحة @Model.PageNumber من @Model.TotalPages (@Model.TotalRows يومية)</span>
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a class="dat-btn ghost" href="?Month=@Model.Month&Search=@Model.Search&StatusFilter=@Model.StatusFilter&PageNumber=@(Model.PageNumber + 1)">التالي</a>
            }
        </div>
    }
</section>

@* ═══ بار الإجراءات الجماعية ═══
   يظهر بأول تحديد ويحمل العدّادين اللذين يحسمان الالتباس: كم صفّاً وكم موظفاً —
   لأن الموظف الواحد قد يحمل خمسة صفوف، والطلب يُقدَّم عن موظف لا عن صفّ. *@
<div class="dat-bulkbar" id="dat-bulkbar">
    <span>محدَّد: <b id="dat-pick-rows">0</b> يومية · <b id="dat-pick-emps">0</b> موظف</span>
    <button type="button" class="dat-btn" onclick="datRequest(true)">تقديم طلب</button>
    <button type="button" class="dat-btn ghost" onclick="datPickAll(false)">إلغاء التحديد</button>
</div>

@* ═══ منبثقة تقديم طلب نيابةً عن الموظفين ═══
   الاعتماد **فوريّ بلا لجنة** (قرار محمد 2026-08-07) لأن المُقدِّم HR لا الموظف؛
   وغير المستحقّ يُستثنى مع تقرير بدل أن يختفي النوع عن الجميع. *@
<div class="dat-modal-bg" id="dat-reqbg" onclick="datRequest(false)"></div>
<div class="dat-modal" id="dat-req" role="dialog" aria-modal="true" aria-labelledby="dat-req-title">
    <h3 id="dat-req-title">تقديم طلب نيابةً عن الموظفين</h3>

    <p class="dat-modal-scope">
        سيُقدَّم على <b id="dat-req-rows">0</b> يومية لـ<b id="dat-req-emps">0</b> موظفاً.
        الأيام المتتالية تُدمج بطلبٍ واحد، والمتباعدة تُقسَّم طلبات.
        <br />
        <b>اعتماد فوريّ</b> بلا لجنة موافقات — ومن لا يستحقّ (شرط أهلية · رصيد · تكرار)
        يُستثنى ويُذكر سببه بالتقرير.
    </p>

    <form method="post" asp-page-handler="BulkRequest" class="dat-modal-form" id="dat-req-form">
        <input type="hidden" name="Month" value="@Model.Month" />
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
        <div id="dat-req-selected"></div>

        <label class="dat-modal-label">نوع الطلب
            <select name="ReqTypeId" id="dat-req-type" class="dat-modal-text"
                    onchange="datTypeChanged()" required>
                <option value="">— اختر —</option>
                @foreach (var group in Model.RequestTypes.GroupBy(t => t.CategoryName))
                {
                    <optgroup label="@group.Key">
                        @foreach (var type in group)
                        {
                            <option value="@type.Id" data-timed="@(Model.TimedTypeIds.Contains(type.Id) ? "1" : "0")">@type.Name</option>
                        }
                    </optgroup>
                }
                @if (Model.Shifts.Count > 0)
                {
                    <optgroup label="المناوبات">
                        <option value="shift" data-timed="0">تغيير المناوبة</option>
                    </optgroup>
                }
            </select>
        </label>

        <label class="dat-modal-label zyu-6aa34d7432e7" id="dat-req-shift-wrap">
            المناوبة البديلة
            <select name="ReqShiftTypeId" id="dat-req-shift" class="dat-modal-text">
                @foreach (var shift in Model.Shifts)
                {
                    <option value="@shift.Id">@shift.Name</option>
                }
            </select>
        </label>

        @* الوقت يُقترح تلقائياً من اليوميات المحدَّدة ويبقى قابلاً للتعديل: التأخير
           نافذتُه [بداية الدوام ← الدخول الفعلي]، والخروج المبكر [الخروج ← نهاية
           الدوام]. الاقتراح لا يدهس تعديل المستخدم — يتوقّف أول ما يلمس الحقل. *@
        @* تحديدٌ بأكثر من يومية: **كل تاريخ بسطره ووقته** — نافذة الأحد ليست نافذة
           الاثنين، وفرضُ نافذةٍ واحدة على أيامٍ مختلفة يُنتج طلباً لا يطابق ما جرى. *@
        <div id="dat-req-days" class="zyu-6aa34d7432e7"></div>

        <div id="dat-req-time-block" class="zyu-6aa34d7432e7">
            <div id="dat-req-time-wrap" class="zyu-297096a428af" class="dat-modal-radios">
                <label class="dat-modal-label">من الساعة
                    <input type="time" name="ReqFromTime" class="dat-modal-text"
                           oninput="this.dataset.touched='1'" />
                </label>
                <label class="dat-modal-label">إلى الساعة
                    <input type="time" name="ReqToTime" class="dat-modal-text"
                           oninput="this.dataset.touched='1'" />
                </label>
                <button type="button" class="dat-btn ghost zyu-edcd900711b9"
                        onclick="datSuggestTimes(true)" title="أعِد حساب الوقت من اليوميات المحدَّدة">
                    ↻ اقتراح تلقائي
                </button>
            </div>
            <div class="dat-modal-legend" id="dat-req-time-hint"></div>
        </div>

        <label class="dat-modal-label">السبب (اختياري)
            <textarea name="ReqReason" rows="3" class="dat-modal-text"
                      placeholder="يُسجَّل بسجلّ الطلب وتاريخ الموافقات"></textarea>
        </label>

        <div class="dat-modal-actions">
            <button type="button" class="dat-btn ghost" onclick="datRequest(false)">إلغاء</button>
            <button type="submit" class="dat-btn"
                    data-zyconfirm="سيُقدَّم الطلب ويُعتمد فوراً بلا لجنة — تأكيد؟">تقديم واعتماد</button>
        </div>
    </form>
</div>

@* ═══ منبثقة إشعار الموظفين ═══
   بلا مؤلّف نطاق: النطاق هو العرض الحالي، ويُذكَر صراحةً بالمنبثقة كي لا يُرسِل
   المستخدم لمجموعةٍ يظنّها غير التي أمامه. *@
<div class="dat-modal-bg" id="dat-notifbg" onclick="datNotify(false)"></div>
<div class="dat-modal" id="dat-notif" role="dialog" aria-modal="true" aria-labelledby="dat-notif-title">
    <h3 id="dat-notif-title">إشعار الموظفين — ملخّص الحضور</h3>

    <p class="dat-modal-scope">
        سيُشعَر <b>@Model.NotifyEmployeeCount</b> موظفاً — وهم موظّفو العرض الحالي
        @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
        {
            <text>(المفلتَر على «@(Model.StatusFilter == IndexModel.StaleFilterKey ? "لم تُحلَّل" : Model.StatusFilter)»)</text>
        }
        للفترة <span dir="ltr">@Model.CutoffPeriod.From.ToString("yyyy-MM-dd") → @Model.CutoffPeriod.To.ToString("yyyy-MM-dd")</span>.
    </p>

    <form method="post" asp-page-handler="Notify" class="dat-modal-form">
        <input type="hidden" name="Month" value="@Model.Month" />
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />

        <div>
            <label class="dat-modal-label">قناة الإشعار</label>
            <div class="dat-modal-radios">
                @foreach (var (key, label) in AttendanceNotificationStore.Channels)
                {
                    @* القيمة تُحسب خارج الوسم: `checked="@(key == "System")"` يضع
                       اقتباساً مزدوجاً داخل قيمة سمةٍ مقتبَسة — مزلق تحليل بـRazor. *@
                    var isDefaultChannel = key == "System";
                    <label><input type="radio" name="Channel" value="@key" checked="@isDefaultChannel" /> @label</label>
                }
            </div>
        </div>

        <label class="dat-modal-label">نص الرسالة
            <textarea name="Message" rows="4" class="dat-modal-text">@AttendanceNotificationStore.DefaultTemplate("Summary")</textarea>
        </label>

        <div class="dat-modal-legend">
            الرموز تُملأ من حضور كل موظف الفعليّ:
            <span dir="ltr">{0}</span> أيام الغياب ·
            <span dir="ltr">{1}</span> ساعات التأخير ·
            <span dir="ltr">{2}</span> ساعات الخروج المبكر ·
            <span dir="ltr">{3}</span> الفترة ·
            <span dir="ltr">{4}</span> البصمات المفقودة.
        </div>

        <label class="dat-modal-check">
            <input type="checkbox" name="CcManager" value="1" /> نسخة للمدير المباشر
        </label>

        <div class="dat-modal-actions">
            <button type="button" class="dat-btn ghost" onclick="datNotify(false)">إلغاء</button>
            <button type="submit" class="dat-btn">إشعار الموظفين</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // ═══ قفل تمرير الصفحة تحت المنبثقة ═══
        // بلا قفل: العجلة تحرّك **الصفحة خلف المنبثقة** بينما المنبثقة ثابتة بمكانها،
        // فيرى المستخدم الشاشة تنزل تحت النافذة بلا سبب — وهو ما لا يفعله أي حوار.
        //
        // القفل بصنف `nxex-scroll-lock` على <html> لا بستايل مباشر: قوقعة النظام
        // تفرض `html { overflow-y: auto !important }` (هي التي جعلت المستند مالك
        // التمرير)، فأي `style.overflowY` يُكتب هنا يخسر أمام `!important` — قِسته
        // حيّاً: الخاصية المباشرة `hidden` والمحسوبة `auto`، والخلفية تمرّ. والصنف
        // معرَّف بـzynora-global-scroll-system.css بـ`!important` فيغلب.
        function datLockScroll() {
            var html = document.documentElement;
            var body = document.body;
            var open = document.getElementById('dat-req').style.display === 'block'
                    || document.getElementById('dat-notif').style.display === 'block';

            if (open === html.classList.contains('nxex-scroll-lock')) { return; }

            if (open) {
                // `overflow: hidden` وحده لم يكفِ — قِسته حيّاً بكروم: المحسوبة
                // `hidden` والخلفية تمرّ 150px تحت النافذة. فيُثبَّت <body> بموضعه
                // السالب: يفقد المستند ارتفاعه القابل للتمرير فلا يبقى ما يتحرّك،
                // والموضع محفوظ ليُعاد تماماً عند الإغلاق (بلا قفزة للأعلى).
                var y = window.scrollY;
                html.classList.add('nxex-scroll-lock');
                body.dataset.datScrollY = String(y);
                body.style.position = 'fixed';
                body.style.top = (-y) + 'px';
                body.style.insetInline = '0';
                body.style.width = '100%';
            } else {
                var restore = parseInt(body.dataset.datScrollY || '0', 10);
                html.classList.remove('nxex-scroll-lock');
                body.style.position = '';
                body.style.top = '';
                body.style.insetInline = '';
                body.style.width = '';
                delete body.dataset.datScrollY;
                window.scrollTo(0, restore);
            }
        }

        function datNotify(open) {
            document.getElementById('dat-notifbg').style.display = open ? 'block' : 'none';
            document.getElementById('dat-notif').style.display = open ? 'block' : 'none';
            datLockScroll();
        }

        // ═══ التحديد الجماعي ═══
        // مصدر الحقيقة الوحيد هو مربّعات الصفحة نفسها؛ لا نسخة موازية بذاكرة JS
        // تفترق عن الشاشة بعد إعادة الرسم.
        function datPicked() {
            return Array.prototype.filter.call(
                document.querySelectorAll('.dat-row-pick'), function (b) { return b.checked; });
        }

        function datSyncBar() {
            var picked = datPicked();
            var employees = {};
            picked.forEach(function (b) { employees[b.value.split('|')[0]] = 1; });
            var empCount = Object.keys(employees).length;

            document.getElementById('dat-pick-rows').textContent = picked.length;
            document.getElementById('dat-pick-emps').textContent = empCount;
            document.getElementById('dat-req-rows').textContent = picked.length;
            document.getElementById('dat-req-emps').textContent = empCount;
            document.getElementById('dat-bulkbar').classList.toggle('is-on', picked.length > 0);

            var all = document.getElementById('dat-pick-all');
            var boxes = document.querySelectorAll('.dat-row-pick');
            if (all) {
                all.checked = boxes.length > 0 && picked.length === boxes.length;
                all.indeterminate = picked.length > 0 && picked.length < boxes.length;
            }
        }

        function datPickChanged(box) {
            var row = box.closest('tr');
            if (row) { row.classList.toggle('is-picked', box.checked); }
            datSyncBar();
        }

        function datPickAll(checked) {
            Array.prototype.forEach.call(document.querySelectorAll('.dat-row-pick'), function (b) {
                b.checked = checked;
                var row = b.closest('tr');
                if (row) { row.classList.toggle('is-picked', checked); }
            });
            datSyncBar();
        }

        function datTypeChanged() {
            var select = document.getElementById('dat-req-type');
            var option = select.options[select.selectedIndex];
            var isShift = select.value === 'shift';
            var timed = option && option.getAttribute('data-timed') === '1';

            document.getElementById('dat-req-shift-wrap').style.display = isShift ? 'flex' : 'none';

            datBuildTargets(false);
        }

        // ═══ نافذة يومٍ واحد من حالته ═══
        // تأخير ⟹ [بداية الدوام ← الدخول]، وخروج مبكر ⟹ [الخروج ← نهاية الدوام].
        function datWindowOf(box) {
            var late = parseFloat(box.dataset.late || '0');
            var early = parseFloat(box.dataset.early || '0');

            if (late > 0 && box.dataset.start && box.dataset.in) {
                return { from: box.dataset.start, to: box.dataset.in, why: 'تأخير ' + late + ' ساعة' };
            }
            if (early > 0 && box.dataset.end && box.dataset.out) {
                return { from: box.dataset.out, to: box.dataset.end, why: 'خروج مبكر ' + early + ' ساعة' };
            }
            return { from: '', to: '', why: '' };
        }

        // ═══ بناء اليوميات المرسَلة ═══
        // النوع الزمنيّ بأكثر من يومية ⟹ **سطر لكل تاريخ بنافذته**، لأن نافذةً واحدة
        // على أيامٍ مختلفة لا تطابق ما جرى بأكثرها. ويومية واحدة تبقى بحقلَي النموذج.
        function datBuildTargets(force) {
            var select = document.getElementById('dat-req-type');
            var option = select.options[select.selectedIndex];
            var timed = !!option && option.getAttribute('data-timed') === '1';

            var picked = datPicked();
            var host = document.getElementById('dat-req-selected');
            var daysHost = document.getElementById('dat-req-days');
            var timeBlock = document.getElementById('dat-req-time-block');
            var perDay = timed && picked.length > 1;

            timeBlock.style.display = (timed && !perDay) ? 'block' : 'none';
            document.querySelector('#dat-req-time-wrap input[name="ReqFromTime"]').required = timed && !perDay;
            document.querySelector('#dat-req-time-wrap input[name="ReqToTime"]').required = timed && !perDay;

            if (!perDay) {
                daysHost.style.display = 'none';
                daysHost.innerHTML = '';
                host.innerHTML = '';
                picked.forEach(function (b) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'Selected';
                    input.value = b.value;
                    host.appendChild(input);
                });
                if (timed) { datSuggestTimes(force); }
                return;
            }

            // بالوضع اليوميّ تحمل أسطرُ الأيام حقولَ الإرسال، فتُفرَّغ المخفيّة وإلا
            // أُرسلت كل يومية مرتين: مرّةً بلا وقت ومرّةً بوقتها.
            host.innerHTML = '';
            daysHost.style.display = 'block';

            var previous = {};
            [].forEach.call(daysHost.querySelectorAll('.dat-day'), function (row) {
                previous[row.dataset.key] = {
                    from: row.querySelector('.dat-day-from').value,
                    to: row.querySelector('.dat-day-to').value,
                    touched: row.dataset.touched === '1'
                };
            });

            var html = '<div class="dat-days-head"><span>وقت كل يومية (مقترَح من حالتها — عدّل ما تشاء)</span>'
                     + '<button type="button" class="dat-btn ghost" onclick="datBuildTargets(true)">↻ اقتراح تلقائي للكل</button></div>'
                     + '<div class="dat-days-list">';

            picked.forEach(function (b) {
                var parts = b.value.split('|');
                var suggestion = datWindowOf(b);
                var kept = (!force && previous[b.value] && previous[b.value].touched) ? previous[b.value] : null;
                var from = kept ? kept.from : suggestion.from;
                var to = kept ? kept.to : suggestion.to;

                html += '<div class="dat-day" data-key="' + b.value + '"' + (kept ? ' data-touched="1"' : '') + '>'
                     +   '<span class="dat-day-label">' + (b.dataset.name || '') + ' — <b>' + parts[1] + '</b>'
                     +     '<span class="dat-day-why' + (suggestion.why ? '' : ' none') + '">'
                     +       (suggestion.why || 'بلا تأخير ولا خروج مبكر — أدخل الوقت يدوياً') + '</span>'
                     +   '</span>'
                     +   '<input type="time" class="dat-day-from" value="' + from + '" required '
                     +     'aria-label="من الساعة ' + parts[1] + '" oninput="datDayChanged(this)" />'
                     +   '<input type="time" class="dat-day-to" value="' + to + '" required '
                     +     'aria-label="إلى الساعة ' + parts[1] + '" oninput="datDayChanged(this)" />'
                     +   '<input type="hidden" name="Selected" value="" />'
                     + '</div>';
            });

            html += '</div>';
            daysHost.innerHTML = html;

            [].forEach.call(daysHost.querySelectorAll('.dat-day'), datSyncDayValue);
        }

        /// قيمة الإرسال لسطر يوم: "موظف|تاريخ|من|إلى" — الوقت جزءٌ من الهُويّة لا حقلٌ عام.
        function datSyncDayValue(row) {
            var from = row.querySelector('.dat-day-from').value;
            var to = row.querySelector('.dat-day-to').value;
            row.querySelector('input[type="hidden"]').value =
                from && to ? row.dataset.key + '|' + from + '|' + to : row.dataset.key;
        }

        function datDayChanged(input) {
            var row = input.closest('.dat-day');
            row.dataset.touched = '1';
            datSyncDayValue(row);
        }

        // ═══ اقتراح وقت المغادرة من اليوميات المحدَّدة ═══
        // مَن يقدّم مغادرةً إنما يغطّي تأخيراً أو خروجاً مبكراً وقع فعلاً، فالنافذة
        // المطلوبة معروفة من الصفّ نفسه: التأخير = [بداية الدوام ← الدخول]، والخروج
        // المبكر = [الخروج ← نهاية الدوام]. نُغطّي المدى الأوسع بالتحديد كي لا تبقى
        // دقيقةٌ خارج الطلب (أدنى بداية وأقصى نهاية).
        function datSuggestTimes(force) {
            var from = document.querySelector('#dat-req-time-wrap input[name="ReqFromTime"]');
            var to = document.querySelector('#dat-req-time-wrap input[name="ReqToTime"]');
            var hint = document.getElementById('dat-req-time-hint');

            if (force) { delete from.dataset.touched; delete to.dataset.touched; }
            var edited = from.dataset.touched === '1' || to.dataset.touched === '1';

            var picked = datPicked();
            var late = picked.filter(function (b) {
                return parseFloat(b.dataset.late || '0') > 0 && b.dataset.start && b.dataset.in;
            });
            var early = picked.filter(function (b) {
                return parseFloat(b.dataset.early || '0') > 0 && b.dataset.end && b.dataset.out;
            });

            // كلا النوعين بتحديدٍ واحد: الأكثر عدداً يفوز (وعند التعادل التأخير)، ويُذكر
            // الآخر بالتلميح — لأن النموذج نافذةٌ واحدة تُطبَّق على كل الأيام.
            var useLate = late.length > 0 && late.length >= early.length;
            var group = useLate ? late : early;

            if (group.length === 0) {
                // تُفرَّغ القيم وإلا بقي اقتراحُ تحديدٍ سابق معلّقاً بالحقل فيُرسَل وقتاً
                // لا علاقة له بما هو محدَّد الآن.
                if (!edited) { from.value = ''; to.value = ''; }
                hint.textContent = picked.length === 0
                    ? ''
                    : 'لا تأخير ولا خروجاً مبكراً باليوميات المحدَّدة — أدخل وقت المغادرة يدوياً.';
                return;
            }

            // "HH:mm" مصفوف صفرياً، فمقارنة النصوص هي مقارنة الوقت نفسها.
            var starts = group.map(function (b) { return useLate ? b.dataset.start : b.dataset.out; });
            var ends = group.map(function (b) { return useLate ? b.dataset.in : b.dataset.end; });
            var suggestedFrom = starts.slice().sort()[0];
            var suggestedTo = ends.slice().sort().pop();

            var label = useLate
                ? 'اقتُرح من تأخير ' + group.length + ' يومية: من بداية الدوام ' + suggestedFrom +
                  ' إلى الدخول الفعلي ' + suggestedTo
                : 'اقتُرح من خروجٍ مبكر بـ' + group.length + ' يومية: من الخروج الفعلي ' + suggestedFrom +
                  ' إلى نهاية الدوام ' + suggestedTo;

            label += ' — عدّله كما تشاء.';

            var other = useLate ? early.length : late.length;
            if (other > 0) {
                label += ' وبالتحديد أيضاً ' + other +
                    (useLate ? ' يومية بخروجٍ مبكر' : ' يومية بتأخير') + ' لم تدخل الاقتراح.';
            }

            if (edited) {
                hint.textContent = 'عدّلت الوقت يدوياً فلم يُستبدَل. الاقتراح: ' +
                    suggestedFrom + ' → ' + suggestedTo + ' (اضغط «اقتراح تلقائي» لاعتماده).';
                return;
            }

            from.value = suggestedFrom;
            to.value = suggestedTo;
            hint.textContent = label;
        }

        function datRequest(open) {
            if (open) {
                // التحديد يُنسخ لحظة الفتح: المربّعات خارج نموذج الإرسال (نموذج
                // الفلترة GET يلفّ أعلى الصفحة)، فلا تُرسَل من تلقائها. والبناء يعيد
                // الحساب على ما هو محدَّد الآن لا على تحديدٍ سابق.
                if (datPicked().length === 0) { return; }
                datTypeChanged();
            }
            document.getElementById('dat-reqbg').style.display = open ? 'block' : 'none';
            document.getElementById('dat-req').style.display = open ? 'block' : 'none';
            datLockScroll();
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { datNotify(false); datRequest(false); }
        });

        datSyncBar();
    </script>
}

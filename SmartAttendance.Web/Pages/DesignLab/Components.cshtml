@page "/DesignLab/Components"
@model SmartAttendance.Web.Pages.DesignLab.ComponentsModel

@{
    ViewData["Title"] = "مكتبة مكونات ZYNORA";
}

<link rel="stylesheet"
      href="~/css/zynora-component-lab.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/zynora-component-lab-datetime-v2.css"
      asp-append-version="true" />
<link rel="stylesheet"
      href="~/css/zynora-component-lab-inline-overrides.css"
      asp-append-version="true" />

<div class="zcl-page" dir="rtl">

    <header class="zcl-header">
        <div class="zcl-header-copy">
            <span class="zcl-kicker">PHASE 0 · UI FOUNDATION</span>

            <h1>مكتبة مكونات ZYNORA</h1>

            <p>
                هذه الصفحة هي مصدر الحقيقة البصري قبل إعادة تصميم صفحات النظام.
                لا نعتمد أي صفحة أعمال قبل تثبيت المكونات الأساسية هنا.
            </p>
        </div>

        <div class="zcl-header-actions">

            <div class="zcl-review-state">
                <strong>قيد المراجعة</strong>
            </div>

            <a href="/DesignLab"
               class="zy-btn zy-btn--ghost zy-btn--sm">
                مختبر المقاسات
            </a>

            <a href="/DesignPreview"
               class="zy-btn zy-btn--ghost zy-btn--sm">
                المعاينة السابقة
            </a>

        </div>
    </header>


    <section class="zcl-contract">

        <div>
            <strong>القاعدة</strong>
            <span>Reference → ZYNORA → Review → Approve → Lock</span>
        </div>

        <div>
            <strong>الاتجاه</strong>
            <span>RTL + LTR</span>
        </div>

        <div>
            <strong>الثيم</strong>
            <span>Dark + Light</span>
        </div>

        <div>
            <strong>الشاشات</strong>
            <span>Desktop + Tablet + Mobile</span>
        </div>

    </section>


    <div class="zcl-layout">

        <!-- ================================================= -->
        <!-- NAVIGATION -->
        <!-- ================================================= -->

        <aside class="zcl-nav">

            <div class="zcl-nav-title">
                COMPONENTS
            </div>

            <a href="#principles">
                <span>00</span>
                الأساس
            </a>

            <a href="#buttons" class="active">
                <span>01</span>
                الأزرار
            </a>

            <a href="#inputs">
                <span>02</span>
                الحقول
            </a>

            <a href="#selection">
                <span>03</span>
                الاختيارات
            </a>

            <a href="#datetime">
                <span>04</span>
                التاريخ والوقت
            </a>

            <a href="#cards">
                <span>05</span>
                البطاقات والحالات
            </a>

            <a href="#tables">
                <span>06</span>
                الجداول
            </a>

            <a href="#overlays">
                <span>07</span>
                Modal / Drawer
            </a>

            <a href="#feedback">
                <span>08</span>
                التنبيهات والحالات
            </a>

        </aside>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <main class="zcl-content">


            <!-- ================================================= -->
            <!-- 00 FOUNDATION -->
            <!-- ================================================= -->

            <section class="zcl-section" id="principles">

                <div class="zcl-section-head">

                    <div>
                        <span class="zcl-number">00</span>
                        <h2>قواعد النظام البصري</h2>

                        <p>
                            أي مكون نعتمده هنا يصبح المرجع لجميع صفحات ZYNORA.
                        </p>
                    </div>

                    <span class="zcl-status zcl-status-review">
                        تحت المراجعة
                    </span>

                </div>


                <div class="zcl-principles">

                    <article>
                        <strong>هوية واحدة</strong>
                        <p>
                            لا ألوان أو Radius أو Shadows مستقلة داخل كل صفحة.
                        </p>
                    </article>

                    <article>
                        <strong>سلوك واحد</strong>
                        <p>
                            نفس الحقل ونفس الزر يتصرفان بنفس الطريقة في كل النظام.
                        </p>
                    </article>

                    <article>
                        <strong>حالات كاملة</strong>
                        <p>
                            Default · Hover · Focus · Disabled · Error · Loading
                        </p>
                    </article>

                    <article>
                        <strong>اعتماد قبل التعميم</strong>
                        <p>
                            لا يُنقل المكون للصفحات قبل الموافقة عليه هنا.
                        </p>
                    </article>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- 01 BUTTONS -->
            <!-- ================================================= -->

            <section class="zcl-section" id="buttons">

                <div class="zcl-section-head">

                    <div>
                        <span class="zcl-number">01</span>
                        <h2>Button System</h2>

                        <p>
                            أول مكون سنثبته نهائياً في ZYNORA.
                        </p>
                    </div>

                    <span class="zcl-status zcl-status-first">
                        أول مراجعة
                    </span>

                </div>


                <div class="zcl-demo-block">

                    <div class="zcl-demo-title">
                        الاستخدام الدلالي
                    </div>

                    <div class="zcl-row">

                        <button type="button"
                                class="zy-btn zy-btn--primary">
                            حفظ التغييرات
                        </button>

                        <button type="button"
                                class="zy-btn zy-btn--secondary">
                            إجراء ثانوي
                        </button>

                        <button type="button"
                                class="zy-btn zy-btn--ghost">
                            رجوع
                        </button>

                        <button type="button"
                                class="zy-btn zy-btn--danger">
                            حذف
                        </button>

                    </div>

                </div>


                <div class="zcl-grid-2">

                    <div class="zcl-demo-block">

                        <div class="zcl-demo-title">
                            الأحجام
                        </div>

                        <div class="zcl-row">

                            <button type="button"
                                    class="zy-btn zy-btn--primary zy-btn--sm">
                                صغير
                            </button>

                            <button type="button"
                                    class="zy-btn zy-btn--primary">
                                قياسي
                            </button>

                            <button type="button"
                                    class="zy-btn zy-btn--primary zy-btn--lg">
                                كبير
                            </button>

                        </div>

                    </div>


                    <div class="zcl-demo-block">

                        <div class="zcl-demo-title">
                            حالات النظام
                        </div>

                        <div class="zcl-row">

                            <button type="button"
                                    class="zy-btn zy-btn--primary">
                                متاح
                            </button>

                            <button type="button"
                                    class="zy-btn zy-btn--primary"
                                    disabled>
                                معطّل
                            </button>

                            <button type="button"
                                    class="zy-btn zy-btn--secondary zcl-loading"
                                    disabled>
                                <span></span>
                                جاري الحفظ
                            </button>

                        </div>

                    </div>

                </div>


                <div class="zcl-decision">

                    <strong>قرار مطلوب لاحقاً</strong>

                    <span>
                        Height · Radius · Font Weight · Padding · Icon Size ·
                        Hover · Focus · Loading
                    </span>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- 02 INPUTS -->
            <!-- ================================================= -->

            <section class="zcl-section" id="inputs">

                <div class="zcl-section-head">

                    <div>
                        <span class="zcl-number">02</span>
                        <h2>Fields & Inputs</h2>

                        <p>
                            الحقول النصية والرقمية والبحث والنصوص الطويلة.
                        </p>
                    </div>

                    <span class="zcl-status">
                        Pending
                    </span>

                </div>


                <div class="zcl-form-grid">

                    <div class="zy-field">

                        <label class="zy-label">
                            اسم الموظف
                            <span class="zy-req">*</span>
                        </label>

                        <input class="zy-input"
                               type="text"
                               placeholder="اكتب اسم الموظف" />

                        <span class="zy-help">
                            الاسم كما يظهر في الملف الوظيفي
                        </span>

                    </div>


                    <div class="zy-field">

                        <label class="zy-label">
                            بحث
                        </label>

                        <input class="zy-input"
                               type="search"
                               placeholder="ابحث بالاسم أو الرمز..." />

                    </div>


                    <div class="zy-field">

                        <label class="zy-label">
                            رقم
                        </label>

                        <input class="zy-input"
                               type="number"
                               value="1200" />

                    </div>


                    <div class="zy-field">

                        <label class="zy-label">
                            للقراءة فقط
                        </label>

                        <input class="zy-input"
                               type="text"
                               value="0015-Seen"
                               readonly />

                    </div>


                    <div class="zy-field">

                        <label class="zy-label">
                            معطّل
                        </label>

                        <input class="zy-input"
                               type="text"
                               value="غير متاح"
                               disabled />

                    </div>


                    <div class="zy-field zy-field--invalid">

                        <label class="zy-label">
                            حقل يحتوي خطأ
                        </label>

                        <input class="zy-input"
                               type="text"
                               value="" />

                        <span class="zy-error">
                            هذا الحقل مطلوب
                        </span>

                    </div>


                    <div class="zy-field zcl-span-2">

                        <label class="zy-label">
                            ملاحظات
                        </label>

                        <textarea class="zy-textarea"
                                  rows="4"
                                  placeholder="اكتب الملاحظات هنا..."></textarea>

                    </div>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- 03 SELECTION -->
            <!-- ================================================= -->

            <section class="zcl-section" id="selection">

                <div class="zcl-section-head">

                    <div>
                        <span class="zcl-number">03</span>
                        <h2>Selection Controls</h2>

                        <p>
                            Dropdown · Checkbox · Radio · Toggle
                        </p>
                    </div>

                    <span class="zcl-status">
                        Pending
                    </span>

                </div>


                <div class="zcl-grid-2">

                    <div class="zcl-demo-block">

                        <div class="zcl-demo-title">
                            Select / Dropdown
                        </div>

                        <div class="zy-field">

                            <label class="zy-label">
                                القسم
                            </label>

                            <div class="zcl3-select"
     data-zcl3-select>

    <button type="button"
            class="zcl3-select-trigger"
            data-zcl3-trigger
            aria-haspopup="listbox"
            aria-expanded="false">

        <span class="zcl3-select-value"
              data-zcl3-value>
            الموارد البشرية
        </span>

        <span class="zcl3-select-chevron"
              aria-hidden="true">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="m7 10 5 5 5-5"></path>
            </svg>
        </span>

    </button>


    <div class="zcl3-select-menu"
         data-zcl3-menu
         role="listbox"
         hidden>

        <button type="button"
                class="zcl3-select-option is-selected"
                role="option"
                aria-selected="true"
                data-value="hr">
            الموارد البشرية
        </button>

        <button type="button"
                class="zcl3-select-option"
                role="option"
                aria-selected="false"
                data-value="finance">
            المالية
        </button>

        <button type="button"
                class="zcl3-select-option"
                role="option"
                aria-selected="false"
                data-value="operations">
            العمليات
        </button>

        <button type="button"
                class="zcl3-select-option"
                role="option"
                aria-selected="false"
                data-value="sales">
            المبيعات
        </button>

    </div>

</div>

                        </div>

                    </div>


                    <div class="zcl-demo-block">

                        <div class="zcl-demo-title">
                            Checkbox
                        </div>

                        <div class="zcl-stack">

                            <label class="zy-check">
                                <input type="checkbox" checked />
                                موظف نشط
                            </label>

                            <label class="zy-check">
                                <input type="checkbox" />
                                يتطلب موافقة
                            </label>

                            <label class="zy-check">
                                <input type="checkbox" disabled />
                                خيار معطّل
                            </label>

                        </div>

                    </div>


                    <div class="zcl-demo-block">

                        <div class="zcl-demo-title">
                            Radio
                            <small>يحتاج مكون ZYNORA رسمي</small>
                        </div>

                        <div class="zcl-stack zcl-radio">

                            <label>
                                <input type="radio"
                                       name="contract"
                                       checked />
                                دوام كامل
                            </label>

                            <label>
                                <input type="radio"
                                       name="contract" />
                                دوام جزئي
                            </label>

                        </div>

                    </div>


                    <div class="zcl-demo-block">

                        <div class="zcl-demo-title">
                            Toggle
                        </div>

                        <div class="zcl-toggle-row">

                            <span class="zy-toggle">
                                <input type="checkbox" checked />
                                <i></i>
                            </span>

                            <div>
                                <strong>تفعيل الخاصية</strong>
                                <small>
                                    المثال يستخدم مكون ZYNORA الحالي
                                </small>
                            </div>

                        </div>

                    </div>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- 04 DATE / TIME -->
            <!-- ================================================= -->

            <section class="zcl-section" id="datetime">

    <div class="zcl-section-head">

        <div>
            <span class="zcl-number">04</span>
            <h2>التاريخ والوقت</h2>
            <p>
                مكونات ZYNORA الموحدة لاختيار التاريخ، الشهر والوقت.
            </p>
        </div>

        <span class="zcl-status">
            قيد التصميم
        </span>

    </div>


    <div class="zdt2-stage">

        <div class="zdt2-stage-head">

            <div>
                <strong>ZYNORA Date & Time</strong>
                <span>
                    بدون أي نافذة أصلية من Windows أو Chrome.
                </span>
            </div>

            <small>DATE · MONTH · TIME</small>

        </div>


        <div class="zdt2-grid">


            <!-- ================= DATE ================= -->

            <div class="zdt2-field zdt2-date">

                <label>التاريخ</label>

                <button type="button"
                        class="zdt2-trigger">

                    <span class="zdt2-value">
                        اختر التاريخ
                    </span>

                    <span class="zdt2-trigger-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="3" y="5"
                                  width="18"
                                  height="16"
                                  rx="3"></rect>

                            <path d="M8 3v4M16 3v4M3 10h18"></path>

                        </svg>

                    </span>

                </button>


                <div class="zdt2-popover zdt2-date-panel"
                     hidden>

                    <div class="zdt2-panel-head">

                        <button type="button"
                                class="zdt2-nav"
                                data-date-prev>
                            ‹
                        </button>

                        <div class="zdt2-date-period">

    <button type="button"
            class="zdt2-period-button"
            data-date-month-label
            title="اختيار الشهر">
    </button>

    <button type="button"
            class="zdt2-period-button"
            data-date-year-label
            title="اختيار السنة">
    </button>

</div>

                        <button type="button"
                                class="zdt2-nav"
                                data-date-next>
                            ›
                        </button>

                    </div>


                    <div class="zdt2-week">

                        <span>أحد</span>
                        <span>اثن</span>
                        <span>ثلا</span>
                        <span>أرب</span>
                        <span>خمي</span>
                        <span>جمع</span>
                        <span>سبت</span>

                    </div>


                    <div class="zdt2-days"
                         data-date-days>
                    </div>


                    <div class="zdt2-panel-foot">

                        <button type="button"
                                data-date-clear>
                            مسح
                        </button>

                        <button type="button"
                                data-date-today>
                            اليوم
                        </button>

                    </div>

                </div>

            </div>


            <!-- ================= MONTH ================= -->

            <div class="zdt2-field zdt2-month">

                <label>الشهر</label>

                <button type="button"
                        class="zdt2-trigger">

                    <span class="zdt2-value">
                        اختر الشهر
                    </span>

                    <span class="zdt2-trigger-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12"
                                    cy="12"
                                    r="9"></circle>

                            <path d="M12 7v5l3 2"></path>

                        </svg>

                    </span>

                </button>


                <div class="zdt2-popover zdt2-month-panel"
                     hidden>

                    <div class="zdt2-panel-head">

                        <button type="button"
                                class="zdt2-nav"
                                data-month-prev>
                            ‹
                        </button>

                        <strong data-month-year></strong>

                        <button type="button"
                                class="zdt2-nav"
                                data-month-next>
                            ›
                        </button>

                    </div>


                    <div class="zdt2-months"
                         data-month-grid>
                    </div>


                    <div class="zdt2-panel-foot">

                        <button type="button"
                                data-month-clear>
                            مسح
                        </button>

                        <button type="button"
                                data-month-current>
                            الشهر الحالي
                        </button>

                    </div>

                </div>

            </div>


            <!-- ================= TIME ================= -->

            <div class="zdt2-field zdt2-time">

                <label>الوقت</label>

                <button type="button"
                        class="zdt2-trigger">

                    <span class="zdt2-value">
                        اختر الوقت
                    </span>

                    <span class="zdt2-trigger-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12"
                                    cy="12"
                                    r="9"></circle>

                            <path d="M12 7v5l3 2"></path>

                        </svg>

                    </span>

                </button>


                <div class="zdt2-popover zdt2-time-panel"
                     hidden>

                    <div class="zdt2-time-title">

                        <span>اختيار الوقت</span>

                        <strong data-time-preview>
                            --:--
                        </strong>

                    </div>


                    <div class="zdt2-time-columns">

                        <div>

                            <span class="zdt2-time-label">
                                الساعة
                            </span>

                            <div class="zdt2-time-list"
                                 data-time-hours>
                            </div>

                        </div>


                        <div>

                            <span class="zdt2-time-label">
                                الدقيقة
                            </span>

                            <div class="zdt2-time-list"
                                 data-time-minutes>
                            </div>

                        </div>

                    </div>


                    <div class="zdt2-panel-foot">

                        <button type="button"
                                data-time-clear>
                            مسح
                        </button>

                        <button type="button"
                                data-time-now>
                            الآن
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<script src="~/js/zynora-component-lab-datetime-v2.js"
        asp-append-version="true"
        defer></script>
<section class="zcl-section" id="cards">

    <div class="zcl-section-head">
        <div>
            <span class="zcl-number">05</span>
            <h2>البطاقات والحالات</h2>
            <p>نبني مكونات البطاقات خطوة بخطوة قبل اعتمادها للنظام.</p>
        </div>

        <span class="zcl-status">
            قيد التصميم
        </span>
    </div>

    <div class="zc5-stage">

        <div class="zc5-stage-head">
            <div>
                <strong>بطاقة المعلومات</strong>
                <span>النموذج الأساسي للبطاقات داخل ZYNORA</span>
            </div>

            <small>CONTENT CARD</small>
        </div>

        <article class="zc5-info-card">

            <div class="zc5-info-icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <rect x="4" y="4" width="16" height="16" rx="3"></rect>
                    <path d="M8 9h8"></path>
                    <path d="M8 13h5"></path>
                </svg>
            </div>

            <div class="zc5-info-copy">

                <span class="zc5-info-type">
                    معلومات
                </span>

                <h3>
                    بيانات الموظف
                </h3>

                <p>
                    تعرض هذه البطاقة مجموعة معلومات مرتبطة ضمن سياق واحد
                    بدون تقسيمات أو عناصر بصرية زائدة.
                </p>

            </div>

        </article>

    </div>

</section>
<section class="zcl-section" id="tables">

                <div class="zcl-section-head">

                    <div>
                        <span class="zcl-number">06</span>
                        <h2>Table System</h2>

                        <p>
                            الجدول سيكون من أهم مكونات ZYNORA لأنه يتكرر في أغلب الصفحات.
                        </p>
                    </div>

                    <span class="zcl-status">
                        Pending
                    </span>

                </div>


                <div class="zcl-table-toolbar">

                    <div class="zy-field zcl-search">
                        <input class="zy-input"
                               type="search"
                               placeholder="بحث في الجدول..." />
                    </div>

                    <button class="zy-btn zy-btn--secondary zy-btn--sm"
                            type="button">
                        تصفية
                    </button>

                    <button class="zy-btn zy-btn--secondary zy-btn--sm"
                            type="button">
                        تصدير
                    </button>

                </div>


                <div class="zy-table-wrap">

                    <table class="zy-table">

                        <thead>
                            <tr>
                                <th>رمز الموظف</th>
                                <th>الموظف</th>
                                <th>القسم</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>

<!-- ZYNORA_TOGGLE_CLICK_V2_START -->

<script>
document.addEventListener("DOMContentLoaded", function () {

    const selection =
        document.getElementById("selection");

    if (!selection) return;


    /*
     * Find the Toggle demo block only.
     * We do not modify the normal Checkbox block.
     */
    const blocks =
        Array.from(
            selection.querySelectorAll(
                ".zcl-demo-block, .zcl-showcase-group, .zcl-grid-2 > div"
            )
        );


    const toggleBlock =
        blocks.find(function (block) {

            const text =
                (block.textContent || "").trim();

            return (
                text.includes("Toggle") ||
                text.includes("تفعيل الخاصية")
            );
        });


    if (!toggleBlock) {
        console.warn(
            "ZYNORA Toggle block was not found."
        );
        return;
    }


    const input =
        toggleBlock.querySelector(
            'input[type="checkbox"]'
        );


    if (!input) {
        console.warn(
            "ZYNORA Toggle checkbox was not found."
        );
        return;
    }


    toggleBlock.classList.add(
        "zcl-toggle-clickable"
    );


    /*
     * If the click already happened on the real input
     * or its label, browser handles it normally.
     * Otherwise clicking anywhere in the Toggle row
     * changes the switch.
     */
    toggleBlock.addEventListener(
        "click",
        function (event) {

            if (input.disabled) return;


            if (
                event.target === input ||
                event.target.closest("label")
            ) {
                return;
            }


            if (
                event.target.closest(
                    "button, a, select, textarea"
                )
            ) {
                return;
            }


            input.checked =
                !input.checked;


            input.dispatchEvent(
                new Event(
                    "change",
                    {
                        bubbles: true
                    }
                )
            );
        }
    );

});
</script>


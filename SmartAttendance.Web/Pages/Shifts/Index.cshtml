@page
@model SmartAttendance.Web.Pages.Shifts.IndexModel

@*
    «الشفتات» — الطبقة القديمة (جدول Shifts). صُيّرت للعرض فقط (read-only):
    الإنشاء/التعديل/الحذف/الاستيراد أُزيلت من الواجهة، وصفحاتها تعيد التوجيه لهنا.
    كل تعريف مناوبة جديد يتم عبر «أنواع المناوبات» /ShiftTypes (المصدر الحديث الذي
    يغذّي الروستر ومحرك الحضور الرسمي). تبقى هذه الشاشة لعرض البيانات القديمة التي
    لا تزال يقرأها ملف الموظف والإعداد ومحرك المعالجة الاحتياطي.
*@

@{
    ViewData["Title"] = "الشفتات (قديم)";
}

<style>
    .lsh-page { display: flex; flex-direction: column; gap: 14px; color: var(--sa-text, #DCEAF4); }
    .lsh-head {
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;
        padding: 16px 20px; border: 1px solid rgba(73,111,151,.22); border-radius: 20px;
        background: radial-gradient(circle at 90% 10%, rgba(148,163,184,.14), transparent 36%),
                    linear-gradient(135deg, rgba(9,31,52,.95), rgba(5,16,29,.95));
    }
    html[data-theme="light"] .lsh-head { background: linear-gradient(135deg, #fff, #f2f7fb); }
    .lsh-head h1 { margin: 0; font-size: 20px; font-weight: 1000; display: flex; align-items: center; gap: 10px; }
    .lsh-head p { margin: 3px 0 0; font-size: 12px; color: var(--sa-muted, #8FA8BC); font-weight: 800; }
    .lsh-legacy-tag { font-size: 11px; font-weight: 900; padding: 3px 10px; border-radius: 999px; background: rgba(148,163,184,.16); color: #94a3b8; border: 1px solid rgba(148,163,184,.3); }
    .lsh-btn { min-height: 38px; padding: 8px 18px; border-radius: 12px; border: 0; font-size: 13px; font-weight: 900; cursor: pointer; background: linear-gradient(135deg, #12D9E3, #0ea5b5); color: #04141d; text-decoration: none; display: inline-flex; align-items: center; }

    .lsh-notice {
        display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
        padding: 12px 16px; border-radius: 14px; font-size: 13px; font-weight: 800;
        border: 1px solid rgba(96,165,250,.32); background: rgba(96,165,250,.08); color: var(--sa-text, #DCEAF4);
    }
    .lsh-notice .ico { font-size: 18px; }
    .lsh-notice b { color: #60a5fa; }
    .lsh-notice a { color: #04141d; }
    .lsh-notice .spacer { flex: 1; }

    .lsh-card { border: 1px solid rgba(73,111,151,.22); border-radius: 18px; overflow: hidden; background: var(--sa-surface, rgba(8,25,43,.9)); }
    .lsh-search { display: flex; gap: 8px; padding: 12px 14px; border-bottom: 1px solid rgba(73,111,151,.18); flex-wrap: wrap; }
    .lsh-search input[type=text] { flex: 1; min-width: 180px; min-height: 36px; border-radius: 10px; border: 1px solid rgba(73,111,151,.25); background: rgba(0,0,0,.16); color: inherit; padding: 6px 12px; font-size: 13px; }
    html[data-theme="light"] .lsh-search input[type=text] { background: #fff; }
    .lsh-search .ghost { min-height: 36px; padding: 6px 16px; border-radius: 10px; border: 1px solid rgba(73,111,151,.3); background: transparent; color: inherit; font-weight: 900; font-size: 13px; text-decoration: none; display: inline-flex; align-items: center; cursor: pointer; }

    .lsh-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .lsh-table th { text-align: start; padding: 12px 14px; font-size: 11px; font-weight: 1000; color: var(--sa-muted, #8FA8BC); border-bottom: 1px solid rgba(73,111,151,.22); background: rgba(0,0,0,.12); white-space: nowrap; }
    html[data-theme="light"] .lsh-table th { background: #f2f7fb; }
    .lsh-table td { padding: 11px 14px; border-bottom: 1px solid rgba(143,168,188,.08); vertical-align: middle; }
    .lsh-table tr:hover td { background: rgba(18,217,227,.04); }
    .lsh-table .num { direction: ltr; text-align: start; font-variant-numeric: tabular-nums; }
    .lsh-chip { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 900; }
    .lsh-chip.on { background: rgba(74,222,128,.12); color: #4ade80; }
    .lsh-chip.off { background: rgba(248,113,113,.12); color: #f87171; }
    .lsh-chip.night { background: rgba(129,140,248,.14); color: #818cf8; }
    .lsh-empty { padding: 28px; text-align: center; color: var(--sa-muted, #8FA8BC); font-weight: 800; }
    .lsh-alert { padding: 10px 14px; border-radius: 12px; font-size: 13px; font-weight: 800; border: 1px solid rgba(74,222,128,.35); background: rgba(74,222,128,.08); }
</style>

<section class="lsh-page" dir="rtl">
    <header class="lsh-head">
        <div>
            <h1>الشفتات <span class="lsh-legacy-tag">طبقة قديمة · للعرض فقط</span></h1>
            <p>عرض مناوبات النظام القديم — للإنشاء والتعديل استخدم «أنواع المناوبات».</p>
        </div>
        <a href="/ShiftTypes" class="lsh-btn">إدارة أنواع المناوبات ←</a>
    </header>

    <div class="lsh-notice">
        <span class="ico">ℹ️</span>
        <span>
            هذه الطبقة القديمة (جدول <b>Shifts</b>) لم تعد قابلة للتحرير هنا. تعريف المناوبات وتعديلها
            صار حصراً عبر <b>«أنواع المناوبات»</b> (<a href="/ShiftTypes">/ShiftTypes</a>) — المصدر الذي
            يغذّي الروستر ومحرك الحضور الرسمي.
        </span>
        <span class="spacer"></span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="lsh-alert">@TempData["SuccessMessage"]</div>
    }

    <div class="lsh-card">
        <form method="get" class="lsh-search">
            <input type="text"
                   name="SearchTerm"
                   value="@Model.SearchTerm"
                   placeholder="بحث برمز المناوبة أو اسمها..." />
            <button type="submit" class="lsh-btn">بحث</button>
            <a asp-page="./Index" class="ghost">مسح</a>
        </form>

        @if (Model.Shifts.Any())
        {
            <table class="lsh-table">
                <thead>
                    <tr>
                        <th>الرمز</th>
                        <th>الاسم</th>
                        <th>البداية</th>
                        <th>النهاية</th>
                        <th>الساعات</th>
                        <th>سماح الدخول</th>
                        <th>سماح الخروج</th>
                        <th>ليلية</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shift in Model.Shifts)
                    {
                        <tr>
                            <td><b>@shift.Code</b></td>
                            <td>@shift.Name</td>
                            <td class="num">@shift.StartTime</td>
                            <td class="num">@shift.EndTime</td>
                            <td class="num">@shift.WorkingHours</td>
                            <td class="num">@shift.GraceInMinutes</td>
                            <td class="num">@shift.GraceOutMinutes</td>
                            <td>
                                @if (shift.IsNightShift)
                                { <span class="lsh-chip night">ليلية</span> }
                                else
                                { <span style="color:var(--sa-muted,#8FA8BC)">—</span> }
                            </td>
                            <td><span class="lsh-chip @(shift.IsActive ? "on" : "off")">@(shift.IsActive ? "نشط" : "متوقف")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="lsh-empty">لا توجد مناوبات في الطبقة القديمة.</div>
        }
    </div>
</section>
